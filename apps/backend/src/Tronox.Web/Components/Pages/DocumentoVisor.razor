@page "/modulo/documento-visor"
@attribute [Authorize(Policy = "TenantMember")]
@layout Tronox.Web.Components.Layout.EmptyLayout
@* RF04 - Visor documental a pantalla completa (calcado de exp_visor.aspx). Static SSR: sirve el DOM
   + pdf.js + exp_visor.js (wwwroot/visor). El JS renderiza el PDF (miniaturas/zoom/rotar/nav) y
   consume /visor/bin y /visor/data. Se abre en un iframe overlay desde el ojo de la bandeja. *@
@using Tronox.Application.Documentos
@using Tronox.Domain.Enums
@inject IDocumentoService DocSvc
@inject Tronox.Application.Common.ITenantContext Tenant

<PageTitle>@(_d?.Nombre ?? "Visor") - TRONOX SGDEA</PageTitle>

<HeadContent>
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/visor/exp_visor.css" rel="stylesheet" />
    <style>html,body{margin:0;height:100%;background:#0f172a;overflow:hidden}</style>
</HeadContent>

@if (_d is null)
{
    <div style="padding:24px;font-family:sans-serif;color:#e2e8f0">@(_error ?? "Cargando documento...")</div>
}
else
{
    <div id="vzShell" class="vz-shell"
         data-doc="@Doc" data-exp="0" data-re="t@(_tenant)" data-t="@_tenant"
         data-bin="/visor/bin?doc=@Doc" data-formato="@_formato" data-ocr="@_d.EstadoFirma" data-tipo="@(_d.TipologiaNombre is null ? 0 : 1)"
         data-nombre="@_d.Nombre" data-fecha="@(_d.FechaDocumento?.ToString("yyyy-MM-dd"))"
         data-scroll="0"
         data-pdfjs="/visor/pdf.js"
         data-pdfworker="/visor/pdf.worker.js">

        @* ── Barra superior ── *@
        <div class="vz-top">
            <div class="vz-doc">
                <span class="vz-doc-ic"><i class="fa fa-file-pdf-o"></i></span>
                <div class="vz-doc-info">
                    <div class="vz-doc-nm">@_d.Nombre</div>
                    <div class="vz-doc-sub">@_formato.ToUpperInvariant() &middot; @(_d.Folios ?? 1) pág.
                        @if (_d.NivelNombre is "Reservado" or "Clasificado")
                        {
                            <text>&middot; <span class="vz-clasif"><i class="fa fa-lock"></i> @_d.NivelNombre</span></text>
                        }
                        <span id="vzOcr" class="vz-ocr"></span>
                    </div>
                </div>
            </div>
            <div class="vz-top-acc">
                <a class="vz-btn" href="/visor/bin?doc=@Doc&dl=1" target="_blank" title="Descargar"><i class="fa fa-download"></i></a>
                <a class="vz-btn" href="/visor/bin?doc=@Doc" target="_blank" title="Imprimir"><i class="fa fa-print"></i></a>
                <span style="display:inline-block;width:1px;height:22px;background:rgba(148,163,184,.45);margin:0 5px;vertical-align:middle;"></span>
                <button type="button" class="vz-btn" onclick="alert('Firmar: se habilita con el modulo de Firma (RQ05).');" title="Firmar"><i class="fa fa-pencil-square-o"></i></button>
                <button type="button" class="vz-btn" onclick="alert('Compartir: se habilita con el modulo de Compartir (RF07).');" title="Compartir"><i class="fa fa-share-alt"></i></button>
                <button type="button" class="vz-btn" onclick="alert('Enviar por correo: proximamente.');" title="Enviar por correo"><i class="fa fa-envelope-o"></i></button>
                <span style="display:inline-block;width:1px;height:22px;background:rgba(148,163,184,.45);margin:0 5px;vertical-align:middle;"></span>
                <button type="button" class="vz-btn" id="vzActFull" title="Pantalla completa"><i class="fa fa-arrows-alt"></i></button>
                <button type="button" class="vz-btn" id="vzTogglePanel" title="Mostrar/ocultar panel"><i class="fa fa-columns"></i></button>
                <button type="button" class="vz-btn vz-btn-close" onclick="if(window.parent&amp;&amp;window.parent!==window&amp;&amp;window.parent.vzCerrarVisor){window.parent.vzCerrarVisor();}else{window.close();}" title="Cerrar"><i class="fa fa-times"></i></button>
            </div>
        </div>

        @* ── Cuerpo: miniaturas | visor | panel ── *@
        <div class="vz-main">
            <div class="vz-thumbs" id="vzThumbs">
                <div class="vz-thumbs-h">PÁGINAS</div>
                <div id="vzThumbsList"></div>
            </div>

            <div class="vz-viewer">
                <div class="vz-toolbar">
                    <button type="button" class="vz-tb" id="vzThumbsToggle" title="Miniaturas"><i class="fa fa-th-large"></i></button>
                    <span class="vz-tb-sep"></span>
                    <button type="button" class="vz-tb" id="vzPrev" title="Anterior"><i class="fa fa-chevron-left"></i></button>
                    <input type="text" id="vzPageNum" class="vz-page" value="1" /> <span class="vz-page-of">/ <span id="vzPageCount">?</span></span>
                    <button type="button" class="vz-tb" id="vzNext" title="Siguiente"><i class="fa fa-chevron-right"></i></button>
                    <span class="vz-tb-sep"></span>
                    <button type="button" class="vz-tb" id="vzZoomOut" title="Alejar"><i class="fa fa-minus"></i></button>
                    <select id="vzZoomSel" class="vz-zoom">
                        <option value="0.5">50%</option>
                        <option value="0.75">75%</option>
                        <option value="1" selected>100%</option>
                        <option value="1.25">125%</option>
                        <option value="1.5">150%</option>
                        <option value="2">200%</option>
                        <option value="fit">Ajustar</option>
                    </select>
                    <button type="button" class="vz-tb" id="vzZoomIn" title="Acercar"><i class="fa fa-plus"></i></button>
                    <span class="vz-tb-sep"></span>
                    <button type="button" class="vz-tb" id="vzRotate" title="Rotar"><i class="fa fa-repeat"></i></button>
                    <span class="vz-tb-sep"></span>
                    <button type="button" class="vz-tb" id="vzViewMode" title="Alternar vista scroll / página"><i class="fa fa-arrows-v"></i></button>
                </div>
                <div class="vz-canvas-wrap" id="vzCanvasWrap">
                    <div class="vz-loading" id="vzLoading"><i class="fa fa-spinner fa-spin"></i>&nbsp; Cargando documento…</div>
                </div>
            </div>

            <div class="vz-panel" id="vzPanel">
                <div class="vz-tabs">
                    <button type="button" class="vz-tab active" data-tab="meta">Metadatos</button>
                    <button type="button" class="vz-tab" data-tab="anot">Anotaciones</button>
                    <button type="button" class="vz-tab" data-tab="traz">Trazabilidad</button>
                    <button type="button" class="vz-tab" data-tab="vers">Versiones</button>
                </div>
                <div class="vz-tab-body">
                    <div class="vz-pane active" data-pane="meta">
                        @if (_d.TipologiaNombre is not null)
                        {
                            <div class="vz-meta-tools">
                                <button type="button" class="vz-mini-btn" id="vzBtnIndexar"><i class="fa fa-pencil"></i>&nbsp; Editar metadatos</button>
                            </div>
                        }
                        <div id="vzMetaRead">
                            @MetaRow("Nombre", _d.Nombre)
                            @MetaBadge("Estado", _d.Estado.ToString())
                            @MetaBadge("Firma", FirmaTexto(_d.EstadoFirma))
                            @MetaRow("Tipo documental", _d.TipologiaNombre ?? "—")
                            @MetaRow("Clasificación", _d.NivelNombre ?? "—")
                            @MetaRow("Soporte", _d.Soporte.ToString())
                            @MetaRow("Expediente", _d.ExpedienteCodigo is null ? "—" : $"{_d.ExpedienteCodigo} {_d.ExpedienteNombre}")
                            @MetaRow("Fecha documento", _d.FechaDocumento?.ToString("yyyy-MM-dd") ?? "—")
                            @MetaRow("Páginas / Folios", (_d.Folios ?? 1).ToString())
                            @MetaRow("Tamaño", TamTexto(_d.TamanoBytes))
                            @MetaHash("Hash SHA-256", _d.HashSha256)
                            @if (_d.Metadatos.Count > 0)
                            {
                                <div class="vz-meta-sec">Metadatos del tipo documental</div>
                                @foreach (var m in _d.Metadatos)
                                {
                                    @MetaRow(m.Nombre, string.IsNullOrWhiteSpace(m.Valor) ? "— sin indexar —" : m.Valor!)
                                }
                            }
                        </div>
                        <div id="vzMetaForm" style="display:none;"></div>
                    </div>
                    <div class="vz-pane" data-pane="anot">
                        <div id="vzAnotList"></div>
                        <div class="vz-soon" style="padding:16px">Las anotaciones se habilitan en un avance posterior.</div>
                    </div>
                    <div class="vz-pane" data-pane="traz">
                        <div id="vzTrazList"></div>
                    </div>
                    <div class="vz-pane" data-pane="vers">
                        <div id="vzVersList"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_esPdf)
    {
        <script src="/visor/pdf.js"></script>
    }
    <script src="/visor/exp_visor.js"></script>
}

@code {
    [SupplyParameterFromQuery] public long Doc { get; set; }

    private DocumentoDetalleDto? _d;
    private string? _error;
    private string _formato = "";
    private bool _esPdf;
    private long _tenant;

    private long Actor => Tenant.UserId ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _tenant = Tenant.TenantId ?? 0;
        if (Doc <= 0) { _error = "Parámetros incompletos para abrir el visor."; return; }
        var res = await DocSvc.GetDetalleAsync(Doc, Actor);
        if (!res.IsOk || res.Value is null) { _error = res.Error ?? "El documento no existe o no es accesible."; return; }
        _d = res.Value;
        _formato = (_d.Formato ?? "").Trim().ToLowerInvariant();
        _esPdf = _formato == "pdf";
    }

    private static string FirmaTexto(EstadoFirmaDocumento f) => f switch
    {
        EstadoFirmaDocumento.Firmado => "Firmado",
        EstadoFirmaDocumento.Pendiente => "Pendiente",
        _ => "Sin firma"
    };

    private static string TamTexto(long? bytes)
        => bytes is not long b || b <= 0 ? "—" : b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0} KB" : $"{b / 1048576.0:0.0} MB";

    private static RenderFragment MetaRow(string etiqueta, string valor) => __builder =>
    {
        <div class="vz-meta-row"><span class="vz-meta-l">@etiqueta</span><span class="vz-meta-v">@valor</span></div>
    };

    private static RenderFragment MetaBadge(string etiqueta, string valor) => __builder =>
    {
        <div class="vz-meta-row"><span class="vz-meta-l">@etiqueta</span><span class="vz-meta-v"><span class="vz-badge">@valor</span></span></div>
    };

    private static RenderFragment MetaHash(string etiqueta, string? hash) => __builder =>
    {
        <div class="vz-meta-row"><span class="vz-meta-l">@etiqueta</span><span class="vz-meta-v">
            @if (string.IsNullOrEmpty(hash)) { <em style="color:#94A3B8;">Se genera al archivar</em> }
            else { <code style="font-size:11px;">@(hash.Substring(0, Math.Min(24, hash.Length)))…</code> }
        </span></div>
    };
}

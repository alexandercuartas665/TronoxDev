    private RenderFragment EstadoMigBadge(string estado) => builder =>
    {
        var (cls, txt) = estado.ToLowerInvariant() switch
        {
            "procesando" or "proceso" => ("bdg bdg-proc", "Procesando"),
            "terminado" or "ok" or "completado" => ("bdg bdg-ok", "Terminado"),
            "error" => ("bdg bdg-err", "Error"),
            _ => ("bdg bdg-canal", estado)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", cls);
        builder.AddContent(2, txt);
        builder.CloseElement();
    };

        {
            var res = await TipoSvc.DeleteAsync(t.Id, Actor);
            if (!res.IsOk) { _pageError = res.Error; return; }
            _pageOk = "Tipo eliminado.";
            _tipos = await TipoSvc.ListAsync(includeInactive: true);
        }
        finally { _busy = false; }
    }

    // ================= BUZONES =================
    private void OpenBuzon(BuzonCorreoDto? b)
    {
        _modalError = null; _pageOk = null; _pageError = null;
        _buzonEditId = b?.Id;
        _buzonTieneClave = b?.TieneClave ?? false;
        _bNombre = b?.NombreBuzon ?? "";
        _bEmail = b?.DireccionEmail ?? "";
        _bProtocolo = b?.Protocolo ?? BuzonProtocolo.Imap;
        _bServidor = b?.Servidor;
        _bPuerto = b?.Puerto;
        _bSeguridad = b?.Seguridad ?? BuzonSeguridad.SslTls;
        _bUsuario = b?.Usuario ?? "";
        _bContrasena = null;
        _bCarpeta = string.IsNullOrWhiteSpace(b?.Carpeta) ? "INBOX" : b!.Carpeta;
        _bFrecuencia = b?.FrecuenciaRevision ?? BuzonFrecuenciaRevision.Diez;
        _bModo = b?.ModoRadicacion ?? BuzonModoRadicacion.SemiAutomatico;
        _bTiempoEspera = b?.TiempoEsperaMinutos;
        _bTipoDefaultId = b?.TipoComunicacionDefaultId;
        _bDependenciaDefaultId = b?.DependenciaDefaultId;
        _bActivo = b?.Activo ?? true;
        _showBuzon = true;
    }

    private async Task SaveBuzonAsync()
    {
        if (!_canEdit) { return; }
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_bNombre)) { _modalError = "El nombre es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_bEmail)) { _modalError = "La direccion de correo es obligatoria."; return; }
        if (string.IsNullOrWhiteSpace(_bUsuario)) { _modalError = "El usuario es obligatorio."; return; }
        if (_bProtocolo == BuzonProtocolo.Imap && string.IsNullOrWhiteSpace(_bServidor)) { _modalError = "El servidor IMAP es obligatorio."; return; }
        _busy = true;
        try
        {
            var req = new SaveBuzonCorreoRequest(
                _bNombre.Trim(), _bEmail.Trim(), _bProtocolo,
                NullIfEmpty(_bServidor), _bPuerto, _bSeguridad, _bUsuario.Trim(),
                string.IsNullOrEmpty(_bContrasena) ? null : _bContrasena,
                string.IsNullOrWhiteSpace(_bCarpeta) ? "INBOX" : _bCarpeta.Trim(),
                _bFrecuencia, _bModo, _bTiempoEspera, _bTipoDefaultId, _bDependenciaDefaultId, _bActivo);
            var res = _buzonEditId is null
                ? await BuzonSvc.CreateAsync(req, Actor)
                : await BuzonSvc.UpdateAsync(_buzonEditId.Value, req, Actor);
            if (!res.IsOk) { _modalError = res.Error; return; }
            _showBuzon = false;
            _pageOk = _buzonEditId is null ? "Buzon creado." : "Buzon actualizado.";
            _buzones = await BuzonSvc.ListAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteBuzonAsync(BuzonCorreoDto b)
    {
        if (!_canEdit) { return; }
        _busy = true; _pageOk = null; _pageError = null;
        try
        {
            var res = await BuzonSvc.DeleteAsync(b.Id, Actor);
            if (!res.IsOk) { _pageError = res.Error; return; }
            _pageOk = "Buzon eliminado.";
            _buzones = await BuzonSvc.ListAsync();
        }
        finally { _busy = false; }
    }


@page "/modulo/config-radicacion"
@attribute [Authorize(Policy = "Perm:modulo/config-radicacion:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Radicacion
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IRadicacionConfigService ConfigSvc
@inject ITipoComunicacionService TipoSvc
@inject IBuzonCorreoService BuzonSvc
@inject IConfiguracionPqrService PqrSvc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS

@* RQ09 - RF01 (Configuracion del modulo de Radicacion). Pantalla CALCADA 1:1 del legacy
   rad_config.aspx: nav lateral vertical + 7 secciones (Consecutivos, Prioridades, Tipos de
   Comunicacion, Buzones, Portal Web, Notificaciones, Migracion). Reusa los servicios ya existentes
   (RadicacionConfig/Tipo/Buzon) mas IConfiguracionPqrService para Prioridades y Portal Web.
   Escrituras gateadas por permiso Editar (fail-closed, invariante 10). *@

<PageTitle>Configuracion Radicacion - TRONOX SGDEA</PageTitle>

<div class="radc">
    <div class="rad-header">
        <h1 class="rad-title">Configuracion Radicacion</h1>
        <div class="rad-subtitle">RQ09 &mdash; Recepcion, Radicacion y Distribucion &middot; Parametros del modulo</div>
    </div>

    @if (_pageError is not null)
    {
        <div class="cfg-warn" style="background:#FEE2E2;border-color:#f06548;color:#991B1B;margin-bottom:14px">@_pageError</div>
    }
    @if (_pageOk is not null)
    {
        <div class="cfg-info" style="background:#D1FAE5;color:#0a7d6f">@_pageOk</div>
    }
    @if (!_canEdit)
    {
        <div class="cfg-info">Modo solo lectura: no tiene permiso para editar la configuracion de radicacion.</div>
    }

    <div class="cfg-layout">
        @* ===== Nav lateral de secciones ===== *@
        <div class="cfg-nav">
            <div class="cfg-nav-head">Configuracion</div>
            @foreach (var (key, label, ico) in Secciones)
            {
                <button type="button" class="cfg-nav-item @(_sec == key ? "active" : "")" @onclick="@(() => _sec = key)">
                    <span class="ico">@ico</span><span>@label</span>
                </button>
            }
        </div>

        @* ===== Cuerpo ===== *@
        <div class="cfg-body">
            @if (_loading)
            {
                <div class="cfg-card"><div class="cfg-card-body"><em>Cargando configuracion...</em></div></div>
            }
            else
            {
                @* ============ 1. CONSECUTIVOS ============ *@
                @if (_sec == "consecutivos")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head"><h3>Esquema de radicacion</h3></div>
                        <div class="cfg-card-body">
                            <div class="pv-box">
                                <div class="pv-t">Vista previa en vivo</div>
                                <div class="pv-items">
                                    <div><div class="pv-l">Entrada</div><div class="pv-n">@PreviewFor("E", _config?.ConsecutivoEntradaActual ?? 0, _cEntradaInicio)</div></div>
                                    <div><div class="pv-l">Salida</div><div class="pv-n">@PreviewFor("S", _config?.ConsecutivoSalidaActual ?? 0, _cSalidaInicio)</div></div>
                                    <div><div class="pv-l">Interno</div><div class="pv-n">@PreviewFor("I", _config?.ConsecutivoInternoActual ?? 0, _cInternoInicio)</div></div>
                                </div>
                            </div>

                            <div class="cfg-grid4">
                                <div class="cfg-field">
                                    <label>Prefijo / Sigla entidad <span class="req">*</span></label>
                                    <input class="cfg-input cfg-mono" style="text-transform:uppercase;font-weight:600" maxlength="8"
                                           @bind="_cSigla" @bind:event="oninput" placeholder="TRNX" disabled="@(!_canEdit)" />
                                    <span class="hint">Ej: TRNX</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Separador</label>
                                    <select class="cfg-select form-select form-select-sm" @bind="_cSeparador" disabled="@(!_canEdit)">
                                        <option value="-">Guion ( - )</option>
                                        <option value="/">Barra ( / )</option>
                                        <option value=".">Punto ( . )</option>
                                        <option value="">Sin separador</option>
                                    </select>
                                    <span class="hint">Ej: - o /</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Digitos del consecutivo <span class="req">*</span></label>
                                    <input class="cfg-input cfg-mono" type="number" min="1" max="12" @bind="_cDigitos" @bind:event="oninput" disabled="@(!_canEdit)" />
                                    <span class="hint">Ej: 6 &rarr; 000142</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Ano</label>
                                    <input class="cfg-input cfg-mono" maxlength="4" @bind="_cAnio" @bind:event="oninput" disabled="@(!_canEdit)" />
                                    <span class="hint">Componente de ano (actual)</span>
                                </div>
                            </div>

                            <div class="cfg-toggle-row" style="margin-top:12px">
                                <div><div class="tg-lbl">Incluir ano en el numero de radicado</div></div>
                                <label class="rad-sw"><input type="checkbox" @bind="_cIncluirAnio" disabled="@(!_canEdit)" /></label>
                            </div>

                            <div class="cfg-subhead">Consecutivos</div>
                            <div class="cfg-grid3">
                                <div class="cfg-field">
                                    <label>Consecutivo entrada actual</label>
                                    <input class="cfg-input cfg-mono" readonly value="@(_config?.ConsecutivoEntradaActual ?? 0)" />
                                    <span class="hint">Solo lectura &mdash; ultimo asignado</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Consecutivo salida actual</label>
                                    <input class="cfg-input cfg-mono" readonly value="@(_config?.ConsecutivoSalidaActual ?? 0)" />
                                    <span class="hint">Solo lectura</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Consecutivo interno actual</label>
                                    <input class="cfg-input cfg-mono" readonly value="@(_config?.ConsecutivoInternoActual ?? 0)" />
                                    <span class="hint">Solo lectura</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Inicio entrada</label>
                                    <input class="cfg-input cfg-mono" type="number" min="1" @bind="_cEntradaInicio" @bind:event="oninput" disabled="@(!_canEdit)" />
                                    <span class="hint">Aplica cuando el consecutivo esta en 0 (sin estrenar o tras el reinicio anual). Default: 1</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Inicio salida</label>
                                    <input class="cfg-input cfg-mono" type="number" min="1" @bind="_cSalidaInicio" @bind:event="oninput" disabled="@(!_canEdit)" />
                                    <span class="hint">Idem</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Inicio interno</label>
                                    <input class="cfg-input cfg-mono" type="number" min="1" @bind="_cInternoInicio" @bind:event="oninput" disabled="@(!_canEdit)" />
                                    <span class="hint">Idem</span>
                                </div>
                            </div>

                            <div class="cfg-toggle-row" style="margin-top:16px">
                                <div><div class="tg-lbl">Reinicio anual</div><div class="tg-hint">El 1 de enero reinicia los tres consecutivos. Default: activo</div></div>
                                <label class="rad-sw"><input type="checkbox" @bind="_cReinicioAnual" disabled="@(!_canEdit)" /></label>
                            </div>

                            <div class="cfg-warn">
                                &#9888; El consecutivo se genera con SELECT FOR UPDATE para evitar duplicados en concurrencia.
                                Los tres consecutivos son independientes. Un numero inhabilitado por anulacion nunca se reutiliza.
                            </div>

                            @if (_canEdit)
                            {
                                <div style="margin-top:18px;text-align:right">
                                    <button class="cfg-btn cfg-btn-lg" @onclick="SaveConsecutivosAsync" disabled="@_busy">
                                        <i class="bi bi-save"></i> Guardar consecutivos
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ============ 2. PRIORIDADES ============ *@
                else if (_sec == "prioridades")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Prioridades</h3>
                            @if (_canEdit)
                            {
                                <button class="cfg-btn" @onclick="NuevaPrioridadAsync" disabled="@_busy">+ Agregar prioridad</button>
                            }
                        </div>
                        <div class="cfg-card-body">
                            <p style="font-size:12.5px;color:#878a99;margin:0 0 14px">
                                Defina los niveles de prioridad con los que se marcan radicados y tramites. Cada uno se
                                identifica con un icono y un color que se muestran en bandejas y tableros.
                            </p>
                            <div style="overflow-x:auto">
                                <table class="cfg-table">
                                    <thead>
                                        <tr>
                                            <th>Vista previa</th><th>Nombre</th><th>Icono</th><th>Color</th>
                                            <th>SLA sugerido (dias)</th><th>Activo</th><th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in _prioridades)
                                        {
                                            <tr>
                                                <td>
                                                    <span style="padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:@((p.Color ?? "#405189") + "1a");color:@(p.Color ?? "#405189")">
                                                        @p.Icono @p.Nombre
                                                    </span>
                                                </td>
                                                <td><input class="cfg-input" style="min-width:150px" maxlength="50" @bind="p.Nombre" disabled="@(!_canEdit)" /></td>
                                                <td><input class="cfg-input" style="width:58px;text-align:center" maxlength="4" @bind="p.Icono" disabled="@(!_canEdit)" /></td>
                                                <td>
                                                    <span style="display:inline-block;width:18px;height:18px;border-radius:4px;border:1px solid #e2e8f0;vertical-align:middle;margin-right:6px;background:@(p.Color ?? "#405189")"></span>
                                                    <input class="cfg-input cfg-mono" style="width:96px" maxlength="9" @bind="p.Color" disabled="@(!_canEdit)" />
                                                </td>
                                                <td><input class="cfg-input" style="width:90px" type="number" placeholder="&mdash;" @bind="p.SlaSugerido" disabled="@(!_canEdit)" /></td>
                                                <td><label class="rad-sw"><input type="checkbox" @bind="p.Activo" disabled="@(!_canEdit)" /></label></td>
                                                <td>
                                                    @if (p.EsBase)
                                                    {
                                                        <span style="color:#adb1bd;font-size:11px" title="Prioridad base - no eliminable">&#128274;</span>
                                                    }
                                                    else if (_canEdit)
                                                    {
                                                        <button class="lnk-del" @onclick="@(() => InactivarPrioridadAsync(p.Id))" disabled="@_busy">&#128465;</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="cfg-warn" style="margin-top:12px">
                                Las prioridades base (Normal / Alta / Urgente) no se eliminan &mdash; solo se editan o inactivan.
                                Los cambios se reflejan de inmediato en el asistente de radicacion, la distribucion (RF07-2) y la Bandeja de Tramites.
                            </div>
                            @if (_canEdit)
                            {
                                <div style="margin-top:16px;text-align:right">
                                    <button class="cfg-btn cfg-btn-lg" @onclick="GuardarPrioridadesAsync" disabled="@_busy">
                                        <i class="bi bi-save"></i> Guardar prioridades
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ============ 3. TIPOS DE COMUNICACION ============ *@
                else if (_sec == "tipos")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Catalogo de tipos de comunicacion</h3>
                            @if (_canEdit)
                            {
                                <button class="cfg-btn" @onclick="@(() => OpenTipo(null))">+ Nuevo tipo</button>
                            }
                        </div>
                        <div class="cfg-card-body">
                            <div style="overflow-x:auto">
                                <table class="cfg-table">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th><th>Direccion</th><th>PQRSD</th><th>Dias</th><th>Tipo dia</th>
                                            <th>Prorrog.</th><th>Estado</th><th>Web</th><th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in _tipos)
                                        {
                                            <tr>
                                                <td class="strong">@t.Nombre</td>
                                                <td>@DireccionLabel(t.Direccion)</td>
                                                <td>@if (t.EsPqrsd) { <span class="bdg bdg-pqrsd">PQRSD</span> } else { <span style="color:#adb1bd">&mdash;</span> }</td>
                                                <td>@DiasLabel(t)</td>
                                                <td>@TipoDiaCol(t)</td>
                                                <td>@if (t.Prorrogable) { <text>Si</text> } else { <span style="color:#f06548">No</span> }</td>
                                                <td>@if (t.Activo) { <span class="bdg bdg-activo">Activo</span> } else { <span class="bdg bdg-inactivo">Inactivo</span> }</td>
                                                <td>@if (t.HabilitadoWeb) { <text>&#10003;</text> } else { <span style="color:#adb1bd">&mdash;</span> }</td>
                                                <td>
                                                    @if (_canEdit)
                                                    {
                                                        <button class="lnk-edit" @onclick="@(() => OpenTipo(t))" title="Editar">&#9998;</button>
                                                        @if (!t.EsBase)
                                                        {
                                                            <button class="lnk-del" style="margin-left:8px" @onclick="@(() => DeleteTipoAsync(t))" disabled="@_busy" title="Eliminar"><i class="bi bi-trash"></i></button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        @if (_tipos.Count == 0)
                                        {
                                            <tr><td colspan="9"><div class="cfg-note">No hay tipos de comunicacion.</div></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="cfg-note">
                                Tipos base no eliminables &mdash; solo editables o inactivables. Todos los tiempos son
                                configurables; los valores precargados son defaults normativos.
                            </div>
                        </div>
                    </div>
                }

                @* ============ 4. BUZONES ============ *@
                else if (_sec == "buzones")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Buzones de correo</h3>
                            @if (_canEdit)
                            {
                                <button class="cfg-btn" @onclick="@(() => OpenBuzon(null))">+ Nuevo buzon</button>
                            }
                        </div>
                        <div class="cfg-card-body">
                            @if (_buzones.Count == 0)
                            {
                                <div class="mig-drop" style="margin-bottom:0">
                                    <div class="mg-i">@("@")</div>
                                    <div class="mg-t">Sin buzones configurados</div>
                                    <div class="mg-s">Agregue un buzon para radicar comunicaciones recibidas por correo electronico.</div>
                                </div>
                            }
                            else
                            {
                                @foreach (var b in _buzones)
                                {
                                    <div class="bz-row">
                                        <div class="bz-ico">@("@")</div>
                                        <div style="flex:1;min-width:0">
                                            <div class="bz-nom">@b.NombreBuzon</div>
                                            <div class="bz-mail">@b.DireccionEmail</div>
                                        </div>
                                        <div class="bz-meta" style="width:90px">@ProtocoloLabel(b.Protocolo)</div>
                                        <span class="bdg bdg-canal">@ModoLabel(b.ModoRadicacion)</span>
                                        <div class="bz-meta" style="width:70px">@FrecuenciaMin(b.FrecuenciaRevision) min</div>
                                        @if (b.Activo) { <span class="bdg bdg-activo">Activo</span> } else { <span class="bdg bdg-inactivo">Inactivo</span> }
                                        @if (_canEdit)
                                        {
                                            <button class="lnk-edit" style="margin-left:8px" @onclick="@(() => OpenBuzon(b))" title="Editar">&#9998;</button>
                                            <button class="lnk-del" @onclick="@(() => DeleteBuzonAsync(b))" disabled="@_busy" title="Eliminar"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                @* ============ 5. PORTAL WEB ============ *@
                else if (_sec == "portalweb")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head"><h3>Portal Web embebible (iframe)</h3></div>
                        <div class="cfg-card-body">
                            <div class="cfg-info">
                                &#128279; Wizard para ciudadanos externos (captcha &rarr; identificacion &rarr; solicitud &rarr; adjuntos).
                                Las radicaciones llegan a la bandeja con canal <strong>Web</strong>.
                            </div>
                            <div class="cfg-grid2">
                                <div class="cfg-field"><label>Nombre de la entidad</label><input class="cfg-input" maxlength="100" @bind="_pc.NombreEntidad" disabled="@(!_canEdit)" /></div>
                                <div class="cfg-field"><label>Subtitulo</label><input class="cfg-input" maxlength="200" @bind="_pc.Subtitulo" disabled="@(!_canEdit)" /></div>
                                <div class="cfg-field"><label>NIT</label><input class="cfg-input" maxlength="30" @bind="_pc.Nit" disabled="@(!_canEdit)" /></div>
                                <div class="cfg-field"><label>Color institucional</label><input class="cfg-input" type="color" style="height:38px;padding:4px" @bind="_pc.Color" disabled="@(!_canEdit)" /></div>
                                <div class="cfg-field"><label>Tamano max. de adjunto (MB)</label><input class="cfg-input cfg-mono" type="number" @bind="_pc.MaxAdjuntoMb" disabled="@(!_canEdit)" /></div>
                                <div class="cfg-field"><label>Slug del portal (URL publica)</label><input class="cfg-input cfg-mono" maxlength="60" placeholder="ej. alcaldia-demo" @bind="_pc.Slug" disabled="@(!_canEdit)" /></div>
                            </div>
                            <div class="cfg-field" style="margin-top:16px">
                                <label>Banner / mensaje de bienvenida</label>
                                <textarea class="cfg-textarea" rows="2" @bind="_pc.Banner" disabled="@(!_canEdit)"></textarea>
                            </div>

                            <div class="cfg-subhead">Tipos habilitados en el portal</div>
                            <div class="cfg-grid2" style="gap:0 24px">
                                @foreach (var t in _tiposWeb)
                                {
                                    <div class="cfg-toggle-row">
                                        <div class="tg-lbl">@t.Nombre</div>
                                        <label class="rad-sw"><input type="checkbox" checked="@t.HabilitadoWeb" @onchange="@(e => ToggleTipoWebAsync(t.Id, (bool)e.Value!))" disabled="@(!_canEdit)" /></label>
                                    </div>
                                }
                            </div>

                            <div class="cfg-subhead">Opciones</div>
                            <div class="cfg-toggle-row">
                                <div><div class="tg-lbl">Permitir radicacion anonima</div><div class="tg-hint">Solo para tipos que permiten anonimo</div></div>
                                <label class="rad-sw"><input type="checkbox" @bind="_pc.PermitirAnonimo" disabled="@(!_canEdit)" /></label>
                            </div>
                            <div class="cfg-toggle-row">
                                <div><div class="tg-lbl">Exigir CAPTCHA (reCAPTCHA)</div><div class="tg-hint">Proteccion contra radicaciones automatizadas</div></div>
                                <label class="rad-sw"><input type="checkbox" @bind="_pc.ExigirCaptcha" disabled="@(!_canEdit)" /></label>
                            </div>

                            <div class="cfg-grid2" style="margin-top:16px">
                                <div class="cfg-field"><label>Canales de atencion</label><textarea class="cfg-textarea" rows="3" @bind="_pc.CanalesAtencion" disabled="@(!_canEdit)"></textarea><span class="hint">Se muestran en la pagina de inicio del portal</span></div>
                                <div class="cfg-field"><label>Aviso de privacidad (Ley 1581/2012)</label><textarea class="cfg-textarea" rows="3" @bind="_pc.AvisoPrivacidad" disabled="@(!_canEdit)"></textarea></div>
                            </div>
                            <div class="cfg-field" style="margin-top:16px">
                                <label>Preguntas frecuentes</label>
                                <textarea class="cfg-textarea cfg-mono" rows="4" style="font-size:12px" @bind="_pc.Faq" disabled="@(!_canEdit)"></textarea>
                                <span class="hint">Una por linea, con el formato: Pregunta|Respuesta</span>
                            </div>

                            @if (_canEdit)
                            {
                                <div style="margin-top:18px;text-align:right">
                                    <button class="cfg-btn cfg-btn-lg" @onclick="GuardarPortalAsync" disabled="@_busy"><i class="bi bi-save"></i> Guardar portal</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Codigo de insercion</h3>
                            <button class="cfg-btn" @onclick="CopiarEmbedAsync">&#128203; Copiar codigo</button>
                        </div>
                        <div class="cfg-card-body">
                            <p style="font-size:12.5px;color:#566980;margin:0 0 12px">
                                Copie este codigo y peguelo en el sitio web de la entidad para exponer el portal de radicacion:
                            </p>
                            <pre class="cfg-code">@EmbedSnippet</pre>
                            @if (!string.IsNullOrWhiteSpace(_pc.Slug))
                            {
                                <div class="cfg-note">Tambien puede abrir el portal directamente: <a href="@PortalUrl" target="_blank">abrir portal ciudadano</a></div>
                            }
                        </div>
                    </div>
                }

                @* ============ 6. NOTIFICACIONES ============ *@
                else if (_sec == "notificaciones")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head"><h3>Parametros de alertas SLA</h3></div>
                        <div class="cfg-card-body">
                            <div class="cfg-grid2" style="gap:20px">
                                <div class="cfg-field">
                                    <label>Primera alerta (% del termino consumido)</label>
                                    <div style="display:flex;align-items:center;gap:12px">
                                        <input type="range" class="sla-range" min="10" max="90" style="accent-color:#405189" @bind="_a1" @bind:event="oninput" disabled="@(!_canEdit)" />
                                        <span class="sla-val" style="color:#405189">@_a1%</span>
                                    </div>
                                    <span class="hint">Primera alerta al consumir el X% del termino. Default: 50</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Segunda alerta (zona critica)</label>
                                    <div style="display:flex;align-items:center;gap:12px">
                                        <input type="range" class="sla-range" min="10" max="99" style="accent-color:#f59e0b" @bind="_a2" @bind:event="oninput" disabled="@(!_canEdit)" />
                                        <span class="sla-val" style="color:#d97706">@_a2%</span>
                                    </div>
                                    <span class="hint">Segunda alerta &mdash; zona critica. Default: 80</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Alerta especial tutela (horas)</label>
                                    <input class="cfg-input cfg-mono" type="number" min="0" @bind="_aTutela" disabled="@(!_canEdit)" />
                                    <span class="hint">Alerta especial para tutelas en horas. Default: 24</span>
                                </div>
                            </div>

                            <div style="margin-top:18px;padding-top:14px;border-top:1px solid #f0f0f3">
                                <div class="cfg-toggle-row">
                                    <div class="tg-lbl">Notificar al responsable al vencer</div>
                                    <label class="rad-sw"><input type="checkbox" @bind="_notifJefe" disabled="@(!_canEdit)" /></label>
                                </div>
                                <div class="cfg-toggle-row">
                                    <div class="tg-lbl">Notificar a la direccion al vencer</div>
                                    <label class="rad-sw"><input type="checkbox" @bind="_notifDir" disabled="@(!_canEdit)" /></label>
                                </div>
                            </div>

                            <div style="margin-top:18px">
                                <label class="cfg-field" style="font-size:11px;font-weight:600;color:#878a99;text-transform:uppercase">Vista previa del termino</label>
                                <div class="sla-bar" style="margin-top:6px">
                                    <div class="sla-mark" style="left:@(_a1)%;background:#405189"></div>
                                    <div class="sla-mark" style="left:@(_a2)%;background:#f59e0b"></div>
                                    <div class="sla-mark" style="right:0;background:#f06548"></div>
                                </div>
                                <div style="display:flex;justify-content:space-between;font-size:10px;color:#adb1bd;margin-top:4px">
                                    <span>Radicacion</span><span>Vencimiento</span>
                                </div>
                            </div>

                            @if (_canEdit)
                            {
                                <div style="margin-top:18px;text-align:right">
                                    <button class="cfg-btn cfg-btn-lg" @onclick="SaveSlaAsync" disabled="@_busy"><i class="bi bi-save"></i> Guardar alertas SLA</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="cfg-card">
                        <div class="cfg-card-head"><h3>Configuracion de notificaciones</h3></div>
                        <div class="cfg-card-body">
                            <div style="overflow-x:auto">
                                <table class="cfg-table">
                                    <thead>
                                        <tr><th>Evento</th><th>Canal</th><th>Destinatarios</th><th>Activa</th><th>Obligatoria</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var n in _notifs)
                                        {
                                            <tr>
                                                <td class="strong">@n.EventoNombre</td>
                                                <td><span class="bdg bdg-canal">Email + Interno</span></td>
                                                <td style="font-size:12px">Configurable</td>
                                                <td>
                                                    <label class="rad-sw"><input type="checkbox" checked="@n.Activo"
                                                        disabled="@(!_canEdit || n.ObligatorioPorLey)"
                                                        @onchange="@(e => ToggleNotifActivo(n, (bool)e.Value!))" /></label>
                                                </td>
                                                <td>
                                                    @if (n.ObligatorioPorLey) { <span class="bdg bdg-oblig">Obligatoria</span> } else { <span style="color:#adb1bd">&mdash;</span> }
                                                </td>
                                                <td>@if (_canEdit) { <button class="lnk-edit" @onclick="@(() => OpenNotif(n))">&#9998; Editar plantilla</button> }</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="plt-preview" style="margin-top:14px">
                                <div class="pp-t">Variables disponibles en plantillas</div>
                                <div>
                                    @foreach (var v in Variables)
                                    {
                                        <span class="var-chip">@v</span>
                                    }
                                </div>
                            </div>
                            <div class="cfg-note">
                                Todos los destinatarios son configurables &mdash; usuarios especificos o roles definidos en RQ01.
                                No hay cargos fijos. Las notificaciones obligatorias por ley no pueden desactivarse.
                            </div>
                        </div>
                    </div>
                }

                @* ============ 7. MIGRACION ============ *@
                else if (_sec == "migracion")
                {
                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Migracion de radicados historicos</h3>
                            <button class="cfg-btn cfg-btn-soft" @onclick="@(() => _pageOk = "Descarga de plantilla: disponible proximamente.")">
                                <i class="bi bi-download"></i> Descargar plantilla Excel
                            </button>
                        </div>
                        <div class="cfg-card-body">
                            <div class="mig-drop">
                                <div class="mg-i">&#128193;</div>
                                <div class="mg-t">Cargar archivo Excel de radicados historicos</div>
                                <div class="mg-s">Proceso asincrono &middot; notificacion al terminar con reporte de exitosos y errores</div>
                                <button class="cfg-btn cfg-btn-lg" disabled>Seleccionar archivo</button>
                            </div>
                            <div class="cfg-grid2">
                                <div class="cfg-field">
                                    <label>Estado al importar</label>
                                    <select class="cfg-select form-select form-select-sm" @bind="_migEstado">
                                        <option value="Respondido">Respondido</option>
                                        <option value="Archivado">Archivado</option>
                                    </select>
                                    <span class="hint">Nunca estados activos</span>
                                </div>
                                <div class="cfg-field">
                                    <label>Crear terceros inexistentes</label>
                                    <select class="cfg-select form-select form-select-sm" @bind="_migCrearTerceros">
                                        <option value="true">Si, crear automaticamente</option>
                                        <option value="false">No, reportar como error</option>
                                    </select>
                                    <span class="hint">Si el remitente no existe en RQ07</span>
                                </div>
                            </div>
                            <div style="margin-top:14px;text-align:right">
                                <button class="cfg-btn cfg-btn-lg" disabled><i class="bi bi-upload"></i> Iniciar migracion</button>
                            </div>
                            <div class="cfg-note">
                                Validaciones: numeros no duplicados, fechas validas, tipos existentes en el catalogo.
                                El consecutivo se ajusta al valor mas alto migrado + 1. Adjuntos: opcional en primera fase.
                            </div>
                        </div>
                    </div>

                    <div class="cfg-card">
                        <div class="cfg-card-head">
                            <h3>Registro de migraciones</h3>
                            <button class="cfg-btn cfg-btn-soft" @onclick="RecargarMigracionesAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
                        </div>
                        <div class="cfg-card-body">
                            @if (_migraciones.Count == 0)
                            {
                                <div class="cfg-note" style="text-align:center">Aun no se han ejecutado migraciones.</div>
                            }
                            else
                            {
                                <div style="overflow-x:auto">
                                    <table class="cfg-table">
                                        <thead>
                                            <tr><th>Fecha</th><th>Archivo fuente</th><th>Cantidad</th><th>Exitosos</th><th>Errores</th><th>Estado</th><th></th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in _migraciones)
                                            {
                                                <tr>
                                                    <td>@m.FechaMigracion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td class="strong">@(m.ArchivoNombre ?? "-")</td>
                                                    <td>@m.CantidadTotal</td>
                                                    <td style="color:#0a7d6f;font-weight:600">@m.CantidadExitosos</td>
                                                    <td style="color:#B91C1C;font-weight:600">@m.CantidadErrores</td>
                                                    <td>@EstadoMigBadge(m.Estado)</td>
                                                    <td><button class="lnk-edit" @onclick="@(() => OpenReporte(m))">Ver reporte</button></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ===================== MODAL: TIPO DE COMUNICACION ===================== *@
    @if (_showTipo)
    {
        <div class="cfg-modal-back" @onclick="@(() => _showTipo = false)">
            <div class="cfg-modal w720" @onclick:stopPropagation="true">
                <div class="cfg-modal-head">
                    <h3>@(_tipoEditId is null ? "Nuevo tipo de comunicacion" : $"Editar tipo: {_tCodigo}")</h3>
                    <button class="cfg-modal-x" @onclick="@(() => _showTipo = false)">&times;</button>
                </div>
                <div class="cfg-modal-body">
                    <div class="cfg-grid3">
                        <div class="cfg-field">
                            <label>Codigo <span class="req">*</span></label>
                            <input class="cfg-input cfg-mono" style="text-transform:uppercase" maxlength="50" @bind="_tCodigo" placeholder="SIN_ESPACIOS" readonly="@(_tipoEditId is not null)" />
                            <span class="hint">Identificador unico, texto sin espacios</span>
                        </div>
                        <div class="cfg-field" style="grid-column:span 2">
                            <label>Nombre <span class="req">*</span></label>
                            <input class="cfg-input" maxlength="100" @bind="_tNombre" placeholder="Nombre visible al usuario y al ciudadano" />
                        </div>
                        <div class="cfg-field">
                            <label>Direccion <span class="req">*</span></label>
                            <select class="cfg-select form-select form-select-sm" @bind="_tDireccion">
                                @foreach (var v in Enum.GetValues<RadicacionDireccion>()) { <option value="@v">@DireccionLabel(v)</option> }
                            </select>
                        </div>
                        <div class="cfg-field">
                            <label>Dias respuesta</label>
                            <input class="cfg-input cfg-mono" type="number" min="0" @bind="_tDiasRespuesta" disabled="@(!_tRequiereRespuesta)" />
                            <span class="hint">Si requiere respuesta</span>
                        </div>
                        <div class="cfg-field">
                            <label>Tipo de dia</label>
                            <select class="cfg-select form-select form-select-sm" @bind="_tTipoDia">
                                @foreach (var v in Enum.GetValues<RadicacionTipoDia>()) { <option value="@v">@TipoDiaLabel(v)</option> }
                            </select>
                        </div>
                        <div class="cfg-field">
                            <label>Inicio termino</label>
                            <select class="cfg-select form-select form-select-sm" @bind="_tInicioTermino">
                                @foreach (var v in Enum.GetValues<RadicacionInicioTermino>()) { <option value="@v">@InicioTerminoLabel(v)</option> }
                            </select>
                        </div>
                        <div class="cfg-field">
                            <label>Dias prorroga</label>
                            <input class="cfg-input cfg-mono" type="number" min="0" @bind="_tDiasProrroga" disabled="@(!_tProrrogable)" />
                            <span class="hint">Maximo igual al termino inicial</span>
                        </div>
                        <div class="cfg-field">
                            <label>Nivel reserva default (id)</label>
                            <input class="cfg-input cfg-mono" type="number" @bind="_tNivelReservaId" placeholder="Id del nivel" />
                        </div>
                        <div class="cfg-field">
                            <label>Color etiqueta</label>
                            <input class="cfg-input" type="color" style="height:38px;padding:4px" value="@(_tColor ?? "#3B82F6")" @onchange="@(e => _tColor = e.Value?.ToString())" />
                            <span class="hint">Etiqueta en bandejas</span>
                        </div>
                        <div class="cfg-field">
                            <label>Orden portal</label>
                            <input class="cfg-input cfg-mono" type="number" @bind="_tOrdenPortal" />
                            <span class="hint">Orden en el portal ciudadano</span>
                        </div>
                        <div class="cfg-field" style="grid-column:span 2">
                            <label>Palabras clave</label>
                            <input class="cfg-input" maxlength="500" @bind="_tPalabrasClave" placeholder="separadas,por,comas" />
                            <span class="hint">Para deteccion automatica en correos</span>
                        </div>
                    </div>

                    <div class="cfg-subhead">Propiedades del tipo</div>
                    <div class="cfg-grid2" style="gap:0 24px">
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Es PQRSD</div><div class="tg-hint">Activa reglas CPACA y reportes</div></div><label class="rad-sw"><input type="checkbox" @bind="_tEsPqrsd" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Es Tutela</div><div class="tg-hint">Bloquea prorroga y usa termino en calendario</div></div><label class="rad-sw"><input type="checkbox" checked="@_tEsTutela" @onchange="OnTutelaChanged" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Es Recurso</div><div class="tg-hint">Habilita campo de acto administrativo</div></div><label class="rad-sw"><input type="checkbox" @bind="_tEsRecurso" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Requiere respuesta</div><div class="tg-hint">Activa el control de terminos SLA</div></div><label class="rad-sw"><input type="checkbox" @bind="_tRequiereRespuesta" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Prorrogable</div><div class="tg-hint">Bloqueado si es tutela</div></div><label class="rad-sw"><input type="checkbox" @bind="_tProrrogable" disabled="@_tEsTutela" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Permite anonimo</div><div class="tg-hint">Si no, remitente obligatorio</div></div><label class="rad-sw"><input type="checkbox" @bind="_tPermiteAnonimo" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Habilitado en portal web</div><div class="tg-hint">Aparece en el portal ciudadano</div></div><label class="rad-sw"><input type="checkbox" @bind="_tHabilitadoWeb" /></label></div>
                        <div class="cfg-toggle-row"><div><div class="tg-lbl">Activo</div><div class="tg-hint">Inactivo oculta el tipo en todos los formularios</div></div><label class="rad-sw"><input type="checkbox" @bind="_tActivo" /></label></div>
                    </div>

                    <div class="cfg-field" style="margin-top:16px">
                        <label>Descripcion para el ciudadano (portal)</label>
                        <textarea class="cfg-textarea" rows="2" @bind="_tDescripcionCiudadano" placeholder="Texto explicativo en lenguaje ciudadano..."></textarea>
                    </div>

                    @if (_modalError is not null) { <div class="cfg-warn" style="background:#FEE2E2;border-color:#f06548;color:#991B1B">@_modalError</div> }
                </div>
                <div class="cfg-modal-foot">
                    <button class="cfg-btn cfg-btn-soft" @onclick="@(() => _showTipo = false)" disabled="@_busy">Cancelar</button>
                    <button class="cfg-btn" @onclick="SaveTipoAsync" disabled="@_busy">Guardar tipo</button>
                </div>
            </div>
        </div>
    }

    @* ===================== MODAL: BUZON ===================== *@
    @if (_showBuzon)
    {
        <div class="cfg-modal-back" @onclick="@(() => _showBuzon = false)">
            <div class="cfg-modal w720" @onclick:stopPropagation="true">
                <div class="cfg-modal-head">
                    <h3>@(_buzonEditId is null ? "Nuevo buzon de correo" : $"Editar buzon: {_bNombre}")</h3>
                    <button class="cfg-modal-x" @onclick="@(() => _showBuzon = false)">&times;</button>
                </div>
                <div class="cfg-modal-body">
                    <div class="cfg-grid2">
                        <div class="cfg-field"><label>Nombre del buzon <span class="req">*</span></label><input class="cfg-input" maxlength="100" @bind="_bNombre" /></div>
                        <div class="cfg-field"><label>Direccion de correo <span class="req">*</span></label><input class="cfg-input cfg-mono" type="email" maxlength="200" @bind="_bEmail" placeholder="buzon@entidad.gov.co" /></div>
                        <div class="cfg-field">
                            <label>Protocolo <span class="req">*</span></label>
                            <select class="cfg-select form-select form-select-sm" @bind="_bProtocolo">
                                @foreach (var v in Enum.GetValues<BuzonProtocolo>()) { <option value="@v">@ProtocoloLabel(v)</option> }
                            </select>
                        </div>
                        <div class="cfg-field">
                            <label>Seguridad <span class="req">*</span></label>
                            <select class="cfg-select form-select form-select-sm" @bind="_bSeguridad">
                                @foreach (var v in Enum.GetValues<BuzonSeguridad>()) { <option value="@v">@SeguridadLabel(v)</option> }
                            </select>
                        </div>
                        @if (_bProtocolo == BuzonProtocolo.Imap)
                        {
                            <div class="cfg-field"><label>Servidor</label><input class="cfg-input cfg-mono" maxlength="200" @bind="_bServidor" placeholder="imap.entidad.gov.co" /><span class="hint">Si IMAP</span></div>
                            <div class="cfg-field"><label>Puerto</label><input class="cfg-input cfg-mono" type="number" @bind="_bPuerto" placeholder="993" /><span class="hint">Ej: 993</span></div>
                        }
                        <div class="cfg-field"><label>Usuario <span class="req">*</span></label><input class="cfg-input cfg-mono" maxlength="200" @bind="_bUsuario" /></div>
                        <div class="cfg-field"><label>Contrasena <span class="req">*</span></label><input class="cfg-input" type="password" @bind="_bContrasena" placeholder="@(_buzonTieneClave ? "(sin cambiar)" : "")" /><span class="hint">Almacenada cifrada AES-256</span></div>
                        <div class="cfg-field"><label>Carpeta <span class="req">*</span></label><input class="cfg-input cfg-mono" maxlength="120" @bind="_bCarpeta" /><span class="hint">Default: INBOX</span></div>
                        <div class="cfg-field">
                            <label>Frecuencia de revision <span class="req">*</span></label>
                            <select class="cfg-select form-select form-select-sm" @bind="_bFrecuencia">
                                @foreach (var v in Enum.GetValues<BuzonFrecuenciaRevision>()) { <option value="@v">@FrecuenciaLabel(v)</option> }
                            </select>
                        </div>
                        <div class="cfg-field">
                            <label>Modo de radicacion <span class="req">*</span></label>
                            <select class="cfg-select form-select form-select-sm" @bind="_bModo">
                                @foreach (var v in Enum.GetValues<BuzonModoRadicacion>()) { <option value="@v">@ModoLabel(v)</option> }
                            </select>
                            <span class="hint">Semi: pre-radica y espera &middot; Auto: radica al instante &middot; Manual: requiere confirmacion</span>
                        </div>
                        @if (_bModo == BuzonModoRadicacion.SemiAutomatico)
                        {
                            <div class="cfg-field"><label>Tiempo de espera (minutos)</label><input class="cfg-input cfg-mono" type="number" min="0" @bind="_bTiempoEspera" /><span class="hint">Solo semi-automatico</span></div>
                        }
                        <div class="cfg-field"><label>Tipo comunicacion default (id)</label><input class="cfg-input cfg-mono" type="number" @bind="_bTipoDefaultId" /><span class="hint">Si el sistema no detecta el tipo</span></div>
                        <div class="cfg-field"><label>Dependencia default (id)</label><input class="cfg-input cfg-mono" type="number" @bind="_bDependenciaDefaultId" /><span class="hint">Dependencia destino si no se detecta</span></div>
                    </div>
                    <div class="cfg-toggle-row" style="margin-top:14px"><div class="tg-lbl">Activo</div><label class="rad-sw"><input type="checkbox" @bind="_bActivo" /></label></div>
                    @if (_modalError is not null) { <div class="cfg-warn" style="background:#FEE2E2;border-color:#f06548;color:#991B1B">@_modalError</div> }
                </div>
                <div class="cfg-modal-foot">
                    <button class="cfg-btn cfg-btn-soft" @onclick="@(() => _showBuzon = false)" disabled="@_busy">Cancelar</button>
                    <button class="cfg-btn" @onclick="SaveBuzonAsync" disabled="@_busy">Guardar buzon</button>
                </div>
            </div>
        </div>
    }

    @* ===================== MODAL: PLANTILLA NOTIFICACION ===================== *@
    @if (_showNotif && _notifEdit is not null)
    {
        <div class="cfg-modal-back" @onclick="@(() => _showNotif = false)">
            <div class="cfg-modal w760" @onclick:stopPropagation="true">
                <div class="cfg-modal-head">
                    <h3>Plantilla: @_notifEdit.EventoNombre</h3>
                    <button class="cfg-modal-x" @onclick="@(() => _showNotif = false)">&times;</button>
                </div>
                <div class="cfg-modal-body">
                    <div class="cfg-field"><label>Asunto <span class="req">*</span></label><input class="cfg-input" maxlength="300" @bind="_nAsunto" @bind:event="oninput" placeholder="Su radicado {{numero_radicado}} fue registrado" /></div>
                    <div class="cfg-field" style="margin-top:16px">
                        <label>Cuerpo del mensaje <span class="req">*</span></label>
                        <textarea class="cfg-textarea cfg-mono" rows="9" style="font-size:12.5px;line-height:1.6" @bind="_nCuerpo" @bind:event="oninput" placeholder="Estimado {{nombre_ciudadano}}, ..."></textarea>
                        <span class="hint">Use las variables para insertar datos del radicado</span>
                    </div>
                    <div style="margin-top:16px">
                        @foreach (var v in Variables)
                        {
                            <button class="var-btn" @onclick="@(() => InsertVar(v))">+ @v</button>
                        }
                    </div>
                    <div class="plt-preview" style="margin-top:16px">
                        <div class="pp-t">Vista previa</div>
                        <div class="pp-a">@RenderPreview(_nAsunto)</div>
                        <div class="pp-b">@RenderPreview(_nCuerpo)</div>
                    </div>
                    @if (_modalError is not null) { <div class="cfg-warn" style="background:#FEE2E2;border-color:#f06548;color:#991B1B">@_modalError</div> }
                </div>
                <div class="cfg-modal-foot">
                    <button class="cfg-btn cfg-btn-soft" @onclick="@(() => _showNotif = false)" disabled="@_busy">Cancelar</button>
                    <button class="cfg-btn" @onclick="SaveNotifAsync" disabled="@_busy">Guardar plantilla</button>
                </div>
            </div>
        </div>
    }

    @* ===================== MODAL: REPORTE MIGRACION ===================== *@
    @if (_showReporte && _reporte is not null)
    {
        <div class="cfg-modal-back" @onclick="@(() => _showReporte = false)">
            <div class="cfg-modal w720" @onclick:stopPropagation="true">
                <div class="cfg-modal-head">
                    <h3>Reporte de migracion</h3>
                    <button class="cfg-modal-x" @onclick="@(() => _showReporte = false)">&times;</button>
                </div>
                <div class="cfg-modal-body">
                    <div class="cfg-grid3">
                        <div class="cfg-field"><label>Archivo</label><div class="strong">@(_reporte.ArchivoNombre ?? "-")</div></div>
                        <div class="cfg-field"><label>Fecha</label><div>@_reporte.FechaMigracion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                        <div class="cfg-field"><label>Estado</label><div>@EstadoMigBadge(_reporte.Estado)</div></div>
                        <div class="cfg-field"><label>Cantidad</label><div class="cfg-mono">@_reporte.CantidadTotal</div></div>
                        <div class="cfg-field"><label>Exitosos</label><div class="cfg-mono" style="color:#0a7d6f;font-weight:600">@_reporte.CantidadExitosos</div></div>
                        <div class="cfg-field"><label>Errores</label><div class="cfg-mono" style="color:#B91C1C;font-weight:600">@_reporte.CantidadErrores</div></div>
                    </div>
                    <div class="cfg-note" style="margin-top:12px">Sin errores reportados.</div>
                </div>
                <div class="cfg-modal-foot">
                    <button class="cfg-btn cfg-btn-soft" @onclick="@(() => _showReporte = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* ===== Config Radicacion - calcado 1:1 de rad_config.aspx (scoped .radc) ===== */
    .radc { padding: 8px 0 40px; font-family: Poppins, sans-serif; color: #212529; }
    .radc .rad-header { margin-bottom: 18px; }
    .radc .rad-title { font-size: 20px; font-weight: 800; color: #0F172A; margin: 0; }
    .radc .rad-subtitle { font-size: 12.5px; color: #94A3B8; margin-top: 3px; }
    .radc .cfg-layout { display: flex; gap: 20px; align-items: flex-start; }

    .radc .cfg-nav { width: 230px; flex-shrink: 0; background: #fff; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.07); overflow: hidden; position: sticky; top: 16px; }
    .radc .cfg-nav-head { padding: 14px 18px; border-bottom: 1px solid #f0f0f3; font-size: 11px; font-weight: 700; color: #878a99; text-transform: uppercase; letter-spacing: .04em; }
    .radc .cfg-nav-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 18px; border: none; cursor: pointer; text-align: left; background: transparent; border-left: 3px solid transparent; color: #566980; font-size: 13px; font-weight: 400; text-decoration: none !important; }
    .radc .cfg-nav-item:hover { background: #f8f9fb; color: #405189; }

    private void InsertVar(string token) => _nCuerpo = (_nCuerpo ?? "") + token;

    private async Task SaveNotifAsync()
    {
        if (!_canEdit || _notifEdit is null) { return; }
        _busy = true; _modalError = null;
        try
        {
            var req = new SaveNotificacionRadicacionRequest(
                _notifEdit.Activo, _notifEdit.RolesIds, _notifEdit.UsuariosIds,
                NullIfEmpty(_nAsunto), NullIfEmpty(_nCuerpo));
            var res = await ConfigSvc.SaveNotificacionAsync(_notifEdit.Id, req, Actor);
            if (!res.IsOk) { _modalError = res.Error; return; }
            _showNotif = false;
            _pageOk = "Plantilla guardada.";
            _notifs = await ConfigSvc.ListNotificacionesAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleNotifActivo(NotificacionRadicacionDto n, bool activo)
    {
        if (!_canEdit || n.ObligatorioPorLey) { return; }
        _busy = true; _pageOk = null; _pageError = null;
        try
        {
            var req = new SaveNotificacionRadicacionRequest(
                activo, n.RolesIds, n.UsuariosIds, n.PlantillaAsunto, n.PlantillaCuerpo);
            var res = await ConfigSvc.SaveNotificacionAsync(n.Id, req, Actor);
            if (!res.IsOk) { _pageError = res.Error; return; }
            _pageOk = activo ? "Notificacion activada." : "Notificacion desactivada.";
            _notifs = await ConfigSvc.ListNotificacionesAsync();
        }
        finally { _busy = false; }
    }


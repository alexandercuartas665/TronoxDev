    // ---- Drag and drop ----
    private async Task DropOnAsync(long? containerId, Node? before)
    {
        if (_dragIsContainer) { _dragIsContainer = false; await AddContainerToAsync(containerId); return; }
        if (_dragCtrl is FormControlType ct && _dragNodeId is null) { _dragCtrl = null; await AddControlToAsync(ct, containerId); return; }
        if (_dragNodeId is not long dragId) { return; }
        _dragNodeId = null; _dragCtrl = null;
        if (dragId == containerId || before?.Id == dragId) { return; }
        _busy = true;
        try
        {
            if (_dragNodeIsQuestion)
            {
                var siblings = _def!.Questions.Where(q => q.ContainerId == containerId && q.Id != dragId).OrderBy(q => q.SortOrder).ToList();
                var index = before is { IsQuestion: true } ? Math.Max(siblings.FindIndex(q => q.Id == before.Id), 0) : siblings.Count;
                var result = await Svc.MoveQuestionToAsync(dragId, containerId, index);
                if (!result.IsOk) { _pageError = result.Error; }
            }
            else
            {
                var siblings = _def!.Containers.Where(c => c.ParentId == containerId && c.Id != dragId).OrderBy(c => c.SortOrder).ToList();
                var index = before is { IsQuestion: false } ? Math.Max(siblings.FindIndex(c => c.Id == before.Id), 0) : siblings.Count;
                var result = await Svc.MoveContainerToAsync(dragId, containerId, index);
                if (!result.IsOk) { _pageError = result.Error; }
            }
            await ReloadAsync();
        }
        finally { _busy = false; }
    }


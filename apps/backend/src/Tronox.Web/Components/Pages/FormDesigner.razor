    private async Task RenameAsync(Node node, string label)
    {
        label = label.Trim();
        if (label.Length == 0) { return; }
        if (node.IsQuestion) { await PatchQuestionAsync(node.Q!, r => r with { Label = label }); }
        else { await PatchContainerAsync(node.C!, r => r with { Name = label }); }
    }

    private async Task ChangeTypeAsync(FormQuestionDto q, string value)
    {
        var type = Enum.Parse<FormControlType>(value);
        await PatchQuestionAsync(q, r => r with
        {
            ControlType = type,
            OptionsJson = FormFieldValidator.ParseOptions(q.OptionsJson).Count > 0 ? q.OptionsJson : DefaultOptions(type)
        });
    }

    private static List<string> TabsOf(FormContainerDto c)
    {
        if (string.IsNullOrWhiteSpace(c.TabsJson)) { return new List<string> { "Pestana 1", "Pestana 2" }; }
        try { return JsonSerializer.Deserialize<List<string>>(c.TabsJson) ?? new List<string>(); }
        catch (JsonException) { return new List<string>(); }
    }

    private async Task PatchTabsAsync(FormContainerDto c, int index, string? value)
    {
        var tabs = TabsOf(c);
        if (index < 0) { tabs.Add(value ?? $"Pestana {tabs.Count + 1}"); }
        else if (value is null) { if (index < tabs.Count) { tabs.RemoveAt(index); } }
        else if (index < tabs.Count) { tabs[index] = value; }
        await PatchContainerAsync(c, r => r with { TabsJson = JsonSerializer.Serialize(tabs) });
    }

    private static List<string> OptionLabels(FormQuestionDto q)
        => FormFieldValidator.ParseOptions(q.OptionsJson).Select(o => o.Label).ToList();

    private async Task PatchOptionAsync(FormQuestionDto q, int index, string? value)
    {
        var options = FormFieldValidator.ParseOptions(q.OptionsJson).ToList();
        if (index < 0)
        {
            var n = options.Count + 1;
            options.Add(new FormOption($"opcion_{n}_{Guid.NewGuid().ToString("N")[..4]}", value ?? $"Opcion {n}"));
        }
        else if (value is null) { if (index < options.Count) { options.RemoveAt(index); } }
        else if (index < options.Count) { options[index] = options[index] with { Label = value }; }
        var json = JsonSerializer.Serialize(options, new JsonSerializerOptions(JsonSerializerDefaults.Web));
        await PatchQuestionAsync(q, r => r with { OptionsJson = json });
    }

    // ---- Permisos por campo (FieldVisibilityJson) ----
    private static Dictionary<string, List<string>> ParseFieldVis(string? json)
    {
        var map = new Dictionary<string, List<string>>(StringComparer.Ordinal) { ["hide"] = new(), ["readonly"] = new() };
        if (string.IsNullOrWhiteSpace(json)) { return map; }
        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var key in new[] { "hide", "readonly" })
            {
                if (doc.RootElement.TryGetProperty(key, out var arr) && arr.ValueKind == JsonValueKind.Array)
                {
                    map[key] = arr.EnumerateArray().Select(e => e.GetString() ?? "").Where(s => s.Length > 0).ToList();
                }
            }
        }
        catch (JsonException) { }
        return map;
    }

    private static bool FieldVisHas(FormQuestionDto q, string key, string role)
        => ParseFieldVis(q.FieldVisibilityJson)[key].Contains(role, StringComparer.OrdinalIgnoreCase);

    private Task ToggleFieldVisAsync(FormQuestionDto q, string key, string role, bool on)
    {
        var map = ParseFieldVis(q.FieldVisibilityJson);
        map[key].RemoveAll(r => string.Equals(r, role, StringComparison.OrdinalIgnoreCase));
        if (on) { map[key].Add(role); }
        var isEmpty = map["hide"].Count == 0 && map["readonly"].Count == 0;
        var json = isEmpty ? null : JsonSerializer.Serialize(map);
        return PatchQuestionAsync(q, r => r with { FieldVisibilityJson = json });
    }


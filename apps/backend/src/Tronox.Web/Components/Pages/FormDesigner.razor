@page "/modulo/formularios-disenador/{Id:long}"
@attribute [Authorize(Policy = "Perm:modulo/formularios-disenador:View")]
@* Constructor visual de formularios dinamicos (RQ08, port fiel de ECOREX / ADR-0015 en estilo TRONOX).
   3 columnas: paleta + arbol (izq), lienzo con presets de dispositivo (centro) y panel de propiedades
   con tabs Diseno / Datos / Reglas (der). PERSISTE-POR-CAMBIO: cada mutacion llama al servicio real y
   recarga (Guardar confirma/refresca). Estilo tx-* + Velzon; NADA de clases fb-*/ECOREX. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using System.Text.Json.Nodes
@using Tronox.Application.Forms
@using Tronox.Application.Forms.Calc
@using Tronox.Application.Forms.Lookups
@using Tronox.Application.MenuConfig
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IFormDefinitionService Svc
@inject IFormConditionService CondSvc
@inject IFormTokenService TokenSvc
@inject Tronox.Application.Forms.Lookups.IFormLookupService LookupSvc
@inject IMenuConfigService MenuSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Diseñador de formulario - TRONOX SGDEA</PageTitle>

@if (_loading)
{
    <div class="tx-ent-hint" style="padding:24px">Cargando constructor...</div>
}
else if (_def is null)
{
    <div style="padding:40px 24px;text-align:center">
        <h3 class="tx-ent-title">Formulario no encontrado</h3>
        <button class="tx-ent-btn" style="margin-top:14px" @onclick="@(() => Nav.NavigateTo("/modulo/formularios"))">Volver a formularios</button>
    </div>
}
else
{
<div class="tx-mod tx-dep tx-trdc fd-root">
    @* ===================== HEADER ===================== *@
    <div class="fd-header">
        <button class="fd-back" title="Volver" @onclick="@(() => Nav.NavigateTo("/modulo/formularios"))"><i class="bi bi-arrow-left"></i></button>
        <span class="fd-code mono">FORX-@_def.Code</span>
        @if (_editingTitle)
        {
            <input class="fd-title-input" value="@_titleDraft" @oninput="@(e => _titleDraft = e.Value?.ToString() ?? "")"
                   @onblur="SaveTitleAsync" @onkeydown="@(async e => { if (e.Key == "Enter") { await SaveTitleAsync(); } })" />
        }
        else
        {
            <div class="fd-title" title="Clic para renombrar" @onclick="@(() => { _titleDraft = _def.Title; _editingTitle = true; })">@_def.Title</div>
        }
        <span class="tx-ent-badge @StatusCss()">@StatusLabel()</span>
        <div class="fd-header-actions">
            <button class="tx-ent-btn sm" @onclick="OpenFormPropsAsync"><i class="bi bi-sliders"></i> Propiedades</button>
            <button class="tx-ent-btn sm" @onclick="@(() => { _previewValues.Clear(); _showPreview = true; })"><i class="bi bi-eye"></i> Vista previa</button>
            @if (_def.Status == FormStatus.Active)
            {
                <button class="tx-ent-btn sm" @onclick="DeactivateAsync" disabled="@_busy"><i class="bi bi-slash-circle"></i> Desactivar</button>
                <button class="tx-ent-btn sm" @onclick="OpenTokenModalAsync" disabled="@_busy"><i class="bi bi-link-45deg"></i> Publicar por URL</button>
            }
            else
            {
                <button class="tx-ent-btn sm" @onclick="ActivateAsync" disabled="@_busy"><i class="bi bi-check2-circle"></i> Activar</button>
            }
            <button class="tx-ent-btn sm primary" @onclick="SaveFlashAsync" disabled="@_busy">@(_savedFlash ? "Guardado" : "Guardar")</button>
            <button class="tx-ent-btn sm" @onclick="@(() => Nav.NavigateTo("/modulo/formularios"))">Cerrar</button>
        </div>
    </div>

    @if (_pageError is not null)
    {
        <div class="tx-ent-fielderr fd-error">
            <span>@_pageError</span>
            <button class="fd-error-x" @onclick="@(() => _pageError = null)">&times;</button>
        </div>
    }

    @* ===================== BODY 3 COLUMNAS ===================== *@
    <div class="fd-body">
        @* ---------- IZQUIERDA: paleta + arbol ---------- *@
        <aside class="fd-left">
            <div class="fd-left-scroll">
                <div class="fd-group">ELEMENTOS</div>
                <div class="fd-group-hint">Arrastra al lienzo o toca para agregar</div>
                @RenderPaletteCard("container", null, "Contenedor", "Filas, columnas o secciones", "bi-columns-gap", "#7c3aed", "#ede9fe")
                @RenderPaletteCard("control", FormControlType.Text, "Campo", "Texto, fecha, lista, numero...", "bi-input-cursor-text", "#2563eb", "#dbeafe")

                <div class="fd-group" style="margin-top:10px">CAMPOS</div>
                <div class="fd-palgrid">
                    @foreach (var t in _fieldPalette)
                    {
                        var reg = RegOf(t);
                        var ct = t;
                        <button class="fd-palchip" draggable="true"
                                @onclick="@(() => AddControlAsync(ct))"
                                @ondragstart="@(() => { _dragCtrl = ct; _dragIsContainer = false; _dragNodeId = null; })">
                            <span class="fd-palchip-ic" style="color:@reg.Color;background:@reg.Soft"><i class="bi @reg.Icon"></i></span>
                            <span class="fd-palchip-tx">@reg.Name</span>
                        </button>
                    }
                </div>

                <div class="fd-group" style="margin-top:10px">DOCUMENTO</div>
                <div class="fd-palgrid">
                    @foreach (var t in _docPalette)
                    {
                        var reg = RegOf(t);
                        var ct = t;
                        <button class="fd-palchip" draggable="true"
                                @onclick="@(() => AddControlAsync(ct))"
                                @ondragstart="@(() => { _dragCtrl = ct; _dragIsContainer = false; _dragNodeId = null; })">
                            <span class="fd-palchip-ic" style="color:@reg.Color;background:@reg.Soft"><i class="bi @reg.Icon"></i></span>
                            <span class="fd-palchip-tx">@reg.Name</span>
                        </button>
                    }
                </div>

                <div class="fd-group fd-structhead" style="margin-top:12px">ESTRUCTURA <span class="tx-ent-badge sm">@TotalNodes()</span></div>
                <div class="fd-tree">
                    <div class="fd-tree-root @(Sel is null ? "sel" : "")" @onclick="@(() => Select(null))">
                        <i class="bi bi-file-earmark-text"></i>
                        <span class="fd-tree-name">Formulario</span>
                        <span class="tx-ent-badge sm">@TotalNodes()</span>
                    </div>
                    @foreach (var row in TreeRows())
                    {
                        var node = row.Node;
                        <div class="fd-tree-row @(IsSelected(node) ? "sel" : "") @(node.Hidden ? "dim" : "")"
                             style="padding-left:@(8 + row.Depth * 15)px" @onclick="@(() => Select(node))">
                            @if (row.HasKids)
                            {
                                <span class="fd-tree-chev @(_collapsed.Contains(node.Id) ? "" : "open")"
                                      @onclick="@(() => ToggleCollapse(node.Id))" @onclick:stopPropagation="true"><i class="bi bi-chevron-right"></i></span>
                            }
                            else { <span class="fd-tree-spc"></span> }
                            <span class="fd-tree-ic" style="color:@node.Reg.Color"><i class="bi @node.Reg.Icon"></i></span>
                            <span class="fd-tree-name">@node.Label</span>
                            <span class="tx-ent-badge sm">@row.Badge</span>
                            <button class="fd-tree-tgl @(node.Locked ? "on" : "")" title="Fijo / bloqueado"
                                    @onclick="@(() => ToggleLockAsync(node))" @onclick:stopPropagation="true"><i class="bi @(node.Locked ? "bi-lock-fill" : "bi-unlock")"></i></button>
                            <button class="fd-tree-tgl @(node.Hidden ? "on" : "")" title="Visible / oculto"
                                    @onclick="@(() => ToggleHideAsync(node))" @onclick:stopPropagation="true"><i class="bi @(node.Hidden ? "bi-eye-slash" : "bi-eye")"></i></button>
                        </div>
                    }
                </div>
            </div>
        </aside>

        @* ---------- CENTRO: device bar + lienzo ---------- *@
        <div class="fd-center">
            <div class="fd-devicebar">
                <div class="fd-devicetabs">
                    <button class="fd-devicetab @(_device == "nav" ? "on" : "")" @onclick="@(() => _device = "nav")"><i class="bi bi-window"></i> Navegador</button>
                    <button class="fd-devicetab @(_device == "tab" ? "on" : "")" @onclick="@(() => _device = "tab")"><i class="bi bi-tablet"></i> Tableta</button>
                    <button class="fd-devicetab @(_device == "mov" ? "on" : "")" @onclick="@(() => _device = "mov")"><i class="bi bi-phone"></i> Movil</button>
                </div>
                <span class="fd-devicelabel">Lienzo @CanvasWidth()</span>
            </div>
            <div class="fd-canvas" @ondragover:preventDefault @ondrop="@(() => DropOnAsync(null, null))" @ondrop:preventDefault>
                <div class="fd-sheet" style="width:@CanvasWidth()">
                    <div class="fd-sheet-grid" @onclick="@(() => Select(null))">
                        @foreach (var node in NodesOf(null))
                        {
                            @RenderNode(node, true)
                        }
                        @if (NodesOf(null).Count == 0)
                        {
                            <div class="fd-empty-root">Lienzo vacio - arrastra o toca un elemento de la paleta</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ---------- DERECHA: propiedades ---------- *@
        <aside class="fd-right">
            <div class="fd-props-head">
                <span class="fd-props-ic" style="color:@(Sel?.Reg.Color ?? "#475569");background:@(Sel?.Reg.Soft ?? "#e2e8f0")"><i class="bi @(Sel?.Reg.Icon ?? "bi-file-earmark-text")"></i></span>
                <div>
                    <div class="fd-props-name">@(Sel?.Label ?? "Formulario")</div>
                    <div class="fd-props-tipo">@(Sel?.Reg.Tipo ?? "Definicion")</div>
                </div>
            </div>
            <div class="fd-props-tabs">
                <button class="fd-props-tab @(_propTab == "diseno" ? "on" : "")" @onclick="@(() => _propTab = "diseno")">Diseño</button>
                <button class="fd-props-tab @(_propTab == "datos" ? "on" : "")" @onclick="@(() => _propTab = "datos")">Datos</button>
                <button class="fd-props-tab @(_propTab == "reglas" ? "on" : "")" @onclick="@(() => _propTab = "reglas")">Reglas</button>
            </div>
            <div class="fd-props-body">
                @if (Sel is null)
                {
                    <div class="fd-hintbox">
                        <div class="fd-group">SUGERENCIA</div>
                        <p class="tx-ent-hint">Selecciona un contenedor o un campo en el lienzo o en el arbol para editar sus propiedades.</p>
                    </div>
                }
                else
                {
                    @if (_propTab == "diseno") { @RenderDisenoTab(Sel) }
                    else if (_propTab == "datos") { @RenderDatosTab(Sel) }
                    else { @RenderReglasTab(Sel) }
                    <button class="tx-ent-btn sm danger fd-delbtn" @onclick="@(() => DeleteNodeAsync(Sel))" disabled="@_busy"><i class="bi bi-trash"></i> Eliminar elemento</button>
                }
            </div>
        </aside>
    </div>
</div>
}

@* ===================== MODAL VISTA PREVIA ===================== *@
@if (_showPreview && _def is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showPreview = false)">
        <div class="modal-dialog" style="max-width:920px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Vista previa - @_def.Title</h3><button class="modal-close" @onclick="@(() => _showPreview = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                <DynamicFormRenderer Definition="_def" Values="_previewValues" ReadOnly="@(_def.Status != FormStatus.Active)" />
            </div>
        </div>
    </div>
}

@* ===================== MODAL PUBLICAR POR URL ===================== *@
@if (_showTokenModal && _def is not null)
{
    <div class="modal-overlay" @onclick="CloseTokenModal">
        <div class="modal-dialog" style="max-width:560px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Publicar por URL</h3><button class="modal-close" @onclick="CloseTokenModal">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                @if (_emittedUrl is null)
                {
                    <div class="tx-ent-field"><label>Referencia (opcional)</label><input class="tx-ent-input" @bind="_tReference" maxlength="100" placeholder="T00042" /></div>
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field"><label>Expira en (horas)</label><input type="number" class="tx-ent-input" @bind="_tHours" min="1" max="8760" /></div>
                        <div class="tx-ent-field" style="justify-content:flex-end;gap:6px">
                            <label class="fd-check"><input type="checkbox" @bind="_tSingleUse" /> Un solo uso</label>
                            <label class="fd-check"><input type="checkbox" @bind="_tAllowAnonymous" /> Permitir anonimo</label>
                        </div>
                    </div>
                    @if (_modalError is not null) { <div class="tx-ent-fielderr">@_modalError</div> }
                }
                else
                {
                    <p style="font-size:13px;margin-bottom:8px">Comparte esta URL. <strong>Se muestra una sola vez</strong>: solo se guarda el hash del token.</p>
                    <div class="fd-tokenurl">
                        <span class="mono" style="flex:1;word-break:break-all">@_emittedUrl</span>
                        <button class="tx-ent-btn sm" @onclick="@(() => CopyAsync(_emittedUrl!))"><i class="bi bi-clipboard"></i></button>
                    </div>
                    <p class="tx-ent-hint" style="margin-top:8px">Expira: @_emittedExpiresAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                }

                @if (_tokens.Count > 0)
                {
                    <div style="margin-top:16px">
                        <label class="tx-ent-hint" style="font-weight:600">Tokens emitidos</label>
                        @foreach (var t in _tokens)
                        {
                            <div class="fd-tokenrow">
                                <span class="tx-ent-badge @(TokenStateLabel(t) == "Vigente" ? "ok" : "off")">@TokenStateLabel(t)</span>
                                <span style="flex:1">@(t.Reference ?? "(sin referencia)") - expira @t.ExpiresAt.ToLocalTime().ToString("dd MMM HH:mm")@(t.SingleUse ? " - un solo uso" : "")</span>
                                @if (t.RevokedAt is null)
                                {
                                    <button class="tx-ent-btn sm danger" @onclick="@(() => RevokeTokenAsync(t.Id))" disabled="@_busy">Revocar</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="CloseTokenModal" disabled="@_busy">Cerrar</button>
                @if (_emittedUrl is null)
                {
                    <button class="tx-ent-btn primary" @onclick="EmitTokenAsync" disabled="@_busy">Emitir URL</button>
                }
            </div>
        </div>
    </div>
}

@* ===================== MODAL PROPIEDADES DEL FORMULARIO ===================== *@
@if (_showFormProps && _def is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showFormProps = false)">
        <div class="modal-dialog" style="max-width:560px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Propiedades del formulario</h3><button class="modal-close" @onclick="@(() => _showFormProps = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                <div class="tx-ent-field">
                    <label>Ancho del formulario</label>
                    <select class="tx-ent-input" @bind="_cardLayout">
                        <option value="@FormCardLayout.Normal">Normal (~720px)</option>
                        <option value="@FormCardLayout.Ancho">Ancho (~1160px)</option>
                        <option value="@FormCardLayout.Completo">Completo (casi toda la ventana)</option>
                    </select>
                    <div class="tx-ent-hint">Se aplica al llenar (URL publica, modulo y vista previa).</div>
                </div>
                <hr class="fd-hr" />
                <label class="fd-check"><input type="checkbox" @bind="_txIsTransactional" /> Es transaccional (cada envio confirmado es un registro)</label>
                @if (_txIsTransactional)
                {
                    <div class="tx-ent-field" style="margin-top:12px">
                        <label>Identidad del registro</label>
                        <select class="tx-ent-input" @bind="_txMode">
                            <option value="@nameof(FormIdentityMode.None)">Ninguna</option>
                            <option value="@nameof(FormIdentityMode.Sequence)">Consecutivo del sistema</option>
                            <option value="@nameof(FormIdentityMode.NaturalKey)">Por dato (clave natural)</option>
                        </select>
                    </div>
                    @if (_txMode == nameof(FormIdentityMode.NaturalKey))
                    {
                        <div class="tx-ent-field">
                            <label>Campo clave (unico por tenant)</label>
                            <select class="tx-ent-input" @bind="_txField">
                                <option value="">Selecciona...</option>
                                @foreach (var q in _def.Questions.Where(x => FormFieldValidator.IsCapture(x.ControlType) && string.IsNullOrWhiteSpace(x.CalcExpression)))
                                {
                                    <option value="@q.FieldCode">@q.Label (@q.FieldCode)</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_txMode == nameof(FormIdentityMode.Sequence))
                    {
                        <div class="tx-ent-hint">El numero se genera con el prefijo del codigo del formulario (ej. @_def.Code-000001).</div>
                    }
                }

                <hr class="fd-hr" />
                <label class="fd-check"><input type="checkbox" @bind="_isModule" @bind:after="OnModuleToggledAsync" /> Es un modulo del sistema (menu propio + bandeja)</label>
                @if (_isModule)
                {
                    <div class="tx-ent-grid c2" style="margin-top:12px">
                        <div class="tx-ent-field">
                            <label>Menu (vista)</label>
                            <select class="tx-ent-input" value="@(_moduleViewId?.ToString() ?? "")"
                                    @onchange="@(e => OnModuleViewChangedAsync(long.TryParse(e.Value?.ToString(), out var v) ? v : (long?)null))">
                                <option value="">Selecciona...</option>
                                @foreach (var view in _menuViews)
                                {
                                    <option value="@view.Id" selected="@(view.Id == _moduleViewId)">@view.Name@(view.IsDefault ? " (por defecto)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="tx-ent-field">
                            <label>Grupo del menu</label>
                            <select class="tx-ent-input" @bind="_moduleParentId">
                                <option value="">Raiz del menu</option>
                                @foreach (var g in _menuGroups)
                                {
                                    <option value="@g.Id">@g.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="tx-ent-field">
                        <label>Nombre en el menu</label>
                        <input class="tx-ent-input" @bind="_moduleLabel" maxlength="80" placeholder="@_def.Title" />
                    </div>
                    <div class="tx-ent-field">
                        <label>Icono</label>
                        <MenuIconPicker @bind-Value="_moduleIcon" />
                    </div>
                    <div class="tx-ent-field">
                        <label>Columnas de la bandeja</label>
                        <div class="fd-chkgrid">
                            @foreach (var q in _def.Questions.Where(x => !FormFieldValidator.IsNonInput(x.ControlType)))
                            {
                                <label class="fd-check"><input type="checkbox" checked="@_moduleColumns.Contains(q.FieldCode)"
                                    @onchange="@(e => ToggleSet(_moduleColumns, q.FieldCode, (bool)e.Value!))" /> @q.Label</label>
                            }
                        </div>
                    </div>
                    <div class="tx-ent-field">
                        <label>Campos de filtro</label>
                        <div class="fd-chkgrid">
                            @foreach (var q in _def.Questions.Where(x => !FormFieldValidator.IsNonInput(x.ControlType)))
                            {
                                <label class="fd-check"><input type="checkbox" checked="@_moduleFilters.Contains(q.FieldCode)"
                                    @onchange="@(e => ToggleSet(_moduleFilters, q.FieldCode, (bool)e.Value!))" /> @q.Label</label>
                            }
                        </div>
                    </div>
                    @if (_def.IsModule) { <div class="tx-ent-hint" style="color:#16a34a">Ya publicado como modulo. Ruta: /m/@_def.Code</div> }
                }
                @if (_modalError is not null) { <div class="tx-ent-fielderr">@_modalError</div> }
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="@(() => _showFormProps = false)" disabled="@_busy">Cerrar</button>
                <button class="tx-ent-btn primary" @onclick="SaveFormPropsAsync" disabled="@_busy">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private FormDefinitionDetailDto? _def;
    private IReadOnlyList<FormDefinitionListItemDto> _allDefs = [];
    private IReadOnlyList<FormFieldConditionDto> _conditions = [];
    private bool _loading = true;
    private bool _busy;
    private bool _savedFlash;
    private string? _pageError;
    private string? _modalError;

    // Seleccion / UI del constructor.
    private long? _selId;
    private bool _selIsQuestion;
    private string _propTab = "diseno";
    private string _device = "nav";
    private readonly HashSet<long> _collapsed = new();
    private bool _editingTitle;
    private string _titleDraft = "";

    // Drag and drop nativo.
    private FormControlType? _dragCtrl;
    private bool _dragIsContainer;
    private long? _dragNodeId;
    private bool _dragNodeIsQuestion;

    // Vista previa.
    private bool _showPreview;
    private readonly Dictionary<string, string?> _previewValues = new();

    // Publicar por URL.
    private bool _showTokenModal;
    private string _tReference = "";
    private int _tHours = 24;
    private bool _tSingleUse;
    private bool _tAllowAnonymous = true;
    private string? _emittedUrl;
    private DateTimeOffset? _emittedExpiresAt;
    private List<FormTokenDto> _tokens = new();

    // Propiedades del formulario (transaccionalidad + modulo).
    private bool _showFormProps;
    private bool _txIsTransactional;
    private string _txMode = nameof(FormIdentityMode.None);
    private string? _txField;
    private FormCardLayout _cardLayout = FormCardLayout.Normal;
    private bool _isModule;
    private long? _moduleViewId;
    private string? _moduleParentId;
    private string? _moduleIcon;
    private string? _moduleLabel;
    private IReadOnlyList<MenuViewDto> _menuViews = [];
    private readonly List<(long Id, string Label)> _menuGroups = new();
    private readonly HashSet<string> _moduleColumns = new(StringComparer.Ordinal);
    private readonly HashSet<string> _moduleFilters = new(StringComparer.Ordinal);

    // Editor de condicion inline (tab Reglas).
    private bool _condOpen;
    private string _condSource = "";
    private string _condOp = "equals";
    private string _condValue = "";
    private string _condEffect = "show";
    private string _condTarget = "";
    private string _condSetValue = "";
    private string? _condError;

    // Columna del GridDetail cuyo panel esta abierto (clave "questionId:columnId").
    private string? _openGridCol;

    // ---- Paletas ----
    private static readonly FormControlType[] _fieldPalette =
    {
        FormControlType.Text, FormControlType.TextArea, FormControlType.Number,
        FormControlType.Date, FormControlType.Time, FormControlType.DateTime,
        FormControlType.Toggle, FormControlType.Select, FormControlType.Radio,
        FormControlType.MultiCheck, FormControlType.GridDetail, FormControlType.Subform,
        FormControlType.CascadeConfigurator, FormControlType.Signature, FormControlType.Photo,
        FormControlType.Gps, FormControlType.File, FormControlType.Barcode, FormControlType.Button
    };
    private static readonly FormControlType[] _docPalette =
    {
        FormControlType.Heading, FormControlType.Paragraph, FormControlType.Divider, FormControlType.Spacer
    };

    private static readonly string[] TenantRoles = { "Administrador", "Supervisor", "Gestor", "Consulta" };

    // ---- Registro de tipos (nombre, tipo corto, icono bootstrap, color, soft) ----
    private sealed record Reg(string Name, string Tipo, string Icon, string Color, string Soft, string Cat);

    private static readonly Dictionary<FormControlType, Reg> ControlReg = new()
    {
        [FormControlType.Text] = new("Texto corto", "Texto", "bi-input-cursor-text", "#7c3aed", "#ede9fe", "control"),

    private RenderFragment RenderReglasTab(Node node) => __builder =>
    {
        <p class="tx-ent-hint">Reglas condicionales de este formulario (mostrar / ocultar / requerir segun otro campo).</p>
        @if (!node.IsQuestion)
        {
            <div class="fd-rules-empty">Las reglas se autoran desde un campo de captura. Selecciona un campo.</div>
            return;
        }
        var q = node.Q!;
        var related = _conditions.Where(c =>
            string.Equals(c.SourceFieldCode, q.FieldCode, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(c.TargetFieldCode, q.FieldCode, StringComparison.OrdinalIgnoreCase)).ToList();

        @if (related.Count > 0)
        {
            @foreach (var c in related)
            {
                <div class="fd-rule-row">
                    <span class="fd-rule-dot"></span>
                    <div class="fd-rule-tx">@ConditionSentence(c)</div>
                    <button class="fd-rule-x" title="Eliminar" @onclick="@(() => DeleteConditionAsync(c.Id))" disabled="@_busy">&times;</button>
                </div>
            }
        }
        else { <div class="fd-rules-empty">Sin reglas para este campo.</div> }

        @if (_condOpen)
        {
            var captureFields = _def!.Questions.Where(x => FormFieldValidator.IsCapture(x.ControlType)).ToList();
            <div class="fd-cond">
                <div class="fd-cond-line">
                    <span>Si el campo</span>
                    <select class="tx-ent-input" value="@_condSource" @onchange="@(e => _condSource = e.Value?.ToString() ?? "")">
                        <option value="">(este campo)</option>
                        @foreach (var f in captureFields) { <option value="@f.FieldCode">@f.Label</option> }
                    </select>
                    <select class="tx-ent-input" value="@_condOp" @onchange="@(e => _condOp = e.Value?.ToString() ?? "equals")">
                        <option value="equals">es igual a</option>
                        <option value="notEquals">es distinto de</option>
                        <option value="empty">esta vacio</option>
                        <option value="notEmpty">tiene valor</option>
                        <option value="contains">contiene</option>
                        <option value="gt">es mayor que</option>
                        <option value="lt">es menor que</option>
                    </select>
                    @if (_condOp is not ("empty" or "notEmpty"))
                    {
                        <input class="tx-ent-input" placeholder="valor" value="@_condValue" @onchange="@(e => _condValue = e.Value?.ToString() ?? "")" />
                    }
                </div>
                <div class="fd-cond-line">
                    <span>entonces</span>
                    <select class="tx-ent-input" value="@_condEffect" @onchange="@(e => _condEffect = e.Value?.ToString() ?? "show")">
                        <option value="show">mostrar</option>
                        <option value="hide">ocultar</option>
                        <option value="require">hacer obligatorio</option>
                        <option value="optional">hacer opcional</option>
                        <option value="setValue">fijar valor</option>
                    </select>
                    <span>el campo</span>
                    <select class="tx-ent-input" value="@_condTarget" @onchange="@(e => _condTarget = e.Value?.ToString() ?? "")">
                        <option value="">Selecciona...</option>
                        @foreach (var f in captureFields) { <option value="@f.FieldCode">@f.Label</option> }
                    </select>
                </div>
                @if (_condEffect == "setValue")
                {
                    <div class="fd-cond-line"><span>con valor</span><input class="tx-ent-input" placeholder="valor a fijar" value="@_condSetValue" @onchange="@(e => _condSetValue = e.Value?.ToString() ?? "")" /></div>
                }
                @if (_condError is not null) { <div class="tx-ent-fielderr">@_condError</div> }
                <div style="display:flex;gap:8px;margin-top:6px">
                    <button class="tx-ent-btn sm" style="flex:1" @onclick="@(() => _condOpen = false)">Cancelar</button>
                    <button class="tx-ent-btn sm primary" style="flex:1" disabled="@_busy" @onclick="@(() => SaveConditionAsync(q))">Crear regla</button>
                </div>
            </div>
        }
        else
        {
            <button class="fd-rule-add" @onclick="@(() => { _condOpen = true; _condError = null; _condSource = ""; _condTarget = ""; _condOp = "equals"; _condEffect = "show"; _condValue = ""; _condSetValue = ""; })">+ Condicion (mostrar/ocultar segun otro campo)</button>
        }
    };

    private string ConditionSentence(FormFieldConditionDto c)
    {
        var op = c.Operator switch
        {
            "equals" => $"= '{c.Value}'", "notEquals" => $"!= '{c.Value}'",
            "empty" => "vacio", "notEmpty" => "con valor",
            "contains" => $"contiene '{c.Value}'", "gt" => $"> {c.Value}", "lt" => $"< {c.Value}",
            _ => c.Operator
        };
        var act = c.Action switch
        {
            "show" => "mostrar", "hide" => "ocultar", "require" => "requerir",
            "optional" => "opcional", "setValue" => $"fijar '{c.SetValue}'", _ => c.Action
        };
        var src = LabelOf(c.SourceFieldCode);
        var tgt = LabelOf(c.TargetFieldCode);
        return $"Si {src} {op} entonces {act} {tgt}";
    }

    private string LabelOf(string fieldCode)
        => _def?.Questions.FirstOrDefault(x => string.Equals(x.FieldCode, fieldCode, StringComparison.OrdinalIgnoreCase))?.Label ?? fieldCode;

    private async Task SaveConditionAsync(FormQuestionDto q)
    {
        _condError = null;
        if (string.IsNullOrWhiteSpace(_condTarget)) { _condError = "Elige el campo objetivo."; return; }
        var source = string.IsNullOrWhiteSpace(_condSource) ? q.FieldCode : _condSource;
        if (string.Equals(source, _condTarget, StringComparison.OrdinalIgnoreCase))
        {
            _condError = "El campo evaluado y el objetivo no pueden ser el mismo."; return;
        }
        _busy = true;
        try
        {
            var value = _condOp is "empty" or "notEmpty" ? null : _condValue;
            var setValue = _condEffect == "setValue" ? _condSetValue : null;
            var res = await CondSvc.AddAsync(Id, new SaveFormFieldConditionRequest(source, _condOp, value, _condEffect, _condTarget, setValue));
            if (!res.IsOk) { _condError = res.Error ?? "No se pudo crear la regla."; return; }
            _condOpen = false;
            _conditions = await CondSvc.ListAsync(Id);
        }
        finally { _busy = false; }
    }

    private async Task DeleteConditionAsync(long conditionId)
    {
        _busy = true;
        try
        {
            var res = await CondSvc.DeleteAsync(conditionId);
            if (!res.IsOk) { _pageError = res.Error; return; }
            _conditions = await CondSvc.ListAsync(Id);
        }
        finally { _busy = false; }
    }


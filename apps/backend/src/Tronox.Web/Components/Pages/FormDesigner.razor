    private static List<FormGridColumn> GridColumns(FormQuestionDto q) => FormGridCalculator.ParseColumns(q.OptionsJson).ToList();

    private static int? ParseColWidth(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw) || !int.TryParse(raw, out var v) || v <= 0) { return null; }
        return Math.Clamp(v, 40, 2000);
    }

    private void ToggleGridCol(FormQuestionDto q, string colId)
    {
        var k = $"{q.Id}:{colId}";
        _openGridCol = _openGridCol == k ? null : k;
    }

    // Claves gestionadas por el round-trip; el resto (lookup/default/...) se preserva.
    private static readonly HashSet<string> GridCoreKeys = new(StringComparer.OrdinalIgnoreCase)
        { "id", "label", "type", "options", "required", "calc", "agg", "aggWhen", "rollup", "width", "format" };

    private static Dictionary<string, Dictionary<string, JsonElement>> RawColumnExtras(string? optionsJson)
    {
        var map = new Dictionary<string, Dictionary<string, JsonElement>>(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(optionsJson)) { return map; }
        try
        {
            using var doc = JsonDocument.Parse(optionsJson);
            if (doc.RootElement.ValueKind != JsonValueKind.Array) { return map; }
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != JsonValueKind.Object) { continue; }
                if (!el.TryGetProperty("id", out var pid) || pid.GetString() is not { Length: > 0 } id) { continue; }
                var extra = new Dictionary<string, JsonElement>(StringComparer.Ordinal);
                foreach (var p in el.EnumerateObject()) { if (!GridCoreKeys.Contains(p.Name)) { extra[p.Name] = p.Value.Clone(); } }
                if (extra.Count > 0) { map[id] = extra; }
            }
        }
        catch (JsonException) { }
        return map;
    }

    private async Task SaveGridColumnsAsync(FormQuestionDto q, IReadOnlyList<FormGridColumn> cols)
    {
        var preserved = RawColumnExtras(q.OptionsJson);
        var shaped = cols.Select(c =>
        {
            var o = new Dictionary<string, object?> { ["id"] = c.Id, ["label"] = c.Label };
            if (c.IsSelect)
            {
                o["type"] = "select";
                o["options"] = (c.Options ?? new List<FormOption>()).Select(x => new { id = x.Id, label = x.Label }).ToList();
            }
            if (c.Required) { o["required"] = true; }
            if (!string.IsNullOrWhiteSpace(c.Calc)) { o["calc"] = c.Calc; }
            if (c.Agg != FormAggregate.None) { o["agg"] = c.Agg.ToString(); }
            if (!string.IsNullOrWhiteSpace(c.AggWhen)) { o["aggWhen"] = c.AggWhen; }
            if (!string.IsNullOrWhiteSpace(c.Rollup)) { o["rollup"] = c.Rollup; }
            if (c.Width is int w and > 0) { o["width"] = w; }
            if (!string.IsNullOrWhiteSpace(c.Format)) { o["format"] = c.Format; }
            if (preserved.TryGetValue(c.Id, out var extra)) { foreach (var kv in extra) { o[kv.Key] = kv.Value; } }
            return o;
        }).ToList();
        var json = JsonSerializer.Serialize(shaped, new JsonSerializerOptions(JsonSerializerDefaults.Web));
        await PatchQuestionAsync(q, r => r with { OptionsJson = json });
    }

    private async Task PatchGridColumnJsonAsync(FormQuestionDto q, int index, Action<JsonObject> mutate)
    {
        JsonArray arr;
        try { arr = (JsonNode.Parse(string.IsNullOrWhiteSpace(q.OptionsJson) ? "[]" : q.OptionsJson) as JsonArray) ?? new JsonArray(); }
        catch (JsonException) { return; }
        if (index < 0 || index >= arr.Count || arr[index] is not JsonObject obj) { return; }
        mutate(obj);
        await PatchQuestionAsync(q, r => r with { OptionsJson = arr.ToJsonString() });
    }

    private Task ChangeGridColumnTypeAsync(FormQuestionDto q, int index, string type)
        => PatchGridColumnJsonAsync(q, index, obj =>
        {
            obj.Remove("lookup");
            switch (type)
            {
                case "select":
                    obj["type"] = "select"; obj.Remove("calc");
                    if (obj["options"] is not JsonArray) { obj["options"] = new JsonArray(new JsonObject { ["id"] = "op_1", ["label"] = "Opcion 1" }); }
                    break;
                case "formula":
                    obj["type"] = "text"; obj.Remove("options");
                    if (obj["calc"] is null) { obj["calc"] = "0"; }
                    break;
                case "lookup":
                    obj["type"] = "text"; obj.Remove("calc"); obj.Remove("options");
                    obj["lookup"] = new JsonObject { ["source"] = "Tercero", ["valueField"] = "id", ["displayField"] = "name" };
                    break;
                default:
                    obj["type"] = "text"; obj.Remove("calc"); obj.Remove("options");
                    break;
            }
        });

    private Task PatchGridLookupFieldAsync(FormQuestionDto q, int index, string key, string? value)
        => PatchGridColumnJsonAsync(q, index, obj =>
        {
            if (obj["lookup"] is not JsonObject lk) { return; }
            var v = value?.Trim();
            if (string.IsNullOrEmpty(v)) { lk.Remove(key); } else { lk[key] = v; }
        });

    private Task ChangeGridLookupSourceAsync(FormQuestionDto q, int index, string? kindStr)
        => PatchGridColumnJsonAsync(q, index, obj =>
        {
            if (obj["lookup"] is not JsonObject lk) { return; }
            lk["source"] = kindStr;
        });

    private bool GridColHasLookup(FormQuestionDto q, string colId) => GridColLookupObj(q, colId) is not null;

    private string GridColLookupSource(FormQuestionDto q, string colId)
        => GridColLookupObj(q, colId)?["source"]?.GetValue<string>() ?? "Tercero";

    private string GridColLookupField(FormQuestionDto q, string colId, string key)
        => GridColLookupObj(q, colId)?[key]?.GetValue<string>() ?? "";

    private static JsonObject? GridColLookupObj(FormQuestionDto q, string colId)
    {
        if (string.IsNullOrWhiteSpace(q.OptionsJson)) { return null; }
        try
        {
            if (JsonNode.Parse(q.OptionsJson) is not JsonArray arr) { return null; }
            foreach (var n in arr)
            {
                if (n is JsonObject o && o["id"]?.GetValue<string>() == colId && o["lookup"] is JsonObject lk) { return lk; }
            }
        }
        catch (JsonException) { }
        return null;
    }

    private Task AddGridColumnAsync(FormQuestionDto q)
    {
        var cols = GridColumns(q);
        var n = cols.Count + 1;
        cols.Add(new FormGridColumn($"col_{n}_{Guid.NewGuid().ToString("N")[..4]}", $"Columna {n}", null, FormAggregate.None, null));
        return SaveGridColumnsAsync(q, cols);
    }

    private Task RemoveGridColumnAsync(FormQuestionDto q, int index)
    {
        var cols = GridColumns(q);
        if (index >= 0 && index < cols.Count) { cols.RemoveAt(index); }
        return SaveGridColumnsAsync(q, cols);
    }

    private Task PatchGridColumnAsync(FormQuestionDto q, int index, Func<FormGridColumn, FormGridColumn> patch)
    {
        var cols = GridColumns(q);
        if (index < 0 || index >= cols.Count) { return Task.CompletedTask; }
        cols[index] = patch(cols[index]);
        return SaveGridColumnsAsync(q, cols);
    }

    private Task MoveGridColumnAsync(FormQuestionDto q, int index, int delta)
    {
        var cols = GridColumns(q);
        var j = index + delta;
        if (index < 0 || index >= cols.Count || j < 0 || j >= cols.Count) { return Task.CompletedTask; }
        (cols[index], cols[j]) = (cols[j], cols[index]);
        return SaveGridColumnsAsync(q, cols);
    }

    private Task PatchGridColumnOptionAsync(FormQuestionDto q, int colIndex, int optIndex, string? value)
        => PatchGridColumnAsync(q, colIndex, c =>
        {
            var opts = (c.Options ?? new List<FormOption>()).ToList();
            if (optIndex < 0)
            {
                var n = opts.Count + 1;
                opts.Add(new FormOption($"op_{n}_{Guid.NewGuid().ToString("N")[..4]}", value ?? $"Opcion {n}"));
            }
            else if (value is null) { if (optIndex < opts.Count) { opts.RemoveAt(optIndex); } }
            else if (optIndex < opts.Count) { opts[optIndex] = opts[optIndex] with { Label = value }; }
            return c with { Options = opts, Kind = "select" };
        });
}


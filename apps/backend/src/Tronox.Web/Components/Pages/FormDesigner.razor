        => t.RevokedAt is not null ? "Revocado"
            : t.ExpiresAt <= DateTimeOffset.UtcNow ? "Expirado"
            : t.SingleUse && t.UsedAt is not null ? "Usado" : "Vigente";

    // =========================================================
    // Render del lienzo (recursivo)
    // =========================================================
    private RenderFragment RenderNode(Node node, bool inRow) => __builder =>
    {
        var span = inRow ? Math.Clamp(node.Width, 1, 12) : 12;
        @if (node.Hidden)
        {
            <div class="fd-node fd-node-hidden @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                 @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                 @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                 @ondragover:preventDefault @ondragover:stopPropagation
                 @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                @if (IsSelected(node)) { @RenderNodeActions(node) }
                <i class="bi bi-eye-slash"></i> <span>@node.Label - oculto</span>
            </div>
            return;
        }
        @if (node.IsContainer)
        {
            var c = node.C!;
            var kids = NodesOf(c.Id);
            var isRow = c.ContainerType == FormContainerType.Row;
            <div class="fd-node fd-node-container @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                 @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                 @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                 @ondragover:preventDefault @ondragover:stopPropagation
                 @ondrop="@(() => DropOnAsync(c.Id, null))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                @if (IsSelected(node)) { @RenderNodeActions(node) }
                <div class="fd-node-label" style="color:@node.Reg.Color;background:@node.Reg.Soft"><i class="bi @node.Reg.Icon"></i> @c.Name</div>
                <div class="@(isRow ? "fd-kids-row" : "fd-kids-col")">
                    @foreach (var kid in kids) { @RenderNode(kid, isRow) }
                    @if (kids.Count == 0)
                    {
                        <div class="fd-node-empty" style="@(isRow ? "grid-column:span 12" : "")">Contenedor vacio - arrastra o toca un elemento</div>
                    }
                </div>
            </div>
            return;
        }
        @if (node.IsDoc)
        {
            var q = node.Q!;
            @if (q.ControlType == FormControlType.Divider)
            {
                <div class="fd-node fd-node-divider @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                     @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                     @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                     @ondragover:preventDefault @ondragover:stopPropagation
                     @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                    @if (IsSelected(node)) { @RenderNodeActions(node) }
                    <div class="fd-divider-line"></div>
                </div>
            }
            else if (q.ControlType == FormControlType.Spacer)
            {
                <div class="fd-node fd-node-spacer @(IsSelected(node) ? "sel" : "")"
                     style="grid-column:span @span;min-height:@(int.TryParse(q.DefaultValue, out var h) && h > 0 ? h : 24)px" draggable="true"
                     @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                     @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                     @ondragover:preventDefault @ondragover:stopPropagation
                     @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                    @if (IsSelected(node)) { @RenderNodeActions(node) }
                </div>
            }
            else if (q.ControlType == FormControlType.Heading)
            {
                <div class="fd-node fd-node-heading @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                     @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                     @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                     @ondragover:preventDefault @ondragover:stopPropagation
                     @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                    @if (IsSelected(node)) { @RenderNodeActions(node) }
                    <h4>@q.Label</h4>
                </div>
            }
            else
            {
                <div class="fd-node fd-node-paragraph @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                     @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                     @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                     @ondragover:preventDefault @ondragover:stopPropagation
                     @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                    @if (IsSelected(node)) { @RenderNodeActions(node) }
                    @(string.IsNullOrWhiteSpace(q.DefaultValue) ? "Texto del documento..." : q.DefaultValue)
                </div>
            }
            return;
        }
        @if (node.Q!.ControlType == FormControlType.Button)
        {
            <div class="fd-node fd-node-btnwrap @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
                 @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
                 @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
                 @ondragover:preventDefault @ondragover:stopPropagation
                 @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
                @if (IsSelected(node)) { @RenderNodeActions(node) }
                <span class="fd-node-btn"><i class="bi bi-hand-index"></i> @(string.IsNullOrWhiteSpace(node.Q!.Label) ? "Boton" : node.Q!.Label)</span>
            </div>
            return;
        }
        @* Control de captura *@
        <div class="fd-node fd-node-control @(IsSelected(node) ? "sel" : "")" style="grid-column:span @span" draggable="true"
             @onclick="@(() => Select(node))" @onclick:stopPropagation="true"
             @ondragstart="@(() => OnNodeDragStart(node))" @ondragstart:stopPropagation="true"
             @ondragover:preventDefault @ondragover:stopPropagation
             @ondrop="@(() => DropOnAsync(ParentOf(node), node))" @ondrop:preventDefault @ondrop:stopPropagation="true">
            @if (IsSelected(node)) { @RenderNodeActions(node) }
            <div class="fd-ctrl-head">
                <span class="fd-ctrl-ic" style="color:@node.Reg.Color"><i class="bi @node.Reg.Icon"></i></span>
                <span class="fd-ctrl-label">@node.Q!.Label@if (node.Q.Required) { <span class="fd-ctrl-req"> *</span> }</span>
                <span class="fd-ctrl-badge">@(node.Width)/12</span>
            </div>
            @RenderCtrlPreview(node.Q!)
        </div>
    };

    private long? ParentOf(Node node) => node.IsQuestion ? node.Q!.ContainerId : node.C!.ParentId;

    private RenderFragment RenderNodeActions(Node node) => __builder =>
    {
        <div class="fd-node-actions" @onclick:stopPropagation="true">
            <button title="Subir" disabled="@node.Locked" @onclick="@(() => MoveNodeAsync(node, true))"><i class="bi bi-chevron-up"></i></button>
            <button title="Bajar" disabled="@node.Locked" @onclick="@(() => MoveNodeAsync(node, false))"><i class="bi bi-chevron-down"></i></button>
            <button title="Duplicar" @onclick="@(() => DuplicateNodeAsync(node))"><i class="bi bi-files"></i></button>
            <button class="danger" title="Eliminar" @onclick="@(() => DeleteNodeAsync(node))"><i class="bi bi-trash"></i></button>
        </div>
    };

    private RenderFragment RenderCtrlPreview(FormQuestionDto q) => __builder =>
    {
        var ph = string.IsNullOrWhiteSpace(q.PlaceholderText) ? "Escribe aqui..." : q.PlaceholderText;
        switch (q.ControlType)
        {
            case FormControlType.TextArea:
                <div class="fd-prev-area">@ph</div>
                break;
            case FormControlType.Select:
            case FormControlType.Radio:
            case FormControlType.MultiCheck:
                var first = FormFieldValidator.ParseOptions(q.OptionsJson).FirstOrDefault()?.Label ?? "Selecciona...";
                <div class="fd-prev-select"><span>@first</span><i class="bi bi-chevron-down"></i></div>
                break;
            case FormControlType.Date:
                <div class="fd-prev-input">dd / mm / aaaa</div>
                break;
            case FormControlType.Time:
                <div class="fd-prev-input">hh : mm</div>
                break;
            case FormControlType.DateTime:
                <div class="fd-prev-input">dd / mm / aaaa  hh : mm</div>
                break;
            case FormControlType.Number:
                <div class="fd-prev-input">0</div>
                break;
            case FormControlType.Toggle:
                <div class="fd-prev-sino"><div class="on">Si</div><div>No</div></div>
                break;
            case FormControlType.GridDetail:
                var cols = FormFieldValidator.ParseOptions(q.OptionsJson);
                if (cols.Count == 0) { cols = new List<FormOption> { new("c1", "Columna 1"), new("c2", "Columna 2") }; }
                <div class="fd-prev-table">
                    <div class="fd-prev-thead" style="grid-template-columns:repeat(@cols.Count,1fr)">
                        @for (var i = 0; i < cols.Count; i++) { <div class="@(i > 0 ? "bl" : "")">@cols[i].Label</div> }
                    </div>
                    <div class="fd-prev-trow" style="grid-template-columns:repeat(@cols.Count,1fr)">
                        @for (var i = 0; i < cols.Count; i++) { <div class="@(i > 0 ? "bl" : "")">-</div> }
                    </div>
                </div>
                break;
            case FormControlType.Subform:
                <div class="fd-prev-capture"><i class="bi bi-diagram-2"></i> Registros hijo (subformulario)</div>
                break;
            case FormControlType.CascadeConfigurator:
                <div class="fd-prev-capture"><i class="bi bi-diagram-3"></i> Configurador en cascada</div>
                break;
            case FormControlType.Signature:
                <div class="fd-prev-capture dashed"><i class="bi bi-pen"></i> Firma aqui</div>
                break;
            case FormControlType.Photo:
            case FormControlType.Image:
                <div class="fd-prev-capture dashed"><i class="bi bi-camera"></i> Capturar</div>
                break;
            case FormControlType.Gps:
                <div class="fd-prev-capture"><i class="bi bi-geo-alt"></i> Ubicacion</div>
                break;
            case FormControlType.File:
            case FormControlType.Audio:
                <div class="fd-prev-capture dashed"><i class="bi bi-paperclip"></i> Subir archivo</div>
                break;
            case FormControlType.Barcode:
                <div class="fd-prev-input">|| ||| |  escanear</div>
                break;
            default:
                <div class="fd-prev-input">@ph</div>
                break;
        }
    };

    // =========================================================
    // Panel de propiedades: DISENO
    // =========================================================
    private RenderFragment RenderDisenoTab(Node node) => __builder =>
    {
        <div class="tx-ent-field">
            <label>Tipo de elemento</label>
            @if (node.IsContainer)
            {
                <select class="tx-ent-input" value="@node.C!.ContainerType"
                        @onchange="@(e => PatchContainerAsync(node.C!, r => r with { ContainerType = Enum.Parse<FormContainerType>(e.Value!.ToString()!) }))">
                    <option value="@FormContainerType.Row">Fila</option>
                    <option value="@FormContainerType.Col">Columna</option>
                    <option value="@FormContainerType.Section">Seccion</option>
                    <option value="@FormContainerType.Tabs">Pestañas</option>
                    <option value="@FormContainerType.Modal">Modal</option>
                    @if (node.C!.ContainerType is FormContainerType.Segment or FormContainerType.Table)
                    {
                        <option value="@node.C.ContainerType">@RegOf(node.C.ContainerType).Name</option>
                    }
                </select>
            }
            else
            {
                var q = node.Q!;
                var opts = node.IsDoc ? _docPalette : _fieldPalette;
                <select class="tx-ent-input" value="@q.ControlType" @onchange="@(e => ChangeTypeAsync(q, e.Value!.ToString()!))">
                    @foreach (var t in opts) { <option value="@t">@RegOf(t).Name</option> }
                    @if (!opts.Contains(q.ControlType)) { <option value="@q.ControlType">@RegOf(q.ControlType).Name</option> }
                </select>
            }
        </div>
        <div class="tx-ent-field">
            <label>Etiqueta visible</label>
            <input class="tx-ent-input" value="@node.Label" @onchange="@(e => RenameAsync(node, e.Value?.ToString() ?? ""))" />
        </div>
        @if (!node.IsDoc)
        {
            <div class="tx-ent-field">
                <label>Ancho (columnas)</label>
                <div class="fd-widthgrid">
                    @for (var w = 1; w <= 12; w++)
                    {
                        var width = w;
                        <button class="@(node.Width == width ? "on" : width < node.Width ? "in" : "")" @onclick="@(() => SetWidthAsync(node, width))">@width</button>
                    }
                </div>
                <div class="fd-widthinfo"><span><b>@node.Width col</b></span><span>@(Math.Round(node.Width / 12d * 100))%</span></div>
            </div>
        }
        @if (node is { IsDoc: true, Q.ControlType: FormControlType.Paragraph })
        {
            <div class="tx-ent-field">
                <label>Contenido</label>
                <textarea class="tx-ent-input" rows="3" value="@node.Q!.DefaultValue"
                          @onchange="@(e => PatchQuestionAsync(node.Q!, r => r with { DefaultValue = e.Value?.ToString() }))"></textarea>
            </div>
        }
        @if (node is { IsDoc: true, Q.ControlType: FormControlType.Spacer })
        {
            <div class="tx-ent-field">
                <label>Alto (px)</label>
                <input type="number" class="tx-ent-input" value="@(node.Q!.DefaultValue ?? "24")"
                       @onchange="@(e => PatchQuestionAsync(node.Q!, r => r with { DefaultValue = (int.TryParse(e.Value?.ToString(), out var px) && px > 0 ? px : 24).ToString() }))" />
            </div>
        }
        @if (node.IsContainer && node.C!.ContainerType == FormContainerType.Tabs)
        {
            <div class="tx-ent-field">
                <label>Pestañas</label>
                @RenderChipList(TabsOf(node.C), "#d97706",
                    (i, v) => PatchTabsAsync(node.C!, i, v),
                    i => PatchTabsAsync(node.C!, i, null),
                    () => PatchTabsAsync(node.C!, -1, $"Pestana {TabsOf(node.C).Count + 1}"))
            </div>
        }
        @if (!node.IsDoc)
        {
            @RenderToggleRow("Fijo en el layout", "No se puede reordenar", node.Locked, () => ToggleLockAsync(node))
            @RenderToggleRow("Oculto", "No visible en el formulario", node.Hidden, () => ToggleHideAsync(node))
            @if (node.IsContainer && node.C!.ContainerType is FormContainerType.Row or FormContainerType.Col)
            {
                @RenderToggleRow("Etiquetas en linea", "El label va al frente del valor", node.C!.InlineLabels,
                    () => PatchContainerAsync(node.C!, r => r with { InlineLabels = !node.C!.InlineLabels }))
            }
        }
    };

    // =========================================================
    // Panel de propiedades: DATOS
    // =========================================================
    private RenderFragment RenderDatosTab(Node node) => __builder =>
    {
        var slug = node.IsQuestion ? node.Q!.FieldCode
            : new string(node.Label.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '_').ToArray()).Trim('_');
        <div class="tx-ent-field"><label>Nombre interno (FORX_DATA)</label><input class="tx-ent-input mono" readonly value="@slug" /></div>
        <div class="tx-ent-field"><label>Tipo de respuesta</label><input class="tx-ent-input" readonly value="@node.Reg.Tipo" /></div>

        @if (node is { IsQuestion: true, Q.ControlType: FormControlType.Select or FormControlType.Radio or FormControlType.MultiCheck })
        {
            <div class="tx-ent-field">
                <label>Opciones de la lista</label>
                @RenderChipList(OptionLabels(node.Q!), "#2563eb",
                    (i, v) => PatchOptionAsync(node.Q!, i, v),
                    i => PatchOptionAsync(node.Q!, i, null),
                    () => PatchOptionAsync(node.Q!, -1, $"Opcion {OptionLabels(node.Q!).Count + 1}"))
            </div>
        }
        @if (node is { IsQuestion: true, Q.ControlType: FormControlType.GridDetail })
        {
            @RenderGridColumnsEditor(node.Q!)
        }
        @if (node is { IsQuestion: true, Q.ControlType: FormControlType.CascadeConfigurator })
        {
            <div class="tx-ent-field">
                <label>Taxonomia del configurador (JSON)</label>
                <textarea class="tx-ent-input mono" rows="6" value="@node.Q!.CascadeConfigJson"
                          @onchange="@(e => PatchQuestionAsync(node.Q!, r => r with { CascadeConfigJson = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }))"></textarea>
                <div class="tx-ent-hint">Config-driven por niveles/columnas/juegos. Editor visual pendiente; por ahora se edita el JSON.</div>
            </div>
        }
        @if (node is { IsQuestion: true, Q.ControlType: FormControlType.Subform })
        {
            <div class="tx-ent-field">
                <label>Formulario hijo (detalle)</label>
                <select class="tx-ent-input" value="@(node.Q!.SubformDefinitionId?.ToString() ?? "")"
                        @onchange="@(e => PatchQuestionAsync(node.Q!, r => r with { SubformDefinitionId = long.TryParse(e.Value?.ToString(), out var id) ? id : (long?)null }))">
                    <option value="">Selecciona una definicion...</option>
                    @foreach (var d in _allDefs.Where(d => d.Id != _def!.Id))
                    {
                        <option value="@d.Id" selected="@(d.Id == node.Q!.SubformDefinitionId)">@d.Title (@d.Code)</option>
                    }
                </select>
                <div class="tx-ent-hint">Cada registro hijo es una respuesta de esa definicion, enlazada a este registro.</div>
            </div>
        }
        @if (node.IsQuestion && !node.IsDoc)
        {
            var q = node.Q!;
            <div class="tx-ent-field"><label>Texto de ayuda (placeholder)</label><input class="tx-ent-input" value="@q.PlaceholderText" @onchange="@(e => PatchQuestionAsync(q, r => r with { PlaceholderText = e.Value?.ToString() }))" /></div>
            <div class="tx-ent-field"><label>Valor por defecto</label><input class="tx-ent-input" value="@q.DefaultValue" @onchange="@(e => PatchQuestionAsync(q, r => r with { DefaultValue = e.Value?.ToString() }))" /></div>
            <div class="tx-ent-field">
                <label>Valor por defecto dinamico (al abrir)</label>
                <select class="tx-ent-input" value="@q.DefaultDynamic"
                        @onchange="@(e => PatchQuestionAsync(q, r => r with { DefaultDynamic = Enum.TryParse<FormDefaultDynamic>(e.Value?.ToString(), out var d) ? d : FormDefaultDynamic.None }))">
                    <option value="@nameof(FormDefaultDynamic.None)">Ninguno</option>
                    <option value="@nameof(FormDefaultDynamic.Today)">Hoy (fecha)</option>
                    <option value="@nameof(FormDefaultDynamic.CurrentUser)">Usuario actual</option>
                </select>
            </div>
            <div class="tx-ent-field">
                <label>Formato (presentacion)</label>
                <select class="tx-ent-input" value="@(q.Format ?? "")"
                        @onchange="@(e => PatchQuestionAsync(q, r => r with { Format = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString() }))">
                    <option value="">Sin formato</option>
                    <option value="currency">Moneda ($)</option>
                    <option value="percent">Porcentaje (%)</option>
                    <option value="integer">Entero (miles)</option>
                    <option value="decimal">Decimal</option>
                    <option value="phone">Telefono (mascara)</option>
                    <option value="document">Documento (miles)</option>
                </select>
            </div>
            <div class="tx-ent-field">
                <label>Ocultar para roles</label>
                <div class="fd-chkgrid">
                    @foreach (var role in TenantRoles)
                    {
                        <label class="fd-check"><input type="checkbox" checked="@FieldVisHas(q, "hide", role)" @onchange="@(e => ToggleFieldVisAsync(q, "hide", role, (bool)e.Value!))" /> @role</label>
                    }
                </div>
            </div>
            <div class="tx-ent-field">
                <label>Solo lectura para roles</label>
                <div class="fd-chkgrid">
                    @foreach (var role in TenantRoles)
                    {
                        <label class="fd-check"><input type="checkbox" checked="@FieldVisHas(q, "readonly", role)" @onchange="@(e => ToggleFieldVisAsync(q, "readonly", role, (bool)e.Value!))" /> @role</label>
                    }
                </div>
            </div>
            @RenderToggleRow("Campo obligatorio", "No permite envio vacio", q.Required, () => PatchQuestionAsync(q, r => r with { Required = !q.Required }))
            <div class="tx-ent-field">
                <label>Formula (campo calculado)</label>
                <input class="tx-ent-input mono" value="@q.CalcExpression" placeholder="{cantidad} * {precio}"
                       @onchange="@(e => PatchQuestionAsync(q, r => r with { CalcExpression = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }))" />
                <div class="tx-ent-hint">Usa {codigo} para referenciar otros campos. Solo lectura al llenar.</div>
            </div>
            @RenderOrigenDatos(q)
        }
    };

    // ---- Origen de datos / lookup (fuentes DIFERIDAS en TRONOX hasta RQ07) ----
    private RenderFragment RenderOrigenDatos(FormQuestionDto q) => __builder =>
    {
        <div class="fd-origen">
            <div class="tx-ent-field">
                <label>Origen de datos</label>
                <select class="tx-ent-input" value="@q.SourceKind" @onchange="@(e => ChangeSourceKindAsync(q, e.Value?.ToString()))">
                    <option value="@nameof(FormSourceKind.Options)">Opciones fijas</option>
                    <option value="@nameof(FormSourceKind.DataContainer)">Contenedor de datos</option>
                    <option value="@nameof(FormSourceKind.Tercero)">Directorio (terceros)</option>
                    <option value="@nameof(FormSourceKind.Item)">Inventario (items)</option>
                </select>
            </div>
            @if (q.SourceKind != FormSourceKind.Options)
            {
                _ = EnsureLookupMetaAsync(q.SourceKind, q.SourceRef);
                var fields = LookupFieldsFor(q.SourceKind, q.SourceRef);
                var sources = _lookupSources.GetValueOrDefault(q.SourceKind) ?? Array.Empty<FormLookupSourceInfo>();

                @if (!LookupSvc.HasSource(q.SourceKind))
                {
                    <div class="fd-rq07">Fuentes de datos disponibles cuando exista el Catalogo de Terceros (RQ07). Puedes configurar el origen; el renderer avisara hasta que la fuente exista.</div>
                }
                @if (q.SourceKind == FormSourceKind.DataContainer)
                {
                    <div class="tx-ent-field">
                        <label>Fuente (contenedor)</label>
                        <select class="tx-ent-input" value="@(q.SourceRef ?? "")"
                                @onchange="@(e => PatchQuestionAsync(q, r => r with { SourceRef = e.Value?.ToString(), DisplayField = null }))">
                            <option value="">Selecciona...</option>
                            @foreach (var s in sources) { <option value="@s.Ref" selected="@(s.Ref == q.SourceRef)">@s.Name</option> }
                        </select>
                    </div>
                }
                <div class="tx-ent-field">
                    <label>Presentacion</label>
                    <select class="tx-ent-input" value="@q.Presentation"
                            @onchange="@(e => PatchQuestionAsync(q, r => r with { Presentation = Enum.TryParse<FormFieldPresentation>(e.Value?.ToString(), out var p) ? p : FormFieldPresentation.Autocomplete }))">
                        <option value="@nameof(FormFieldPresentation.Autocomplete)">Autocompletar</option>
                        <option value="@nameof(FormFieldPresentation.Dropdown)">Lista</option>
                        <option value="@nameof(FormFieldPresentation.Modal)">Buscador</option>
                    </select>
                </div>
                <div class="tx-ent-field">
                    <label>Mostrar (etiqueta)</label>
                    <select class="tx-ent-input" value="@(q.DisplayField ?? "")"
                            @onchange="@(e => PatchQuestionAsync(q, r => r with { DisplayField = e.Value?.ToString() }))">
                        <option value="">Automatico</option>
                        @foreach (var f in fields) { <option value="@f.Name" selected="@(f.Name == q.DisplayField)">@f.Label</option> }
                    </select>
                </div>
                <div class="tx-ent-field">
                    <label>Filtro (JSON opcional)</label>
                    <input class="tx-ent-input mono" value="@q.FilterJson" placeholder='{"perfil":"Cliente"}'
                           @onchange="@(e => PatchQuestionAsync(q, r => r with { FilterJson = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }))" />
                </div>
                @if (fields.Count > 0)
                {
                    <div class="tx-ent-field">
                        <label>Autollenar campos (al elegir, copia)</label>
                        @RenderAutofillMap(q, fields)
                    </div>
                }
            }
        </div>
    };

    private RenderFragment RenderAutofillMap(FormQuestionDto q, IReadOnlyList<FormLookupField> fields) => __builder =>
    {
        var map = ParseAutofillMap(q.AutofillMapJson).ToList();
        var targets = _def!.Questions.Where(x => x.Id != q.Id && x.SourceKind == FormSourceKind.Options).Select(x => x.FieldCode).ToList();
        <div class="fd-autofill">
            @foreach (var pair in map)
            {
                var src = pair.Key;
                <div class="fd-autofill-row">
                    <select class="tx-ent-input" value="@src" @onchange="@(e => SetAutofillAsync(q, src, e.Value?.ToString(), pair.Value))">
                        @foreach (var f in fields) { <option value="@f.Name" selected="@(f.Name == src)">@f.Label</option> }
                    </select>
                    <span class="fd-autofill-arrow">&rarr;</span>
                    <select class="tx-ent-input" value="@pair.Value" @onchange="@(e => SetAutofillAsync(q, src, src, e.Value?.ToString()))">
                        <option value="">Campo destino...</option>
                        @foreach (var t in targets) { <option value="@t" selected="@(t == pair.Value)">@t</option> }
                    </select>
                    <button class="fd-chip-x" title="Quitar" @onclick="@(() => RemoveAutofillAsync(q, src))">&times;</button>
                </div>
            }
            <button class="fd-chip-add" @onclick="@(() => AddAutofillAsync(q, fields))">+ Agregar mapeo</button>
        </div>
    };

    // ---- Metadata de lookup cacheada ----
    private readonly Dictionary<string, IReadOnlyList<FormLookupField>> _lookupFields = new(StringComparer.Ordinal);
    private readonly Dictionary<FormSourceKind, IReadOnlyList<FormLookupSourceInfo>> _lookupSources = new();
    private readonly HashSet<string> _lookupMetaLoading = new(StringComparer.Ordinal);

    private static string MetaKey(FormSourceKind kind, string? sourceRef) => $"{kind}|{sourceRef}";
    private IReadOnlyList<FormLookupField> LookupFieldsFor(FormSourceKind kind, string? sourceRef)
        => _lookupFields.GetValueOrDefault(MetaKey(kind, sourceRef)) ?? Array.Empty<FormLookupField>();

    private async Task EnsureLookupMetaAsync(FormSourceKind kind, string? sourceRef)
    {
        if (kind == FormSourceKind.Options) { return; }
        var key = MetaKey(kind, sourceRef);
        if (_lookupFields.ContainsKey(key) || !_lookupMetaLoading.Add(key)) { return; }
        try
        {
            if (!_lookupSources.ContainsKey(kind)) { _lookupSources[kind] = await LookupSvc.ListSourcesAsync(kind); }
            _lookupFields[key] = await LookupSvc.DescribeFieldsAsync(kind, sourceRef ?? "");
        }
        catch (Exception) { _lookupFields[key] = Array.Empty<FormLookupField>(); }
        finally { _lookupMetaLoading.Remove(key); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangeSourceKindAsync(FormQuestionDto q, string? kindStr)
    {
        var kind = Enum.TryParse<FormSourceKind>(kindStr, out var k) ? k : FormSourceKind.Options;
        await PatchQuestionAsync(q, r => r with
        {
            SourceKind = kind,
            ValueField = kind == FormSourceKind.Options ? null : "id",
            SourceRef = kind == FormSourceKind.DataContainer ? r.SourceRef : null
        });
    }

    private static IReadOnlyDictionary<string, string> ParseAutofillMap(string? json)
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(json)) { return map; }
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object) { return map; }
            foreach (var p in doc.RootElement.EnumerateObject())
            {
                map[p.Name] = p.Value.ValueKind == JsonValueKind.String ? (p.Value.GetString() ?? "") : "";
            }
        }
        catch (JsonException) { }
        return map;
    }

    private async Task AddAutofillAsync(FormQuestionDto q, IReadOnlyList<FormLookupField> fields)
    {
        var map = new Dictionary<string, string>(ParseAutofillMap(q.AutofillMapJson), StringComparer.OrdinalIgnoreCase);
        var candidate = fields.Select(f => f.Name).FirstOrDefault(k => !map.ContainsKey(k));
        if (candidate is null) { return; }
        map[candidate] = "";
        await PatchAutofillAsync(q, map);
    }

    private async Task SetAutofillAsync(FormQuestionDto q, string oldSource, string? newSource, string? target)
    {
        var map = new Dictionary<string, string>(ParseAutofillMap(q.AutofillMapJson), StringComparer.OrdinalIgnoreCase);
        map.Remove(oldSource);
        if (!string.IsNullOrWhiteSpace(newSource)) { map[newSource] = target ?? ""; }
        await PatchAutofillAsync(q, map);
    }

    private async Task RemoveAutofillAsync(FormQuestionDto q, string source)
    {
        var map = new Dictionary<string, string>(ParseAutofillMap(q.AutofillMapJson), StringComparer.OrdinalIgnoreCase);
        map.Remove(source);
        await PatchAutofillAsync(q, map);
    }

    private Task PatchAutofillAsync(FormQuestionDto q, Dictionary<string, string> map)
        => PatchQuestionAsync(q, r => r with { AutofillMapJson = map.Count == 0 ? null : JsonSerializer.Serialize(map) });


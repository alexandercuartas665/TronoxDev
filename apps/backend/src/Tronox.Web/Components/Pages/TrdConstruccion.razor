    private void OpenTipologias(TrdAsignacionDto a)
    {
        _tipAsign = a;
        ResetTipEditor();
        _showTipologias = true;
    }

    private void OpenTipEditor(TrdTipologiaDto t)
    {
        _editingTip = t;
        _fTipNombre = t.Nombre; _fTipSoporte = t.Soporte; _fTipFormato = t.Formato; _fTipObligatorio = t.ObligatorioEnExpediente;
        _tipError = null;
    }

    private void ResetTipEditor()
    {
        _editingTip = null;
        _fTipNombre = ""; _fTipSoporte = SoporteTipologia.Electronico; _fTipFormato = null; _fTipObligatorio = false;
        _tipError = null;
    }

    private async Task SaveTipologia()
    {
        if (_tipAsign is null) { return; }
        _busy = true; _tipError = null;
        try
        {
            var request = new SaveTipologiaRequest(_fTipNombre, _fTipSoporte, _fTipFormato, _fTipObligatorio);
            var actor = Tenant.UserId ?? 0;
            var result = _editingTip is null
                ? await Svc.AddTipologiaAsync(_tipAsign.Id, request, actor)
                : await Svc.UpdateTipologiaAsync(_editingTip.Id, request, actor);
            if (!result.IsOk) { _tipError = result.Error; return; }
            await ReloadWorkspaceAsync();
            _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign;
            ResetTipEditor();
        }
        finally { _busy = false; }
    }

    private async Task SetTipArchived(TrdTipologiaDto t, bool archived)
    {
        _busy = true; _tipError = null;
        try
        {
            var result = await Svc.SetTipologiaArchivedAsync(t.Id, archived, Tenant.UserId ?? 0,
                motivo: archived ? "Inactivacion de tipologia (RF05)" : "Reactivacion (RF05)");
            if (!result.IsOk) { _tipError = result.Error; return; }
            await ReloadWorkspaceAsync();
            if (_tipAsign is not null) { _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign; }
        }
        finally { _busy = false; }
    }


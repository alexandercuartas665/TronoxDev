@page "/trd"
@attribute [Authorize(Policy = "Perm:modulo/trd:View")]
@* Llave de permisos = ruta de menu "modulo/trd" (RF09 5.9.3). Se entra desde el listado de
   Versiones de TRD (RF01) con ?version={id}. Es el submodulo de construccion de la TRD y sus
   tipologias (RF04 + RF05), equivalente al legacy doc_tablaRetencionDocumental. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Trd
@using Tronox.Application.SeriesDocumentales
@using Tronox.Application.Archivistica
@using Tronox.Application.Listas
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject ITrdConstruccionService Svc
@inject ISerieDocumentalService SeriesSvc
@inject INivelClasificacionService NivelesSvc
@inject IListaMaestraService ListasSvc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject NavigationManager Nav

@* RQ02 - RF04 + RF05. Vista list-first: aterriza en "Gestion de TRD por dependencia" (con Estado
   TRD DERIVADO, ADR-007) y desde "Ver/Crear" se abre el workspace de esa dependencia, donde se
   construye la TRD (cruce Dependencia x Serie), sus tipologias documentales y sus metadatos de
   expediente y de documento. Respeta la solo-lectura por estado de la version (RF01 3.1.3). *@

<PageTitle>Tabla de Retención Documental - TRONOX SGDEA</PageTitle>

<div class="tx-mod tx-dep tx-trdc">

    <nav class="tronox-breadcrumb" aria-label="Ruta de navegación">
        <a href="/inicio">Inicio</a>
        <span class="sep">/</span>
        <span>Configuración Documental</span>
        <span class="sep">/</span>
        <a href="/trd-versiones">Versiones de TRD</a>
        <span class="sep">/</span>
        <span class="cur">Gestión de la TRD</span>
    </nav>

    @if (_version is null)
    {
        <div class="tx-ent-card">
            <div class="tx-ent-card-body">
                <div class="tx-ent-empty">
                    <i class="bi bi-table"></i>
                    <div>
                        <strong>Selecciona una versión de TRD</strong><br />
                        La construcción de la TRD se hace sobre una versión. Entra desde el módulo de
                        <a href="/trd-versiones">Versiones de TRD</a> con «Abrir/Ver TRD».
                    </div>
                    <a class="tx-ent-btn primary" href="/trd-versiones"><i class="bi bi-clock-history"></i> Ir a Versiones de TRD</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="tx-ent-head">
            <div>
                <div class="tx-ent-eyebrow"><i class="bi bi-table"></i><span>RQ02 &middot; RF04 &middot; RF05</span></div>
                <h1 class="tx-ent-title">Gestión de Tablas de Retención Documental &middot; <span class="mono">@_version.CodigoVersion</span></h1>
                <p class="tx-ent-sub">
                    Asignación por dependencia. Cada dependencia tiene su propia TRD (principio de procedencia):
                    cruza sus <strong>series</strong>, define tiempos, disposición, clasificación, <strong>tipos documentales</strong> y metadatos.
                </p>
            </div>
            <div>
                <span class="tx-ent-badge @EstadoClase(_version.Estado)">@EstadoLabel(_version.Estado)</span>
            </div>
        </div>

        @if (_version.SoloConsulta)
        {
            <div class="tx-ent-alert"><i class="bi bi-eye"></i><span>Versión <strong>@EstadoLabel(_version.Estado)</strong>: solo consulta. No se puede modificar la TRD.</span></div>
        }
        else if (_version.Vigente)
        {
            <div class="tx-ent-alert"><i class="bi bi-shield-lock"></i><span>Versión <strong>Vigente</strong>: puedes agregar series, tipos documentales y metadatos, pero <strong>no</strong> los tiempos, la disposición, la clasificación ni eliminar. Para eso crea una nueva versión.</span></div>
        }

        @if (_pageError is not null)
        {
            <div class="tx-ent-alert err"><i class="bi bi-exclamation-triangle-fill"></i><span>@_pageError</span></div>
        }
        @if (_pageOk is not null)
        {
            <div class="tx-ent-alert ok"><i class="bi bi-check-circle-fill"></i><span>@_pageOk</span></div>
        }

        @* =================== LISTA "Asignacion por Dependencia" (siempre visible) =================== *@
        <div class="tx-ent-card">
                <div class="tx-dep-toolbar" style="gap:12px;flex-wrap:wrap">
                    <div class="tx-dep-search">
                        <i class="bi bi-search"></i>
                        <input class="tx-ent-input" placeholder="Buscar código o dependencia..."
                               value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? "")" />
                    </div>
                    <div class="tx-ent-field" style="margin:0;min-width:200px">
                        <select class="tx-ent-input" @bind="_estadoFilter">
                            <option value="">Todos los estados</option>
                            <option value="@EstadoTrdDependencia.SinTrd">Sin TRD</option>
                            <option value="@EstadoTrdDependencia.EnConstruccion">En construcción</option>
                            <option value="@EstadoTrdDependencia.Activa">Activa</option>
                            <option value="@EstadoTrdDependencia.Historica">Histórica</option>
                            <option value="@EstadoTrdDependencia.Inactiva">Inactiva</option>
                        </select>
                    </div>
                </div>

                <div class="tx-ent-table-wrap">
                    <table class="tx-ent-table">
                        <thead>
                            <tr>
                                <th>Código</th><th>Dependencia</th><th>Versión TRD</th><th>Estado TRD</th>
                                <th>Fecha creación</th><th>Usuario creador</th><th class="right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (DependenciasFiltradas().Count == 0)
                            {
                                <tr><td colspan="7"><div class="tx-ent-hint" style="padding:14px">No hay dependencias que coincidan. Créalas en Organizacional › Dependencias.</div></td></tr>
                            }
                            else
                            {
                                @foreach (var d in DependenciasFiltradas())
                                {
                                    <tr>
                                        <td class="mono">@d.Codigo</td>
                                        <td>@d.Nombre</td>
                                        <td>@(d.SeriesAsignadas > 0 ? _version.CodigoVersion : "--")</td>
                                        <td><span class="tx-ent-badge sm @EstadoDepClase(d.Estado)">@EstadoDepLabel(d.Estado)</span></td>
                                        <td>@(d.FechaCreacion is DateTimeOffset f ? f.ToString("yyyy-MM-dd") : "--")</td>
                                        <td>@(d.CreadoPorId is long uid ? $"Usuario {uid}" : "--")</td>
                                        <td class="right">
                                            @if (d.SeriesAsignadas > 0)
                                            {
                                                <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWorkspace(d, autoAdd:false))"><i class="bi bi-table"></i> Ver TRD</button>
                                            }
                                            else if (_canAgregar)
                                            {
                                                <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWorkspace(d, autoAdd:true))"><i class="bi bi-plus-lg"></i> Crear</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenWorkspace(d, autoAdd:false))"><i class="bi bi-eye"></i> Ver</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
        </div>

        @* =================== WORKSPACE como MODAL (fiel al legacy pnlTRDWorkspace = rf4-modal-workspace) =================== *@
        @if (_workspaceDep is not null)
        {
            <div class="modal-overlay" @onclick="BackToList">
                <div class="modal-dialog" style="max-width:1080px;width:96%" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <div>
                            <h3 style="margin:0"><span class="mono">@_workspaceDep.Codigo</span> &middot; @_workspaceDep.Nombre</h3>
                            <div class="tx-ent-hint" style="margin-top:2px">Tabla de Retención Documental por dependencia</div>
                        </div>
                        <button class="modal-close" @onclick="BackToList">&times;</button>
                    </div>
                    <div class="modal-body tx-mod tx-trdc">
                        @if (_pageError is not null)
                        {
                            <div class="tx-ent-alert err"><i class="bi bi-exclamation-triangle-fill"></i><span>@_pageError</span></div>
                        }
                        @if (_pageOk is not null)
                        {
                            <div class="tx-ent-alert ok"><i class="bi bi-check-circle-fill"></i><span>@_pageOk</span></div>
                        }

                        <div class="tx-ent-head" style="margin-bottom:8px">
                            <div>
                                <h3 style="margin:0">Tabla de Retención Documental</h3>
                                <p class="tx-ent-sub" style="margin:2px 0 0">@_version.CodigoVersion &middot; Configura series, subseries y tipologías desde un solo módulo</p>
                            </div>
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                                <span class="tx-ent-badge @EstadoClase(_version.Estado)">@EstadoLabel(_version.Estado)</span>
                                @if (_canAgregar)
                                {
                                    <button type="button" class="tx-ent-btn sm primary" @onclick="OpenAddAsignacion"><i class="bi bi-plus-lg"></i> Nueva Serie</button>
                                }
                            </div>
                        </div>

                        <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span><strong>Módulo central TRD:</strong> gestiona series, subseries y tipologías documentales desde este árbol. Usa el botón <i class="bi bi-plus-lg"></i> de cada serie para agregar subseries o tipologías según su estructura.</span></div>

                        <div class="tx-ent-card" style="padding:12px;margin-top:10px">
                            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
                                <div><strong>Serie / Subserie / Tipología</strong>
                                    <span class="tx-ent-hint">&nbsp;@ContarSeries() series &middot; @ContarSubseries() subseries</span>
                                </div>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                                    <input class="tx-ent-input" style="min-width:220px" placeholder="Buscar serie, subserie o tipología..."
                                           value="@_treeSearch" @oninput="@(e => _treeSearch = e.Value?.ToString() ?? "")" />
                                    <button type="button" class="tx-ent-btn sm" @onclick="ExpandAll"><i class="bi bi-arrows-expand"></i> Expandir</button>
                                    <button type="button" class="tx-ent-btn sm" @onclick="CollapseAll"><i class="bi bi-arrows-collapse"></i> Colapsar</button>
                                    @if (_canAgregar)
                                    {
                                        <button type="button" class="tx-ent-btn sm primary" @onclick="OpenAddAsignacion"><i class="bi bi-plus-lg"></i> Crear</button>
                                    }
                                </div>
                            </div>

                            @if (_asignaciones.Count == 0)
                            {
                                <div class="tx-ent-empty" style="margin-top:12px"><i class="bi bi-diagram-3"></i><div>Esta dependencia aún no tiene series en la TRD.</div></div>
                            }
                            else
                            {
                                <div class="tx-ent-table-wrap" style="margin-top:10px">
                                    <table class="tx-ent-table">
                                        <thead>
                                            <tr>
                                                <th>Serie / Subserie / Tipología</th><th>Código</th><th>T. Gestión</th><th>T. Central</th>
                                                <th>Disposición</th><th>Formato / Conteo</th><th>Estado</th><th class="right">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var serie in SeriesTop())
                                            {
                                                @SerieRow(serie, 0)
                                                @if (IsExpanded(serie))
                                                {
                                                    @foreach (var t in TipsVisibles(serie)) { @TipologiaRow(serie, t) }
                                                    @foreach (var sub in SubseriesDe(serie))
                                                    {
                                                        @SerieRow(sub, 1)
                                                        @if (IsExpanded(sub))
                                                        {
                                                            @foreach (var t in TipsVisibles(sub)) { @TipologiaRow(sub, t) }
                                                        }
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @* ===== Modal asignacion (crear/editar reglas) ===== *@
    @if (_showAsignEditor)
    {
        <div class="modal-overlay" @onclick="@(() => _showAsignEditor = false)">
            <div class="modal-dialog" style="max-width:680px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>@(_editingAsign is null ? "Agregar serie a la dependencia" : $"Editar {_editingAsign.CodigoCcd}")</h3>
                    <button class="modal-close" @onclick="@(() => _showAsignEditor = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    @if (_editingAsign is null)
                    {
                        <div class="tx-ent-field">
                            <label>Serie del catálogo (activas) <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fSerieId">
                                <option value="0">— Selecciona —</option>
                                @foreach (var s in _seriesActivas)
                                {
                                    <option value="@s.Id">@s.Codigo — @s.Nombre</option>
                                }
                            </select>
                            <div class="tx-ent-hint">El código CCD se generará como código de dependencia + código de serie.</div>
                        </div>
                    }
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field">
                            <label>Tiempo en Gestión (años) <span class="req">*</span></label>
                            <input type="number" min="0" class="tx-ent-input" @bind="_fTiempoGestion" />
                        </div>
                        <div class="tx-ent-field">
                            <label>Tiempo en Central (años) <span class="req">*</span></label>
                            <input type="number" min="0" class="tx-ent-input" @bind="_fTiempoCentral" />
                        </div>
                    </div>
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field">
                            <label>Disposición final <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fDisposicion">
                                <option value="@DisposicionFinal.ConservacionTotal">CT — Conservación Total</option>
                                <option value="@DisposicionFinal.Seleccion">S — Selección</option>
                                <option value="@DisposicionFinal.Eliminacion">E — Eliminación</option>
                            </select>
                        </div>
                        <div class="tx-ent-field">
                            <label>Clasificación <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fNivelId">
                                @foreach (var n in _niveles)
                                {
                                    <option value="@n.Id">@n.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="tx-ent-grid c2">
                        <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                            <input type="checkbox" @bind="_fReproduccion" /> Reproducción técnica del papel (M/D)
                        </label>
                        <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                            <input type="checkbox" @bind="_fDdhh" /> Serie con documentos DD.HH / DIH
                        </label>
                    </div>
                    <div class="tx-ent-field">
                        <label>Procedimiento <span class="opt">(opcional)</span></label>
                        <textarea class="tx-ent-input" @bind="_fProcedimiento" maxlength="1000" rows="2"></textarea>
                    </div>
                    @if (_asignError is not null)
                    {
                        <div class="tx-ent-fielderr">@_asignError</div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showAsignEditor = false)" disabled="@_busy">Cancelar</button>
                    <button class="tx-ent-btn primary" @onclick="SaveAsignacion" disabled="@_busy">@(_editingAsign is null ? "Agregar" : "Guardar")</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal metadatos del EXPEDIENTE (RF04) ===== *@
    @if (_showMetadatos && _metaAsign is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showMetadatos = false)">
            <div class="modal-dialog" style="max-width:720px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Metadatos del Expediente &middot; <span class="mono">@_metaAsign.CodigoCcd</span></h3>
                    <button class="modal-close" @onclick="@(() => _showMetadatos = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Se diligencian al crear un expediente bajo esta serie en esta dependencia.</p>
                    @MetadatosTabla(_metaAsign.Metadatos, OpenMetaEditor, SetMetaArchived)

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingMeta is null ? "Nuevo metadato del expediente" : "Editar metadato")</strong>
                            @MetadatoForm(false)
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showMetadatos = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal TIPOLOGIAS (RF05) ===== *@
    @if (_showTipologias && _tipAsign is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showTipologias = false)">
            <div class="modal-dialog" style="max-width:820px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Tipos documentales &middot; <span class="mono">@_tipAsign.CodigoCcd</span></h3>
                    <button class="modal-close" @onclick="@(() => _showTipologias = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Tipos de documento que conforman esta serie en esta dependencia (RF05). Cada uno con su soporte, formato y metadatos de documento.</p>

                    @if (_tipAsign.Tipologias.Count > 0)
                    {
                        <div class="tx-ent-table-wrap">
                            <table class="tx-ent-table">
                                <thead><tr><th>Nombre</th><th>Soporte</th><th>Formato</th><th>Obligatorio</th><th>Meta. doc.</th><th>Estado</th><th class="right">Acciones</th></tr></thead>
                                <tbody>
                                    @foreach (var t in _tipAsign.Tipologias)
                                    {
                                        <tr class="@(t.IsArchived ? "archivada" : "")">
                                            <td>@t.Nombre</td>
                                            <td>@SoporteLabel(t.Soporte)</td>
                                            <td>@(string.IsNullOrWhiteSpace(t.Formato) ? "--" : t.Formato)</td>
                                            <td>@(t.ObligatorioEnExpediente ? "Sí" : "No")</td>
                                            <td><button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenMetadatosDoc(t))">@t.Metadatos.Count(m => !m.IsArchived) campo(s)</button></td>
                                            <td><span class="tx-ent-badge sm @(t.IsArchived ? "off" : "ok")">@(t.IsArchived ? "Inactivo" : "Activo")</span></td>
                                            <td class="right">
                                                @if (_canEditProcMeta && !t.IsArchived)
                                                {
                                                    <button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenTipEditor(t))" disabled="@_busy">Editar</button>
                                                }
                                                @if (_canEliminar)
                                                {
                                                    @if (t.IsArchived)
                                                    {
                                                        <button type="button" class="tx-ent-btn sm" @onclick="@(() => SetTipArchived(t, false))" disabled="@_busy">Reactivar</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="tx-ent-btn sm danger" @onclick="@(() => SetTipArchived(t, true))" disabled="@_busy">Inactivar</button>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="tx-ent-hint">Sin tipos documentales todavía.</div>
                    }

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingTip is null ? "Nuevo tipo documental" : "Editar tipo documental")</strong>
                            <div class="tx-ent-grid c2" style="margin-top:8px">
                                <div class="tx-ent-field">
                                    <label>Nombre <span class="req">*</span></label>
                                    <input class="tx-ent-input" @bind="_fTipNombre" maxlength="200" placeholder="Ej: Acta de Reunión, Contrato" />
                                </div>
                                <div class="tx-ent-field">
                                    <label>Soporte <span class="req">*</span></label>
                                    <select class="tx-ent-input" @bind="_fTipSoporte">
                                        <option value="@SoporteTipologia.Electronico">Electrónico</option>
                                        <option value="@SoporteTipologia.Fisico">Físico</option>
                                        <option value="@SoporteTipologia.Hibrido">Híbrido</option>
                                    </select>
                                </div>
                            </div>
                            <div class="tx-ent-grid c2">
                                <div class="tx-ent-field">
                                    <label>Formato <span class="opt">(opcional)</span></label>
                                    <input class="tx-ent-input" @bind="_fTipFormato" maxlength="100" placeholder="PDF, XML, DOCX, Papel..." />
                                </div>
                                <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="checkbox" @bind="_fTipObligatorio" /> Obligatorio en el expediente
                                </label>
                            </div>
                            @if (_tipError is not null)
                            {
                                <div class="tx-ent-fielderr">@_tipError</div>
                            }
                            <div style="margin-top:8px;display:flex;gap:8px">
                                <button class="tx-ent-btn primary sm" @onclick="SaveTipologia" disabled="@_busy">@(_editingTip is null ? "Agregar" : "Guardar")</button>
                                @if (_editingTip is not null)
                                {
                                    <button class="tx-ent-btn sm" @onclick="ResetTipEditor" disabled="@_busy">Cancelar edición</button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showTipologias = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal metadatos del DOCUMENTO (RF05) ===== *@
    @if (_showMetaDoc && _docTip is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showMetaDoc = false)">
            <div class="modal-dialog" style="max-width:720px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Metadatos del Documento &middot; <span class="mono">@_docTip.Nombre</span></h3>
                    <button class="modal-close" @onclick="@(() => _showMetaDoc = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Se diligencian al cargar cada documento de este tipo al expediente (RF05).</p>
                    @MetadatosTabla(_docTip.Metadatos, OpenMetaEditor, SetMetaArchived)

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingMeta is null ? "Nuevo metadato del documento" : "Editar metadato")</strong>
                            @MetadatoForm(true)
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showMetaDoc = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string ModuleKey = "modulo/trd";

    [SupplyParameterFromQuery(Name = "version")] public long? VersionId { get; set; }

    private bool _busy;
    private string _search = "";
    private EstadoTrdDependencia? _estadoFilter;
    private string? _pageError;
    private string? _pageOk;

    private bool _permView, _permCreate, _permEdit, _permDelete;
    private bool _canAgregar, _canEditEstructura, _canEditProcMeta, _canEliminar;

    private TrdVersionCabeceraDto? _version;
    private IReadOnlyList<DependenciaTrdResumenDto> _dependencias = [];

    // Workspace
    private DependenciaTrdResumenDto? _workspaceDep;
    private IReadOnlyList<TrdAsignacionDto> _asignaciones = [];
    private readonly HashSet<long> _expanded = [];   // series/subseries expandidas por SerieId
    private string _treeSearch = "";

    private List<SerieNodeDto> _seriesActivas = [];
    private IReadOnlyList<NivelClasificacionDto> _niveles = [];
    private IReadOnlyList<ListaMaestraDto> _listas = [];

    // ---- Editor asignacion ----
    private bool _showAsignEditor;
    private TrdAsignacionDto? _editingAsign;
    private long _fSerieId;
    private int _fTiempoGestion, _fTiempoCentral;
    private DisposicionFinal _fDisposicion = DisposicionFinal.ConservacionTotal;
    private long _fNivelId;
    private bool _fReproduccion, _fDdhh;
    private string? _fProcedimiento;
    private string? _asignError;

    // ---- Metadatos (expediente y documento comparten editor) ----
    private bool _showMetadatos;              // metadatos de expediente (de una asignacion)
    private TrdAsignacionDto? _metaAsign;
    private bool _showMetaDoc;                // metadatos de documento (de una tipologia)
    private TrdTipologiaDto? _docTip;
    private TrdMetadatoDto? _editingMeta;
    private string _fMetaNombre = "";
    private TipoDatoMetadato _fMetaTipo = TipoDatoMetadato.TextoCorto;
    private bool _fMetaObligatorio;
    private long _fMetaListaId;
    private string? _metaError;

    // ---- Tipologias ----
    private bool _showTipologias;
    private TrdAsignacionDto? _tipAsign;
    private TrdTipologiaDto? _editingTip;
    private string _fTipNombre = "";
    private SoporteTipologia _fTipSoporte = SoporteTipologia.Electronico;
    private string? _fTipFormato;
    private bool _fTipObligatorio;
    private string? _tipError;

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _permView = eff.Can(ModuleKey, PermissionAction.View);
        _permCreate = eff.Can(ModuleKey, PermissionAction.Create);
        _permEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        _permDelete = eff.Can(ModuleKey, PermissionAction.Delete);

        if (VersionId is not long vid) { return; }
        _version = await Svc.GetVersionAsync(vid);
        if (_version is null) { return; }

        RecalcularPermisos();

        _niveles = await NivelesSvc.ListAsync(soloActivos: true);
        var tree = await SeriesSvc.GetTreeAsync(includeInactivas: false);
        _seriesActivas = [];
        Collect(tree);
        _listas = (await ListasSvc.ListAsync(includeInactivas: false))
            .Where(l => !l.EsInactiva).ToList();

        await LoadDependenciasAsync();
    }

    private void RecalcularPermisos()
    {
        var estado = _version!.Estado;
        _canAgregar = _permCreate && estado is TrdVersionEstado.EnConstruccion or TrdVersionEstado.Vigente;
        _canEditEstructura = _permEdit && estado == TrdVersionEstado.EnConstruccion;
        _canEditProcMeta = _permEdit && estado is TrdVersionEstado.EnConstruccion or TrdVersionEstado.Vigente;
        _canEliminar = _permDelete && estado == TrdVersionEstado.EnConstruccion;
    }

    private void Collect(IReadOnlyList<SerieNodeDto> nodes)
    {
        foreach (var n in nodes) { _seriesActivas.Add(n); Collect(n.Children); }
    }

    private async Task LoadDependenciasAsync()
    {
        _dependencias = await Svc.GetDependenciasResumenAsync(_version!.Id);
    }

    private List<DependenciaTrdResumenDto> DependenciasFiltradas()
    {
        var q = _search.Trim();
        return _dependencias.Where(d =>
            (_estadoFilter is null || d.Estado == _estadoFilter)
            && (q.Length == 0
                || d.Codigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                || d.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    // ---- Workspace ----

    private async Task OpenWorkspace(DependenciaTrdResumenDto d, bool autoAdd)
    {
        _workspaceDep = d;
        _expanded.Clear();
        _treeSearch = "";
        _pageOk = null; _pageError = null;
        _asignaciones = await Svc.GetAsignacionesAsync(_version!.Id, d.DependenciaId, includeArchived: true);
        if (autoAdd && _canAgregar) { OpenAddAsignacion(); }
    }

    private async Task BackToList()
    {
        _workspaceDep = null;
        _asignaciones = [];
        _expanded.Clear();
        _treeSearch = "";
        _pageOk = null; _pageError = null;
        await LoadDependenciasAsync();
    }

    private async Task ReloadWorkspaceAsync()
    {
        if (_workspaceDep is null) { return; }
        _asignaciones = await Svc.GetAsignacionesAsync(_version!.Id, _workspaceDep.DependenciaId, includeArchived: true);
    }

    // ---- Arbol Serie / Subserie / Tipologia (rpSeries) ----

    private bool TreeSearching => _treeSearch.Trim().Length > 0;
    private bool TextMatch(string? s) => s is not null && s.Contains(_treeSearch.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool TipMatch(TrdTipologiaDto t) => TextMatch(t.Nombre) || TextMatch(t.Formato);

    private IEnumerable<TrdAsignacionDto> SubseriesRaw(TrdAsignacionDto serie)
        => _asignaciones.Where(x => x.SerieParentId == serie.SerieId);

    private bool NodeMatch(TrdAsignacionDto a) =>
        TextMatch(a.SerieNombre) || TextMatch(a.SerieCodigo) || a.Tipologias.Any(TipMatch)
        || SubseriesRaw(a).Any(sub => TextMatch(sub.SerieNombre) || TextMatch(sub.SerieCodigo) || sub.Tipologias.Any(TipMatch));

    private List<TrdAsignacionDto> SeriesTop()
    {
        var ids = _asignaciones.Select(a => a.SerieId).ToHashSet();
        var tops = _asignaciones.Where(a => a.SerieParentId is null || !ids.Contains(a.SerieParentId.Value));
        if (TreeSearching) { tops = tops.Where(NodeMatch); }
        return tops.OrderBy(a => a.SerieCodigo, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<TrdAsignacionDto> SubseriesDe(TrdAsignacionDto serie)
    {
        var subs = SubseriesRaw(serie);
        if (TreeSearching)
        {
            subs = subs.Where(sub => NodeMatch(serie) || TextMatch(sub.SerieNombre) || TextMatch(sub.SerieCodigo) || sub.Tipologias.Any(TipMatch));
        }
        return subs.OrderBy(a => a.SerieCodigo, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<TrdTipologiaDto> TipsVisibles(TrdAsignacionDto a)
    {
        IEnumerable<TrdTipologiaDto> tips = a.Tipologias;
        if (TreeSearching) { tips = tips.Where(t => TipMatch(t) || TextMatch(a.SerieNombre) || TextMatch(a.SerieCodigo)); }
        return tips.OrderBy(t => t.Nombre, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private int ContarSeries() => _asignaciones.Count(a => a.SerieParentId is null);
    private int ContarSubseries() => _asignaciones.Count(a => a.SerieParentId is not null);

    private bool Expandable(TrdAsignacionDto a) => SubseriesRaw(a).Any() || a.Tipologias.Any(t => !t.IsArchived);
    private bool IsExpanded(TrdAsignacionDto a) => TreeSearching || _expanded.Contains(a.SerieId);
    private void ToggleExpand(TrdAsignacionDto a) { if (!_expanded.Add(a.SerieId)) { _expanded.Remove(a.SerieId); } }
    private void ExpandAll() { foreach (var a in _asignaciones) { _expanded.Add(a.SerieId); } }
    private void CollapseAll() => _expanded.Clear();

    private RenderFragment SerieRow(TrdAsignacionDto a, int level) => __builder =>
    {
        var subCount = SubseriesRaw(a).Count();
        var tipCount = a.Tipologias.Count(t => !t.IsArchived);
        <tr class="@(a.IsArchived ? "archivada" : "")">
            <td>
                <span style="display:inline-flex;align-items:center;gap:6px;padding-left:@(level * 22)px">
                    @if (Expandable(a))
                    {
                        <button type="button" class="tx-ent-btn sm" style="padding:2px 7px" @onclick="@(() => ToggleExpand(a))"><i class="bi @(IsExpanded(a) ? "bi-chevron-down" : "bi-chevron-right")"></i></button>
                    }
                    else { <span style="display:inline-block;width:28px"></span> }
                    <i class="bi @(level == 0 ? "bi-folder-fill" : "bi-file-earmark-text")"></i>
                    <span>@a.SerieNombre</span>
                </span>
            </td>
            <td class="mono">@a.SerieCodigo</td>
            <td>@a.TiempoGestion años</td>
            <td>@a.TiempoCentral años</td>
            <td><span class="tx-ent-badge sm @DispClase(a.DisposicionFinal)">@DispCodigo(a.DisposicionFinal)</span></td>
            <td><span class="tx-ent-badge sm">@subCount subs &middot; @tipCount tipos</span></td>
            <td><span class="tx-ent-badge sm @(a.IsArchived ? "off" : "ok")">@(a.IsArchived ? "Inactivo" : "TRD")</span></td>
            <td class="right">
                <button type="button" title="Metadatos del expediente" class="tx-ent-btn sm" @onclick="@(() => OpenMetadatos(a))"><i class="bi bi-eye"></i></button>
                @if (_canEditEstructura && !a.IsArchived)
                {
                    <button type="button" title="Editar reglas TRD" class="tx-ent-btn sm" @onclick="@(() => OpenEditAsignacion(a))" disabled="@_busy"><i class="bi bi-pencil"></i></button>
                }
                @if (_canEditProcMeta)
                {
                    <button type="button" title="Tipos documentales" class="tx-ent-btn sm" @onclick="@(() => OpenTipologias(a))"><i class="bi bi-plus-lg"></i></button>
                }
                @if (_canEliminar)
                {
                    @if (a.IsArchived)
                    {
                        <button type="button" title="Reactivar" class="tx-ent-btn sm" @onclick="@(() => SetArchived(a, false))" disabled="@_busy"><i class="bi bi-arrow-counterclockwise"></i></button>
                    }
                    else
                    {
                        <button type="button" title="Quitar de la TRD" class="tx-ent-btn sm danger" @onclick="@(() => SetArchived(a, true))" disabled="@_busy"><i class="bi bi-trash"></i></button>
                    }
                }
            </td>
        </tr>
    };

    private RenderFragment TipologiaRow(TrdAsignacionDto parent, TrdTipologiaDto t) => __builder =>
    {
        var level = parent.SerieParentId is null ? 1 : 2;
        <tr class="@(t.IsArchived ? "archivada" : "")">
            <td>
                <span style="display:inline-flex;align-items:center;gap:6px;padding-left:@(level * 22)px">
                    <span style="display:inline-block;width:28px"></span>
                    <i class="bi bi-file-text"></i>
                    <span>@t.Nombre</span>
                </span>
            </td>
            <td class="mono">&mdash;</td>
            <td class="tx-ent-hint">&mdash; heredado &mdash;</td>
            <td class="tx-ent-hint">&mdash; heredado &mdash;</td>
            <td class="tx-ent-hint">&mdash;</td>
            <td>
                <span class="tx-ent-badge sm">@SoporteLabel(t.Soporte)</span>
                @if (!string.IsNullOrWhiteSpace(t.Formato))
                {
                    <span class="tx-ent-badge sm">@t.Formato</span>
                }
            </td>
            <td><span class="tx-ent-badge sm @(t.IsArchived ? "off" : "ok")">@(t.IsArchived ? "Inactivo" : "Activo")</span></td>
            <td class="right">
                <button type="button" title="Metadatos del documento" class="tx-ent-btn sm" @onclick="@(() => OpenMetadatosDoc(t))"><i class="bi bi-eye"></i></button>
                @if (_canEditProcMeta)
                {
                    <button type="button" title="Editar tipo documental" class="tx-ent-btn sm" @onclick="@(() => OpenTipologias(parent))"><i class="bi bi-pencil"></i></button>
                }
            </td>
        </tr>
    };

    // ---- Asignacion ----

    private void OpenAddAsignacion()
    {
        _editingAsign = null;
        _fSerieId = 0; _fTiempoGestion = 0; _fTiempoCentral = 0;
        _fDisposicion = DisposicionFinal.ConservacionTotal;
        _fNivelId = _niveles.FirstOrDefault(n => n.Codigo == "02")?.Id ?? _niveles.FirstOrDefault()?.Id ?? 0;
        _fReproduccion = false; _fDdhh = false; _fProcedimiento = null;
        _asignError = null; _pageOk = null; _pageError = null;
        _showAsignEditor = true;
    }

    private void OpenEditAsignacion(TrdAsignacionDto a)
    {
        _editingAsign = a;
        _fTiempoGestion = a.TiempoGestion; _fTiempoCentral = a.TiempoCentral;
        _fDisposicion = a.DisposicionFinal; _fNivelId = a.NivelClasificacionId;
        _fReproduccion = a.ReproduccionTecnica; _fDdhh = a.SerieDdhhDih; _fProcedimiento = a.Procedimiento;
        _asignError = null; _pageOk = null; _pageError = null;
        _showAsignEditor = true;
    }

    private async Task SaveAsignacion()
    {
        _busy = true; _asignError = null;
        try
        {
            var actor = Tenant.UserId ?? 0;
            TrdResult<TrdAsignacionDto> result;
            if (_editingAsign is null)
            {
                if (_fSerieId <= 0) { _asignError = "Selecciona una serie."; return; }
                result = await Svc.AddAsignacionAsync(_version!.Id, new AddAsignacionRequest(
                    _workspaceDep!.DependenciaId, _fSerieId, _fTiempoGestion, _fTiempoCentral, _fDisposicion,
                    _fNivelId, _fReproduccion, _fDdhh, _fProcedimiento), actor);
            }
            else
            {
                result = await Svc.UpdateAsignacionAsync(_editingAsign.Id, new UpdateAsignacionRequest(
                    _fTiempoGestion, _fTiempoCentral, _fDisposicion, _fNivelId, _fReproduccion, _fDdhh, _fProcedimiento), actor);
            }
            if (!result.IsOk) { _asignError = result.Error; return; }
            _showAsignEditor = false;
            _pageOk = _editingAsign is null ? "Serie asignada a la TRD." : "Asignación actualizada.";
            await ReloadWorkspaceAsync();
        }
        finally { _busy = false; }
    }

    private async Task SetArchived(TrdAsignacionDto a, bool archived)
    {
        _busy = true; _pageError = null; _pageOk = null;
        try
        {
            var result = await Svc.SetAsignacionArchivedAsync(a.Id, archived, Tenant.UserId ?? 0,
                motivo: archived ? "Inactivacion de asignacion TRD (RF04)" : "Reactivacion (RF04)");
            if (!result.IsOk) { _pageError = result.Error; return; }
            _pageOk = archived ? "Asignación inactivada." : "Asignación reactivada.";
            await ReloadWorkspaceAsync();
        }
        finally { _busy = false; }
    }

    // ---- Metadatos (expediente) ----

    private void OpenMetadatos(TrdAsignacionDto a)
    {
        _metaAsign = a;
        ResetMetaEditor();
        _showMetadatos = true;
    }

    // ---- Metadatos (documento) ----

    private void OpenMetadatosDoc(TrdTipologiaDto t)
    {
        _docTip = t;
        ResetMetaEditor();
        _showMetaDoc = true;
    }

    private void OpenMetaEditor(TrdMetadatoDto m)
    {
        _editingMeta = m;
        _fMetaNombre = m.Nombre; _fMetaTipo = m.TipoDato; _fMetaObligatorio = m.Obligatorio;
        _fMetaListaId = m.ListaMaestraId ?? 0; _metaError = null;
    }

    private void ResetMetaEditor()
    {
        _editingMeta = null;
        _fMetaNombre = ""; _fMetaTipo = TipoDatoMetadato.TextoCorto; _fMetaObligatorio = false; _fMetaListaId = 0;
        _metaError = null;
    }

    private async Task SaveMetadato(bool documento)
    {
        _busy = true; _metaError = null;
        try
        {
            long? listaId = _fMetaTipo == TipoDatoMetadato.Lista ? (_fMetaListaId > 0 ? _fMetaListaId : null) : null;
            var request = new SaveMetadatoRequest(_fMetaNombre, _fMetaTipo, _fMetaObligatorio, listaId);
            var actor = Tenant.UserId ?? 0;
            TrdResult<TrdMetadatoDto> result;
            if (_editingMeta is not null)
            {
                result = await Svc.UpdateMetadatoAsync(_editingMeta.Id, request, actor);
            }
            else if (documento)
            {
                result = await Svc.AddMetadatoDocumentoAsync(_docTip!.Id, request, actor);
            }
            else
            {
                result = await Svc.AddMetadatoAsync(_metaAsign!.Id, request, actor);
            }
            if (!result.IsOk) { _metaError = result.Error; return; }
            await ReloadWorkspaceAsync();
            RefreshOpenMetaContext();
            ResetMetaEditor();
        }
        finally { _busy = false; }
    }

    private async Task SetMetaArchived(TrdMetadatoDto m, bool archived)
    {
        _busy = true; _metaError = null;
        try
        {
            var result = await Svc.SetMetadatoArchivedAsync(m.Id, archived, Tenant.UserId ?? 0);
            if (!result.IsOk) { _metaError = result.Error; return; }
            await ReloadWorkspaceAsync();
            RefreshOpenMetaContext();
        }
        finally { _busy = false; }
    }

    /// <summary>Reengancha los objetos abiertos (asignacion/tipologia) a la lista recargada.</summary>
    private void RefreshOpenMetaContext()
    {
        if (_metaAsign is not null)
        {
            _metaAsign = _asignaciones.FirstOrDefault(x => x.Id == _metaAsign.Id) ?? _metaAsign;
        }
        if (_tipAsign is not null)
        {
            _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign;
        }
        if (_docTip is not null)
        {
            _docTip = _asignaciones.SelectMany(a => a.Tipologias).FirstOrDefault(t => t.Id == _docTip.Id) ?? _docTip;
        }
    }

    // ---- Tipologias ----

    private void OpenTipologias(TrdAsignacionDto a)
    {
        _tipAsign = a;
        ResetTipEditor();
        _showTipologias = true;
    }

    private void OpenTipEditor(TrdTipologiaDto t)
    {
        _editingTip = t;
        _fTipNombre = t.Nombre; _fTipSoporte = t.Soporte; _fTipFormato = t.Formato; _fTipObligatorio = t.ObligatorioEnExpediente;
        _tipError = null;
    }

    private void ResetTipEditor()
    {
        _editingTip = null;
        _fTipNombre = ""; _fTipSoporte = SoporteTipologia.Electronico; _fTipFormato = null; _fTipObligatorio = false;
        _tipError = null;
    }

    private async Task SaveTipologia()
    {
        if (_tipAsign is null) { return; }
        _busy = true; _tipError = null;
        try
        {
            var request = new SaveTipologiaRequest(_fTipNombre, _fTipSoporte, _fTipFormato, _fTipObligatorio);
            var actor = Tenant.UserId ?? 0;
            var result = _editingTip is null
                ? await Svc.AddTipologiaAsync(_tipAsign.Id, request, actor)
                : await Svc.UpdateTipologiaAsync(_editingTip.Id, request, actor);
            if (!result.IsOk) { _tipError = result.Error; return; }
            await ReloadWorkspaceAsync();
            _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign;
            ResetTipEditor();
        }
        finally { _busy = false; }
    }

    private async Task SetTipArchived(TrdTipologiaDto t, bool archived)
    {
        _busy = true; _tipError = null;
        try
        {
            var result = await Svc.SetTipologiaArchivedAsync(t.Id, archived, Tenant.UserId ?? 0,
                motivo: archived ? "Inactivacion de tipologia (RF05)" : "Reactivacion (RF05)");
            if (!result.IsOk) { _tipError = result.Error; return; }
            await ReloadWorkspaceAsync();
            if (_tipAsign is not null) { _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign; }
        }
        finally { _busy = false; }
    }

    // ---- Fragmentos reutilizables ----

    private RenderFragment MetadatosTabla(IReadOnlyList<TrdMetadatoDto> metas, Action<TrdMetadatoDto> onEdit, Func<TrdMetadatoDto, bool, Task> onArchive) => __builder =>
    {
        if (metas.Count > 0)
        {
            <div class="tx-ent-table-wrap">
                <table class="tx-ent-table">
                    <thead><tr><th>Nombre</th><th>Tipo</th><th>Obligatorio</th><th>Lista</th><th>Estado</th><th class="right">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var m in metas)
                        {
                            <tr class="@(m.IsArchived ? "archivada" : "")">
                                <td>@m.Nombre</td>
                                <td>@TipoLabel(m.TipoDato)</td>
                                <td>@(m.Obligatorio ? "Sí" : "No")</td>
                                <td>@(m.ListaNombre ?? "--")</td>
                                <td><span class="tx-ent-badge sm @(m.IsArchived ? "off" : "ok")">@(m.IsArchived ? "Inactivo" : "Activo")</span></td>
                                <td class="right">
                                    @if (_canEditProcMeta)
                                    {
                                        <button type="button" class="tx-ent-btn sm" @onclick="@(() => onEdit(m))" disabled="@_busy">Editar</button>
                                        @if (m.IsArchived)
                                        {
                                            <button type="button" class="tx-ent-btn sm" @onclick="@(() => onArchive(m, false))" disabled="@_busy">Reactivar</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="tx-ent-btn sm danger" @onclick="@(() => onArchive(m, true))" disabled="@_busy">Inactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="tx-ent-hint">Sin metadatos todavía.</div>
        }
    };

    private RenderFragment MetadatoForm(bool documento) => __builder =>
    {
        <div class="tx-ent-grid c2" style="margin-top:8px">
            <div class="tx-ent-field">
                <label>Nombre <span class="req">*</span></label>
                <input class="tx-ent-input" @bind="_fMetaNombre" maxlength="200" />
            </div>
            <div class="tx-ent-field">
                <label>Tipo de dato <span class="req">*</span></label>
                <select class="tx-ent-input" @bind="_fMetaTipo">
                    @foreach (var t in Enum.GetValues<TipoDatoMetadato>())
                    {
                        <option value="@t">@TipoLabel(t)</option>
                    }
                </select>
            </div>
        </div>
        <div class="tx-ent-grid c2">
            @if (_fMetaTipo == TipoDatoMetadato.Lista)
            {
                <div class="tx-ent-field">
                    <label>Lista <span class="req">*</span></label>
                    <select class="tx-ent-input" @bind="_fMetaListaId">
                        <option value="0">— Selecciona —</option>
                        @foreach (var l in _listas)
                        {
                            <option value="@l.Id">@l.NombreLista</option>
                        }
                    </select>
                </div>
            }
            <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                <input type="checkbox" @bind="_fMetaObligatorio" /> Obligatorio
            </label>
        </div>
        @if (_metaError is not null)
        {
            <div class="tx-ent-fielderr">@_metaError</div>
        }
        <div style="margin-top:8px;display:flex;gap:8px">
            <button class="tx-ent-btn primary sm" @onclick="@(() => SaveMetadato(documento))" disabled="@_busy">@(_editingMeta is null ? "Agregar" : "Guardar")</button>
            @if (_editingMeta is not null)
            {
                <button class="tx-ent-btn sm" @onclick="ResetMetaEditor" disabled="@_busy">Cancelar edición</button>
            }
        </div>
    };

    // ---- Labels ----

    private static string EstadoLabel(TrdVersionEstado e) => e switch
    {
        TrdVersionEstado.EnConstruccion => "En construcción",
        TrdVersionEstado.Vigente => "Vigente",
        TrdVersionEstado.Historico => "Histórico",
        TrdVersionEstado.Inactivo => "Inactivo",
        _ => e.ToString()
    };
    private static string EstadoClase(TrdVersionEstado e) => e switch
    {
        TrdVersionEstado.EnConstruccion => "violet",
        TrdVersionEstado.Vigente => "ok",
        _ => "off"
    };
    private static string EstadoDepLabel(EstadoTrdDependencia e) => e switch
    {
        EstadoTrdDependencia.SinTrd => "Sin TRD",
        EstadoTrdDependencia.EnConstruccion => "En construcción",
        EstadoTrdDependencia.Activa => "Activa",
        EstadoTrdDependencia.Historica => "Histórica",
        EstadoTrdDependencia.Inactiva => "Inactiva",
        _ => e.ToString()
    };
    private static string EstadoDepClase(EstadoTrdDependencia e) => e switch
    {
        EstadoTrdDependencia.EnConstruccion => "violet",
        EstadoTrdDependencia.Activa => "ok",
        _ => "off"
    };
    private static string DispCodigo(DisposicionFinal d) => d switch
    {
        DisposicionFinal.ConservacionTotal => "CT",
        DisposicionFinal.Seleccion => "S",
        DisposicionFinal.Eliminacion => "E",
        _ => "?"
    };
    private static string DispClase(DisposicionFinal d) => d switch
    {
        DisposicionFinal.ConservacionTotal => "ok",
        DisposicionFinal.Seleccion => "violet",
        DisposicionFinal.Eliminacion => "off",
        _ => ""
    };
    private static string TipoLabel(TipoDatoMetadato t) => t switch
    {
        TipoDatoMetadato.TextoCorto => "Texto corto",
        TipoDatoMetadato.TextoLargo => "Texto largo",
        TipoDatoMetadato.Numerico => "Numérico",
        TipoDatoMetadato.Fecha => "Fecha",
        TipoDatoMetadato.Lista => "Lista",
        TipoDatoMetadato.Booleano => "Booleano",

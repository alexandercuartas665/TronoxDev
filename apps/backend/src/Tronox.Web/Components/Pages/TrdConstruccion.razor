    private bool _showWizard;
    private string _wzMode = "SERIE";   // SERIE | SUBSERIE
    private int _wzStep = 1;
    private TrdAsignacionDto? _wzParent;
    private string? _wzError;
    private bool _wzBusy;
    // Paso 1
    private long _wzSerieCatId;
    private string _wzCodigo = ""; private string _wzNombre = ""; private string? _wzDescripcion;
    // Paso 2
    private int _wzTG, _wzTC;
    private DisposicionFinal _wzDisp = DisposicionFinal.ConservacionTotal;
    private long _wzNivelId; private bool _wzDdhh, _wzRepro; private string? _wzProc;
    // Paso 3 (metadatos de expediente)
    private readonly List<WizMeta> _wzMetas = [];
    private bool _wzMetaForm; private string _wzMetaNombre = ""; private TipoDatoMetadato _wzMetaTipo = TipoDatoMetadato.TextoCorto; private bool _wzMetaOblig; private long _wzMetaListaId;
    // Paso 4 (tipologias)
    private readonly List<WizTip> _wzTips = [];
    private bool _wzTipForm; private string _wzTipNombre = ""; private SoporteTipologia _wzTipSop = SoporteTipologia.Electronico; private string? _wzTipFmt; private bool _wzTipOblig;
    private readonly List<WizMeta> _wzTipMetas = [];
    private bool _wzTipMetaForm; private string _wzTipMetaNombre = ""; private TipoDatoMetadato _wzTipMetaTipo = TipoDatoMetadato.TextoCorto; private bool _wzTipMetaOblig; private long _wzTipMetaListaId;

    private sealed record WizMeta(string Nombre, TipoDatoMetadato Tipo, bool Obligatorio, long? ListaId);
    private sealed class WizTip { public string Nombre = ""; public SoporteTipologia Soporte; public string? Formato; public bool Obligatorio; public List<WizMeta> Metas = []; }

    private static readonly string[] _wzPasos = ["Datos básicos", "Caracterización", "Metadatos", "Tipologías"];

    private List<SerieNodeDto> WizSeriesCatalogo()
    {
        var asignados = _asignaciones.Select(a => a.SerieId).ToHashSet();
        return _seriesActivas.Where(s => s.ParentId is null && !asignados.Contains(s.Id)).ToList();
    }

    private void OpenWizard(string mode, TrdAsignacionDto? parent)
    {
        _wzMode = mode; _wzParent = parent; _wzStep = 1; _wzError = null;
        _wzSerieCatId = 0; _wzCodigo = ""; _wzNombre = ""; _wzDescripcion = null;
        _wzTG = 0; _wzTC = 0; _wzDisp = DisposicionFinal.ConservacionTotal;
        _wzNivelId = _niveles.FirstOrDefault(n => n.Codigo == "02")?.Id ?? _niveles.FirstOrDefault()?.Id ?? 0;
        _wzDdhh = false; _wzRepro = false; _wzProc = null;
        _wzMetas.Clear(); _wzMetaForm = false; ResetWzMetaForm();
        _wzTips.Clear(); _wzTipForm = false; ResetWzTipForm();
        _pageOk = null; _pageError = null;
        _showWizard = true;
    }

    private void WizSerieChanged(ChangeEventArgs e)
    {
        _wzSerieCatId = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        var n = _seriesActivas.FirstOrDefault(s => s.Id == _wzSerieCatId);
        if (n is not null) { _wzCodigo = n.Codigo; _wzNombre = n.Nombre; }
    }

    private string? WizValidateStep(int step)
    {
        if (step == 1)
        {
            if (_wzMode == "SERIE") { if (_wzSerieCatId <= 0) { return "Selecciona una serie del catálogo."; } }
            else { if (string.IsNullOrWhiteSpace(_wzCodigo)) { return "El código es obligatorio."; } if (string.IsNullOrWhiteSpace(_wzNombre)) { return "El nombre es obligatorio."; } }
        }
        else if (step == 2)
        {
            if (_wzTG < 0 || _wzTC < 0) { return "Los tiempos no pueden ser negativos."; }
        }
        return null;
    }

    private void WizNext()
    {
        var err = WizValidateStep(_wzStep);
        if (err is not null) { _wzError = err; return; }
        _wzError = null; if (_wzStep < 4) { _wzStep++; }
    }
    private void WizBack() { _wzError = null; if (_wzStep > 1) { _wzStep--; } }

    private void ResetWzMetaForm() { _wzMetaNombre = ""; _wzMetaTipo = TipoDatoMetadato.TextoCorto; _wzMetaOblig = false; _wzMetaListaId = 0; }
    private void WzAddMeta()
    {
        if (string.IsNullOrWhiteSpace(_wzMetaNombre)) { _wzError = "El nombre del metadato es obligatorio."; return; }
        long? lista = _wzMetaTipo == TipoDatoMetadato.Lista ? (_wzMetaListaId > 0 ? _wzMetaListaId : null) : null;
        _wzMetas.Add(new WizMeta(_wzMetaNombre.Trim(), _wzMetaTipo, _wzMetaOblig, lista));
        ResetWzMetaForm(); _wzMetaForm = false; _wzError = null;
    }

    private void ResetWzTipForm() { _wzTipNombre = ""; _wzTipSop = SoporteTipologia.Electronico; _wzTipFmt = null; _wzTipOblig = false; _wzTipMetas.Clear(); _wzTipMetaForm = false; ResetWzTipMetaForm(); }
    private void ResetWzTipMetaForm() { _wzTipMetaNombre = ""; _wzTipMetaTipo = TipoDatoMetadato.TextoCorto; _wzTipMetaOblig = false; _wzTipMetaListaId = 0; }
    private void WzAddTipMeta()
    {
        if (string.IsNullOrWhiteSpace(_wzTipMetaNombre)) { _wzError = "El nombre del metadato es obligatorio."; return; }
        long? lista = _wzTipMetaTipo == TipoDatoMetadato.Lista ? (_wzTipMetaListaId > 0 ? _wzTipMetaListaId : null) : null;
        _wzTipMetas.Add(new WizMeta(_wzTipMetaNombre.Trim(), _wzTipMetaTipo, _wzTipMetaOblig, lista));
        ResetWzTipMetaForm(); _wzTipMetaForm = false; _wzError = null;
    }
    private void WzAddTip()
    {
        if (string.IsNullOrWhiteSpace(_wzTipNombre)) { _wzError = "El nombre de la tipología es obligatorio."; return; }
        _wzTips.Add(new WizTip { Nombre = _wzTipNombre.Trim(), Soporte = _wzTipSop, Formato = string.IsNullOrWhiteSpace(_wzTipFmt) ? null : _wzTipFmt!.Trim(), Obligatorio = _wzTipOblig, Metas = [.. _wzTipMetas] });
        ResetWzTipForm(); _wzTipForm = false; _wzError = null;
    }

    private async Task WizardCrear()
    {
        var errAll = WizValidateStep(1) ?? WizValidateStep(2);
        if (errAll is not null) { _wzError = errAll; _wzStep = string.IsNullOrEmpty(WizValidateStep(1)) ? 2 : 1; return; }
        _wzBusy = true; _wzError = null;
        try
        {
            var actor = Tenant.UserId ?? 0;
            long serieId;
            if (_wzMode == "SUBSERIE")
            {
                var cr = await SeriesSvc.CreateAsync(new SaveSerieRequest(_wzCodigo.Trim(), _wzNombre.Trim(), _wzDescripcion, _wzParent!.SerieId), actor);
                if (!cr.IsOk) { _wzError = cr.Error; return; }
                serieId = cr.Value!.Id;
            }
            else { serieId = _wzSerieCatId; }

            var ar = await Svc.AddAsignacionAsync(_version!.Id, new AddAsignacionRequest(
                _workspaceDep!.DependenciaId, serieId, _wzTG, _wzTC, _wzDisp, _wzNivelId, _wzRepro, _wzDdhh, _wzProc), actor);
            if (!ar.IsOk) { _wzError = ar.Error; return; }
            var asigId = ar.Value!.Id;

            foreach (var m in _wzMetas) { await Svc.AddMetadatoAsync(asigId, new SaveMetadatoRequest(m.Nombre, m.Tipo, m.Obligatorio, m.ListaId), actor); }
            foreach (var t in _wzTips)
            {
                var tr = await Svc.AddTipologiaAsync(asigId, new SaveTipologiaRequest(t.Nombre, t.Soporte, t.Formato, t.Obligatorio), actor);
                if (tr.IsOk) { foreach (var dm in t.Metas) { await Svc.AddMetadatoDocumentoAsync(tr.Value!.Id, new SaveMetadatoRequest(dm.Nombre, dm.Tipo, dm.Obligatorio, dm.ListaId), actor); } }
            }
            _showWizard = false;
            _pageOk = _wzMode == "SUBSERIE" ? "Subserie agregada a la TRD." : "Serie agregada a la TRD.";
            if (_wzParent is not null) { _expanded.Add(_wzParent.SerieId); }
            await ReloadWorkspaceAsync();
        }
        finally { _wzBusy = false; }
    }

    // ==================== WIZARD Tipologia (legacy pnlModalTipologia, 2 pasos) ====================
    private bool _showTipWizard;
    private int _twStep = 1;
    private TrdAsignacionDto? _twParent;
    private TrdTipologiaDto? _twEditing;
    private string? _twError; private bool _twBusy;
    private string _twNombre = ""; private SoporteTipologia _twSop = SoporteTipologia.Electronico; private string? _twFmt; private bool _twOblig;
    private readonly List<WizMeta> _twMetas = [];
    private bool _twMetaForm; private string _twMetaNombre = ""; private TipoDatoMetadato _twMetaTipo = TipoDatoMetadato.TextoCorto; private bool _twMetaOblig; private long _twMetaListaId;

    private void OpenTipWizard(TrdAsignacionDto parent, TrdTipologiaDto? editing)
    {
        _twParent = parent; _twEditing = editing; _twStep = 1; _twError = null;
        _twNombre = editing?.Nombre ?? ""; _twSop = editing?.Soporte ?? SoporteTipologia.Electronico;
        _twFmt = editing?.Formato; _twOblig = editing?.ObligatorioEnExpediente ?? false;
        _twMetas.Clear();
        _twMetaForm = false; ResetTwMetaForm();
        _pageOk = null; _pageError = null;
        _showTipWizard = true;
    }
    private void ResetTwMetaForm() { _twMetaNombre = ""; _twMetaTipo = TipoDatoMetadato.TextoCorto; _twMetaOblig = false; _twMetaListaId = 0; }
    private void TwAddMeta()
    {
        if (string.IsNullOrWhiteSpace(_twMetaNombre)) { _twError = "El nombre del metadato es obligatorio."; return; }
        long? lista = _twMetaTipo == TipoDatoMetadato.Lista ? (_twMetaListaId > 0 ? _twMetaListaId : null) : null;
        _twMetas.Add(new WizMeta(_twMetaNombre.Trim(), _twMetaTipo, _twMetaOblig, lista));
        ResetTwMetaForm(); _twMetaForm = false; _twError = null;
    }
    private void TwNext() { if (string.IsNullOrWhiteSpace(_twNombre)) { _twError = "El nombre de la tipología es obligatorio."; return; } _twError = null; _twStep = 2; }
    private void TwBack() { _twError = null; _twStep = 1; }
    private async Task TwCrear()
    {
        if (string.IsNullOrWhiteSpace(_twNombre)) { _twError = "El nombre es obligatorio."; _twStep = 1; return; }
        _twBusy = true; _twError = null;
        try
        {
            var actor = Tenant.UserId ?? 0;
            if (_twEditing is not null)
            {
                var ur = await Svc.UpdateTipologiaAsync(_twEditing.Id, new SaveTipologiaRequest(_twNombre.Trim(), _twSop, _twFmt, _twOblig), actor);
                if (!ur.IsOk) { _twError = ur.Error; return; }
            }
            else
            {
                var cr = await Svc.AddTipologiaAsync(_twParent!.Id, new SaveTipologiaRequest(_twNombre.Trim(), _twSop, _twFmt, _twOblig), actor);
                if (!cr.IsOk) { _twError = cr.Error; return; }
                foreach (var m in _twMetas) { await Svc.AddMetadatoDocumentoAsync(cr.Value!.Id, new SaveMetadatoRequest(m.Nombre, m.Tipo, m.Obligatorio, m.ListaId), actor); }
            }
            _showTipWizard = false;
            _pageOk = _twEditing is null ? "Tipología agregada." : "Tipología actualizada.";
            if (_twParent is not null) { _expanded.Add(_twParent.SerieId); }
            await ReloadWorkspaceAsync();
        }
        finally { _twBusy = false; }
    }


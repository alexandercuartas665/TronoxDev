    // ---- Asignacion ----

    private void OpenAddAsignacion()
    {
        _editingAsign = null;
        _addScopeParentSerieId = null; _addScopeParentNombre = null;
        _fSerieId = 0; _fTiempoGestion = 0; _fTiempoCentral = 0;
        _fDisposicion = DisposicionFinal.ConservacionTotal;
        _fNivelId = _niveles.FirstOrDefault(n => n.Codigo == "02")?.Id ?? _niveles.FirstOrDefault()?.Id ?? 0;
        _fReproduccion = false; _fDdhh = false; _fProcedimiento = null;
        _asignError = null; _pageOk = null; _pageError = null;
        _showAsignEditor = true;
    }

    private void OpenEditAsignacion(TrdAsignacionDto a)
    {
        _editingAsign = a;
        _fTiempoGestion = a.TiempoGestion; _fTiempoCentral = a.TiempoCentral;
        _fDisposicion = a.DisposicionFinal; _fNivelId = a.NivelClasificacionId;
        _fReproduccion = a.ReproduccionTecnica; _fDdhh = a.SerieDdhhDih; _fProcedimiento = a.Procedimiento;
        _asignError = null; _pageOk = null; _pageError = null;
        _showAsignEditor = true;
    }

    private async Task SaveAsignacion()
    {
        _busy = true; _asignError = null;
        try
        {
            var actor = Tenant.UserId ?? 0;
            TrdResult<TrdAsignacionDto> result;
            if (_editingAsign is null)
            {
                if (_fSerieId <= 0) { _asignError = "Selecciona una serie."; return; }
                result = await Svc.AddAsignacionAsync(_version!.Id, new AddAsignacionRequest(
                    _workspaceDep!.DependenciaId, _fSerieId, _fTiempoGestion, _fTiempoCentral, _fDisposicion,
                    _fNivelId, _fReproduccion, _fDdhh, _fProcedimiento), actor);
            }
            else
            {
                result = await Svc.UpdateAsignacionAsync(_editingAsign.Id, new UpdateAsignacionRequest(
                    _fTiempoGestion, _fTiempoCentral, _fDisposicion, _fNivelId, _fReproduccion, _fDdhh, _fProcedimiento), actor);
            }
            if (!result.IsOk) { _asignError = result.Error; return; }
            _showAsignEditor = false;
            _pageOk = _editingAsign is null ? "Serie asignada a la TRD." : "Asignación actualizada.";
            await ReloadWorkspaceAsync();
        }
        finally { _busy = false; }
    }

    private async Task SetArchived(TrdAsignacionDto a, bool archived)
    {
        _busy = true; _pageError = null; _pageOk = null;
        try
        {
            var result = await Svc.SetAsignacionArchivedAsync(a.Id, archived, Tenant.UserId ?? 0,
                motivo: archived ? "Inactivacion de asignacion TRD (RF04)" : "Reactivacion (RF04)");
            if (!result.IsOk) { _pageError = result.Error; return; }
            _pageOk = archived ? "Asignación inactivada." : "Asignación reactivada.";
            await ReloadWorkspaceAsync();
        }
        finally { _busy = false; }
    }


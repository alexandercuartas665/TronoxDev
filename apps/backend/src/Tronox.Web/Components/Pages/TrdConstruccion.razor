    };
    private static string SoporteLabel(SoporteTipologia s) => s switch
    {
        SoporteTipologia.Fisico => "Físico",
        SoporteTipologia.Electronico => "Electrónico",
        SoporteTipologia.Hibrido => "Híbrido",
        _ => s.ToString()
    };
}

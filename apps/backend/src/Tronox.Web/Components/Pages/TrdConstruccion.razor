    // ---- Arbol Serie / Subserie / Tipologia (rpSeries) ----

    private bool TreeSearching => _treeSearch.Trim().Length > 0;
    private bool TextMatch(string? s) => s is not null && s.Contains(_treeSearch.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool TipMatch(TrdTipologiaDto t) => TextMatch(t.Nombre) || TextMatch(t.Formato);

    private IEnumerable<TrdAsignacionDto> SubseriesRaw(TrdAsignacionDto serie)
        => _asignaciones.Where(x => x.SerieParentId == serie.SerieId);

    private bool NodeMatch(TrdAsignacionDto a) =>
        TextMatch(a.SerieNombre) || TextMatch(a.SerieCodigo) || a.Tipologias.Any(TipMatch)
        || SubseriesRaw(a).Any(sub => TextMatch(sub.SerieNombre) || TextMatch(sub.SerieCodigo) || sub.Tipologias.Any(TipMatch));

    private List<TrdAsignacionDto> SeriesTop()
    {
        var ids = _asignaciones.Select(a => a.SerieId).ToHashSet();
        var tops = _asignaciones.Where(a => a.SerieParentId is null || !ids.Contains(a.SerieParentId.Value));
        if (TreeSearching) { tops = tops.Where(NodeMatch); }
        return tops.OrderBy(a => a.SerieCodigo, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<TrdAsignacionDto> SubseriesDe(TrdAsignacionDto serie)
    {
        var subs = SubseriesRaw(serie);
        if (TreeSearching)
        {
            subs = subs.Where(sub => NodeMatch(serie) || TextMatch(sub.SerieNombre) || TextMatch(sub.SerieCodigo) || sub.Tipologias.Any(TipMatch));
        }
        return subs.OrderBy(a => a.SerieCodigo, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<TrdTipologiaDto> TipsVisibles(TrdAsignacionDto a)
    {
        IEnumerable<TrdTipologiaDto> tips = a.Tipologias;
        if (TreeSearching) { tips = tips.Where(t => TipMatch(t) || TextMatch(a.SerieNombre) || TextMatch(a.SerieCodigo)); }
        return tips.OrderBy(t => t.Nombre, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private int ContarSeries() => _asignaciones.Count(a => a.SerieParentId is null);
    private int ContarSubseries() => _asignaciones.Count(a => a.SerieParentId is not null);

    private bool Expandable(TrdAsignacionDto a) => SubseriesRaw(a).Any() || a.Tipologias.Any(t => !t.IsArchived);
    private bool Filtering => TreeSearching || _treeLevelFilter.Length > 0 || _treeEstadoFilter.Length > 0;
    private bool IsExpanded(TrdAsignacionDto a) => Filtering || _expanded.Contains(a.SerieId);
    private void ToggleExpand(TrdAsignacionDto a) { if (!_expanded.Add(a.SerieId)) { _expanded.Remove(a.SerieId); } }
    private void ExpandAll() { foreach (var a in _asignaciones) { _expanded.Add(a.SerieId); } }
    private void CollapseAll() => _expanded.Clear();

    private bool ShowNivel(string nivel) => _treeLevelFilter.Length == 0 || _treeLevelFilter == nivel;
    private bool EstadoMatchAsig(TrdAsignacionDto a) => _treeEstadoFilter switch { "activo" => !a.IsArchived, "inactivo" => a.IsArchived, _ => true };
    private bool EstadoMatchTip(TrdTipologiaDto t) => _treeEstadoFilter switch { "activo" => !t.IsArchived, "inactivo" => t.IsArchived, _ => true };

    // El + contextual (legacy TIENE_SUBSERIES): en una serie con subseries en el catalogo agrega una
    // SUBSERIE; en una serie hoja o en una subserie agrega una TIPOLOGIA.
    private IReadOnlyList<SerieNodeDto> CatalogChildren(long serieId) => _catalogById.TryGetValue(serieId, out var n) ? n.Children : [];

    private List<SerieNodeDto> SeriesParaAgregar()
    {
        if (_addScopeParentSerieId is long pid)
        {
            var asignados = _asignaciones.Select(a => a.SerieId).ToHashSet();
            return CatalogChildren(pid).Where(c => !asignados.Contains(c.Id)).ToList();
        }
        return _seriesActivas;
    }

    // El + contextual (legacy: If TIENE_SUBSERIES -> NuevaSubserie else NuevaTipologia):
    // en una subserie -> wizard de tipologia; en una serie contenedora -> wizard de subserie;
    // en una serie hoja -> wizard de tipologia.
    private void AgregarHijo(TrdAsignacionDto a)
    {
        if (a.SerieParentId is not null) { OpenTipWizard(a, null); }
        else if (CatalogChildren(a.SerieId).Count > 0 || SubseriesRaw(a).Any()) { OpenWizard("SUBSERIE", a); }
        else { OpenTipWizard(a, null); }
    }

    private void OpenAddSubserie(TrdAsignacionDto serie)
    {
        OpenAddAsignacion();
        _addScopeParentSerieId = serie.SerieId;
        _addScopeParentNombre = serie.SerieNombre;
    }


            <td class="right">
                <button type="button" title="Metadatos del expediente" class="tx-ent-btn sm" @onclick="@(() => OpenMetadatos(a))"><i class="bi bi-eye"></i></button>
                @if (_canEditEstructura && !a.IsArchived)
                {
                    <button type="button" title="Editar reglas TRD" class="tx-ent-btn sm" @onclick="@(() => OpenEditAsignacion(a))" disabled="@_busy"><i class="bi bi-pencil"></i></button>
                }
                @if (_canEditProcMeta)
                {
                    <button type="button" title="Agregar subserie o tipología" class="tx-ent-btn sm" @onclick="@(() => AgregarHijo(a))"><i class="bi bi-plus-lg"></i></button>

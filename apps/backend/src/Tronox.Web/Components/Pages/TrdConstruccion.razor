    private RenderFragment MetadatosTabla(IReadOnlyList<TrdMetadatoDto> metas, Action<TrdMetadatoDto> onEdit, Func<TrdMetadatoDto, bool, Task> onArchive) => __builder =>
    {
        if (metas.Count > 0)
        {
            <div class="tx-ent-table-wrap">
                <table class="tx-ent-table">
                    <thead><tr><th>Nombre</th><th>Tipo</th><th>Obligatorio</th><th>Lista</th><th>Estado</th><th class="right">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var m in metas)
                        {
                            <tr class="@(m.IsArchived ? "archivada" : "")">
                                <td>@m.Nombre</td>
                                <td>@TipoLabel(m.TipoDato)</td>
                                <td>@(m.Obligatorio ? "Sí" : "No")</td>
                                <td>@(m.ListaNombre ?? "--")</td>
                                <td><span class="tx-ent-badge sm @(m.IsArchived ? "off" : "ok")">@(m.IsArchived ? "Inactivo" : "Activo")</span></td>
                                <td class="right">
                                    @if (_canEditProcMeta)
                                    {
                                        <button type="button" class="tx-ent-btn sm" @onclick="@(() => onEdit(m))" disabled="@_busy">Editar</button>
                                        @if (m.IsArchived)
                                        {
                                            <button type="button" class="tx-ent-btn sm" @onclick="@(() => onArchive(m, false))" disabled="@_busy">Reactivar</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="tx-ent-btn sm danger" @onclick="@(() => onArchive(m, true))" disabled="@_busy">Inactivar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="tx-ent-hint">Sin metadatos todavía.</div>
        }
    };


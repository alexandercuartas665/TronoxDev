@page "/trd"
@attribute [Authorize(Policy = "Perm:modulo/trd:View")]
@* Llave de permisos = ruta de menu "modulo/trd" (RF09 5.9.3). Se entra desde el listado de
   Versiones de TRD (RF01) con ?version={id}. Es el submodulo de construccion de la TRD y sus
   tipologias (RF04 + RF05), equivalente al legacy doc_tablaRetencionDocumental. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text
@using System.Xml.Linq
@using Tronox.Application.Trd
@using Tronox.Application.TrdVersiones
@using Tronox.Application.SeriesDocumentales
@using Tronox.Application.Archivistica
@using Tronox.Application.Listas
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject ITrdConstruccionService Svc
@inject ITrdVersionService VersionsSvc
@inject ISerieDocumentalService SeriesSvc
@inject INivelClasificacionService NivelesSvc
@inject IListaMaestraService ListasSvc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS

@* RQ02 - RF04 + RF05. Vista list-first: aterriza en "Gestion de TRD por dependencia" (con Estado
   TRD DERIVADO, ADR-007) y desde "Ver/Crear" se abre el workspace de esa dependencia, donde se
   construye la TRD (cruce Dependencia x Serie), sus tipologias documentales y sus metadatos de
   expediente y de documento. Respeta la solo-lectura por estado de la version (RF01 3.1.3). *@

<PageTitle>Tabla de Retención Documental - TRONOX SGDEA</PageTitle>

<div class="tx-mod tx-dep tx-trdc">

    <nav class="tronox-breadcrumb" aria-label="Ruta de navegación">
        <a href="/inicio">Inicio</a>
        <span class="sep">/</span>
        <span>Configuración Documental</span>
        <span class="sep">/</span>
        <a href="/trd-versiones">Versiones de TRD</a>
        <span class="sep">/</span>
        <span class="cur">Gestión de la TRD</span>
    </nav>

    @if (_version is null)
    {
        <div class="tx-ent-card">
            <div class="tx-ent-card-body">
                <div class="tx-ent-empty">
                    <i class="bi bi-table"></i>
                    <div>
                        <strong>Selecciona una versión de TRD</strong><br />
                        La construcción de la TRD se hace sobre una versión. Entra desde el módulo de
                        <a href="/trd-versiones">Versiones de TRD</a> con «Abrir/Ver TRD».
                    </div>
                    <a class="tx-ent-btn primary" href="/trd-versiones"><i class="bi bi-clock-history"></i> Ir a Versiones de TRD</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="tx-ent-head">
            <div>
                <div class="tx-ent-eyebrow"><i class="bi bi-table"></i><span>RQ02 &middot; RF04 &middot; RF05</span></div>
                <h1 class="tx-ent-title">Gestión de Tablas de Retención Documental &middot; <span class="mono">@_version.CodigoVersion</span></h1>
                <p class="tx-ent-sub">
                    Asignación por dependencia. Cada dependencia tiene su propia TRD (principio de procedencia):
                    cruza sus <strong>series</strong>, define tiempos, disposición, clasificación, <strong>tipos documentales</strong> y metadatos.
                </p>
            </div>
            <div>
                <span class="tx-ent-badge @EstadoClase(_version.Estado)">@EstadoLabel(_version.Estado)</span>
            </div>
        </div>

        @if (_version.SoloConsulta)
        {
            <div class="tx-ent-alert"><i class="bi bi-eye"></i><span>Versión <strong>@EstadoLabel(_version.Estado)</strong>: solo consulta. No se puede modificar la TRD.</span></div>
        }
        else if (_version.Vigente)
        {
            <div class="tx-ent-alert"><i class="bi bi-shield-lock"></i><span>Versión <strong>Vigente</strong>: puedes agregar series, tipos documentales y metadatos, pero <strong>no</strong> los tiempos, la disposición, la clasificación ni eliminar. Para eso crea una nueva versión.</span></div>
        }

        @if (_pageError is not null)
        {
            <div class="tx-ent-alert err"><i class="bi bi-exclamation-triangle-fill"></i><span>@_pageError</span></div>
        }
        @if (_pageOk is not null)
        {
            <div class="tx-ent-alert ok"><i class="bi bi-check-circle-fill"></i><span>@_pageOk</span></div>
        }

        @* =================== LISTA "Asignacion por Dependencia" (siempre visible) =================== *@
        <div class="tx-ent-card">
                <div class="tx-dep-toolbar" style="gap:12px;flex-wrap:wrap">
                    <div class="tx-dep-search">
                        <i class="bi bi-search"></i>
                        <input class="tx-ent-input" placeholder="Buscar código o dependencia..."
                               value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? "")" />
                    </div>
                    <div class="tx-ent-field" style="margin:0;min-width:200px">
                        <select class="tx-ent-input" @bind="_estadoFilter">
                            <option value="">Todos los estados</option>
                            <option value="@EstadoTrdDependencia.SinTrd">Sin TRD</option>
                            <option value="@EstadoTrdDependencia.EnConstruccion">En construcción</option>
                            <option value="@EstadoTrdDependencia.Activa">Activa</option>
                            <option value="@EstadoTrdDependencia.Historica">Histórica</option>
                            <option value="@EstadoTrdDependencia.Inactiva">Inactiva</option>
                        </select>
                    </div>
                </div>

                <div class="tx-ent-table-wrap">
                    <table class="tx-ent-table">
                        <thead>
                            <tr>
                                <th>Código</th><th>Dependencia</th><th>Versión TRD</th><th>Estado TRD</th>
                                <th>Fecha creación</th><th>Usuario creador</th><th class="right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (DependenciasFiltradas().Count == 0)
                            {
                                <tr><td colspan="7"><div class="tx-ent-hint" style="padding:14px">No hay dependencias que coincidan. Créalas en Organizacional › Dependencias.</div></td></tr>
                            }
                            else
                            {
                                @foreach (var d in DependenciasFiltradas())
                                {
                                    <tr>
                                        <td class="mono">@d.Codigo</td>
                                        <td>@d.Nombre</td>
                                        <td>@(d.SeriesAsignadas > 0 ? _version.CodigoVersion : "--")</td>
                                        <td><span class="tx-ent-badge sm @EstadoDepClase(d.Estado)">@EstadoDepLabel(d.Estado)</span></td>
                                        <td>@(d.FechaCreacion is DateTimeOffset f ? f.ToString("yyyy-MM-dd") : "--")</td>
                                        <td>@(d.CreadoPorId is long uid ? $"Usuario {uid}" : "--")</td>
                                        <td class="right">
                                            @if (d.SeriesAsignadas > 0)
                                            {
                                                <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWorkspace(d, autoAdd:false))"><i class="bi bi-table"></i> Ver TRD</button>
                                            }
                                            else if (_canAgregar)
                                            {
                                                <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWorkspace(d, autoAdd:true))"><i class="bi bi-plus-lg"></i> Crear</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenWorkspace(d, autoAdd:false))"><i class="bi bi-eye"></i> Ver</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
        </div>

        @* =================== WORKSPACE como MODAL (fiel al legacy pnlTRDWorkspace = rf4-modal-workspace) =================== *@
        @if (_workspaceDep is not null)
        {
            <div class="modal-overlay" @onclick="BackToList">
                <div class="modal-dialog" style="max-width:1080px;width:96%" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <div>
                            <h3 style="margin:0"><span class="mono">@_workspaceDep.Codigo</span> &middot; @_workspaceDep.Nombre</h3>
                            <div class="tx-ent-hint" style="margin-top:2px">Tabla de Retención Documental por dependencia</div>
                        </div>
                        <button class="modal-close" @onclick="BackToList">&times;</button>
                    </div>
                    <div class="modal-body tx-mod tx-trdc">
                        @if (_pageError is not null)
                        {
                            <div class="tx-ent-alert err"><i class="bi bi-exclamation-triangle-fill"></i><span>@_pageError</span></div>
                        }
                        @if (_pageOk is not null)
                        {
                            <div class="tx-ent-alert ok"><i class="bi bi-check-circle-fill"></i><span>@_pageOk</span></div>
                        }

                        <div class="tx-ent-head" style="margin-bottom:8px">
                            <div>
                                <h3 style="margin:0">Tabla de Retención Documental</h3>
                                <p class="tx-ent-sub" style="margin:2px 0 0">@_version.CodigoVersion &middot; Configura series, subseries y tipologías desde un solo módulo</p>
                            </div>
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                                <span class="tx-ent-badge @EstadoClase(_version.Estado)">@EstadoLabel(_version.Estado)</span>
                                @if (_asignaciones.Count > 0)
                                {
                                    <button type="button" class="tx-ent-btn sm" @onclick="ExportXls" disabled="@_busy"><i class="bi bi-file-earmark-spreadsheet"></i> XLS</button>
                                    <button type="button" class="tx-ent-btn sm" @onclick="ExportXml" disabled="@_busy"><i class="bi bi-filetype-xml"></i> XML</button>
                                }
                                @if (_canPublicar)
                                {
                                    <button type="button" class="tx-ent-btn sm ok" @onclick="@(() => _showPublicar = true)" disabled="@_busy"><i class="bi bi-cloud-arrow-up"></i> Publicar como versión TRD</button>
                                }
                                @if (_canAgregar)
                                {
                                    <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWizard("SERIE", null))"><i class="bi bi-plus-lg"></i> Nueva Serie</button>
                                }
                            </div>
                        </div>

                        <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span><strong>Módulo central TRD:</strong> gestiona series, subseries y tipologías documentales desde este árbol. Usa el botón <i class="bi bi-plus-lg"></i> de cada serie para agregar subseries o tipologías según su estructura.</span></div>

                        <div class="tx-ent-card" style="padding:12px;margin-top:10px">
                            <div style="margin-bottom:8px"><strong>Serie / Subserie / Tipología</strong>
                                <span class="tx-ent-hint">&nbsp;@ContarSeries() series &middot; @ContarSubseries() subseries</span>
                            </div>
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:nowrap">
                                <input class="tx-ent-input" style="flex:1 1 auto;min-width:120px" placeholder="Buscar serie, subserie o tipología..."
                                       value="@_treeSearch" @oninput="@(e => _treeSearch = e.Value?.ToString() ?? "")" />
                                <select class="tx-ent-input" style="flex:0 0 auto;width:170px" @bind="_treeLevelFilter">
                                        <option value="">Todos los niveles</option>
                                        <option value="serie">Series</option>
                                        <option value="subserie">Subseries</option>
                                        <option value="tipologia">Tipologías</option>
                                    </select>
                                    <select class="tx-ent-input" style="flex:0 0 auto;width:160px" @bind="_treeEstadoFilter">
                                        <option value="">Estado: todos</option>
                                        <option value="activo">Activo</option>
                                        <option value="inactivo">Inactivo</option>
                                    </select>
                                    <button type="button" class="tx-ent-btn sm" @onclick="ExpandAll"><i class="bi bi-arrows-expand"></i> Expandir</button>
                                    <button type="button" class="tx-ent-btn sm" @onclick="CollapseAll"><i class="bi bi-arrows-collapse"></i> Colapsar</button>
                                    @if (_canAgregar)
                                    {
                                        <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => OpenWizard("SERIE", null))"><i class="bi bi-plus-lg"></i> Crear</button>
                                    }
                                </div>

                            @if (_asignaciones.Count == 0)
                            {
                                <div class="tx-ent-empty" style="margin-top:12px"><i class="bi bi-diagram-3"></i><div>Esta dependencia aún no tiene series en la TRD.</div></div>
                            }
                            else
                            {
                                <div class="tx-ent-table-wrap" style="margin-top:10px">
                                    <table class="tx-ent-table">
                                        <thead>
                                            <tr>
                                                <th>Serie / Subserie / Tipología</th><th>Código</th><th>T. Gestión</th><th>T. Central</th>
                                                <th>Disposición</th><th>Formato / Conteo</th><th>Estado</th><th class="right">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var serie in SeriesTop())
                                            {
                                                @if (ShowNivel("serie") && EstadoMatchAsig(serie)) { @SerieRow(serie, 0) }
                                                @if (IsExpanded(serie) && _treeLevelFilter != "serie")
                                                {
                                                    @if (ShowNivel("tipologia"))
                                                    {
                                                        @foreach (var t in TipsVisibles(serie)) { @if (EstadoMatchTip(t)) { @TipologiaRow(serie, t) } }
                                                    }
                                                    @foreach (var sub in SubseriesDe(serie))
                                                    {
                                                        @if (ShowNivel("subserie") && EstadoMatchAsig(sub)) { @SerieRow(sub, 1) }
                                                        @if (IsExpanded(sub) && _treeLevelFilter != "subserie" && ShowNivel("tipologia"))
                                                        {
                                                            @foreach (var t in TipsVisibles(sub)) { @if (EstadoMatchTip(t)) { @TipologiaRow(sub, t) } }
                                                        }
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @* ===== Wizard Nueva Serie/Subserie (legacy pnlModalSubserie, 4 pasos) ===== *@
    @if (_showWizard)
    {
        <div class="modal-overlay" @onclick="@(() => _showWizard = false)">
            <div class="modal-dialog" style="max-width:840px;width:96%" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>@(_wzMode == "SUBSERIE" ? "Nueva Subserie" : "Nueva Serie")</h3>
                    <button class="modal-close" @onclick="@(() => _showWizard = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap">
                        @for (var i = 1; i <= 4; i++)
                        {
                            var idx = i;
                            <span class="tx-ent-badge sm @(_wzStep == idx ? "primary" : (_wzStep > idx ? "ok" : "off"))">@idx. @_wzPasos[idx - 1]</span>
                        }
                    </div>
                    @if (_wzParent is not null)
                    {
                        <div class="tx-ent-alert"><i class="bi bi-diagram-3"></i><span>Serie padre: <strong>@_wzParent.SerieCodigo &middot; @_wzParent.SerieNombre</strong></span></div>
                    }
                    @if (_wzError is not null) { <div class="tx-ent-fielderr">@_wzError</div> }

                    @if (_wzStep == 1)
                    {
                        @if (_wzMode == "SERIE")
                        {
                            <div class="tx-ent-field">
                                <label>Serie del catálogo (activas) <span class="req">*</span></label>
                                <select class="tx-ent-input" @onchange="WizSerieChanged">
                                    <option value="0">— Selecciona —</option>
                                    @foreach (var s in WizSeriesCatalogo())
                                    {
                                        <option value="@s.Id" selected="@(s.Id == _wzSerieCatId)">@s.Codigo — @s.Nombre</option>
                                    }
                                </select>
                                <div class="tx-ent-hint">El código CCD se generará como código de dependencia + código de serie.</div>
                            </div>
                        }
                        else
                        {
                            <div class="tx-ent-grid c2">
                                <div class="tx-ent-field"><label>Código de la subserie <span class="req">*</span></label><input class="tx-ent-input" @bind="_wzCodigo" maxlength="20" /></div>
                                <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_wzNombre" maxlength="200" /></div>
                            </div>
                            <div class="tx-ent-field"><label>Descripción <span class="opt">(opcional)</span></label><textarea class="tx-ent-input" @bind="_wzDescripcion" rows="2" maxlength="500"></textarea></div>
                        }
                    }
                    else if (_wzStep == 2)
                    {
                        <div class="tx-ent-grid c2">
                            <div class="tx-ent-field"><label>Tiempo en Gestión (años) <span class="req">*</span></label><input type="number" min="0" class="tx-ent-input" @bind="_wzTG" /></div>
                            <div class="tx-ent-field"><label>Tiempo en Central (años) <span class="req">*</span></label><input type="number" min="0" class="tx-ent-input" @bind="_wzTC" /></div>
                        </div>
                        <div class="tx-ent-grid c2">
                            <div class="tx-ent-field"><label>Disposición final <span class="req">*</span></label>
                                <select class="tx-ent-input" @bind="_wzDisp">
                                    <option value="@DisposicionFinal.ConservacionTotal">CT — Conservación Total</option>
                                    <option value="@DisposicionFinal.Seleccion">S — Selección</option>
                                    <option value="@DisposicionFinal.Eliminacion">E — Eliminación</option>
                                </select>
                            </div>
                            <div class="tx-ent-field"><label>Clasificación <span class="req">*</span></label>
                                <select class="tx-ent-input" @bind="_wzNivelId">@foreach (var n in _niveles) { <option value="@n.Id">@n.Nombre</option> }</select>
                            </div>
                        </div>
                        <div class="tx-ent-grid c2">
                            <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_wzRepro" /> Reproducción técnica del papel (M/D)</label>
                            <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_wzDdhh" /> Serie con documentos DD.HH / DIH</label>
                        </div>
                        <div class="tx-ent-field"><label>Procedimiento <span class="opt">(opcional)</span></label><textarea class="tx-ent-input" @bind="_wzProc" rows="2" maxlength="1000"></textarea></div>
                    }
                    else if (_wzStep == 3)
                    {
                        <p class="tx-ent-hint" style="margin-top:0">Se diligencian al crear un expediente bajo esta serie en esta dependencia.</p>
                        @WizMetaList(_wzMetas)
                        @if (!_wzMetaForm)
                        {
                            <button class="tx-ent-btn sm" @onclick="@(() => { _wzMetaForm = true; ResetWzMetaForm(); })"><i class="bi bi-plus-lg"></i> Agregar metadato</button>
                        }
                        else
                        {
                            <div class="tx-ent-card" style="padding:12px;margin-top:8px">
                                <strong>Nuevo metadato del expediente</strong>
                                <div class="tx-ent-grid c2" style="margin-top:8px">
                                    <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_wzMetaNombre" maxlength="200" /></div>
                                    <div class="tx-ent-field"><label>Tipo de dato</label><select class="tx-ent-input" @bind="_wzMetaTipo">@foreach (var tp in Enum.GetValues<TipoDatoMetadato>()) { <option value="@tp">@TipoLabel(tp)</option> }</select></div>
                                </div>
                                <div class="tx-ent-grid c2">
                                    @if (_wzMetaTipo == TipoDatoMetadato.Lista)
                                    {
                                        <div class="tx-ent-field"><label>Lista <span class="req">*</span></label><select class="tx-ent-input" @bind="_wzMetaListaId"><option value="0">— Selecciona —</option>@foreach (var l in _listas) { <option value="@l.Id">@l.NombreLista</option> }</select></div>
                                    }
                                    <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_wzMetaOblig" /> Obligatorio</label>
                                </div>
                                <div style="margin-top:8px;display:flex;gap:8px"><button class="tx-ent-btn primary sm" @onclick="WzAddMeta">Agregar</button><button class="tx-ent-btn sm" @onclick="@(() => _wzMetaForm = false)">Cancelar</button></div>
                            </div>
                        }
                    }
                    else if (_wzStep == 4)
                    {
                        <p class="tx-ent-hint" style="margin-top:0">Tipos de documento que conforman esta serie, con sus metadatos de documento (opcional).</p>
                        @if (_wzTips.Count > 0)
                        {
                            <div class="tx-ent-table-wrap"><table class="tx-ent-table"><thead><tr><th>Nombre</th><th>Soporte</th><th>Formato</th><th>Oblig.</th><th>Meta.</th><th class="right">Acciones</th></tr></thead><tbody>
                                @foreach (var t in _wzTips)
                                {
                                    <tr><td>@t.Nombre</td><td>@SoporteLabel(t.Soporte)</td><td>@(t.Formato ?? "--")</td><td>@(t.Obligatorio ? "Sí" : "No")</td><td>@t.Metas.Count</td><td class="right"><button class="tx-ent-btn sm danger" @onclick="@(() => _wzTips.Remove(t))">Quitar</button></td></tr>
                                }
                            </tbody></table></div>
                        }
                        else { <div class="tx-ent-hint">Sin tipologías (opcional).</div> }
                        @if (!_wzTipForm)
                        {
                            <button class="tx-ent-btn sm" @onclick="@(() => { _wzTipForm = true; ResetWzTipForm(); })"><i class="bi bi-plus-lg"></i> Agregar tipología</button>
                        }
                        else
                        {
                            <div class="tx-ent-card" style="padding:12px;margin-top:10px">
                                <strong>Nueva tipología</strong>
                                <div class="tx-ent-grid c2" style="margin-top:8px">
                                    <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_wzTipNombre" maxlength="200" /></div>
                                    <div class="tx-ent-field"><label>Soporte</label><select class="tx-ent-input" @bind="_wzTipSop"><option value="@SoporteTipologia.Electronico">Electrónico</option><option value="@SoporteTipologia.Fisico">Físico</option><option value="@SoporteTipologia.Hibrido">Híbrido</option></select></div>
                                </div>
                                <div class="tx-ent-grid c2">
                                    <div class="tx-ent-field"><label>Formato <span class="opt">(opcional)</span></label><input class="tx-ent-input" @bind="_wzTipFmt" maxlength="100" placeholder="PDF, DOCX..." /></div>
                                    <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_wzTipOblig" /> Obligatorio en el expediente</label>
                                </div>
                                <div style="margin-top:6px"><strong class="tx-ent-hint">Metadatos del documento</strong></div>
                                @WizMetaList(_wzTipMetas)
                                @if (!_wzTipMetaForm)
                                {
                                    <button class="tx-ent-btn sm" @onclick="@(() => { _wzTipMetaForm = true; ResetWzTipMetaForm(); })"><i class="bi bi-plus-lg"></i> Agregar metadato</button>
                                }
                                else
                                {
                                    <div class="tx-ent-card" style="padding:10px;margin-top:6px">
                                        <div class="tx-ent-grid c2">
                                            <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_wzTipMetaNombre" maxlength="200" /></div>
                                            <div class="tx-ent-field"><label>Tipo de dato</label><select class="tx-ent-input" @bind="_wzTipMetaTipo">@foreach (var tp in Enum.GetValues<TipoDatoMetadato>()) { <option value="@tp">@TipoLabel(tp)</option> }</select></div>
                                        </div>
                                        <div class="tx-ent-grid c2">
                                            @if (_wzTipMetaTipo == TipoDatoMetadato.Lista)
                                            {
                                                <div class="tx-ent-field"><label>Lista <span class="req">*</span></label><select class="tx-ent-input" @bind="_wzTipMetaListaId"><option value="0">— Selecciona —</option>@foreach (var l in _listas) { <option value="@l.Id">@l.NombreLista</option> }</select></div>
                                            }
                                            <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_wzTipMetaOblig" /> Obligatorio</label>
                                        </div>
                                        <div style="margin-top:6px;display:flex;gap:8px"><button class="tx-ent-btn primary sm" @onclick="WzAddTipMeta">Agregar</button><button class="tx-ent-btn sm" @onclick="@(() => _wzTipMetaForm = false)">Cancelar</button></div>
                                    </div>
                                }
                                <div style="margin-top:10px;display:flex;gap:8px">
                                    <button class="tx-ent-btn primary sm" @onclick="WzAddTip">Agregar tipología</button>
                                    <button class="tx-ent-btn sm" @onclick="@(() => { _wzTipForm = false; ResetWzTipForm(); })">Cancelar</button>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-foot">
                    <span class="tx-ent-hint" style="margin:0;margin-right:auto">Paso @_wzStep de 4</span>
                    @if (_wzStep > 1) { <button class="tx-ent-btn" @onclick="WizBack" disabled="@_wzBusy">Atrás</button> }
                    @if (_wzStep < 4) { <button class="tx-ent-btn primary" @onclick="WizNext" disabled="@_wzBusy">Siguiente</button> }
                    else { <button class="tx-ent-btn primary" @onclick="WizardCrear" disabled="@_wzBusy">Crear</button> }
                </div>
            </div>
        </div>
    }

    @* ===== Wizard Tipologia (legacy pnlModalTipologia, 2 pasos) ===== *@
    @if (_showTipWizard)
    {
        <div class="modal-overlay" @onclick="@(() => _showTipWizard = false)">
            <div class="modal-dialog" style="max-width:700px;width:96%" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>@(_twEditing is null ? "Nueva Tipología Documental" : "Editar Tipología Documental")</h3>
                    <button class="modal-close" @onclick="@(() => _showTipWizard = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <div style="display:flex;gap:6px;margin-bottom:12px">
                        <span class="tx-ent-badge sm @(_twStep == 1 ? "primary" : "ok")">1. Configuración</span>
                        <span class="tx-ent-badge sm @(_twStep == 2 ? "primary" : "off")">2. Confirmar</span>
                    </div>
                    @if (_twParent is not null) { <div class="tx-ent-alert"><i class="bi bi-diagram-3"></i><span>Sobre: <strong class="mono">@_twParent.CodigoCcd</strong> &middot; @_twParent.SerieNombre</span></div> }
                    @if (_twError is not null) { <div class="tx-ent-fielderr">@_twError</div> }
                    @if (_twStep == 1)
                    {
                        <div class="tx-ent-grid c2">
                            <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_twNombre" maxlength="200" placeholder="Ej: Acta de Reunión" /></div>
                            <div class="tx-ent-field"><label>Soporte</label><select class="tx-ent-input" @bind="_twSop"><option value="@SoporteTipologia.Electronico">Electrónico</option><option value="@SoporteTipologia.Fisico">Físico</option><option value="@SoporteTipologia.Hibrido">Híbrido</option></select></div>
                        </div>
                        <div class="tx-ent-grid c2">
                            <div class="tx-ent-field"><label>Formato <span class="opt">(opcional)</span></label><input class="tx-ent-input" @bind="_twFmt" maxlength="100" placeholder="PDF, DOCX..." /></div>
                            <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_twOblig" /> Obligatorio en el expediente</label>
                        </div>
                        @if (_twEditing is null)
                        {
                            <div style="margin-top:8px"><strong class="tx-ent-hint">Metadatos del documento</strong></div>
                            @WizMetaList(_twMetas)
                            @if (!_twMetaForm)
                            {
                                <button class="tx-ent-btn sm" @onclick="@(() => { _twMetaForm = true; ResetTwMetaForm(); })"><i class="bi bi-plus-lg"></i> Agregar metadato</button>
                            }
                            else
                            {
                                <div class="tx-ent-card" style="padding:10px;margin-top:6px">
                                    <div class="tx-ent-grid c2">
                                        <div class="tx-ent-field"><label>Nombre <span class="req">*</span></label><input class="tx-ent-input" @bind="_twMetaNombre" maxlength="200" /></div>
                                        <div class="tx-ent-field"><label>Tipo de dato</label><select class="tx-ent-input" @bind="_twMetaTipo">@foreach (var tp in Enum.GetValues<TipoDatoMetadato>()) { <option value="@tp">@TipoLabel(tp)</option> }</select></div>
                                    </div>
                                    <div class="tx-ent-grid c2">
                                        @if (_twMetaTipo == TipoDatoMetadato.Lista)
                                        {
                                            <div class="tx-ent-field"><label>Lista <span class="req">*</span></label><select class="tx-ent-input" @bind="_twMetaListaId"><option value="0">— Selecciona —</option>@foreach (var l in _listas) { <option value="@l.Id">@l.NombreLista</option> }</select></div>
                                        }
                                        <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" @bind="_twMetaOblig" /> Obligatorio</label>
                                    </div>
                                    <div style="margin-top:6px;display:flex;gap:8px"><button class="tx-ent-btn primary sm" @onclick="TwAddMeta">Agregar</button><button class="tx-ent-btn sm" @onclick="@(() => _twMetaForm = false)">Cancelar</button></div>
                                </div>
                            }
                        }
                        else { <div class="tx-ent-hint">Los metadatos del documento se gestionan desde el ícono <i class="bi bi-eye"></i> de la tipología.</div> }
                    }
                    else
                    {
                        <p class="tx-ent-hint" style="margin-top:0">Confirma el tipo documental:</p>
                        <ul>
                            <li>Nombre: <strong>@_twNombre</strong></li>
                            <li>Soporte: @SoporteLabel(_twSop)</li>
                            <li>Formato: @(_twFmt ?? "--")</li>
                            <li>Obligatorio en expediente: @(_twOblig ? "Sí" : "No")</li>
                            @if (_twEditing is null) { <li>Metadatos de documento: @_twMetas.Count</li> }
                        </ul>
                    }
                </div>
                <div class="modal-foot">
                    <span class="tx-ent-hint" style="margin:0;margin-right:auto">Paso @_twStep de 2</span>
                    @if (_twStep == 2) { <button class="tx-ent-btn" @onclick="TwBack" disabled="@_twBusy">Atrás</button> }
                    @if (_twStep == 1) { <button class="tx-ent-btn primary" @onclick="TwNext" disabled="@_twBusy">Siguiente</button> }
                    else { <button class="tx-ent-btn primary" @onclick="TwCrear" disabled="@_twBusy">@(_twEditing is null ? "Crear" : "Guardar")</button> }
                </div>
            </div>
        </div>
    }

    @* ===== Modal publicar version TRD (activar) ===== *@
    @if (_showPublicar && _version is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showPublicar = false)">
            <div class="modal-dialog" style="max-width:560px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Publicar como versión TRD</h3>
                    <button class="modal-close" @onclick="@(() => _showPublicar = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p>Vas a publicar la versión <strong class="mono">@_version.CodigoVersion</strong> como <strong>Vigente</strong>.</p>
                    <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span>La versión <strong>Vigente</strong> actual (si existe) pasará automáticamente a <strong>Histórica</strong>. Los expedientes ya creados conservan la versión bajo la que nacieron. A partir de aquí solo se podrán hacer cambios aditivos (no se editan tiempos/disposición/clasificación).</span></div>
                    @if (_publicarError is not null)
                    {
                        <div class="tx-ent-fielderr">@_publicarError</div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showPublicar = false)" disabled="@_busy">Cancelar</button>
                    <button class="tx-ent-btn ok" @onclick="Publicar" disabled="@_busy"><i class="bi bi-cloud-arrow-up"></i> Publicar</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal asignacion (crear/editar reglas) ===== *@
    @if (_showAsignEditor)
    {
        <div class="modal-overlay" @onclick="@(() => _showAsignEditor = false)">
            <div class="modal-dialog" style="max-width:680px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>@(_editingAsign is not null ? $"Editar {_editingAsign.CodigoCcd}" : _addScopeParentNombre is not null ? $"Agregar subserie a {_addScopeParentNombre}" : "Agregar serie a la dependencia")</h3>
                    <button class="modal-close" @onclick="@(() => _showAsignEditor = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    @if (_editingAsign is null)
                    {
                        <div class="tx-ent-field">
                            <label>@(_addScopeParentSerieId is not null ? "Subserie del catálogo (activas)" : "Serie del catálogo (activas)") <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fSerieId">
                                <option value="0">— Selecciona —</option>
                                @foreach (var s in SeriesParaAgregar())
                                {
                                    <option value="@s.Id">@s.Codigo — @s.Nombre</option>
                                }
                            </select>
                            @if (_addScopeParentSerieId is not null && SeriesParaAgregar().Count == 0)
                            {
                                <div class="tx-ent-hint">No hay subseries del catálogo disponibles para esta serie (créalas en el Catálogo de Series).</div>
                            }
                            else
                            {
                                <div class="tx-ent-hint">El código CCD se generará como código de dependencia + código de serie.</div>
                            }
                        </div>
                    }
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field">
                            <label>Tiempo en Gestión (años) <span class="req">*</span></label>
                            <input type="number" min="0" class="tx-ent-input" @bind="_fTiempoGestion" />
                        </div>
                        <div class="tx-ent-field">
                            <label>Tiempo en Central (años) <span class="req">*</span></label>
                            <input type="number" min="0" class="tx-ent-input" @bind="_fTiempoCentral" />
                        </div>
                    </div>
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field">
                            <label>Disposición final <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fDisposicion">
                                <option value="@DisposicionFinal.ConservacionTotal">CT — Conservación Total</option>
                                <option value="@DisposicionFinal.Seleccion">S — Selección</option>
                                <option value="@DisposicionFinal.Eliminacion">E — Eliminación</option>
                            </select>
                        </div>
                        <div class="tx-ent-field">
                            <label>Clasificación <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_fNivelId">
                                @foreach (var n in _niveles)
                                {
                                    <option value="@n.Id">@n.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="tx-ent-grid c2">
                        <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                            <input type="checkbox" @bind="_fReproduccion" /> Reproducción técnica del papel (M/D)
                        </label>
                        <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                            <input type="checkbox" @bind="_fDdhh" /> Serie con documentos DD.HH / DIH
                        </label>
                    </div>
                    <div class="tx-ent-field">
                        <label>Procedimiento <span class="opt">(opcional)</span></label>
                        <textarea class="tx-ent-input" @bind="_fProcedimiento" maxlength="1000" rows="2"></textarea>
                    </div>
                    @if (_asignError is not null)
                    {
                        <div class="tx-ent-fielderr">@_asignError</div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showAsignEditor = false)" disabled="@_busy">Cancelar</button>
                    <button class="tx-ent-btn primary" @onclick="SaveAsignacion" disabled="@_busy">@(_editingAsign is null ? "Agregar" : "Guardar")</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal metadatos del EXPEDIENTE (RF04) ===== *@
    @if (_showMetadatos && _metaAsign is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showMetadatos = false)">
            <div class="modal-dialog" style="max-width:720px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Metadatos del Expediente &middot; <span class="mono">@_metaAsign.CodigoCcd</span></h3>
                    <button class="modal-close" @onclick="@(() => _showMetadatos = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Se diligencian al crear un expediente bajo esta serie en esta dependencia.</p>
                    @MetadatosTabla(_metaAsign.Metadatos, OpenMetaEditor, SetMetaArchived)

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingMeta is null ? "Nuevo metadato del expediente" : "Editar metadato")</strong>
                            @MetadatoForm(false)
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showMetadatos = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal TIPOLOGIAS (RF05) ===== *@
    @if (_showTipologias && _tipAsign is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showTipologias = false)">
            <div class="modal-dialog" style="max-width:820px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Tipos documentales &middot; <span class="mono">@_tipAsign.CodigoCcd</span></h3>
                    <button class="modal-close" @onclick="@(() => _showTipologias = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Tipos de documento que conforman esta serie en esta dependencia (RF05). Cada uno con su soporte, formato y metadatos de documento.</p>

                    @if (_tipAsign.Tipologias.Count > 0)
                    {
                        <div class="tx-ent-table-wrap">
                            <table class="tx-ent-table">
                                <thead><tr><th>Nombre</th><th>Soporte</th><th>Formato</th><th>Obligatorio</th><th>Meta. doc.</th><th>Estado</th><th class="right">Acciones</th></tr></thead>
                                <tbody>
                                    @foreach (var t in _tipAsign.Tipologias)
                                    {
                                        <tr class="@(t.IsArchived ? "archivada" : "")">
                                            <td>@t.Nombre</td>
                                            <td>@SoporteLabel(t.Soporte)</td>
                                            <td>@(string.IsNullOrWhiteSpace(t.Formato) ? "--" : t.Formato)</td>
                                            <td>@(t.ObligatorioEnExpediente ? "Sí" : "No")</td>
                                            <td><button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenMetadatosDoc(t))">@t.Metadatos.Count(m => !m.IsArchived) campo(s)</button></td>
                                            <td><span class="tx-ent-badge sm @(t.IsArchived ? "off" : "ok")">@(t.IsArchived ? "Inactivo" : "Activo")</span></td>
                                            <td class="right">
                                                @if (_canEditProcMeta && !t.IsArchived)
                                                {
                                                    <button type="button" class="tx-ent-btn sm" @onclick="@(() => OpenTipEditor(t))" disabled="@_busy">Editar</button>
                                                }
                                                @if (_canEliminar)
                                                {
                                                    @if (t.IsArchived)
                                                    {
                                                        <button type="button" class="tx-ent-btn sm" @onclick="@(() => SetTipArchived(t, false))" disabled="@_busy">Reactivar</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="tx-ent-btn sm danger" @onclick="@(() => SetTipArchived(t, true))" disabled="@_busy">Inactivar</button>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="tx-ent-hint">Sin tipos documentales todavía.</div>
                    }

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingTip is null ? "Nuevo tipo documental" : "Editar tipo documental")</strong>
                            <div class="tx-ent-grid c2" style="margin-top:8px">
                                <div class="tx-ent-field">
                                    <label>Nombre <span class="req">*</span></label>
                                    <input class="tx-ent-input" @bind="_fTipNombre" maxlength="200" placeholder="Ej: Acta de Reunión, Contrato" />
                                </div>
                                <div class="tx-ent-field">
                                    <label>Soporte <span class="req">*</span></label>
                                    <select class="tx-ent-input" @bind="_fTipSoporte">
                                        <option value="@SoporteTipologia.Electronico">Electrónico</option>
                                        <option value="@SoporteTipologia.Fisico">Físico</option>
                                        <option value="@SoporteTipologia.Hibrido">Híbrido</option>
                                    </select>
                                </div>
                            </div>
                            <div class="tx-ent-grid c2">
                                <div class="tx-ent-field">
                                    <label>Formato <span class="opt">(opcional)</span></label>
                                    <input class="tx-ent-input" @bind="_fTipFormato" maxlength="100" placeholder="PDF, XML, DOCX, Papel..." />
                                </div>
                                <label class="tx-ent-hint" style="margin:0;display:inline-flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="checkbox" @bind="_fTipObligatorio" /> Obligatorio en el expediente
                                </label>
                            </div>
                            @if (_tipError is not null)
                            {
                                <div class="tx-ent-fielderr">@_tipError</div>
                            }
                            <div style="margin-top:8px;display:flex;gap:8px">
                                <button class="tx-ent-btn primary sm" @onclick="SaveTipologia" disabled="@_busy">@(_editingTip is null ? "Agregar" : "Guardar")</button>
                                @if (_editingTip is not null)
                                {
                                    <button class="tx-ent-btn sm" @onclick="ResetTipEditor" disabled="@_busy">Cancelar edición</button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showTipologias = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }

    @* ===== Modal metadatos del DOCUMENTO (RF05) ===== *@
    @if (_showMetaDoc && _docTip is not null)
    {
        <div class="modal-overlay" @onclick="@(() => _showMetaDoc = false)">
            <div class="modal-dialog" style="max-width:720px" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Metadatos del Documento &middot; <span class="mono">@_docTip.Nombre</span></h3>
                    <button class="modal-close" @onclick="@(() => _showMetaDoc = false)">&times;</button>
                </div>
                <div class="modal-body tx-mod tx-trdc">
                    <p class="tx-ent-hint" style="margin-top:0">Se diligencian al cargar cada documento de este tipo al expediente (RF05).</p>
                    @MetadatosTabla(_docTip.Metadatos, OpenMetaEditor, SetMetaArchived)

                    @if (_canEditProcMeta)
                    {
                        <div class="tx-ent-card" style="margin-top:12px;padding:12px">
                            <strong>@(_editingMeta is null ? "Nuevo metadato del documento" : "Editar metadato")</strong>
                            @MetadatoForm(true)
                        </div>
                    }
                </div>
                <div class="modal-foot">
                    <button class="tx-ent-btn" @onclick="@(() => _showMetaDoc = false)">Cerrar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string ModuleKey = "modulo/trd";

    [SupplyParameterFromQuery(Name = "version")] public long? VersionId { get; set; }

    private bool _busy;
    private string _search = "";
    private EstadoTrdDependencia? _estadoFilter;
    private string? _pageError;
    private string? _pageOk;

    private bool _permView, _permCreate, _permEdit, _permDelete;
    private bool _canAgregar, _canEditEstructura, _canEditProcMeta, _canEliminar, _canPublicar;

    // ---- Publicar version (activar) ----
    private bool _showPublicar;
    private string? _publicarError;

    private TrdVersionCabeceraDto? _version;
    private IReadOnlyList<DependenciaTrdResumenDto> _dependencias = [];

    // Workspace
    private DependenciaTrdResumenDto? _workspaceDep;
    private IReadOnlyList<TrdAsignacionDto> _asignaciones = [];
    private readonly HashSet<long> _expanded = [];   // series/subseries expandidas por SerieId
    private string _treeSearch = "";
    private string _treeLevelFilter = "";   // "" | serie | subserie | tipologia
    private string _treeEstadoFilter = "";  // "" | activo | inactivo

    private List<SerieNodeDto> _seriesActivas = [];
    private readonly Dictionary<long, SerieNodeDto> _catalogById = [];   // catalogo por id (para el + contextual)
    private IReadOnlyList<NivelClasificacionDto> _niveles = [];
    private IReadOnlyList<ListaMaestraDto> _listas = [];

    // ---- Editor asignacion ----
    private bool _showAsignEditor;
    private TrdAsignacionDto? _editingAsign;
    private long _fSerieId;
    private int _fTiempoGestion, _fTiempoCentral;
    private DisposicionFinal _fDisposicion = DisposicionFinal.ConservacionTotal;
    private long _fNivelId;
    private bool _fReproduccion, _fDdhh;
    private string? _fProcedimiento;
    private string? _asignError;
    private long? _addScopeParentSerieId;   // != null cuando se agrega una SUBSERIE de esta serie (+ contextual)
    private string? _addScopeParentNombre;

    // ---- Metadatos (expediente y documento comparten editor) ----
    private bool _showMetadatos;              // metadatos de expediente (de una asignacion)
    private TrdAsignacionDto? _metaAsign;
    private bool _showMetaDoc;                // metadatos de documento (de una tipologia)
    private TrdTipologiaDto? _docTip;
    private TrdMetadatoDto? _editingMeta;
    private string _fMetaNombre = "";

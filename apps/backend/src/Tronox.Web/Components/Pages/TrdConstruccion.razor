    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _permView = eff.Can(ModuleKey, PermissionAction.View);
        _permCreate = eff.Can(ModuleKey, PermissionAction.Create);
        _permEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        _permDelete = eff.Can(ModuleKey, PermissionAction.Delete);

        if (VersionId is not long vid) { return; }
        _version = await Svc.GetVersionAsync(vid);
        if (_version is null) { return; }

        RecalcularPermisos();

        _niveles = await NivelesSvc.ListAsync(soloActivos: true);
        var tree = await SeriesSvc.GetTreeAsync(includeInactivas: false);
        _seriesActivas = [];
        _catalogById.Clear();
        Collect(tree);
        _listas = (await ListasSvc.ListAsync(includeInactivas: false))
            .Where(l => !l.EsInactiva).ToList();

        await LoadDependenciasAsync();
    }

    private void RecalcularPermisos()
    {
        var estado = _version!.Estado;
        _canAgregar = _permCreate && estado is TrdVersionEstado.EnConstruccion or TrdVersionEstado.Vigente;
        _canEditEstructura = _permEdit && estado == TrdVersionEstado.EnConstruccion;
        _canEditProcMeta = _permEdit && estado is TrdVersionEstado.EnConstruccion or TrdVersionEstado.Vigente;
        _canEliminar = _permDelete && estado == TrdVersionEstado.EnConstruccion;
        // Publicar (activar) solo desde En Construccion; se reutiliza el flujo de RF01.
        _canPublicar = _permEdit && estado == TrdVersionEstado.EnConstruccion;
    }

    // ---- Publicar version TRD (reutiliza la activacion de RF01) ----

    private async Task Publicar()
    {
        if (_version is null) { return; }
        _busy = true; _publicarError = null;
        try
        {
            var result = await VersionsSvc.ActivarAsync(_version.Id, Tenant.UserId ?? 0);
            if (!result.IsOk) { _publicarError = result.Error; return; }
            _showPublicar = false;
            _version = await Svc.GetVersionAsync(_version.Id) ?? _version;
            RecalcularPermisos();
            await ReloadWorkspaceAsync();
            _pageOk = $"Versión {_version.CodigoVersion} publicada como Vigente.";
        }
        finally { _busy = false; }
    }

    // ---- Exportar la TRD de la dependencia (XLS / XML) ----

    private async Task ExportXls()
    {
        var html = new StringBuilder();
        html.Append("<html><head><meta charset=\"utf-8\"></head><body>");
        html.Append($"<h3>Tabla de Retención Documental · {Xml(_version!.CodigoVersion)} · {Xml(_workspaceDep!.Codigo)} {Xml(_workspaceDep!.Nombre)}</h3>");
        html.Append("<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\">");
        html.Append("<tr><th>Nivel</th><th>Serie / Subserie / Tipología</th><th>Código</th><th>T. Gestión</th><th>T. Central</th><th>Disposición</th><th>Formato / Conteo</th><th>Estado</th></tr>");
        foreach (var f in FlattenParaExport())
        {
            html.Append("<tr>");
            html.Append($"<td>{Xml(f.Nivel)}</td><td>{Xml(f.Nombre)}</td><td>{Xml(f.Codigo)}</td><td>{Xml(f.Gestion)}</td><td>{Xml(f.Central)}</td><td>{Xml(f.Disposicion)}</td><td>{Xml(f.FormatoConteo)}</td><td>{Xml(f.Estado)}</td>");
            html.Append("</tr>");
        }
        html.Append("</table></body></html>");
        await Descargar($"TRD_{_version!.CodigoVersion}_{_workspaceDep!.Codigo}.xls", "application/vnd.ms-excel", html.ToString());
    }

    private async Task ExportXml()
    {
        var raiz = new XElement("TablaRetencionDocumental",
            new XAttribute("version", _version!.CodigoVersion),
            new XAttribute("estadoVersion", _version.Estado.ToString()),
            new XAttribute("dependenciaCodigo", _workspaceDep!.Codigo),
            new XAttribute("dependenciaNombre", _workspaceDep.Nombre));

        foreach (var serie in SeriesTop())
        {
            raiz.Add(SerieXml(serie, "Serie"));
        }
        var doc = new XDocument(new XDeclaration("1.0", "utf-8", null), raiz);
        await Descargar($"TRD_{_version.CodigoVersion}_{_workspaceDep.Codigo}.xml", "application/xml", doc.Declaration + Environment.NewLine + doc);
    }

    private XElement SerieXml(TrdAsignacionDto a, string tag)
    {
        var el = new XElement(tag,
            new XAttribute("codigo", a.SerieCodigo),
            new XAttribute("nombre", a.SerieNombre),
            new XAttribute("ccd", a.CodigoCcd),
            new XAttribute("tiempoGestion", a.TiempoGestion),
            new XAttribute("tiempoCentral", a.TiempoCentral),
            new XAttribute("disposicion", DispCodigo(a.DisposicionFinal)),
            new XAttribute("clasificacion", a.NivelClasificacionNombre),
            new XAttribute("estado", a.IsArchived ? "Inactivo" : "Activo"));
        foreach (var t in a.Tipologias)
        {
            el.Add(new XElement("Tipologia",
                new XAttribute("nombre", t.Nombre),
                new XAttribute("soporte", t.Soporte.ToString()),
                new XAttribute("formato", t.Formato ?? ""),
                new XAttribute("obligatorioEnExpediente", t.ObligatorioEnExpediente),
                new XAttribute("estado", t.IsArchived ? "Inactivo" : "Activo")));
        }
        foreach (var sub in SubseriesDe(a))
        {
            el.Add(SerieXml(sub, "Subserie"));
        }
        return el;
    }

    private readonly record struct ExportRow(string Nivel, string Nombre, string Codigo, string Gestion, string Central, string Disposicion, string FormatoConteo, string Estado);

    private List<ExportRow> FlattenParaExport()
    {
        var rows = new List<ExportRow>();
        void AddSerie(TrdAsignacionDto a, string nivel)
        {
            var subs = SubseriesRaw(a).Count();
            var tips = a.Tipologias.Count(t => !t.IsArchived);
            rows.Add(new ExportRow(nivel, a.SerieNombre, a.SerieCodigo, $"{a.TiempoGestion} años",
                $"{a.TiempoCentral} años", DispCodigo(a.DisposicionFinal), $"{subs} subs / {tips} tipos",
                a.IsArchived ? "Inactivo" : "TRD"));
            foreach (var t in a.Tipologias.OrderBy(x => x.Nombre))
            {
                var fmt = string.IsNullOrWhiteSpace(t.Formato) ? SoporteLabel(t.Soporte) : $"{SoporteLabel(t.Soporte)} / {t.Formato}";
                rows.Add(new ExportRow("Tipología", t.Nombre, "", "— heredado —", "— heredado —", "—", fmt,
                    t.IsArchived ? "Inactivo" : "Activo"));
            }
            foreach (var sub in SubseriesDe(a)) { AddSerie(sub, "Subserie"); }
        }
        foreach (var serie in SeriesTop()) { AddSerie(serie, "Serie"); }
        return rows;
    }

    private async Task Descargar(string filename, string mime, string contenido)
    {
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(contenido));
        await JS.InvokeVoidAsync("tronoxDownload", filename, base64, mime);
    }

    private static string Xml(string? s) => System.Security.SecurityElement.Escape(s ?? "") ?? "";

    private void Collect(IReadOnlyList<SerieNodeDto> nodes)
    {
        foreach (var n in nodes) { _seriesActivas.Add(n); _catalogById[n.Id] = n; Collect(n.Children); }
    }

    private async Task LoadDependenciasAsync()
    {
        _dependencias = await Svc.GetDependenciasResumenAsync(_version!.Id);
    }

    private List<DependenciaTrdResumenDto> DependenciasFiltradas()
    {
        var q = _search.Trim();
        return _dependencias.Where(d =>
            (_estadoFilter is null || d.Estado == _estadoFilter)
            && (q.Length == 0
                || d.Codigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                || d.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))).ToList();
    }


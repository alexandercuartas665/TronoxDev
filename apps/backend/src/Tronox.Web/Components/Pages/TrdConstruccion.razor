        ResetMetaEditor();
        _showMetaDoc = true;
    }

    private void OpenMetaEditor(TrdMetadatoDto m)
    {
        _editingMeta = m;
        _fMetaNombre = m.Nombre; _fMetaTipo = m.TipoDato; _fMetaObligatorio = m.Obligatorio;
        _fMetaListaId = m.ListaMaestraId ?? 0; _metaError = null;
    }

    private void ResetMetaEditor()
    {
        _editingMeta = null;
        _fMetaNombre = ""; _fMetaTipo = TipoDatoMetadato.TextoCorto; _fMetaObligatorio = false; _fMetaListaId = 0;
        _metaError = null;
    }

    private async Task SaveMetadato(bool documento)
    {
        _busy = true; _metaError = null;
        try
        {
            long? listaId = _fMetaTipo == TipoDatoMetadato.Lista ? (_fMetaListaId > 0 ? _fMetaListaId : null) : null;
            var request = new SaveMetadatoRequest(_fMetaNombre, _fMetaTipo, _fMetaObligatorio, listaId);
            var actor = Tenant.UserId ?? 0;
            TrdResult<TrdMetadatoDto> result;
            if (_editingMeta is not null)
            {
                result = await Svc.UpdateMetadatoAsync(_editingMeta.Id, request, actor);
            }
            else if (documento)
            {
                result = await Svc.AddMetadatoDocumentoAsync(_docTip!.Id, request, actor);
            }
            else
            {
                result = await Svc.AddMetadatoAsync(_metaAsign!.Id, request, actor);
            }
            if (!result.IsOk) { _metaError = result.Error; return; }
            await ReloadWorkspaceAsync();
            RefreshOpenMetaContext();
            ResetMetaEditor();
        }
        finally { _busy = false; }
    }

    private async Task SetMetaArchived(TrdMetadatoDto m, bool archived)
    {
        _busy = true; _metaError = null;
        try
        {
            var result = await Svc.SetMetadatoArchivedAsync(m.Id, archived, Tenant.UserId ?? 0);
            if (!result.IsOk) { _metaError = result.Error; return; }
            await ReloadWorkspaceAsync();
            RefreshOpenMetaContext();
        }
        finally { _busy = false; }
    }

    /// <summary>Reengancha los objetos abiertos (asignacion/tipologia) a la lista recargada.</summary>
    private void RefreshOpenMetaContext()
    {
        if (_metaAsign is not null)
        {
            _metaAsign = _asignaciones.FirstOrDefault(x => x.Id == _metaAsign.Id) ?? _metaAsign;
        }
        if (_tipAsign is not null)
        {
            _tipAsign = _asignaciones.FirstOrDefault(x => x.Id == _tipAsign.Id) ?? _tipAsign;
        }
        if (_docTip is not null)
        {
            _docTip = _asignaciones.SelectMany(a => a.Tipologias).FirstOrDefault(t => t.Id == _docTip.Id) ?? _docTip;
        }
    }


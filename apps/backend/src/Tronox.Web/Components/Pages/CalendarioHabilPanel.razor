@using Tronox.Application.Radicacion
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase

@* Usa su PROPIO scope de DI (ScopedServices) para no compartir el DbContext scoped del circuito con la
   pagina que lo embebe (Datos de la Entidad): sus inicializaciones async se solapaban y disparaban
   "A second operation was started on this context instance". El tenant se resuelve igual (viene del
   IHttpContextAccessor singleton). *@

@* RQ01 - Calendario Habil (calcado del legacy ctrlCalendarioHabil.ascx). Control completo: dias habiles
   de la semana + jornada (izquierda) y calendario mensual visual con festivos + alta de festivo local
   (derecha). Siempre visible dentro de "Datos de la Entidad" y reutilizado por la pagina suelta. *@

<div class="chp-card">
    <div class="chp-head">
        <div class="chp-head-left">
            <div class="chp-icon"><i class="bi bi-calendar-week"></i></div>
            <div>
                <h3 class="chp-title">Calendario Hábil</h3>
                <p class="chp-sub">Defina días hábiles, jornada y festivos que servirán como base para el cálculo de términos legales.</p>
            </div>
        </div>
        <button type="button" class="chp-save" @onclick="GuardarConfigAsync" disabled="@_busy">
            <i class="bi bi-save"></i> Guardar
        </button>
    </div>

    @if (_flash is not null)
    {
        <div class="chp-alert @(_flashOk ? "ok" : "err")">@_flash</div>
    }

    <div class="chp-body">
        <div class="chp-layout">

            <!-- COLUMNA IZQUIERDA: dias habiles + jornada -->
            <div class="chp-sub-card">
                <div class="chp-sub-head">
                    <h4 class="chp-sub-title">Días Hábiles y Jornada</h4>
                    <p class="chp-sub-desc">Seleccione los días laborables de la entidad.</p>
                </div>
                <div class="chp-sub-body">
                    <span class="chp-section-title">Días hábiles de la semana</span>
                    <div class="chp-checks">
                        <label><input type="checkbox" @bind="_lun" /> Lunes</label>
                        <label><input type="checkbox" @bind="_mar" /> Martes</label>
                        <label><input type="checkbox" @bind="_mie" /> Miércoles</label>
                        <label><input type="checkbox" @bind="_jue" /> Jueves</label>
                        <label><input type="checkbox" @bind="_vie" /> Viernes</label>
                        <label><input type="checkbox" @bind="_sab" /> Sábado</label>
                        <label><input type="checkbox" @bind="_dom" /> Domingo</label>
                    </div>

                    <div class="chp-divider"></div>

                    <div class="chp-time-grid">
                        <div class="chp-field">
                            <label class="chp-label">Inicio Jornada</label>
                            <input type="time" class="chp-time" value="@_horaInicio" @onchange="e => _horaInicio = e.Value?.ToString() ?? _horaInicio" />
                        </div>
                        <div class="chp-field">
                            <label class="chp-label">Fin Jornada</label>
                            <input type="time" class="chp-time" value="@_horaFin" @onchange="e => _horaFin = e.Value?.ToString() ?? _horaFin" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: calendario mensual -->
            <div class="chp-sub-card">
                <div class="chp-sub-head chp-fest-toolbar">
                    <div class="chp-fest-title-wrap">
                        <div>
                            <h4 class="chp-sub-title">Festivos @_anio — @NombreMes(_mes)</h4>
                            <p class="chp-sub-desc">Calendario base de términos hábiles.</p>
                        </div>
                        <div class="chp-nav">
                            <button type="button" class="chp-nav-btn" @onclick="MesAnterior" title="Mes anterior"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="chp-nav-btn" @onclick="MesSiguiente" title="Mes siguiente"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                    <button type="button" class="chp-btn-light" @onclick="AbrirModal">
                        <i class="bi bi-plus-lg"></i> Agregar Festivo Local
                    </button>
                </div>

                <div class="chp-sub-body">
                    <div class="chp-cal">
                        <div class="chp-weekdays">
                            <div class="chp-weekday">DOM</div><div class="chp-weekday">LUN</div><div class="chp-weekday">MAR</div>
                            <div class="chp-weekday">MIÉ</div><div class="chp-weekday">JUE</div><div class="chp-weekday">VIE</div><div class="chp-weekday">SÁB</div>
                        </div>
                        <div class="chp-days">
                            @foreach (var cell in Celdas())
                            {
                                @if (cell is null)
                                {
                                    <div class="chp-cell is-empty"></div>
                                }
                                else
                                {
                                    var f = cell.Value;
                                    <div class="chp-cell @ClaseCelda(f)" title="@Tooltip(f)">@f.Day</div>
                                }
                            }
                        </div>
                    </div>

                    <div class="chp-legend">
                        <span class="chp-legend-item"><span class="chp-dot hoy"></span> Hoy</span>
                        <span class="chp-legend-item"><span class="chp-dot festivo"></span> Festivo</span>
                        <span class="chp-legend-item"><span class="chp-dot finsemana"></span> Fin de semana</span>
                    </div>

                    @{ var propios = _festivos.Where(x => !x.EsNacional).ToList(); }
                    @if (propios.Count > 0)
                    {
                        <div class="chp-propios">
                            <span class="chp-propios-title">Festivos propios de la entidad (@propios.Count)</span>
                            <div class="chp-chips">
                                @foreach (var p in propios)
                                {
                                    <span class="chp-chip">
                                        <strong>@p.Fecha.ToString("dd/MM")</strong> @p.Nombre
                                        <span class="chp-chip-tipo">@p.Tipo</span>
                                        <button type="button" class="chp-chip-x" title="Quitar" @onclick="() => EliminarAsync(p.Id)" disabled="@_busy">&times;</button>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <div class="chp-info">
                        <i class="bi bi-info-circle"></i>
                        <div>Precarga festivos nacionales de Colombia por año (Ley Emiliani + Pascua). El administrador puede agregar festivos locales. Base para cálculos de términos: Tutela, Derecho de Petición, Queja, etc.</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@if (_showModal)
{
    <div class="chp-modal-overlay" @onclick="CerrarModal">
        <div class="chp-modal" @onclick:stopPropagation="true">
            <div class="chp-modal-head">
                <div class="chp-head-left">
                    <div class="chp-icon"><i class="bi bi-calendar-plus"></i></div>
                    <div>
                        <h5 class="chp-modal-title">Agregar Festivo Local</h5>
                        <p class="chp-sub">Registre un festivo local o institucional adicional.</p>
                    </div>
                </div>
                <button type="button" class="chp-close" @onclick="CerrarModal">&times;</button>
            </div>
            <div class="chp-modal-body">
                @if (_modalMsg is not null) { <div class="chp-alert err">@_modalMsg</div> }
                <div class="chp-modal-grid">
                    <div class="chp-field">
                        <label class="chp-label">Fecha <span class="req">*</span></label>
                        <input type="date" class="chp-time" @bind="_mFecha" />
                    </div>
                    <div class="chp-field">
                        <label class="chp-label">Nombre del festivo <span class="req">*</span></label>
                        <input class="chp-time" maxlength="150" @bind="_mNombre" placeholder="Ej. Fiesta de la entidad" />
                    </div>
                    <div class="chp-field">
                        <label class="chp-label">Tipo <span class="req">*</span></label>
                        <select class="chp-time" @bind="_mTipo">
                            <option value="Local">LOCAL</option>
                            <option value="Institucional">INSTITUCIONAL</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="chp-modal-foot">
                <button type="button" class="chp-btn-cancel" @onclick="CerrarModal" disabled="@_busy">Cancelar</button>
                <button type="button" class="chp-btn-save" @onclick="GuardarFestivoAsync" disabled="@_busy"><i class="bi bi-check-lg"></i> Guardar Festivo</button>
            </div>
        </div>
    </div>
}


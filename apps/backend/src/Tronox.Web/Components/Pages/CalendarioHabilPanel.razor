@code {
    private ICalendarioHabilService CalSvc => ScopedServices.GetRequiredService<ICalendarioHabilService>();

    private bool _lun = true, _mar = true, _mie = true, _jue = true, _vie = true, _sab, _dom;
    private string _horaInicio = "08:00", _horaFin = "17:00";

    private IReadOnlyList<DiaFestivoDto> _festivos = Array.Empty<DiaFestivoDto>();
    private Dictionary<DateOnly, DiaFestivoDto> _mapa = new();

    private int _anio = DateTime.Today.Year;
    private int _mes = DateTime.Today.Month;

    private bool _busy;
    private string? _flash; private bool _flashOk;

    private bool _showModal;
    private string? _modalMsg;
    private DateOnly? _mFecha; private string _mNombre = ""; private string _mTipo = "Local";

    protected override async Task OnInitializedAsync()
    {
        var cfg = await CalSvc.ObtenerConfigAsync();
        _lun = cfg.Lunes; _mar = cfg.Martes; _mie = cfg.Miercoles; _jue = cfg.Jueves;
        _vie = cfg.Viernes; _sab = cfg.Sabado; _dom = cfg.Domingo;
        _horaInicio = cfg.JornadaInicio; _horaFin = cfg.JornadaFin;
        await CargarFestivosAsync();
    }

    private async Task CargarFestivosAsync()
    {
        _festivos = await CalSvc.ListarAsync(_anio);
        if (_festivos.Count == 0)
        {
            // Autosiembra los festivos nacionales del anio mostrado (equivalente a AsegurarFestivosNacionales).
            await CalSvc.SembrarAnioAsync(_anio);
            _festivos = await CalSvc.ListarAsync(_anio);
        }
        _mapa = _festivos.ToDictionary(f => f.Fecha, f => f);
    }

    private async Task GuardarConfigAsync()
    {
        _busy = true;
        try
        {
            var dto = new CalendarioConfigDto(_lun, _mar, _mie, _jue, _vie, _sab, _dom, _horaInicio, _horaFin);
            var r = await CalSvc.GuardarConfigAsync(dto);
            if (r == CalendarioGuardarResult.JornadaInvalida) { Flash("La hora de inicio debe ser menor que la hora final.", false); return; }
            Flash("Calendario hábil guardado correctamente.", true);
        }
        finally { _busy = false; }
    }

    private async Task MesAnterior()
    {
        var f = new DateOnly(_anio, _mes, 1).AddMonths(-1);
        _mes = f.Month; if (f.Year != _anio) { _anio = f.Year; await CargarFestivosAsync(); }
    }

    private async Task MesSiguiente()
    {
        var f = new DateOnly(_anio, _mes, 1).AddMonths(1);
        _mes = f.Month; if (f.Year != _anio) { _anio = f.Year; await CargarFestivosAsync(); }
    }

    private IEnumerable<DateOnly?> Celdas()
    {
        var primero = new DateOnly(_anio, _mes, 1);
        var dias = DateTime.DaysInMonth(_anio, _mes);
        var offset = (int)primero.DayOfWeek; // domingo = 0
        var total = offset + dias;
        if (total % 7 != 0) { total += 7 - (total % 7); }
        for (var i = 0; i < total; i++)
        {
            var d = i - offset + 1;
            yield return (i < offset || d > dias) ? (DateOnly?)null : new DateOnly(_anio, _mes, d);
        }
    }

    private string ClaseCelda(DateOnly f)
    {
        if (f == DateOnly.FromDateTime(DateTime.Today)) { return "is-today"; }
        if (_mapa.ContainsKey(f)) { return "is-holiday"; }
        if (f.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday) { return "is-weekend"; }
        return "";
    }

    private string Tooltip(DateOnly f)
        => _mapa.TryGetValue(f, out var d) ? d.Nombre : f.ToString("yyyy-MM-dd");

    private void AbrirModal()
    {
        _mFecha = null; _mNombre = ""; _mTipo = "Local"; _modalMsg = null; _showModal = true;
    }

    private void CerrarModal() => _showModal = false;

    private async Task GuardarFestivoAsync()
    {
        _modalMsg = null;
        if (_mFecha is null) { _modalMsg = "Debe indicar una fecha válida."; return; }
        if (string.IsNullOrWhiteSpace(_mNombre)) { _modalMsg = "Debe indicar el nombre del festivo."; return; }
        _busy = true;
        try
        {
            var r = await CalSvc.AgregarAsync(_mFecha.Value, _mNombre, _mTipo);
            if (r is null) { _modalMsg = "Ya existe un día no hábil en esa fecha."; return; }
            _showModal = false;
            // Muestra el mes del festivo agregado.
            _mes = _mFecha.Value.Month;
            if (_mFecha.Value.Year != _anio) { _anio = _mFecha.Value.Year; }
            await CargarFestivosAsync();
            Flash("Festivo guardado correctamente.", true);
        }
        finally { _busy = false; }
    }

    private async Task EliminarAsync(long id)
    {
        _busy = true;
        try { await CalSvc.EliminarAsync(id); await CargarFestivosAsync(); }
        finally { _busy = false; }
    }

    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }

    private static string NombreMes(int mes) => mes switch
    {
        1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril", 5 => "Mayo", 6 => "Junio",
        7 => "Julio", 8 => "Agosto", 9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre", _ => ""
    };
}

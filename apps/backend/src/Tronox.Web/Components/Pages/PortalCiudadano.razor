</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private long? _tid;
    private bool _notFound;
    private PortalPublicoDto? _portal;
    private string _view = "home";
    private int _paso = 1;
    private bool _busy;
    private string? _error;

    private readonly string[] _stepLabels = { "Identificacion", "Solicitud", "Confirmar" };
    private readonly (string val, string lbl)[] _remitenteOpts =
    {
        ("natural", "Persona Natural"), ("juridica", "Empresa"), ("publica", "Entidad Publica"), ("anonimo", "Anonimo")
    };

    private PortalRadicarRequest _req = new() { RemitenteTipoDoc = "CC" };
    private string _tipoRemitente = "natural";
    private string _captchaTxt = "";
    private bool _autoriza, _veraz;
    private PortalRadicarResult? _comprobante;

    private string _cNumero = "", _cDocumento = "";
    private PortalConsultaResult? _consulta;

    protected override async Task OnInitializedAsync()
    {
        _tid = await PortalSvc.ResolverTenantAsync(Slug);
        if (_tid is null) { _notFound = true; return; }
        using (AmbientTenantContext.Begin(_tid.Value)) { _portal = await PortalSvc.GetPortalAsync(); }
        if (_portal is null) { _notFound = true; }
    }

    private void IrWizardNuevo() { _paso = 1; _error = null; _view = "wizard"; }

    private void ElegirTipo(TipoPublicoDto t) { _req.TipoComunicacionId = t.Id; _paso = 1; _error = null; _view = "wizard"; }
    private void ElegirTipoWizard(TipoPublicoDto t) { _req.TipoComunicacionId = t.Id; }

    private void Paso1Next()
    {
        _error = null;
        if (_portal!.ExigirCaptcha && string.IsNullOrWhiteSpace(_captchaTxt)) { _error = "Escriba el codigo de verificacion."; return; }
        if (_tipoRemitente != "anonimo")
        {
            if (string.IsNullOrWhiteSpace(_req.RemitenteDocumento) || string.IsNullOrWhiteSpace(_req.RemitenteNombre)) { _error = "Documento y nombre son obligatorios."; return; }
        }
        if (!_autoriza) { _error = "Debe autorizar el tratamiento de datos personales (Ley 1581/2012)."; return; }
        _paso = 2;
    }

    private void Paso2Next()
    {
        _error = null;
        if (_req.TipoComunicacionId <= 0) { _error = "Seleccione el tipo de solicitud."; return; }
        if (string.IsNullOrWhiteSpace(_req.Asunto)) { _error = "El asunto es obligatorio."; return; }
        _paso = 3;
    }

    private async Task RadicarAsync()
    {
        _error = null;
        if (!_veraz) { _error = "Debe certificar que la informacion es veraz."; return; }
        _busy = true;
        try
        {
            _req.Anonimo = _tipoRemitente == "anonimo";
            _req.CaptchaOk = !_portal!.ExigirCaptcha || !string.IsNullOrWhiteSpace(_captchaTxt);
            using (AmbientTenantContext.Begin(_tid!.Value))
            {
                var res = await PortalSvc.RadicarAsync(_req);
                if (!res.Ok) { _error = res.Error; return; }
                _comprobante = res;
                _view = "exito";
            }
        }
        finally { _busy = false; }
    }

    private void OtraSolicitud()
    {
        _req = new() { RemitenteTipoDoc = "CC" };
        _tipoRemitente = "natural"; _captchaTxt = ""; _autoriza = false; _veraz = false; _comprobante = null; _error = null;
        _paso = 1; _view = "wizard";
    }

    private async Task ConsultarAsync()
    {
        _busy = true;
        try
        {
            using (AmbientTenantContext.Begin(_tid!.Value)) { _consulta = await PortalSvc.ConsultarAsync(_cNumero, _cDocumento); }
        }
        finally { _busy = false; }
    }

    private async Task Copiar()
    {
        if (_comprobante is not null) { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _comprobante.Numero); }
    }

    private RenderFragment RenderFaq() => __builder =>
    {
        var faq = _portal?.Faq;
        if (string.IsNullOrWhiteSpace(faq)) { <span>-</span> return; }
        foreach (var linea in faq.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = linea.Split('|', 2);
            <div style="font-weight:700;color:#212529;margin-top:10px">@parts[0]</div>
            if (parts.Length > 1) { <div>@parts[1]</div> }
        }
    };

    private RenderFragment ResRow(string k, string? v) => __builder =>
    {
        <div class="res-row"><span class="k">@k</span><span class="v">@(string.IsNullOrWhiteSpace(v) ? "-" : v)</span></div>
    };

    private RenderFragment Semaforo(int? dias) => __builder =>
    {
        var (bg, fg, txt) = dias is null ? ("#F1F5F9", "#64748B", "Sin termino")
            : dias < 0 ? ("#FEE2E2", "#991B1B", $"{Math.Abs(dias.Value)} dia(s) de retraso")
            : dias <= 3 ? ("#FEF3C7", "#92400E", $"{dias} dia(s) restantes")
            : ("#D1FAE5", "#0a7d6f", $"{dias} dia(s) restantes");
        <span class="sem" style="background:@bg;color:@fg"><span class="dot" style="background:@fg"></span>@txt</span>
    };
}

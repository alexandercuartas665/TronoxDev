@page "/portal/{Slug}"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Radicacion
@using Tronox.Web.Auth
@inject IPortalCiudadanoService PortalSvc
@inject IJSRuntime JS

@* RQ09 - RF03 (Portal ciudadano, port de rad_portal). Diseno CALCADO del legacy VB.NET (hero + tarjetas
   de tipos + wizard de 3 pasos + exito + consulta con semaforo/timeline), con su CSS tal cual. Superficie
   publica; tenant por slug (ADR-014); radicar reutiliza RadicadorService. Captcha como refuerzo (toggle);
   adjuntos diferidos (upload). *@

<PageTitle>Portal de Radicacion</PageTitle>

@if (_notFound)
{
    <div class="pt-load"><div style="color:#B91C1C;font-size:14px">No fue posible cargar el portal.</div></div>
}
else if (_portal is null)
{
    <div class="pt-load"><div class="pt-spin"></div><div>Cargando portal...</div></div>
}
else
{
    var navy = _portal.Color ?? "#405189";
    <div style="--navy:@navy">

    @if (_view == "home" || _view == "wizard" || _view == "consulta")
    {
        @* ══ RF03-1 — Inicio del portal ══ *@
        <div>
            <div class="pt-hero">
                <div class="pt-hero-top">
                    <h1>@(_portal.NombreEntidad) &mdash; Sede Electronica</h1>
                    <div class="s">Portal ciudadano</div>
                </div>
                <div class="pt-hero-main">
                    <h2>Radique su solicitud en linea</h2>
                    <p>@(_portal.Banner ?? "Presente peticiones, quejas, recursos, denuncias y demas comunicaciones directamente desde este portal. Recibira su numero de radicado de forma inmediata.")</p>
                    <button type="button" class="pt-btn blanco" @onclick="IrWizardNuevo">&rarr; Radicar nueva solicitud</button>
                    <button type="button" class="pt-btn borde" @onclick='() => _view = "consulta"'>&#128269; Consultar estado</button>
                </div>
            </div>
            <div class="pt-sec">
                <h3>Tipos de solicitud que puede radicar</h3>
                <div class="sub">Estos son los tramites disponibles. Elegira el tipo al iniciar la radicacion.</div>
                <div class="pt-cards">
                    @if (_portal.Tipos.Count == 0)
                    {
                        <div style="color:#94A3B8;font-size:13px">No hay tipos habilitados en el portal.</div>
                    }
                    @foreach (var t in _portal.Tipos)
                    {
                        <div class="pt-card" style="border-top-color:@(t.Color ?? "#405189")" @onclick="@(() => ElegirTipo(t))">
                            <div class="ic">@(string.IsNullOrEmpty(t.Icono) ? "\U0001F4CB" : t.Icono)</div>
                            <div class="n">@t.Nombre</div>
                            <div class="t">@t.Termino</div>
                            @if (t.EsPqrsd) { <div class="pq">&#9733; PQRSD</div> }
                        </div>
                    }
                </div>
            </div>
            <div class="pt-sec" style="padding-top:6px">
                <div class="pt-info">
                    <div class="pt-box"><b class="t">&#128222; Canales de atencion</b>@(_portal.CanalesAtencion ?? "-")</div>
                    <div class="pt-box"><b class="t">&#10067; Preguntas frecuentes</b>@RenderFaq()</div>
                    <div class="pt-box"><b class="t">&#128274; Aviso de privacidad - Ley 1581/2012</b>@(_portal.AvisoPrivacidad ?? "")</div>
                </div>
            </div>
            <div class="pt-footer">&copy; @DateTime.Now.Year @(_portal.NombreEntidad) &middot; Sistema de Gestion Documental &middot; Datos protegidos (Ley 1581/2012)</div>
        </div>
    }

    @* ══ RF03-2 — Wizard de radicacion (pop-up) ══ *@
    @if (_view == "wizard")
    {
        <div class="pt-modal">
            <div class="wc-wrap">
                <div class="wc">
                    <div class="wc-head">
                        <div class="av">@((_portal.NombreEntidad ?? "T").Substring(0, 1))</div>
                        <div><div class="e">@_portal.NombreEntidad</div><div class="s">@(_portal.Subtitulo)</div></div>
                        <button type="button" class="wc-x" @onclick='() => _view = "home"' title="Cerrar">&#10005;</button>
                    </div>
                    <div class="wc-steps">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var cls = _paso > i ? "done" : _paso == i ? "cur" : "";
                            <div class="wc-step @cls"><div class="b">@(_paso > i ? "✓" : i.ToString())</div><span class="l">@(_stepLabels[i - 1])</span></div>
                            if (i < 3) { <div class="wc-line @(_paso > i ? "done" : "")"></div> }
                        }
                    </div>
                    <div class="wc-body">
                        @if (_paso == 1)
                        {
                            <h3>Sus datos</h3>
                            <div class="sub">Complete la verificacion de seguridad e identifiquese para recibir su comprobante y respuesta.</div>
                            @if (_portal.ExigirCaptcha)
                            {
                                <div class="fld"><label>Verificacion de seguridad <span class="req">*</span></label>
                                    <div class="cap2">
                                        <input class="in" @bind="_captchaTxt" maxlength="5" autocomplete="off" placeholder="CODIGO" />
                                    </div>
                                    <div class="hint">Escriba el codigo (reCAPTCHA v3 reforzara esta validacion)</div>
                                </div>
                            }
                            <div style="margin-bottom:14px">
                                @foreach (var (val, lbl) in _remitenteOpts)
                                {
                                    if (val == "anonimo" && !_portal.PermitirAnonimo) { continue; }
                                    <button type="button" class="chip @(_tipoRemitente == val ? "on" : "")" @onclick="@(() => _tipoRemitente = val)">@lbl</button>
                                }
                            </div>
                            @if (_tipoRemitente != "anonimo")
                            {
                                <div class="grid2">
                                    <div class="fld"><label>Tipo de documento <span class="req">*</span></label>
                                        <select class="in" @bind="_req.RemitenteTipoDoc">
                                            @foreach (var d in new[] { "CC", "NIT", "CE", "Pasaporte", "TI", "PPT" }) { <option>@d</option> }
                                        </select>
                                    </div>
                                    <div class="fld"><label>Numero de documento <span class="req">*</span></label>
                                        <input class="in" @bind="_req.RemitenteDocumento" placeholder="Ej: 1.020.456.789" /></div>
                                </div>
                                <div class="fld"><label>Nombre completo <span class="req">*</span></label>
                                    <input class="in" @bind="_req.RemitenteNombre" placeholder="Nombre o razon social" /></div>
                                <div class="grid2b">
                                    <div class="fld"><label>Correo electronico <span class="req">*</span></label>
                                        <input class="in" type="email" @bind="_req.RemitenteEmail" placeholder="correo@@ejemplo.com" />
                                        <div class="hint">Aqui recibira su comprobante</div></div>
                                    <div class="fld"><label>Telefono</label><input class="in" @bind="_req.RemitenteTelefono" placeholder="Numero de contacto" /></div>
                                </div>
                            }
                            else
                            {
                                <div class="fld" style="background:#FEF3C7;border:1px solid #F59E0B;border-radius:10px;padding:12px 14px;font-size:13px;color:#92400E">Radicacion anonima: no recibira comprobante por correo. Guarde su numero de radicado al finalizar.</div>
                            }
                            <label class="chk"><input type="checkbox" @bind="_autoriza" /> <span>Autorizo el tratamiento de mis datos personales conforme a la Ley 1581 de 2012 y la politica de privacidad de la entidad. <span class="req">*</span></span></label>
                            @if (_error is not null) { <div class="pt-inerr">@_error</div> }
                            <div class="wc-foot"><span></span><button type="button" class="pt-btn navy" @onclick="Paso1Next">Continuar &rarr;</button></div>
                        }
                        else if (_paso == 2)
                        {
                            <h3>Su solicitud</h3>
                            <div class="sub">Elija el tipo de solicitud, describala y adjunte documentos de soporte.</div>
                            <div class="fld"><label>Tipo de solicitud <span class="req">*</span></label>
                                <div class="tcards">
                                    @foreach (var t in _portal.Tipos)
                                    {
                                        <button type="button" class="tcard @(_req.TipoComunicacionId == t.Id ? "on" : "")" @onclick="@(() => ElegirTipoWizard(t))">
                                            <div class="n">@(string.IsNullOrEmpty(t.Icono) ? "\U0001F4CB" : t.Icono) @t.Nombre</div>
                                            <div class="t">@t.Termino.Replace("Respuesta: ", "")</div>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="fld"><label>Asunto <span class="req">*</span></label>
                                <input class="in" maxlength="500" @bind="_req.Asunto" @bind:event="oninput" placeholder="Resuma su solicitud en una frase" />
                                <div class="hint">@((_req.Asunto ?? "").Length)/500 caracteres</div></div>
                            <div class="fld"><label>Descripcion detallada</label>
                                <textarea class="in" rows="4" @bind="_req.Descripcion" placeholder="Explique con detalle su solicitud..."></textarea></div>
                            <div class="fld"><label>Documentos adjuntos</label>
                                <div class="drop"><div style="font-size:26px">&#128206;</div>
                                    <div style="font-weight:700;font-size:14px;margin-top:6px">Adjuntar archivos</div>
                                    <div style="font-size:12px;color:#94A3B8;margin-top:3px">La carga de adjuntos se habilita en una segunda pasada</div></div>
                                <div class="hint">Formatos: PDF, JPG, PNG &middot; Max. @_portal.MaxAdjuntoMb MB por archivo</div></div>
                            @if (_error is not null) { <div class="pt-inerr">@_error</div> }
                            <div class="wc-foot"><button type="button" class="pt-btn soft" @onclick="@(() => _paso = 1)">&larr; Atras</button><button type="button" class="pt-btn navy" @onclick="Paso2Next">Revisar &rarr;</button></div>
                        }
                        else
                        {
                            var t = _portal.Tipos.FirstOrDefault(x => x.Id == _req.TipoComunicacionId);
                            <h3>Confirme su radicacion</h3>
                            <div class="sub">Revise la informacion antes de enviar. Una vez radicada no podra modificarla.</div>
                            <div class="resumen">
                                @ResRow("Tipo de solicitud", t?.Nombre ?? "-")
                                @ResRow("Solicitante", _tipoRemitente == "anonimo" ? "Anonimo" : _req.RemitenteNombre)
                                @ResRow("Documento", _tipoRemitente == "anonimo" ? "-" : $"{_req.RemitenteTipoDoc} {_req.RemitenteDocumento}")
                                @ResRow("Correo", _tipoRemitente == "anonimo" ? "-" : _req.RemitenteEmail)
                                @ResRow("Asunto", _req.Asunto)
                                @ResRow("Termino de respuesta", t?.Termino.Replace("Respuesta: ", "") ?? "-")
                            </div>
                            <label class="chk"><input type="checkbox" @bind="_veraz" /> <span>Certifico que la informacion suministrada es veraz y asumo la responsabilidad correspondiente. <span class="req">*</span></span></label>
                            @if (_error is not null) { <div class="pt-inerr">@_error</div> }
                            <div class="wc-foot"><button type="button" class="pt-btn soft" @onclick="@(() => _paso = 2)">&larr; Atras</button>
                                <button type="button" class="pt-btn verde" @onclick="RadicarAsync" disabled="@_busy">&#10003; Radicar solicitud</button></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ══ RF03-3 — Radicacion exitosa ══ *@
    @if (_view == "exito" && _comprobante is not null)
    {
        <div class="exito-wrap">
            <div class="exito">
                <div class="ic">&#9989;</div>
                <h2>&iexcl;Solicitud radicada!</h2>
                <div class="sub">Su solicitud fue recibida correctamente. Guarde su numero de radicado para hacer seguimiento.</div>
                <div class="numbox">
                    <div class="l">NUMERO DE RADICADO</div>
                    <div class="num">@_comprobante.Numero</div>
                    <div style="margin-top:12px"><button type="button" class="pt-btn soft" @onclick="Copiar">&#128203; Copiar numero</button></div>
                </div>
                <div class="meta">Token de seguimiento: <b>@_comprobante.Token</b> &middot; guardelo para consultar el estado.</div>
                <div class="acc">
                    <button type="button" class="pt-btn soft" @onclick='() => _view = "consulta"'>&#128269; Consultar estado</button>
                    <button type="button" class="pt-btn soft" @onclick="OtraSolicitud">Radicar otra solicitud</button>
                </div>
            </div>
        </div>
    }

    @* ══ RF03-4 — Consulta ciudadana (pop-up) ══ *@
    @if (_view == "consulta")
    {
        <div class="pt-modal">
            <div class="wc-wrap" style="max-width:640px">
                <div class="wc">
                    <div class="wc-head">
                        <div class="av">@((_portal.NombreEntidad ?? "T").Substring(0, 1))</div>
                        <div><div class="e">Consultar estado de mi radicado</div><div class="s">@_portal.NombreEntidad</div></div>
                        <button type="button" class="wc-x" @onclick='() => { _view = "home"; _consulta = null; }' title="Cerrar">&#10005;</button>
                    </div>
                    <div class="wc-body">
                        <div class="sub">Ingrese el numero de radicado y el documento del solicitante.</div>
                        <div class="fld"><label>Numero de radicado <span class="req">*</span></label>
                            <input class="in" @bind="_cNumero" placeholder="Ej: TRNX-E-2026-000147" style="font-family:Consolas,monospace" /></div>
                        <div class="fld"><label>Numero de documento del solicitante <span class="req">*</span></label>
                            <input class="in" @bind="_cDocumento" placeholder="Documento con el que radico" /></div>
                        <div class="wc-foot"><span></span><button type="button" class="pt-btn navy" @onclick="ConsultarAsync" disabled="@_busy">&#128269; Consultar</button></div>
                        <div style="margin-top:18px">
                            @if (_consulta is not null && !_consulta.Ok)
                            {
                                <div class="fld" style="background:#FEF2F2;border:1px solid #FCA5A5;border-radius:10px;padding:12px 14px;font-size:13px;color:#B91C1C">@_consulta.Error</div>
                            }
                            else if (_consulta is not null && _consulta.Ok)
                            {
                                <div class="resumen">
                                    @ResRow("Radicado", _consulta.Numero)
                                    @ResRow("Tipo", _consulta.TipoNombre)
                                    @ResRow("Fecha de radicacion", _consulta.Fecha)
                                    @ResRow("Estado actual", _consulta.Estado)
                                    @ResRow("Dependencia responsable", _consulta.Dependencia ?? "-")
                                    <div class="res-row"><span class="k">Termino</span><span class="v">@Semaforo(_consulta.DiasRestantes)</span></div>
                                </div>
                                @if (_consulta.Timeline.Count > 0)
                                {
                                    <b style="font-size:14px">Linea de tiempo</b>
                                    <div class="tl">
                                        @foreach (var ev in _consulta.Timeline)
                                        {
                                            <div class="tl-item">@ev.Evento<div class="f">@ev.Fecha</div></div>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_consulta.RespuestaPublica))
                                {
                                    <div class="fld" style="background:#F0FDF4;border:1px solid #86EFAC;border-radius:10px;padding:14px 16px;font-size:13.5px;color:#166534;margin-top:14px"><b>Respuesta de la entidad:</b><br />@_consulta.RespuestaPublica</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    </div>
}

<style>
    /* RQ09 RF03 - Portal ciudadano (CALCADO del legacy rad_portal.aspx) */
    .pt-load { min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 14px; color: #566980; font-size: 13px; background:#F1F5F9; }
    .pt-spin { width: 42px; height: 42px; border-radius: 50%; border: 4px solid #E2E8F0; border-top-color: #405189; animation: ptspin .8s linear infinite; }
    @@keyframes ptspin { to { transform: rotate(360deg); } }
    body, .pt-hero { font-family: Poppins, 'Segoe UI', Arial, sans-serif; }
    .pt-hero { background: var(--navy, #405189); color: #fff; }
    .pt-hero h1, .pt-hero h2, .pt-hero p, .pt-hero .s { color: #fff !important; }
    .pt-hero-top { padding: 22px 5%; }
    .pt-hero-top h1 { margin: 0; font-size: 24px; font-weight: 800; }
    .pt-hero-top .s { font-size: 13px; opacity: .85; margin-top: 3px; }
    .pt-hero-main { padding: 34px 5% 44px; }
    .pt-hero-main h2 { margin: 0 0 12px; font-size: 32px; font-weight: 800; }
    .pt-hero-main p { margin: 0 0 22px; font-size: 15px; opacity: .9; max-width: 640px; line-height: 1.6; }
    .pt-btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; border: none; }
    .pt-btn.blanco { background: #fff; color: var(--navy, #405189); }
    .pt-btn.borde { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.6); margin-left: 10px; }
    .pt-btn.navy { background: var(--navy, #405189); color: #fff; }
    .pt-btn.verde { background: #0ab39c; color: #fff; }
    .pt-btn.soft { background: #fff; color: #566980; border: 1px solid #D5DDE9; }
    .pt-sec { padding: 30px 5%; background:#F1F5F9; }
    .pt-sec h3 { font-size: 18px; font-weight: 800; margin: 0 0 4px; }
    .pt-sec .sub { font-size: 13px; color: #64748B; margin-bottom: 18px; }
    .pt-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
    .pt-card { background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 1px 3px rgba(0,0,0,.07); border-top: 3px solid #405189; cursor: pointer; transition: transform .15s, box-shadow .15s; }
    .pt-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,.12); }
    .pt-card .ic { font-size: 24px; margin-bottom: 8px; }
    .pt-card .n { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
    .pt-card .t { font-size: 12.5px; color: #64748B; }
    .pt-card .pq { font-size: 11px; color: #7C3AED; font-weight: 700; margin-top: 6px; }
    .pt-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .pt-box { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.07); font-size: 13px; line-height: 1.7; color: #475569; white-space:pre-wrap; }
    .pt-box b.t { display: block; font-size: 14px; color: #212529; margin-bottom: 8px; }
    .pt-footer { text-align: center; font-size: 12px; color: #94A3B8; padding: 24px 5% 36px; background:#F1F5F9; }
    .wc-wrap { max-width: 860px; margin: 26px auto 40px; padding: 0 16px; }
    .wc { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .wc-head { background: var(--navy, #405189); color: #fff; padding: 18px 26px; display: flex; align-items: center; gap: 14px; }
    .wc-head .av { width: 42px; height: 42px; border-radius: 10px; background: #0ab39c; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; flex-shrink: 0; }
    .wc-head .e { font-size: 17px; font-weight: 800; }
    .wc-head .s { font-size: 12px; opacity: .85; }
    .wc-steps { display: flex; align-items: center; justify-content: center; padding: 16px 26px; border-bottom: 1px solid #E2E8F0; gap: 0; }
    .wc-step { display: flex; align-items: center; gap: 8px; }
    .wc-step .b { width: 28px; height: 28px; border-radius: 50%; background: #E2E8F0; color: #94A3B8; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .wc-step.cur .b { background: var(--navy, #405189); color: #fff; }
    .wc-step.done .b { background: #0ab39c; color: #fff; }
    .wc-step .l { font-size: 12.5px; color: #94A3B8; }
    .wc-step.cur .l { color: var(--navy, #405189); font-weight: 700; }
    .wc-step.done .l { color: #0ab39c; }
    .wc-line { width: 90px; max-width: 14vw; height: 2px; background: #E2E8F0; margin: 0 12px; }
    .wc-line.done { background: #0ab39c; }
    .wc-body { padding: 26px 8%; }
    .wc-body h3 { margin: 0 0 4px; font-size: 20px; font-weight: 800; }
    .wc-body .sub { font-size: 13px; color: #64748B; margin-bottom: 18px; }
    .wc-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 22px; }
    .fld { margin-bottom: 16px; }
    .fld label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px; }
    .fld label .req { color: #EF4444; }
    .fld .hint { font-size: 11.5px; color: #94A3B8; margin-top: 3px; }
    .in { width: 100%; padding: 11px 13px; border-radius: 9px; border: 1px solid #D5DDE9; font-size: 14px; font-family: inherit; outline: none; }
    .in:focus { border-color: var(--navy, #405189); }
    .grid2 { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; }
    .grid2b { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @@media (max-width: 560px) { .grid2, .grid2b { grid-template-columns: 1fr; } }
    .chip { padding: 10px 18px; border-radius: 22px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1px solid #D5DDE9; background: #fff; color: #566980; font-family: inherit; margin: 0 8px 8px 0; }
    .chip.on { border-color: var(--navy, #405189); color: var(--navy, #405189); box-shadow: inset 0 0 0 1px var(--navy, #405189); }
    .cap2 { display: flex; align-items: center; gap: 10px; }
    .cap2 input { flex: 1; text-transform: uppercase; letter-spacing: 3px; font-weight: 700; font-family: Consolas, monospace; }
    .pt-modal { position: fixed; inset: 0; background: rgba(15,23,42,.55); z-index: 100; overflow-y: auto; padding: 3vh 14px; }
    .pt-modal .wc-wrap { margin: 0 auto; }
    .wc-x { margin-left: auto; background: rgba(255,255,255,.15); border: none; color: #fff; width: 32px; height: 32px; border-radius: 8px; font-size: 15px; cursor: pointer; flex-shrink: 0; }
    .chk { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: #F8FAFC; border-radius: 10px; font-size: 13px; color: #475569; cursor: pointer; line-height: 1.5; margin-bottom:8px; }
    .chk input { margin-top: 3px; }
    .tcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 6px; }

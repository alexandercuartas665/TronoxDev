        _fSerieAsigId = 0;
        _advSeries = _fDepId > 0 ? await Svc.GetSeriesParaCrearAsync(_fDepId) : [];
    }

    private async Task ClearFilters()
    {
        _fTexto = ""; _fEstado = ""; _fFase = ""; _fNivelId = 0; _fDepId = 0; _fSerieAsigId = 0;
        _fDesde = null; _fHasta = null; _advSeries = []; _page = 1;
        await LoadBandeja();
    }

    // ---- Paginacion ----
    private int TotalPages => _bandeja is null ? 1 : Math.Max(1, (int)Math.Ceiling(_bandeja.Items.Count / (double)PerPage));
    private List<ExpedienteBandejaItemDto> PagedItems => _bandeja is null ? [] : _bandeja.Items.Skip((_page - 1) * PerPage).Take(PerPage).ToList();
    private int PageFrom => _bandeja is null || _bandeja.Items.Count == 0 ? 0 : (_page - 1) * PerPage + 1;
    private int PageTo => _bandeja is null ? 0 : Math.Min(_page * PerPage, _bandeja.Items.Count);
    private void GoTo(int p) { _page = Math.Clamp(p, 1, TotalPages); }
    private IEnumerable<int> PageNumbers()
    {
        var from = Math.Max(1, _page - 2);
        var to = Math.Min(TotalPages, _page + 2);
        for (var i = from; i <= to; i++) { yield return i; }
    }

    // ---- Seleccion ----
    private bool AllPageSelected => PagedItems.Count > 0 && PagedItems.All(i => _selected.Contains(i.Id));
    private void ToggleRow(long id) { if (!_selected.Remove(id)) { _selected.Add(id); } }
    private void ToggleAllPage()
    {
        if (AllPageSelected) { foreach (var i in PagedItems) { _selected.Remove(i.Id); } }
        else { foreach (var i in PagedItems) { _selected.Add(i.Id); } }
    }


                        <label style="font-size:12px;font-weight:700;color:#334155;display:block;margin-bottom:4px;">Rótulos por hoja</label>
                        <select class="exp-sel full" value="@_rotPorHoja" @onchange="OnPorHojaChanged">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:700;color:#334155;display:block;margin-bottom:4px;">Posición de inicio <span style="font-weight:400;color:#94A3B8;">(hoja parcial)</span></label>
                        <select class="exp-sel full" value="@_rotPosicion" @onchange="@((ChangeEventArgs e) => _rotPosicion = int.TryParse(e.Value?.ToString(), out var v) ? v : 1)">
                            @for (var i = 1; i <= _rotPorHoja; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="exp-btn" @onclick="@(() => _showRotulos = false)">Cancelar</button>
                <button class="exp-btn exp-btn-primary" disabled="@_rotBusy" @onclick="GenerarRotulos"><i class="bi bi-download"></i> Generar PDF</button>
            </div>
        </div>
    </div>
}


    private void AbrirRotulos()
    {
        _rotError = null;
        _rotTam = RotuloTamano.Caja;
        _rotPorHoja = 4;
        _rotPosicion = 1;
        _showRotulos = true;
    }

    private void OnPorHojaChanged(ChangeEventArgs e)
    {
        _rotPorHoja = int.TryParse(e.Value?.ToString(), out var v) ? v : 4;
        if (_rotPosicion > _rotPorHoja) { _rotPosicion = 1; }
    }

    private async Task GenerarRotulos()
    {
        if (_rotBusy) { return; }
        _rotError = null;
        var ids = _selected.ToList();
        if (ids.Count == 0) { _rotError = "Seleccione al menos un expediente."; return; }
        _rotBusy = true;
        try
        {
            var res = await Svc.GenerarRotulosAsync(ids, _rotTam, _rotPorHoja, _rotPosicion, Actor);
            if (res.IsOk && res.Value is not null)
            {
                var nombre = $"Rotulos_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
                await JS.InvokeVoidAsync("tronoxDownload", nombre, "application/pdf", Convert.ToBase64String(res.Value));
                _showRotulos = false;
                Toast("Rótulos generados.");
            }
            else
            {
                _rotError = res.Error ?? "No se pudieron generar los rótulos.";
            }
        }
        finally
        {
            _rotBusy = false;
        }
    }


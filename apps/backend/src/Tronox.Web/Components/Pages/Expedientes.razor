@page "/modulo/expedientes-mios"
@attribute [Authorize(Policy = "Perm:modulo/expedientes-mios:View")]
@* RQ03 - Gestion Integral de Expedientes / "Mis Expedientes" (RF01). Bandeja calcada del legacy
   exp_bandeja.aspx: sistema visual .exp-*, 5 KPIs, pestanas contextuales, filtros rapidos + avanzados,
   seleccion masiva, paginacion, badges pill. Crear/Editar/Eliminar (logico) + Detalle. Visibilidad por
   clasificacion fail-closed (RF10) resuelta en el servicio. Funciones diferidas (FUID, Alertas, Rotulos,
   Transferencias, Mis Vistas, exportadores) se muestran con su UI pero avisan "proximamente". *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Expedientes
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IExpedienteService Svc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Mis Expedientes - TRONOX SGDEA</PageTitle>

<div class="exp-wrap">

    <nav class="tronox-breadcrumb" aria-label="Ruta de navegación">
        <a href="/inicio">Inicio</a><span class="sep">/</span>
        <span>Gestión Documental</span><span class="sep">/</span>
        <span>Gestión Integral de Expedientes</span><span class="sep">/</span>
        <span class="cur">@VistaLabel(_vista)</span>
    </nav>

    @* ===================== HEADER ===================== *@
    <div class="exp-page-header">
        <div>
            <h1 class="exp-page-title">Gestión de Expedientes</h1>
            <p class="exp-page-sub">@VistaLabel(_vista) · Archivo de Gestión · @_entidadNombre</p>
        </div>
        <div class="exp-page-actions">
            <button class="exp-btn" @onclick="AbrirAlertas" title="Alertas activas">
                <i class="bi bi-bell"></i> Alertas
                @if (_alertasCount > 0) { <span class="exp-badge-count">@_alertasCount</span> }
            </button>
            <button class="exp-btn" @onclick="@(() => _showColumnas = true)" title="Configurar columnas"><i class="bi bi-layout-three-columns"></i> Vista</button>
            <button class="exp-btn" @onclick='() => Toast("El submódulo de Transferencias llega en una fase posterior de RQ03.")' title="Transferencias">
                <i class="bi bi-arrow-left-right"></i> Transferencias
                @if (_transfCount > 0) { <span class="exp-badge-count">@_transfCount</span> }
            </button>
            <button class="exp-btn" @onclick="@(() => _showFuid = true)" title="Generar FUID"><i class="bi bi-table"></i> FUID</button>
            @if (_canCreate)
            {
                <button class="exp-btn exp-btn-primary" @onclick="OpenCrear"><i class="bi bi-folder-plus"></i> Nuevo Expediente</button>
            }
        </div>
    </div>

    @if (_pageOk is not null) { <div class="exp-flash ok"><i class="bi bi-check-circle"></i> @_pageOk</div> }
    @if (_pageError is not null) { <div class="exp-flash err"><i class="bi bi-exclamation-triangle"></i> @_pageError</div> }

    @* ===================== KPIs ===================== *@
    <div class="exp-stats">
        <div class="exp-stat">
            <div class="exp-stat-ic blue"><i class="bi bi-folder2"></i></div>
            <div><div class="exp-stat-num">@(_bandeja?.Stats.Total ?? 0)</div><div class="exp-stat-label">Total expedientes</div></div>
        </div>
        <div class="exp-stat">
            <div class="exp-stat-ic green"><i class="bi bi-check-circle"></i></div>
            <div><div class="exp-stat-num">@(_bandeja?.Stats.Abiertos ?? 0)</div><div class="exp-stat-label">Abiertos</div></div>
        </div>
        <div class="exp-stat">
            <div class="exp-stat-ic red"><i class="bi bi-x-circle"></i></div>
            <div><div class="exp-stat-num">@(_bandeja?.Stats.Cerrados ?? 0)</div><div class="exp-stat-label">Cerrados</div></div>
        </div>
        <div class="exp-stat">
            <div class="exp-stat-ic amber"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="exp-stat-num amber">@_alertasCount</div><div class="exp-stat-label">Con alertas activas</div></div>
        </div>
        <div class="exp-stat">
            <div class="exp-stat-ic purple"><i class="bi bi-arrow-repeat"></i></div>
            <div><div class="exp-stat-num">@_transfCount</div><div class="exp-stat-label">Pendientes transferencia</div></div>
        </div>
    </div>

    @* ===================== TABS ===================== *@
    <div class="exp-tabs">
        @foreach (var v in _vistas)
        {
            var vv = v;
            <button class="exp-tab @(_vista == vv ? "active" : "")" @onclick="@(() => SwitchVista(vv))">@VistaLabel(vv)</button>
        }
        <button class="exp-tab star" @onclick='() => Toast("Las vistas personalizadas (Mis Vistas) llegan en una fase posterior de RQ03.")' title="Mis Vistas"><i class="bi bi-star"></i> Mis Vistas</button>
    </div>

    @* ===================== TOOLBAR ===================== *@
    <div class="exp-toolbar">
        <div class="exp-search-wrap">
            <i class="bi bi-search"></i>
            <input class="exp-search" placeholder="Buscar por código, nombre o serie..."
                   @bind="_fTexto" @bind:event="oninput" @onkeyup="OnSearchKey" />
        </div>
        <select class="exp-sel" @bind="_fEstado" @bind:after="ApplyFilters">
            <option value="">Todos los estados</option>
            <option value="@EstadoExpediente.Abierto">Abierto</option>
            <option value="@EstadoExpediente.Cerrado">Cerrado</option>
        </select>
        <select class="exp-sel" @bind="_fFase" @bind:after="ApplyFilters">
            <option value="">Todas las fases</option>
            <option value="@FaseArchivo.Gestion">Gestión</option>
            <option value="@FaseArchivo.Central">Central</option>
            <option value="@FaseArchivo.Historico">Histórico</option>
        </select>
        <select class="exp-sel" @bind="_fNivelId" @bind:after="ApplyFilters">
            <option value="0">Todas las clasificaciones</option>
            @foreach (var n in _niveles) { <option value="@n.Id">@n.Nombre</option> }
        </select>
        <button class="exp-btn @(_showAdv ? "active" : "")" @onclick="ToggleAdvanced"><i class="bi bi-sliders"></i> Filtros</button>
    </div>

    @* ---- Panel filtros avanzados ---- *@
    @if (_showAdv)
    {
        <div class="exp-adv">
            <div class="exp-adv-grid">
                <div class="exp-field">
                    <label>Dependencia productora</label>
                    <select class="exp-sel full" @onchange="OnAdvDepChanged">
                        <option value="0">Todas</option>
                        @foreach (var d in _advDeps) { <option value="@d.Id" selected="@(d.Id == _fDepId)">@d.Codigo — @d.Nombre</option> }
                    </select>
                </div>
                <div class="exp-field">
                    <label>Serie / Subserie</label>
                    <select class="exp-sel full" @bind="_fSerieAsigId" disabled="@(_fDepId <= 0)">
                        <option value="0">@(_fDepId <= 0 ? "Elige dependencia" : "Todas")</option>
                        @foreach (var s in _advSeries) { <option value="@s.TrdAsignacionId">@s.SerieCodigo — @s.SerieNombre</option> }
                    </select>
                </div>
                <div class="exp-field">
                    <label>Fecha apertura desde</label>
                    <input type="date" class="exp-sel full" @bind="_fDesde" />
                </div>
                <div class="exp-field">
                    <label>Fecha apertura hasta</label>
                    <input type="date" class="exp-sel full" @bind="_fHasta" />
                </div>
            </div>
            <div class="exp-adv-actions">
                <button class="exp-btn" @onclick="ClearFilters"><i class="bi bi-x-lg"></i> Limpiar</button>
                <button class="exp-btn exp-btn-primary" @onclick="ApplyFilters"><i class="bi bi-check-lg"></i> Aplicar filtros</button>
            </div>
        </div>
    }

    @* ---- Barra de seleccion masiva ---- *@
    @if (_selected.Count > 0)
    {
        <div class="exp-selbar">
            <span><strong>@_selected.Count</strong> seleccionado(s)</span>
            <button class="exp-link" @onclick="@(() => { _selected.Clear(); })">Cancelar selección</button>
            <div class="exp-selbar-actions">
                <button class="exp-btn sm" @onclick="AbrirRotulos"><i class="bi bi-tag"></i> Rótulos</button>
                <button class="exp-btn sm" @onclick="@(() => _showFuid = true)"><i class="bi bi-table"></i> FUID</button>
                <button class="exp-btn sm" @onclick='() => Toast("Exportadores XLSX/XML/PDF: fase posterior de RQ03.")'><i class="bi bi-file-earmark-excel"></i> Exportar</button>
            </div>
        </div>
    }

    @* ===================== TABLA ===================== *@
    <div class="exp-card">
        <div class="exp-table-wrap">
            <table class="exp-table">
                <thead>
                    <tr>
                        <th class="chk"><input type="checkbox" checked="@AllPageSelected" @onchange="ToggleAllPage" /></th>
                        <th>Código</th>
                        <th>Nombre del expediente</th>
                        <th>Serie / Subserie</th>
                        @if (ColOn("dep")) { <th>Dependencia</th> }
                        @if (ColOn("fap")) { <th>Fecha apertura</th> }
                        @if (ColOn("fci")) { <th>Fecha cierre</th> }
                        @if (ColOn("est")) { <th>Estado</th> }
                        @if (ColOn("fase")) { <th>Fase</th> }
                        @if (ColOn("clas")) { <th>Clasificación</th> }
                        @if (ColOn("cre")) { <th>Creado por</th> }
                        @if (ColOn("fondo")) { <th>Fondo</th> }
                        <th class="center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_bandeja is null)
                    {
                        <tr><td colspan="13" class="exp-empty">Cargando...</td></tr>
                    }
                    else if (PagedItems.Count == 0)
                    {
                        <tr><td colspan="13" class="exp-empty">
                            <i class="bi bi-folder2-open"></i>
                            <div><strong>No hay expedientes</strong><div class="exp-empty-sub">No se encontraron expedientes con los filtros seleccionados.</div></div>
                        </td></tr>
                    }
                    else
                    {
                        @foreach (var e in PagedItems)
                        {
                            var ee = e;
                            <tr class="@(_selected.Contains(ee.Id) ? "sel" : "")">
                                <td class="chk"><input type="checkbox" checked="@_selected.Contains(ee.Id)" @onchange="@(() => ToggleRow(ee.Id))" /></td>
                                <td><button class="exp-cod" @onclick="@(() => VerDetalle(ee.Id))">@ee.Codigo</button></td>
                                <td><span class="exp-nombre">@ee.Nombre</span></td>
                                <td>
                                    <div>@FormatSerie(ee.SerieCodigo, ee.SerieNombre)</div>
                                </td>
                                @if (ColOn("dep")) { <td>@ee.DependenciaNombre</td> }
                                @if (ColOn("fap")) { <td>@ee.FechaApertura.ToString("yyyy-MM-dd")</td> }
                                @if (ColOn("fci")) { <td>@(ee.FechaCierre?.ToString("yyyy-MM-dd") ?? "—")</td> }
                                @if (ColOn("est")) { <td><span class="exp-pill @EstadoClass(ee.Estado)"><span class="dot"></span>@ee.Estado</span></td> }
                                @if (ColOn("fase")) { <td><span class="exp-pill @FaseClass(ee.Fase)">@ee.Fase</span></td> }
                                @if (ColOn("clas")) { <td><span class="exp-pill @ClasClass(ee.NivelNombre)">@ee.NivelNombre</span></td> }
                                @if (ColOn("cre")) { <td>@(ee.CreadoPorNombre ?? "—")</td> }
                                @if (ColOn("fondo")) { <td>@(ee.FondoNombre ?? "—")</td> }
                                <td class="center">
                                    <div class="exp-row-actions">
                                        <button class="exp-act" title="Ver" @onclick="@(() => VerDetalle(ee.Id))"><i class="bi bi-eye"></i></button>
                                        @if (_canEdit && ee.PuedeEditar && ee.Estado == EstadoExpediente.Abierto)
                                        {
                                            <button class="exp-act" title="Editar" @onclick="@(() => OpenEditar(ee.Id))"><i class="bi bi-pencil"></i></button>
                                        }
                                        @if (_canDelete)
                                        {
                                            <button class="exp-act danger" title="Eliminar" @onclick="@(() => OpenEliminar(ee))"><i class="bi bi-trash"></i></button>
                                        }
                                        <button class="exp-act off" title="Descargar (disponible en RQ04)" disabled><i class="bi bi-download"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_bandeja is not null && _bandeja.Items.Count > 0)
        {
            <div class="exp-pagination">
                <div class="exp-pg-info">Mostrando @(PageFrom)–@(PageTo) de @_bandeja.Items.Count registros</div>
                <div class="exp-pg-btns">
                    <button class="exp-pg-btn" disabled="@(_page <= 1)" @onclick="@(() => GoTo(_page - 1))">«</button>
                    @foreach (var p in PageNumbers())
                    {
                        var pp = p;
                        <button class="exp-pg-btn @(pp == _page ? "active" : "")" @onclick="@(() => GoTo(pp))">@pp</button>
                    }
                    <button class="exp-pg-btn" disabled="@(_page >= TotalPages)" @onclick="@(() => GoTo(_page + 1))">»</button>
                </div>
            </div>
        }
    </div>
</div>

@* =================== Modales existentes (Crear/Detalle/Editar/Eliminar) + nuevos (Alertas/FUID/Columnas) =================== *@
@if (_showCrear)
{
    <div class="modal-overlay" @onclick="@(() => _showCrear = false)">
        <div class="modal-dialog" style="max-width:820px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Nuevo Expediente</h3><button class="modal-close" @onclick="@(() => _showCrear = false)">&times;</button></div>
            <div class="modal-body">
                @if (_crearError is not null) { <div class="exp-flash err">@_crearError</div> }
                <div class="exp-sec-title">1. Clasificación TRD</div>
                <div class="exp-grid2">
                    <div class="exp-field">
                        <label>Fondo documental <span class="opt">(filtra dependencias)</span></label>
                        <select class="exp-sel full" @onchange="OnFondoChanged">
                            <option value="0">Todos los fondos</option>
                            @foreach (var f in _crearFondos) { <option value="@f.Id" selected="@(f.Id == _selFondoId)">@f.Codigo — @f.Nombre</option> }
                        </select>
                    </div>
                    <div class="exp-field">
                        <label>Dependencia productora <span class="req">*</span></label>
                        <select class="exp-sel full" @onchange="OnDepChanged">
                            <option value="0">— Selecciona —</option>
                            @foreach (var d in _crearDeps) { <option value="@d.Id" selected="@(d.Id == _selDepId)">@d.Codigo — @d.Nombre</option> }
                        </select>
                    </div>
                </div>
                <div class="exp-field">
                    <label>Serie / Subserie (TRD Vigente) <span class="req">*</span></label>
                    <select class="exp-sel full" @onchange="OnSerieChanged" disabled="@(_selDepId <= 0)">
                        <option value="0">@(_selDepId <= 0 ? "Selecciona una dependencia primero" : "— Selecciona —")</option>
                        @foreach (var s in _crearSeries) { <option value="@s.TrdAsignacionId" selected="@(s.TrdAsignacionId == _selAsignacionId)">@s.SerieCodigo — @s.SerieNombre</option> }
                    </select>
                    @if (_selDepId > 0 && _crearSeries.Count == 0) { <div class="exp-hint">Esta dependencia no tiene series en la TRD Vigente.</div> }
                </div>
                @if (_selAsignacionId > 0)
                {
                    <div class="exp-sec-title">2. Datos del Expediente</div>
                    <div class="exp-field">
                        <label>Nombre del expediente <span class="req">*</span></label>
                        <input class="exp-sel full" @bind="_cNombre" maxlength="200" placeholder="Ej: Contrato de suministro No. 045 de 2026" />
                    </div>
                    <div class="exp-grid2">
                        <div class="exp-field">
                            <label>Fecha de apertura <span class="req">*</span></label>
                            <input type="date" class="exp-sel full" @bind="_cFecha" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="exp-field">
                            <label>Nivel de clasificación <span class="req">*</span></label>
                            <select class="exp-sel full" @bind="_cNivelId">
                                @foreach (var n in _niveles.Where(n => n.Orden >= _cNivelHeredadoOrden)) { <option value="@n.Id">@n.Nombre</option> }
                            </select>
                            <div class="exp-hint">Heredado de la TRD; solo se puede elevar (RF10).</div>
                        </div>
                    </div>
                    <div class="exp-field">
                        <label>Código estructurado</label>
                        <input class="exp-sel full mono" value="@CodigoPreview()" disabled />
                        <div class="exp-hint">El consecutivo se asigna automáticamente al guardar.</div>
                    </div>
                    @if (_crearMetaDefs.Count > 0)
                    {
                        <div class="exp-sec-title">3. Metadatos de la serie</div>
                        @foreach (var m in _crearMetaDefs)
                        {
                            <div class="exp-field"><label>@m.Nombre @if (m.Obligatorio) { <span class="req">*</span> }</label>@MetaInput(m, _cMetaValores)</div>
                        }
                    }
                }
            </div>
            <div class="modal-foot">
                <button class="exp-btn" @onclick="@(() => _showCrear = false)" disabled="@_crearBusy">Cancelar</button>
                <button class="exp-btn exp-btn-primary" @onclick="GuardarCrear" disabled="@(_crearBusy || _selAsignacionId <= 0)"><i class="bi bi-save"></i> Crear expediente</button>
            </div>
        </div>
    </div>
}

@if (_showDetalle && _detalle is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showDetalle = false)">
        <div class="modal-dialog" style="max-width:720px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><span class="mono">@_detalle.Codigo</span></h3><button class="modal-close" @onclick="@(() => _showDetalle = false)">&times;</button></div>
            <div class="modal-body">
                <h4 style="margin:0 0 8px">@_detalle.Nombre</h4>
                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
                    <span class="exp-pill @EstadoClass(_detalle.Estado)"><span class="dot"></span>@_detalle.Estado</span>
                    <span class="exp-pill @FaseClass(_detalle.Fase)">Fase: @_detalle.Fase</span>
                    <span class="exp-pill @ClasClass(_detalle.NivelNombre)">@_detalle.NivelNombre</span>
                    <span class="exp-pill">Ubicación: @_detalle.EstadoUbicacion</span>
                </div>
                <div class="exp-grid2">
                    <div><span class="exp-hint">Serie / Subserie</span><div>@_detalle.SerieCodigo — @_detalle.SerieNombre</div></div>
                    <div><span class="exp-hint">Dependencia</span><div>@_detalle.DependenciaNombre</div></div>
                    <div><span class="exp-hint">Fondo</span><div>@(_detalle.FondoNombre ?? "—")</div></div>
                    <div><span class="exp-hint">Versión TRD</span><div>@_detalle.VersionTrd</div></div>
                    <div><span class="exp-hint">Fecha apertura</span><div>@_detalle.FechaApertura.ToString("yyyy-MM-dd")</div></div>
                    <div><span class="exp-hint">Fecha cierre</span><div>@(_detalle.FechaCierre?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div><span class="exp-hint">Creado por</span><div>@(_detalle.CreadoPorNombre ?? "—")</div></div>
                    <div><span class="exp-hint">Creado en sistema</span><div>@_detalle.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</div></div>
                </div>
                @if (_detalle.Metadatos.Count > 0)
                {
                    <div class="exp-sec-title">Metadatos</div>
                    <div class="exp-table-wrap"><table class="exp-table"><thead><tr><th>Metadato</th><th>Valor</th></tr></thead>
                        <tbody>@foreach (var m in _detalle.Metadatos) { <tr><td>@m.Nombre</td><td>@(string.IsNullOrWhiteSpace(m.Valor) ? "—" : m.Valor)</td></tr> }</tbody>
                    </table></div>
                }
            </div>
            <div class="modal-foot">
                @if (_canEdit && _detalle.Estado == EstadoExpediente.Abierto) { <button class="exp-btn" @onclick="@(() => OpenEditar(_detalle!.Id))"><i class="bi bi-pencil"></i> Editar</button> }
                <button class="exp-btn exp-btn-primary" @onclick="@(() => _showDetalle = false)">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (_showEditar)
{
    <div class="modal-overlay" @onclick="@(() => _showEditar = false)">
        <div class="modal-dialog" style="max-width:760px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head">
                <div><h3>Editar Expediente</h3>@if (_editDetalle is not null) { <div class="exp-hint mono" style="margin-top:2px">@_editDetalle.Codigo · @_editDetalle.Nombre</div> }</div>
                <button class="modal-close" @onclick="@(() => _showEditar = false)">&times;</button>
            </div>
            <div class="modal-body">
                @if (_editError is not null) { <div class="exp-flash err">@_editError</div> }
                <p class="exp-hint" style="margin-bottom:14px">Modifique los campos editables. La clasificación TRD y los datos del sistema no se pueden alterar.</p>

                <div class="exp-sec-title"><i class="bi bi-lock"></i> Campos inmutables del sistema</div>
                <div class="exp-grid2">
                    <div class="exp-field"><label>Código estructurado</label><input class="exp-sel full mono ro" value="@_editDetalle?.Codigo" disabled /></div>
                    <div class="exp-field"><label>Fecha creación sistema</label><input class="exp-sel full ro" value="@(_editDetalle?.FechaCreacion.ToString("yyyy-MM-dd HH:mm"))" disabled /></div>
                </div>
                <div class="exp-field"><label>Creado por</label><input class="exp-sel full ro" value="@(_editDetalle?.CreadoPorNombre ?? "—")" disabled /></div>

                <div class="exp-sec-title"><i class="bi bi-diagram-3"></i> Clasificación TRD <span class="exp-hint" style="text-transform:none;font-weight:400;letter-spacing:0">— la serie/subserie no se puede modificar post-creación</span></div>
                <div class="exp-grid2">
                    <div class="exp-field"><label>Fondo documental</label><input class="exp-sel full ro" value="@(_editDetalle?.FondoNombre ?? "—")" disabled /></div>
                    <div class="exp-field"><label>Dependencia productora</label><input class="exp-sel full ro" value="@(_editDetalle?.DependenciaNombre)" disabled /></div>
                    <div class="exp-field"><label>Serie TRD</label><input class="exp-sel full ro" value="@($"{_editDetalle?.SerieCodigo} - {_editDetalle?.SerieNombre}")" disabled /></div>
                    <div class="exp-field"><label>Subserie TRD</label><input class="exp-sel full ro" value="(sin subserie)" disabled /></div>
                </div>

                <div class="exp-sec-title"><i class="bi bi-pencil"></i> Datos editables</div>
                <div class="exp-field"><label>Nombre del expediente <span class="req">*</span></label><input class="exp-sel full" @bind="_eNombre" maxlength="200" /></div>
                <div class="exp-field">
                    <label>Nivel de clasificación <span class="req">*</span></label>
                    <select class="exp-sel full" @bind="_eNivelId">@foreach (var n in _niveles.Where(n => n.Orden >= _eNivelHeredadoOrden)) { <option value="@n.Id">@n.Nombre</option> }</select>
                    <div class="exp-hint">Solo se puede elevar respecto al heredado (RF10).</div>
                </div>
                @if (_eMetaDefs.Count > 0)
                {

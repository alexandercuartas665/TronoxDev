                    <div class="exp-fuid-card @(_rotTam == RotuloTamano.Carpeta ? "sel red" : "")" @onclick="@(() => _rotTam = RotuloTamano.Carpeta)"><i class="bi bi-folder"></i><div>Carpeta<br /><small style="color:#94A3B8;">18 × 6 cm</small></div></div>
                    <div class="exp-fuid-card @(_rotTam == RotuloTamano.Sticker ? "sel blue" : "")" @onclick="@(() => _rotTam = RotuloTamano.Sticker)"><i class="bi bi-sticky"></i><div>Sticker<br /><small style="color:#94A3B8;">10 × 5 cm</small></div></div>
                </div>

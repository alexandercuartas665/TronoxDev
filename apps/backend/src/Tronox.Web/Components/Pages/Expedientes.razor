    // ---- Crear ----
    private async Task OpenCrear()
    {
        _crearError = null; _crearBusy = false;
        _selFondoId = 0; _selDepId = 0; _selAsignacionId = 0;
        _cNombre = ""; _cFecha = DateTime.Today; _cNivelId = 0; _cNivelHeredadoOrden = 0;
        _cSerieCodigo = ""; _cDepCodigo = "";
        _crearSeries = []; _crearMetaDefs = []; _cMetaValores.Clear();
        _crearFondos = await Svc.GetFondosAsync();
        _crearDeps = await Svc.GetDependenciasParaCrearAsync(null);
        _pageOk = null; _pageError = null;
        _showCrear = true;
    }

    private async Task OnFondoChanged(ChangeEventArgs e)
    {
        _selFondoId = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _selDepId = 0; _selAsignacionId = 0; _crearSeries = []; _crearMetaDefs = []; _cMetaValores.Clear();
        _crearDeps = await Svc.GetDependenciasParaCrearAsync(_selFondoId > 0 ? _selFondoId : null);
    }

    private async Task OnDepChanged(ChangeEventArgs e)
    {
        _selDepId = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _selAsignacionId = 0; _crearMetaDefs = []; _cMetaValores.Clear();
        _cDepCodigo = _crearDeps.FirstOrDefault(d => d.Id == _selDepId)?.Codigo ?? "";
        _crearSeries = _selDepId > 0 ? await Svc.GetSeriesParaCrearAsync(_selDepId) : [];
    }

    private async Task OnSerieChanged(ChangeEventArgs e)
    {
        _selAsignacionId = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        var serie = _crearSeries.FirstOrDefault(s => s.TrdAsignacionId == _selAsignacionId);
        _cSerieCodigo = serie?.SerieCodigo ?? "";
        _cNivelHeredadoOrden = serie?.NivelHeredadoOrden ?? 0;
        _cNivelId = serie?.NivelHeredadoId ?? 0;
        _cMetaValores.Clear();
        _crearMetaDefs = _selAsignacionId > 0 ? await Svc.GetMetadatosSerieAsync(_selAsignacionId) : [];
    }

    private string CodigoPreview() => $"{_cDepCodigo}-{_cSerieCodigo}-{_cFecha.Year}-{new string('X', 6)}";

    private async Task GuardarCrear()
    {
        _crearBusy = true; _crearError = null;
        try
        {
            var metadatos = _crearMetaDefs.Select(m => new MetadatoInput(m.TrdMetadatoId, _cMetaValores.TryGetValue(m.TrdMetadatoId, out var v) ? v : null)).ToList();
            var req = new CrearExpedienteRequest(_selAsignacionId, _cNombre, DateOnly.FromDateTime(_cFecha), _cNivelId, metadatos);
            var res = await Svc.CrearAsync(req, Actor);
            if (!res.IsOk) { _crearError = res.Error; return; }
            _showCrear = false;
            _pageOk = $"Expediente {res.Value!.Codigo} creado.";
            await LoadBandeja();
        }
        finally { _crearBusy = false; }
    }

    // ---- Detalle ----
    // El ojo y el codigo NAVEGAN a la pagina de detalle (calcado del legacy: redirige a exp_detalle.aspx?reg=).
    private void VerDetalle(long id) => Nav.NavigateTo($"/modulo/expedientes-detalle/{id}");

    // ---- Editar ----
    private async Task OpenEditar(long id)
    {
        _editError = null; _editBusy = false;
        var res = await Svc.GetDetalleAsync(id, Actor);
        if (!res.IsOk) { _pageError = res.Error; return; }
        var d = res.Value!;
        _editDetalle = d;
        _editId = d.Id; _eNombre = d.Nombre; _eNivelId = d.NivelClasificacionId; _eNivelHeredadoOrden = d.NivelHeredadoOrden;
        _eMetaDefs = await Svc.GetMetadatosSerieAsync(d.TrdAsignacionId);
        _eMetaValores.Clear();
        foreach (var m in d.Metadatos) { _eMetaValores[m.TrdMetadatoId] = m.Valor; }
        _showDetalle = false; _showEditar = true;
    }

    private async Task GuardarEditar()
    {
        _editBusy = true; _editError = null;
        try
        {
            var metadatos = _eMetaDefs.Select(m => new MetadatoInput(m.TrdMetadatoId, _eMetaValores.TryGetValue(m.TrdMetadatoId, out var v) ? v : null)).ToList();
            var req = new EditarExpedienteRequest(_eNombre, _eNivelId, metadatos);
            var res = await Svc.EditarAsync(_editId, req, Actor);
            if (!res.IsOk) { _editError = res.Error; return; }
            _showEditar = false; _pageOk = "Expediente actualizado."; await LoadBandeja();
        }
        finally { _editBusy = false; }
    }


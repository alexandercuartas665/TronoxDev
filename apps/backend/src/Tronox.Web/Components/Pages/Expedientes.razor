<script>
    // Descarga un archivo desde base64 (rotulos PDF, RF17). Igual patron que Documentos/ExpedienteDetalle.
    window.tronoxDownload = function (fileName, contentType, base64) {
        var a = document.createElement('a');
        a.href = 'data:' + contentType + ';base64,' + base64;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    };
</script>


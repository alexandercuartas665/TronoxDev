    private async Task SwitchVista(BandejaVista v) { _vista = v; _page = 1; _selected.Clear(); await LoadBandeja(); }

    private async Task LoadBandeja()
    {
        var estado = Enum.TryParse<EstadoExpediente>(_fEstado, out var es) ? (EstadoExpediente?)es : null;
        var fase = Enum.TryParse<FaseArchivo>(_fFase, out var fs) ? (FaseArchivo?)fs : null;
        var filtro = new ExpedienteFiltro(
            Texto: string.IsNullOrWhiteSpace(_fTexto) ? null : _fTexto,
            Estado: estado,
            Fase: fase,
            NivelClasificacionId: _fNivelId > 0 ? _fNivelId : null,
            DependenciaId: _fDepId > 0 ? _fDepId : null,
            SerieId: _fSerieAsigId > 0 ? _fSerieAsigId : null,
            AperturaDesde: _fDesde is { } dd ? DateOnly.FromDateTime(dd) : null,
            AperturaHasta: _fHasta is { } hh ? DateOnly.FromDateTime(hh) : null);
        _bandeja = await Svc.GetBandejaAsync(_vista, filtro, Actor);
        if (_page > TotalPages) { _page = TotalPages; }
        if (_page < 1) { _page = 1; }
    }

    private async Task ApplyFilters() { _page = 1; await LoadBandeja(); }
    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await ApplyFilters(); } }

    private async Task ToggleAdvanced()
    {
        _showAdv = !_showAdv;
        if (_showAdv && _advDeps.Count == 0) { _advDeps = await Svc.GetDependenciasParaCrearAsync(null); }
    }


        }
        finally { _delBusy = false; }
    }

    // ---- Render de un input de metadato segun su tipo (DAT-04) ----
    private RenderFragment MetaInput(MetadatoDefDto m, Dictionary<long, string?> store) => __builder =>
    {
        string? current = store.TryGetValue(m.TrdMetadatoId, out var v) ? v : null;
        void Set(ChangeEventArgs e) => store[m.TrdMetadatoId] = e.Value?.ToString();
        switch (m.TipoDato)
        {
            case TipoDatoMetadato.TextoLargo:
                <textarea class="exp-sel full" rows="2" value="@current" @onchange="Set"></textarea>
                break;
            case TipoDatoMetadato.Numerico:
            case TipoDatoMetadato.Moneda:
                <input type="number" step="any" class="exp-sel full" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Fecha:
                <input type="date" class="exp-sel full" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Booleano:
                <select class="exp-sel full" value="@current" @onchange="Set"><option value="">--</option><option value="true">Sí</option><option value="false">No</option></select>
                break;
            case TipoDatoMetadato.Lista:
                <select class="exp-sel full" value="@current" @onchange="Set"><option value="">— Selecciona —</option>@foreach (var o in m.OpcionesLista) { <option value="@o.Clave">@o.Valor</option> }</select>
                break;
            default:
                <input class="exp-sel full" value="@current" @onchange="Set" />
                break;
        }
    };

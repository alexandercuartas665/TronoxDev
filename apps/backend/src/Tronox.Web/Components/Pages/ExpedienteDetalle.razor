@page "/modulo/expedientes-detalle/{Id:long}"
@attribute [Authorize(Policy = "Perm:modulo/expedientes-mios:View")]
@* RQ03 - Vista de DETALLE del expediente (calcada del legacy exp_detalle.aspx, al que se llega por
   redireccion desde la bandeja). Pagina completa con 5 pestanas. Reales: Detalle (ficha), Ubicacion
   fisica, Trazabilidad, Vinculados, y Cerrar/Reabrir. Diferidas (muestran aviso): Documentos (RQ04),
   Firma/Indice (RQ05), Cambiar Fase (Transferencias), Rotulo, Compartir. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Expedientes
@using Tronox.Application.Documentos
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IExpedienteService Svc
@inject IDocumentoService DocSvc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Expediente - TRONOX SGDEA</PageTitle>

<div class="exp-wrap det">

@if (_notFound)
{
    <div class="exp-flash err" style="margin-top:12px"><i class="bi bi-exclamation-triangle"></i> El expediente no existe o no tienes permiso para verlo.</div>
    <button class="exp-btn" @onclick="Volver"><i class="bi bi-arrow-left"></i> Volver a la bandeja</button>
}
else if (_d is null)
{
    <div class="exp-empty">Cargando...</div>
}
else
{
    <nav class="tronox-breadcrumb" aria-label="Ruta">
        <a href="/inicio">Inicio</a><span class="sep">/</span>
        <a href="/modulo/expedientes-mios">Expedientes</a><span class="sep">/</span>
        <span class="cur">@_d.Codigo</span>
    </nav>

    <button class="exp-btn" style="margin:6px 0 12px" @onclick="Volver"><i class="bi bi-chevron-left"></i> Volver a la bandeja</button>

    @if (_flash is not null) { <div class="exp-flash @(_flashOk ? "ok" : "err")">@_flash</div> }

    @* ===================== HEADER ===================== *@
    <div class="det-head">
        <div class="det-head-main">
            <div class="det-ruta">@_d.FondoNombre / @_d.DependenciaNombre / @_d.SerieCodigo @_d.SerieNombre</div>
            <h1 class="det-codigo mono">@_d.Codigo</h1>
            <div class="det-nombre">@_d.Nombre</div>
            <div class="det-badges">
                <span class="exp-pill @EstadoClass(_d.Estado)"><span class="dot"></span>@_d.Estado</span>
                <span class="exp-pill @FaseClass(_d.Fase)">@_d.Fase</span>
                <span class="exp-pill @ClasClass(_d.NivelNombre)">@_d.NivelNombre</span>
                <span class="exp-pill">Ubicación: @UbicTexto(_d.EstadoUbicacion)</span>
            </div>
            <div class="det-metaline">
                <span><i class="bi bi-diagram-3"></i> Serie / Subserie: <strong>@_d.SerieCodigo — @_d.SerieNombre</strong></span>
                <span><i class="bi bi-calendar3"></i> Apertura: @_d.FechaApertura.ToString("yyyy-MM-dd")</span>
                <span><i class="bi bi-person"></i> Creado por: @(_d.CreadoPorNombre ?? "—")</span>
            </div>
        </div>
        <div class="det-head-actions">
            <button class="exp-btn" @onclick='() => Toast("Cambiar Fase depende del módulo de Transferencias (próximamente).")'><i class="bi bi-arrow-left-right"></i> Cambiar Fase</button>
            <button class="exp-btn" @onclick='() => Toast("Índice Electrónico depende de Documentos (RQ04) + Firma (RQ05) (próximamente).")'><i class="bi bi-file-earmark-text"></i> Índice</button>
            <button class="exp-btn" @onclick='() => Toast("Rótulo depende del módulo de rotulación (próximamente).")'><i class="bi bi-tag"></i> Rótulo</button>
            <button class="exp-btn" @onclick='() => Toast("Compartir expediente depende del módulo de Compartir (RF11, próximamente).")'><i class="bi bi-share"></i> Compartir</button>
            @if (_canEdit && _d.Estado == EstadoExpediente.Abierto)
            {
                <button class="exp-btn danger" @onclick="@(() => _showCerrar = true)"><i class="bi bi-lock"></i> Cerrar Expediente</button>
            }
            @if (_canEdit && _d.Estado == EstadoExpediente.Cerrado)
            {
                <button class="exp-btn" @onclick="AbrirReabrir"><i class="bi bi-unlock"></i> Abrir Expediente</button>
            }
        </div>
    </div>

    @* ===================== TABS ===================== *@
    <div class="exp-tabs det-tabs">
        <button class="exp-tab @TabCls("documentos")" @onclick='() => SetTab("documentos")'><i class="bi bi-file-text"></i> Documentos</button>
        <button class="exp-tab @TabCls("detalle")" @onclick='() => SetTab("detalle")'><i class="bi bi-info-circle"></i> Detalle</button>
        <button class="exp-tab @TabCls("ubicacion")" @onclick='() => SetTab("ubicacion")'><i class="bi bi-geo-alt"></i> Ubicación Física</button>
        <button class="exp-tab @TabCls("trazabilidad")" @onclick='() => SetTab("trazabilidad")'><i class="bi bi-clock-history"></i> Trazabilidad</button>
        <button class="exp-tab @TabCls("vinculados")" @onclick='() => SetTab("vinculados")'><i class="bi bi-link-45deg"></i> Expedientes Vinculados</button>
    </div>

    @* ===================== PANE: DOCUMENTOS ===================== *@
    @if (_tab == "documentos")
    {
        <div class="exp-card" style="padding:0">
            <div class="exp-doc-toolbar">
                <div class="exp-doc-count">@(_docs?.Count ?? 0) documentos · @FoliosTotales folios totales</div>
                <div class="exp-doc-tbtns">
                    <button class="exp-btn sm" @onclick='() => Toast("Configurar columnas visibles: fase posterior de RQ04.")'><i class="bi bi-layout-three-columns"></i> Vista</button>
                    <button class="exp-btn sm" @onclick='() => Toast("Exportar la grilla de documentos (CSV): fase posterior de RQ04.")'><i class="bi bi-filetype-csv"></i> CSV</button>
                    <button class="exp-btn sm" @onclick='() => Toast("Exportar la grilla de documentos (XLSX): fase posterior de RQ04.")'><i class="bi bi-file-earmark-excel"></i> XLSX</button>
                    <button class="exp-btn sm" @onclick='() => Toast("Exportar la grilla de documentos (XML): fase posterior de RQ04.")'><i class="bi bi-filetype-xml"></i> XML</button>
                    <button class="exp-btn sm" @onclick='() => Toast("Exportar la grilla de documentos (PDF): fase posterior de RQ04.")'><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                    <button class="exp-btn sm exp-btn-primary" @onclick="AbrirNuevoDoc"><i class="bi bi-plus-lg"></i> Nuevo Documento</button>
                </div>
            </div>
            @if (_docs is null)
            {
                <div class="exp-empty">Cargando...</div>
            }
            else if (_docs.Count == 0)
            {
                <div class="exp-empty"><i class="bi bi-file-earmark-text"></i><div><strong>Sin documentos</strong><div class="exp-empty-sub">Este expediente aún no tiene documentos. Usa "Nuevo Documento" para incorporar.</div></div></div>
            }
            else
            {
                <div class="exp-table-wrap">
                    <table class="exp-table">
                        <thead><tr>
                            <th>Tipo</th><th>Nombre del documento</th><th>Tipo documental</th><th>Fecha doc.</th>
                            <th>Fecha incorporación</th><th>Folios</th><th>Formato</th><th>Tamaño</th>
                            <th>Origen</th><th>Estado</th><th>Firma</th><th class="center">Acciones</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var doc in _docs)
                            {
                                var dd = doc;
                                <tr>
                                    <td><i class="bi @IconoFormato(dd.Formato)" style="font-size:18px;color:#64748B"></i></td>
                                    <td><span class="exp-nombre">@dd.Nombre</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(dd.TipologiaNombre) ? "—" : dd.TipologiaNombre)</td>
                                    <td>@(dd.FechaDocumento?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>@(dd.FechaIncorporacion?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>@FoliosTexto(dd)</td>
                                    <td>@(string.IsNullOrWhiteSpace(dd.Formato) ? "—" : dd.Formato!.ToUpperInvariant())</td>
                                    <td>@TamTexto(dd.TamanoBytes)</td>
                                    <td>@dd.Soporte</td>
                                    <td><span class="exp-pill @EstDocClass(dd.Estado)">@dd.Estado</span></td>
                                    <td><span class="exp-pill @FirmaClass(dd.EstadoFirma)">@FirmaTexto(dd.EstadoFirma)</span></td>
                                    <td class="center"><div class="exp-row-actions">
                                        <button class="exp-act" title="Ver / descargar" @onclick="@(() => Descargar(dd.Id))" disabled="@(!dd.TieneBinario)"><i class="bi bi-eye"></i></button>
                                        <button class="exp-act" title="Editar metadatos" @onclick='() => Toast("Editar metadatos del documento: fase posterior de RQ04.")'><i class="bi bi-pencil-square"></i></button>
                                        <button class="exp-act" title="Más acciones" @onclick='() => Toast("Más acciones del documento (versiones, firma, referenciar, anular): fase posterior de RQ04/RQ05.")'><i class="bi bi-three-dots-vertical"></i></button>
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* ===================== PANE: DETALLE ===================== *@
    @if (_tab == "detalle")
    {
        <div class="exp-card det-ficha">
            <div class="det-sec">
                <div class="det-sec-t">Identificación</div>
                <div class="det-grid">
                    <div><span class="k">Código</span><span class="v mono">@_d.Codigo</span></div>
                    <div><span class="k">Nombre</span><span class="v">@_d.Nombre</span></div>
                    <div><span class="k">Estado</span><span class="v"><span class="exp-pill @EstadoClass(_d.Estado)"><span class="dot"></span>@_d.Estado</span></span></div>
                    <div><span class="k">Fase</span><span class="v"><span class="exp-pill @FaseClass(_d.Fase)">@_d.Fase</span></span></div>
                    <div><span class="k">Clasificación</span><span class="v"><span class="exp-pill @ClasClass(_d.NivelNombre)">@_d.NivelNombre</span></span></div>
                    <div><span class="k">Estado ubicación</span><span class="v">@UbicTexto(_d.EstadoUbicacion)</span></div>
                </div>
            </div>
            <div class="det-sec">
                <div class="det-sec-t">Clasificación TRD</div>
                <div class="det-grid">
                    <div><span class="k">Fondo</span><span class="v">@(_d.FondoNombre ?? "—")</span></div>
                    <div><span class="k">Dependencia</span><span class="v">@_d.DependenciaNombre</span></div>
                    <div><span class="k">Serie / Subserie</span><span class="v">@_d.SerieCodigo — @_d.SerieNombre</span></div>
                    <div><span class="k">Código CCD</span><span class="v mono">@_d.CodigoCcd</span></div>
                    <div><span class="k">Versión TRD</span><span class="v">@_d.VersionTrd</span></div>
                </div>
            </div>
            <div class="det-sec">
                <div class="det-sec-t">Información TRD (retención y disposición)</div>
                <div class="det-grid">
                    <div><span class="k">Tiempo en Gestión</span><span class="v">@_d.TiempoGestion años</span></div>
                    <div><span class="k">Tiempo en Central</span><span class="v">@_d.TiempoCentral años</span></div>
                    <div><span class="k">Disposición final</span><span class="v">@DispTexto(_d.DisposicionFinal)</span></div>
                    <div><span class="k">Documentos DD.HH / DIH</span><span class="v">@(_d.SerieDdhhDih ? "Sí" : "No")</span></div>
                    <div class="wide"><span class="k">Procedimiento</span><span class="v">@(string.IsNullOrWhiteSpace(_d.Procedimiento) ? "—" : _d.Procedimiento)</span></div>
                </div>
            </div>
            <div class="det-sec">
                <div class="det-sec-t">Datos del sistema</div>
                <div class="det-grid">
                    <div><span class="k">Fecha apertura</span><span class="v">@_d.FechaApertura.ToString("yyyy-MM-dd")</span></div>
                    <div><span class="k">Fecha cierre</span><span class="v">@(_d.FechaCierre?.ToString("yyyy-MM-dd") ?? "—")</span></div>
                    <div><span class="k">Creado en sistema</span><span class="v">@_d.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</span></div>
                    <div><span class="k">Creado por</span><span class="v">@(_d.CreadoPorNombre ?? "—")</span></div>
                </div>
            </div>
            @if (_d.Metadatos.Count > 0)
            {
                <div class="det-sec">
                    <div class="det-sec-t">Metadatos de la serie</div>
                    <div class="det-grid">
                        @foreach (var m in _d.Metadatos)
                        {
                            <div><span class="k">@m.Nombre</span><span class="v">@(string.IsNullOrWhiteSpace(m.Valor) ? "—" : m.Valor)</span></div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* ===================== PANE: UBICACION ===================== *@
    @if (_tab == "ubicacion")
    {
        <div class="exp-card" style="padding:18px">
            <div class="det-secbar">
                <div>
                    <div class="det-sec-t" style="margin:0">Ubicación Física</div>
                    <div class="exp-empty-sub">Historial topográfico del expediente (append-only) ligado a la topografía del archivo (RQ02).</div>
                </div>
                @if (_canEdit)
                {
                    <button class="exp-btn exp-btn-primary" @onclick="AbrirUbicacion"><i class="bi bi-geo-alt"></i> Asignar / Cambiar ubicación</button>
                }
            </div>
            @if (_ubic?.Actual is not null)
            {
                <div class="det-ubic-actual">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div>
                        <div class="k">Ubicación actual</div>
                        <div class="v mono">@_ubic.Actual.Ubicacion</div>
                        <div class="exp-empty-sub">Fase @_ubic.Actual.Fase · por @(_ubic.Actual.AsignadoPor ?? "—") · @_ubic.Actual.Fecha.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
            }
            @if (_ubic is null)
            {
                <div class="exp-empty">Cargando...</div>
            }
            else if (_ubic.Historial.Count == 0)
            {
                <div class="exp-empty"><i class="bi bi-geo-alt"></i><div><strong>Sin ubicación</strong><div class="exp-empty-sub">Este expediente aún no tiene una ubicación física asignada.</div></div></div>
            }
            else
            {
                <table class="exp-table" style="margin-top:12px">
                    <thead><tr><th>Ubicación</th><th>Fase</th><th>Asignado por</th><th>Fecha</th><th>Observación</th></tr></thead>
                    <tbody>
                        @foreach (var h in _ubic.Historial)
                        {
                            <tr><td class="mono">@h.Ubicacion</td><td>@h.Fase</td><td>@(h.AsignadoPor ?? "—")</td><td>@h.Fecha.ToString("yyyy-MM-dd HH:mm")</td><td>@(h.Observacion ?? "—")</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @* ===================== PANE: TRAZABILIDAD ===================== *@
    @if (_tab == "trazabilidad")
    {
        <div class="exp-card" style="padding:18px">
            <div class="det-sec-t" style="margin-top:0">Trazabilidad</div>
            <div class="exp-empty-sub" style="margin-bottom:12px">Pistas de auditoría del expediente (append-only, RF09).</div>
            @if (_traza is null)
            {
                <div class="exp-empty">Cargando...</div>
            }
            else if (_traza.Count == 0)
            {
                <div class="exp-empty"><i class="bi bi-clock-history"></i><div><strong>Sin eventos</strong></div></div>
            }
            else
            {
                <div class="det-timeline">
                    @foreach (var t in _traza)
                    {
                        <div class="det-tl-item">
                            <div class="det-tl-dot"></div>
                            <div class="det-tl-body">
                                <div class="det-tl-head"><strong>@AccionTexto(t.Accion)</strong> <span class="exp-empty-sub">· @(t.Usuario ?? "—") · @t.Fecha.ToString("yyyy-MM-dd HH:mm")</span></div>
                                @if (!string.IsNullOrWhiteSpace(t.Detalle)) { <div class="det-tl-detalle mono">@t.Detalle</div> }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ===================== PANE: VINCULADOS ===================== *@
    @if (_tab == "vinculados")
    {
        <div class="exp-card" style="padding:18px">
            <div class="det-sec-t" style="margin-top:0">Expedientes Vinculados <span class="det-vinc-hint">Relación bidireccional — aparece en ambos expedientes</span></div>
            @if (_canEdit)
            {
                <div class="det-vinc-add">
                    <div class="det-vinc-add-t"><i class="bi bi-plus-circle"></i> Agregar vínculo a otro expediente</div>
                    <div class="det-vinc-buscar">
                        <input class="exp-search" style="flex:1" placeholder="Código o nombre del expediente..." @bind="_vincTexto" @bind:event="oninput" @onkeyup="OnVincKey" />
                        <button class="exp-btn" @onclick="BuscarVinculo"><i class="bi bi-search"></i> Buscar</button>
                    </div>
                    <input class="exp-search" style="width:100%;margin-top:8px" placeholder="Observación (opcional)" @bind="_vincObs" @bind:event="oninput" />
                    @if (_vincMsg is not null) { <div class="exp-hint" style="margin-top:8px">@_vincMsg</div> }
                    @if (_vincResultados.Count > 0)
                    {
                        <div class="det-vinc-res">
                            <div class="exp-hint" style="margin-bottom:6px">Resultados (top 20). Clic «Vincular» para agregar:</div>
                            <table class="exp-table">
                                <thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th class="center">Acción</th></tr></thead>
                                <tbody>
                                    @foreach (var r in _vincResultados)
                                    {
                                        var rr = r;
                                        <tr><td class="mono">@rr.Codigo</td><td>@rr.Nombre</td><td><span class="exp-pill @EstadoClass(rr.Estado)"><span class="dot"></span>@rr.Estado</span></td>
                                            <td class="center"><button class="exp-btn sm exp-btn-primary" @onclick="@(() => Vincular(rr.Id))"><i class="bi bi-link"></i> Vincular</button></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            @if (_vinculos is null)
            {
                <div class="exp-empty">Cargando...</div>
            }
            else if (_vinculos.Count == 0)
            {
                <div class="exp-empty"><i class="bi bi-link-45deg"></i><div><strong>Sin vínculos</strong><div class="exp-empty-sub">Este expediente no está vinculado con otros.</div></div></div>
            }
            else
            {
                <table class="exp-table" style="margin-top:12px">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th>Vinculado por</th><th>Fecha</th><th>Observación</th><th class="center">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var v in _vinculos)
                        {
                            var vv = v;
                            <tr>
                                <td class="mono">@vv.OtroCodigo</td><td>@vv.OtroNombre</td>
                                <td><span class="exp-pill @EstadoClass(vv.OtroEstado)"><span class="dot"></span>@vv.OtroEstado</span></td>
                                <td>@(vv.VinculadoPor ?? "—")</td><td>@vv.Fecha.ToString("yyyy-MM-dd")</td><td>@(vv.Observacion ?? "—")</td>
                                <td class="center"><div class="exp-row-actions">
                                    <button class="exp-act" title="Ver" @onclick="@(() => Nav.NavigateTo($"/modulo/expedientes-detalle/{vv.OtroExpedienteId}"))"><i class="bi bi-eye"></i></button>
                                    @if (_canEdit) { <button class="exp-act danger" title="Desvincular" @onclick="@(() => Desvincular(vv.VinculoId))"><i class="bi bi-link-45deg"></i></button> }
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}
</div>

@* ===================== Modales ===================== *@
@if (_showCerrar && _d is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showCerrar = false)">
        <div class="modal-dialog" style="max-width:520px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-lock"></i> Cerrar expediente</h3><button class="modal-close" @onclick="@(() => _showCerrar = false)">&times;</button></div>
            <div class="modal-body">
                <p>Se cerrará el expediente <strong class="mono">@_d.Codigo</strong>. Se calcula un <strong>hash SHA-256</strong> del índice como sello de integridad y se registra en la trazabilidad. La firma criptográfica se aplicará cuando exista el módulo de firma (RQ05).</p>
            </div>
            <div class="modal-foot">
                <button class="exp-btn" @onclick="@(() => _showCerrar = false)" disabled="@_busy">Cancelar</button>
                <button class="exp-btn danger" @onclick="CerrarExp" disabled="@_busy"><i class="bi bi-lock"></i> Cerrar</button>
            </div>
        </div>
    </div>
}

@if (_showReabrir && _d is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showReabrir = false)">
        <div class="modal-dialog" style="max-width:520px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-unlock"></i> Abrir expediente</h3><button class="modal-close" @onclick="@(() => _showReabrir = false)">&times;</button></div>
            <div class="modal-body">
                @if (_modalErr is not null) { <div class="exp-flash err">@_modalErr</div> }
                <p>Reabrir <strong class="mono">@_d.Codigo</strong>. Indica la justificación (mínimo 20 caracteres):</p>
                <textarea class="exp-search" style="width:100%;height:90px;padding:10px" maxlength="1000" @bind="_reJustif"></textarea>
            </div>
            <div class="modal-foot">
                <button class="exp-btn" @onclick="@(() => _showReabrir = false)" disabled="@_busy">Cancelar</button>
                <button class="exp-btn exp-btn-primary" @onclick="ReabrirExp" disabled="@_busy">Reabrir</button>
            </div>
        </div>
    </div>
}

@if (_showUbic && _d is not null)
{
    <div class="modal-overlay" @onclick="@(() => _showUbic = false)">
        <div class="modal-dialog" style="max-width:560px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-geo-alt"></i> Asignar / Cambiar ubicación</h3><button class="modal-close" @onclick="@(() => _showUbic = false)">&times;</button></div>
            <div class="modal-body">
                @if (_modalErr is not null) { <div class="exp-flash err">@_modalErr</div> }
                @if (_topoArbol.Count == 0)
                {
                    <div class="exp-hint">No hay nodos de topografía. Créalos en Topografía Física (RQ02).</div>
                }
                else
                {
                    <div class="exp-field">
                        <label>Ubicación topográfica <span class="req">*</span></label>
                        @foreach (var (data, nivel) in UbLevels().Select((d, i) => (d, i)))
                        {
                            <select class="exp-sel full ub-casc" value="@data.Sel" @onchange="e => OnUbLevelChange(nivel, e)">
                                <option value="0">— Seleccione —</option>
                                @foreach (var o in data.Opts)
                                {
                                    <option value="@o.Id">@o.NivelNombre @o.Nombre@(o.Estado != TopografiaEstado.Disponible ? $" ({o.Estado})" : "")</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="ub-path"><i class="bi bi-signpost-split"></i> <span class="mono">@UbBreadcrumb()</span></div>
                    @if (UbHint() is string hint)
                    {
                        <div class="exp-hint warn">@hint</div>
                    }
                    <div class="exp-field"><label>Observación</label><input class="exp-sel full" maxlength="1000" @bind="_ubObs" /></div>
                }
            </div>
            <div class="modal-foot">
                <button class="exp-btn" @onclick="@(() => _showUbic = false)" disabled="@_busy">Cancelar</button>
                <button class="exp-btn exp-btn-primary" @onclick="GuardarUbicacion" disabled="@(_busy || !UbListoParaGuardar())">Guardar</button>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public long Id { get; set; }
    private const string ModuleKey = "modulo/expedientes-mios";

    private long Actor => Tenant.UserId ?? 0;
    private bool _canEdit;
    private bool _notFound;

    private ExpedienteDetalleDto? _d;
    private string _tab = "detalle";

    private ExpedienteUbicacionDto? _ubic;
    private IReadOnlyList<TrazaItemDto>? _traza;
    private IReadOnlyList<VinculoDto>? _vinculos;
    private IReadOnlyList<ExpedienteDocumentoDto>? _docs;

    private string? _flash; private bool _flashOk;
    private string? _toast;
    private string? _modalErr;
    private bool _busy;

    // Cerrar / reabrir
    private bool _showCerrar, _showReabrir;
    private string _reJustif = "";

    // Ubicacion
    private bool _showUbic;
    private IReadOnlyList<TopografiaOpcionDto> _topoOpts = [];
    private long _ubTopoId; private string _ubObs = "";

    // Vinculos
    private string _vincTexto = "", _vincObs = "";
    private IReadOnlyList<VinculoBusquedaDto> _vincResultados = [];

    protected override async Task OnParametersSetAsync()
    {
        var eff = await Perms.GetAsync();
        _canEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        var res = await Svc.GetDetalleAsync(Id, Actor);
        if (!res.IsOk) { _notFound = true; _d = null; return; }
        _notFound = false; _d = res.Value;
        _ubic = null; _traza = null; _vinculos = null; _tab = "detalle";
    }

    private string TabCls(string t) => _tab == t ? "active" : "";
    private async Task SetTab(string t)
    {
        _tab = t;
        if (t == "ubicacion" && _ubic is null) { var r = await Svc.GetUbicacionAsync(Id, Actor); _ubic = r.IsOk ? r.Value : new ExpedienteUbicacionDto(null, []); }
        if (t == "trazabilidad" && _traza is null) { _traza = await Svc.GetTrazabilidadAsync(Id, Actor); }
        if (t == "vinculados" && _vinculos is null) { var r = await Svc.GetVinculosAsync(Id, Actor); _vinculos = r.IsOk ? r.Value : []; }
        if (t == "documentos" && _docs is null) { _docs = await DocSvc.ListarPorExpedienteAsync(Id, Actor); }
    }

    private async Task Descargar(long docId)
    {
        var res = await DocSvc.DescargarAsync(docId, Actor);
        if (!res.IsOk) { Flash(res.Error ?? "No se pudo descargar.", false); return; }
        var d = res.Value!;
        await JS.InvokeVoidAsync("tronoxDownload", d.NombreArchivo, d.ContentType, Convert.ToBase64String(d.Contenido));
    }

    private static string FoliosTexto(ExpedienteDocumentoDto d)
        => d.PaginaInicio is int pi && d.PaginaFin is int pf ? $"{pi}-{pf}" : (d.Folios?.ToString() ?? "—");
    private static string TamTexto(long? bytes)
        => bytes is not long b ? "—" : b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0.#} KB" : $"{b / 1048576.0:0.#} MB";
    private static string FirmaTexto(EstadoFirmaDocumento f)
        => f switch { EstadoFirmaDocumento.Firmado => "Firmado", EstadoFirmaDocumento.Pendiente => "Pendiente", _ => "Sin firma" };

    private void AbrirReabrir() { _reJustif = ""; _modalErr = null; _showReabrir = true; }
    private void Volver() => Nav.NavigateTo("/modulo/expedientes-mios");
    private void Toast(string m) => _toast = m;
    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }

    // ---- Cerrar / reabrir ----
    private async Task CerrarExp()
    {
        _busy = true; _modalErr = null;
        try
        {
            var r = await Svc.CerrarAsync(Id, Actor);
            if (!r.IsOk) { _modalErr = r.Error; return; }
            _showCerrar = false; Flash("Expediente cerrado. Se registró el hash de integridad.", true);
            await Recargar();
        }
        finally { _busy = false; }
    }

    private async Task ReabrirExp()
    {
        _busy = true; _modalErr = null;
        try
        {
            var r = await Svc.ReabrirAsync(Id, _reJustif, Actor);
            if (!r.IsOk) { _modalErr = r.Error; return; }
            _showReabrir = false; Flash("Expediente reabierto.", true);
            await Recargar();
        }
        finally { _busy = false; }
    }

    private async Task Recargar()
    {
        var res = await Svc.GetDetalleAsync(Id, Actor);
        if (res.IsOk) { _d = res.Value; }
        _traza = null; // la traza cambio
        if (_tab == "trazabilidad") { _traza = await Svc.GetTrazabilidadAsync(Id, Actor); }
    }

    // ---- Ubicacion ----
    private async Task AbrirUbicacion()
    {
        _modalErr = null; _ubTopoId = 0; _ubObs = "";
        if (_topoOpts.Count == 0) { _topoOpts = await Svc.GetTopografiaOpcionesAsync(); }
        _showUbic = true;
    }

    private async Task GuardarUbicacion()
    {
        _busy = true; _modalErr = null;
        try
        {
            var r = await Svc.AsignarUbicacionAsync(Id, _ubTopoId, _ubObs, Actor);
            if (!r.IsOk) { _modalErr = r.Error; return; }
            _showUbic = false; Flash("Ubicación asignada.", true);
            var ru = await Svc.GetUbicacionAsync(Id, Actor); _ubic = ru.IsOk ? ru.Value : _ubic;
            var rd = await Svc.GetDetalleAsync(Id, Actor); if (rd.IsOk) { _d = rd.Value; }
        }
        finally { _busy = false; }
    }

    // ---- Vinculos ----
    private async Task OnVincKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await BuscarVinculo(); } }
    private async Task BuscarVinculo() => _vincResultados = await Svc.BuscarParaVincularAsync(Id, _vincTexto, Actor);

    private async Task Vincular(long destinoId)
    {
        _busy = true;
        try
        {
            var r = await Svc.CrearVinculoAsync(Id, destinoId, _vincObs, Actor);
            if (!r.IsOk) { Flash(r.Error ?? "No se pudo vincular.", false); return; }
            _vincResultados = []; _vincTexto = ""; _vincObs = "";
            var rv = await Svc.GetVinculosAsync(Id, Actor); _vinculos = rv.IsOk ? rv.Value : _vinculos;
            Flash("Expediente vinculado.", true);
        }
        finally { _busy = false; }
    }

    private async Task Desvincular(long vinculoId)
    {
        _busy = true;
        try
        {
            await Svc.DesvincularAsync(vinculoId, Actor);
            var rv = await Svc.GetVinculosAsync(Id, Actor); _vinculos = rv.IsOk ? rv.Value : _vinculos;
        }
        finally { _busy = false; }
    }

    // ---- Helpers de presentacion ----
    private static string EstadoClass(EstadoExpediente e) => e == EstadoExpediente.Abierto ? "est-ab" : "est-ce";
    private static string FaseClass(FaseArchivo f) => f switch { FaseArchivo.Gestion => "fa-ges", FaseArchivo.Central => "fa-cen", _ => "fa-his" };
    private static string ClasClass(string nivel) => nivel?.ToLowerInvariant() switch
    { "publico" or "público" => "cl-pub", "interno" => "cl-int", "reservado" => "cl-res", "clasificado" => "cl-cla", _ => "plain" };
    private static string UbicTexto(EstadoUbicacionExpediente u) => u switch
    { EstadoUbicacionExpediente.SinUbicar => "Sin ubicar", EstadoUbicacionExpediente.Ubicado => "Ubicado", _ => "Reubicado" };
    private static string DispTexto(DisposicionFinal d) => d switch
    { DisposicionFinal.ConservacionTotal => "Conservación total", DisposicionFinal.Seleccion => "Selección", DisposicionFinal.Eliminacion => "Eliminación", _ => d.ToString() };
    private static string AccionTexto(string a) => a switch
    {
        "expediente.crear" => "Expediente creado", "expediente.editar" => "Expediente editado",
        "expediente.eliminar" => "Expediente eliminado", "expediente.cerrar" => "Expediente cerrado",
        "expediente.reabrir" => "Expediente reabierto", "expediente.ubicar" => "Ubicación asignada",
        "expediente.vincular" => "Expediente vinculado", "expediente.desvincular" => "Vínculo retirado",
        _ => a
    };
}

    .ca-grid { flex:1; display:grid; grid-template-columns:360px minmax(0,1fr) 400px; gap:0; overflow:hidden; }
    .ca-col { overflow-y:auto; padding:16px; }
    .ca-left { border-right:1px solid #E2E8F0; } .ca-center { background:#F1F5F9; display:flex; } .ca-right { border-left:1px solid #E2E8F0; }
    .ca-dropzone { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; border:2px dashed #CBD5E1; border-radius:12px; padding:22px 14px; text-align:center; cursor:pointer; background:#F8FAFC; }
    .ca-dropzone:hover { border-color:#2563EB; background:#EFF6FF; }

@using Tronox.Application.Documentos
@using Tronox.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IDocumentoService DocSvc

@* RQ04 - "Carga de Archivos" (Flujo A), calcado del legacy ctrlIncorporarDoc: modal 3 columnas
   (dropzone+cola | visor | metadatos), cola con FOCO secuencial (no wizard), indexacion uno-a-uno.
   El binario se sube AL CONFIRMAR cada documento (IncorporarEnExpedienteAsync). Nace Archivado con
   foliacion continua; el nivel se hereda del expediente. *@

<div class="ca-overlay" @onclick="Cerrar">
    <div class="ca-modal" @onclick:stopPropagation="true">
        <div class="ca-head">
            <div>
                <h3><i class="bi bi-cloud-arrow-up"></i> Carga masiva e indexación rápida</h3>
                @if (ModoBorrador)
                {
                    <div class="ca-ruta">Mis Documentos <span>›</span> <strong>Borrador privado</strong></div>
                }
                else
                {
                    <div class="ca-ruta">@FondoNombre <span>›</span> @SerieCodigo - @SerieNombre <span>›</span> <strong>@Codigo</strong></div>
                }
            </div>
            <div class="ca-head-right">
                <span class="ca-counter">@Guardados/@_cola.Count indexados</span>
                <button class="ca-x" @onclick="Cerrar">&times;</button>
            </div>
        </div>

        @if (_flash is not null) { <div class="ca-flash @(_flashOk ? "ok" : "err")">@_flash</div> }

        <div class="ca-grid">
            @* ---------- IZQUIERDA: dropzone + cola ---------- *@
            <div class="ca-col ca-left">
                <label class="ca-dropzone">
                    <InputFile OnChange="OnFiles" multiple />
                    <i class="bi bi-cloud-arrow-up"></i>
                    <div class="ca-dz-t">Arrastra o haz clic para subir</div>
                    <div class="ca-hint">PDF, DOCX, XLSX, JPG, PNG, MP4, MP3, XML · Máx. 50 MB c/u</div>
                </label>

                <label class="ca-fisico-chk"><input type="checkbox" @bind="_fisicoMode" /> Documento físico (sin archivo)</label>
                @if (_fisicoMode)
                {
                    <div class="ca-fisico-box">
                        <input type="number" min="1" class="ca-inp" style="width:80px" @bind="_fisicoFolios" /> folios
                        <button class="ca-btn sm" @onclick="AgregarFisico">Agregar</button>
                    </div>
                }

                @if (_cola.Count > 0)
                {
                    <div class="ca-progress">
                        <div class="ca-prog-stats"><span>Total @_cola.Count</span><span>Pend. @Pendientes</span><span class="ok">Ok @Guardados</span>@if (Errores > 0) { <span class="err">Err. @Errores</span> }</div>
                        <div class="ca-bar"><div class="ca-bar-fill" style="width:@(_cola.Count == 0 ? 0 : Guardados * 100 / _cola.Count)%"></div></div>
                    </div>
                }

                <div class="ca-cola">
                    @if (_cola.Count == 0) { <div class="ca-cola-empty">La cola está vacía. Sube archivos para empezar.</div> }
                    @for (var i = 0; i < _cola.Count; i++)
                    {
                        var idx = i; var it = _cola[i];
                        <div class="ca-row @(idx == _foco ? "cur" : "") @(it.Estado != "Pendiente" ? "done" : "")">
                            <span class="ca-badge @BadgeClass(it)">@(it.EsFisico ? "FIS" : (it.Formato?.ToUpperInvariant() ?? "?"))</span>
                            <div class="ca-row-main">
                                <div class="ca-row-nom">@it.Nombre</div>
                                <div class="ca-row-meta">@TamTexto(it.Tamano) · @it.Folios folio(s)@if (it.OcrPend) { <span> · OCR pend.</span> }</div>
                            </div>
                            <span class="ca-estado ca-e-@it.Estado.ToLower()">@it.Estado</span>
                            <div class="ca-row-acts">
                                @if (it.Estado == "Pendiente") { <button class="ca-ic" title="Indexar" @onclick="@(() => _foco = idx)"><i class="bi bi-pencil"></i></button> }
                                <button class="ca-ic" title="Quitar" @onclick="@(() => Quitar(idx))"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ---------- CENTRO: visor ---------- *@
            <div class="ca-col ca-center">
                @if (Foco is null) { <div class="ca-visor-empty"><i class="bi bi-eye"></i><div>Selecciona un documento de la cola para previsualizarlo.</div></div> }
                else if (Foco.EsFisico) { <div class="ca-visor-empty"><i class="bi bi-file-earmark"></i><div>Documento físico — sin archivo digital.</div></div> }
                else if (_previewUri is not null && Foco.Formato == "pdf") { <iframe class="ca-visor-frame" src="@_previewUri" title="Vista previa"></iframe> }
                else if (_previewUri is not null) { <div class="ca-visor-img"><img src="@_previewUri" alt="Vista previa" /></div> }
                else { <div class="ca-visor-empty"><i class="bi bi-file-earmark-text"></i><div>Vista previa no disponible para @(Foco.Formato?.ToUpperInvariant()).</div></div> }
            </div>

            @* ---------- DERECHA: metadatos ---------- *@
            <div class="ca-col ca-right">
                @if (Foco is null || Foco.Estado != "Pendiente")
                {
                    <div class="ca-idx-empty"><i class="bi bi-arrow-left-circle"></i><div>Sube o selecciona un documento pendiente para indexarlo.</div></div>
                }
                else
                {
                    var it = Foco;
                    <div class="ca-idx-h">Metadatos · Documento #@(_foco + 1) · @Pendientes pendiente(s)</div>
                    <div class="ca-idx-file"><i class="bi @IconoFormato(it.Formato)"></i> <span class="mono">@(it.NombreArchivo ?? "físico")</span></div>

                    <div class="ca-field"><label>Nombre del documento <span class="req">*</span></label>
                        <input class="ca-inp" maxlength="200" @bind="it.Nombre" />
                        <div class="ca-hint">Se normaliza (sin tildes; espacios → guión bajo) al guardar.</div>
                    </div>
                    <div class="ca-field"><label>Fecha del documento <span class="req">*</span></label>
                        <input type="date" class="ca-inp" @bind="it.Fecha" />
                    </div>
                    @if (_tipologias.Count > 0)
                    {
                        <div class="ca-field"><label>Tipo documental</label>
                            <select class="ca-inp" value="@(it.TipologiaId?.ToString() ?? "")" @onchange="e => OnTipologiaChanged(it, e)">
                                <option value="">— Sin tipología —</option>
                                @foreach (var t in _tipologias) { <option value="@t.Id">@t.Nombre</option> }
                            </select>
                        </div>
                    }
                    @if (!ModoBorrador)
                    {
                        <div class="ca-field"><label>Nº de folios</label>
                            <input type="number" min="1" class="ca-inp" @bind="it.Folios" readonly="@(!it.FolioManual && !it.EsFisico)" />
                            @if (!it.FolioManual && !it.EsFisico) { <div class="ca-hint">Automático (PDF: páginas; imagen: 1). Se recalcula al guardar.</div> }
                        </div>
                    }

                    @if (it.TipologiaId is long tid && _metaDefs.TryGetValue(tid, out var defs) && defs.Count > 0)
                    {
                        <div class="ca-metas-t">Metadatos de la tipología</div>
                        @foreach (var m in defs)
                        {
                            <div class="ca-field"><label>@m.Nombre @if (m.Obligatorio) { <span class="req">*</span> }</label>@MetaInput(m, it.Metas)</div>
                        }
                    }

                    <div class="ca-idx-acts">
                        <button class="ca-btn primary" @onclick="GuardarActual" disabled="@_busy"><i class="bi bi-save"></i> Guardar y siguiente</button>
                        <button class="ca-btn" @onclick="Omitir" disabled="@_busy"><i class="bi bi-skip-forward"></i> Omitir</button>
                        @if (_ultimoGuardado is not null) { <button class="ca-btn" @onclick="@(() => Replicar(it))" disabled="@_busy"><i class="bi bi-clipboard"></i> Replicar anterior</button> }
                    </div>
                }
            </div>
        </div>

        <div class="ca-foot">
            <button class="ca-btn" @onclick="Cerrar">Devolver</button>
            <button class="ca-btn primary" @onclick="Finalizar"><i class="bi bi-check-lg"></i> Finalizar</button>
        </div>
    </div>
</div>

<style>
    .ca-overlay { position:fixed; inset:0; background:rgba(15,23,42,.5); z-index:1090; display:flex; align-items:center; justify-content:center; padding:10px; }
    .ca-modal { background:#fff; border-radius:14px; width:99vw; height:calc(100vh - 20px); max-width:1500px; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 20px 50px rgba(15,23,42,.35); font-family:Poppins,sans-serif; }
    .ca-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 18px; border-bottom:1px solid #E2E8F0; }
    .ca-head h3 { margin:0; font-size:17px; font-weight:700; color:#0F172A; }
    .ca-ruta { font-size:12px; color:#94A3B8; margin-top:3px; } .ca-ruta span { color:#CBD5E1; margin:0 4px; } .ca-ruta strong { color:#2563EB; }
    .ca-head-right { display:flex; align-items:center; gap:14px; }

    .ca-cola-empty { font-size:12px; color:#94A3B8; text-align:center; padding:16px; }
    .ca-row { display:flex; align-items:center; gap:8px; border:1px solid #E2E8F0; border-radius:9px; padding:8px 10px; background:#fff; }
    .ca-row.cur { border-color:#2563EB; box-shadow:0 0 0 2px rgba(37,99,235,.12); } .ca-row.done { opacity:.75; }
    .ca-badge { font-size:9.5px; font-weight:700; border-radius:5px; padding:3px 5px; background:#EFF6FF; color:#2563EB; min-width:34px; text-align:center; }
    .ca-badge.fis { background:#FEF3C7; color:#B45309; }
    .ca-row-main { flex:1; min-width:0; } .ca-row-nom { font-size:12.5px; font-weight:600; color:#0F172A; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; } .ca-row-meta { font-size:10.5px; color:#94A3B8; }
    .ca-estado { font-size:9.5px; font-weight:700; border-radius:999px; padding:2px 7px; text-transform:uppercase; }

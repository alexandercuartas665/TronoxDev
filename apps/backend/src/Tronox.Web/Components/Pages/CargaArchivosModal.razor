    .ca-btn:hover { background:#F8FAFC; } .ca-btn.sm { height:30px; padding:0 10px; font-size:12px; }
    .ca-btn.primary { background:#2563EB; border-color:#2563EB; color:#fff; } .ca-btn.primary:hover { background:#1D4ED8; } .ca-btn:disabled { opacity:.55; cursor:default; }

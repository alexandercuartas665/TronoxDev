    .ca-visor-img { width:100%; height:100%; display:flex; align-items:center; justify-content:center; padding:16px; overflow:auto; } .ca-visor-img img { max-width:100%; max-height:100%; box-shadow:0 4px 16px rgba(15,23,42,.2); }
    .ca-visor-empty { margin:auto; text-align:center; color:#94A3B8; font-size:13px; } .ca-visor-empty i { font-size:38px; display:block; margin-bottom:10px; color:#CBD5E1; }
    .ca-idx-h { font-size:13px; font-weight:700; color:#2563EB; margin-bottom:10px; }
    .ca-idx-file { font-size:12px; color:#475569; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; padding:8px 10px; margin-bottom:12px; word-break:break-all; }
    .ca-idx-empty { color:#94A3B8; text-align:center; font-size:13px; margin-top:40px; } .ca-idx-empty i { font-size:32px; display:block; margin-bottom:8px; color:#CBD5E1; }
    .ca-field { display:flex; flex-direction:column; gap:5px; margin-bottom:11px; } .ca-field label { font-size:12.5px; font-weight:600; color:#334155; } .ca-field .req { color:#DC2626; }
    .ca-inp { height:38px; border:1px solid #E2E8F0; border-radius:8px; padding:0 11px; font-size:13px; background:#fff; width:100%; } .ca-inp[readonly] { background:#F1F5F9; color:#64748B; }
    textarea.ca-inp { height:auto; padding:8px 11px; }

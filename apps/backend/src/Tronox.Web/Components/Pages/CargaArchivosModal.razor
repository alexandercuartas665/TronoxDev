    @@media (max-width:1100px){ .ca-grid { grid-template-columns:1fr; } .ca-center { display:none; } }
</style>

@code {
    [Parameter] public long ExpedienteId { get; set; }
    [Parameter] public string? FondoNombre { get; set; }
    [Parameter] public string? SerieCodigo { get; set; }
    [Parameter] public string? SerieNombre { get; set; }
    [Parameter] public string? Codigo { get; set; }
    [Parameter] public long Actor { get; set; }
    /// <summary>Modo Mis Documentos (Flujo B): crea BORRADORES privados (sin expediente/tipologia/foliacion).</summary>
    [Parameter] public bool ModoBorrador { get; set; }
    [Parameter] public EventCallback OnGuardados { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    private const long MaxSize = 50L * 1024 * 1024;
    private const int MaxFiles = 30;
    private static readonly string[] Permitidas = ["pdf", "docx", "xlsx", "pptx", "jpg", "jpeg", "png", "tif", "tiff", "mp3", "mp4", "aac", "xml"];

    private sealed class ColaItem
    {
        public byte[]? Bytes;
        public string? NombreArchivo;
        public string? Formato;
        public long Tamano;
        public bool EsFisico;
        public string Nombre = "";
        public DateTime Fecha = DateTime.Today;
        public long? TipologiaId;
        public int Folios = 1;
        public bool FolioManual;
        public bool OcrPend;
        public Dictionary<long, string?> Metas = new();
        public string Estado = "Pendiente";
    }

    private readonly List<ColaItem> _cola = new();
    private int _foco = -1;
    private bool _fisicoMode;
    private int _fisicoFolios = 1;
    private bool _busy;
    private bool _huboGuardado;
    private ColaItem? _ultimoGuardado;
    private string? _flash; private bool _flashOk;
    private string? _previewUri;

    private IReadOnlyList<TipologiaOpcionDto> _tipologias = [];
    private readonly Dictionary<long, IReadOnlyList<DocMetadatoDefDto>> _metaDefs = new();

    private ColaItem? Foco => _foco >= 0 && _foco < _cola.Count ? _cola[_foco] : null;
    private int Guardados => _cola.Count(i => i.Estado == "Guardado");
    private int Pendientes => _cola.Count(i => i.Estado == "Pendiente");
    private int Errores => _cola.Count(i => i.Estado == "Error");

    protected override async Task OnInitializedAsync()
    {
        // En modo borrador no hay expediente: los borradores no llevan tipologia (se asigna al archivar).
        if (!ModoBorrador) { _tipologias = await DocSvc.GetTipologiasExpedienteAsync(ExpedienteId, Actor); }
    }

    protected override void OnParametersSet() => ActualizarPreview();

    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _flash = null;
        foreach (var f in e.GetMultipleFiles(MaxFiles))
        {
            var ext = (System.IO.Path.GetExtension(f.Name) ?? "").TrimStart('.').ToLowerInvariant();
            if (!Permitidas.Contains(ext)) { Flash($"'{f.Name}': extensión no permitida.", false); continue; }
            if (f.Size <= 0 || f.Size > MaxSize) { Flash($"'{f.Name}': tamaño inválido (máx 50 MB).", false); continue; }
            byte[] bytes;
            using (var ms = new MemoryStream())
            {
                await f.OpenReadStream(MaxSize).CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            var esImg = ext is "jpg" or "jpeg" or "png" or "tif" or "tiff" or "gif" or "bmp";
            _cola.Add(new ColaItem
            {
                Bytes = bytes, NombreArchivo = f.Name, Formato = ext, Tamano = bytes.LongLength,
                Nombre = NormalizarNombre(System.IO.Path.GetFileNameWithoutExtension(f.Name)),
                Folios = esImg ? 1 : 1,
                FolioManual = ext is "docx" or "xlsx" or "pptx",
                OcrPend = ext is "pdf" or "jpg" or "jpeg" or "png" or "tif" or "tiff"
            });
        }
        if (_foco < 0) { _foco = _cola.FindIndex(i => i.Estado == "Pendiente"); }
        ActualizarPreview();
    }

    private void AgregarFisico()
    {
        _cola.Add(new ColaItem { EsFisico = true, Nombre = "documento_fisico", Folios = Math.Max(1, _fisicoFolios), FolioManual = true });
        if (_foco < 0) { _foco = _cola.Count - 1; }
        _fisicoMode = false;
    }

    private void Quitar(int idx)
    {
        if (idx < 0 || idx >= _cola.Count) { return; }
        _cola.RemoveAt(idx);
        if (_foco >= _cola.Count) { _foco = _cola.FindIndex(i => i.Estado == "Pendiente"); }
        ActualizarPreview();
    }

    private async Task OnTipologiaChanged(ColaItem it, ChangeEventArgs e)
    {
        it.TipologiaId = long.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        it.Metas.Clear();
        if (it.TipologiaId is long tid && !_metaDefs.ContainsKey(tid))
        {
            _metaDefs[tid] = await DocSvc.GetMetadatosTipologiaAsync(tid);
        }
    }

    private async Task GuardarActual()
    {
        var it = Foco;
        if (it is null) { return; }
        if (string.IsNullOrWhiteSpace(it.Nombre)) { Flash("El nombre es obligatorio.", false); return; }
        _busy = true; _flash = null;
        try
        {
            var fecha = DateOnly.FromDateTime(it.Fecha);
            if (ModoBorrador)
            {
                // Flujo B: crea un BORRADOR privado (sin expediente/foliacion). El tipo/metadatos se
                // capturan luego con "Editar metadatos" o al Archivar (RF16).
                var rb = it.EsFisico
                    ? await DocSvc.CrearBorradorFisicoAsync(new CrearBorradorFisicoRequest(it.Nombre, fecha), Actor)
                    : await DocSvc.CrearBorradorBinarioAsync(it.Nombre, fecha, it.Bytes!, it.NombreArchivo!, Actor);
                if (!rb.IsOk) { Flash(rb.Error ?? "No se pudo guardar.", false); return; }
            }
            else
            {
                var metas = it.Metas.Select(kv => new DocMetadatoInput(kv.Key, kv.Value)).ToList();
                var req = new IncorporarDocRequest(
                    ExpedienteId, it.Nombre, fecha, it.TipologiaId,
                    it.Folios, it.EsFisico, it.EsFisico ? null : it.Bytes, it.EsFisico ? null : it.NombreArchivo, metas);
                var res = await DocSvc.IncorporarEnExpedienteAsync(req, Actor);
                if (!res.IsOk) { Flash(res.Error ?? "No se pudo guardar.", false); return; }
            }
            it.Estado = "Guardado";
            it.Bytes = null; // libera memoria
            _huboGuardado = true; _ultimoGuardado = it;
            await OnGuardados.InvokeAsync();
            Avanzar();
        }
        finally { _busy = false; }
    }

    private void Omitir()
    {
        if (Foco is { } it) { it.Estado = "Omitido"; it.Bytes = null; }
        Avanzar();
    }

    private void Replicar(ColaItem it)
    {
        if (_ultimoGuardado is null) { return; }
        it.Fecha = _ultimoGuardado.Fecha;
        it.TipologiaId = _ultimoGuardado.TipologiaId;
        it.Metas = new Dictionary<long, string?>(_ultimoGuardado.Metas);
    }

    private void Avanzar()
    {
        _foco = _cola.FindIndex(i => i.Estado == "Pendiente");
        ActualizarPreview();
    }

    private void ActualizarPreview()
    {
        var it = Foco;
        _previewUri = null;
        if (it is null || it.EsFisico || it.Bytes is null) { return; }
        if (it.Formato is "pdf" or "jpg" or "jpeg" or "png" or "gif" or "bmp" or "webp")
        {
            var ct = it.Formato == "pdf" ? "application/pdf" : $"image/{(it.Formato == "jpg" ? "jpeg" : it.Formato)}";
            _previewUri = $"data:{ct};base64,{Convert.ToBase64String(it.Bytes)}";
        }
    }

    private async Task Finalizar()
    {
        if (_huboGuardado) { await OnGuardados.InvokeAsync(); }
        await OnCerrar.InvokeAsync();
    }

    private async Task Cerrar() => await OnCerrar.InvokeAsync();
    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }

    // ---- Helpers de presentacion ----
    private static string TamTexto(long b) => b <= 0 ? "—" : b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0.#} KB" : $"{b / 1048576.0:0.#} MB";
    private static string BadgeClass(ColaItem it) => it.EsFisico ? "fis" : "";
    private static string IconoFormato(string? f) => f switch
    {
        "pdf" => "bi-file-earmark-pdf", "docx" => "bi-file-earmark-word", "xlsx" => "bi-file-earmark-excel",
        "jpg" or "jpeg" or "png" or "gif" or "bmp" or "tif" or "tiff" => "bi-file-earmark-image", _ => "bi-file-earmark-text"
    };

    private static string NormalizarNombre(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) { return "documento"; }
        var norm = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in norm)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) == System.Globalization.UnicodeCategory.NonSpacingMark) { continue; }
            sb.Append(c == ' ' ? '_' : c);
        }
        var res = System.Text.RegularExpressions.Regex.Replace(sb.ToString(), @"[^A-Za-z0-9_\-.]", "").ToLowerInvariant();
        return string.IsNullOrWhiteSpace(res) ? "documento" : res;
    }

    private RenderFragment MetaInput(DocMetadatoDefDto m, Dictionary<long, string?> store) => __builder =>
    {
        string? current = store.TryGetValue(m.TrdMetadatoId, out var v) ? v : null;
        void Set(ChangeEventArgs e) => store[m.TrdMetadatoId] = e.Value?.ToString();
        switch (m.TipoDato)
        {
            case TipoDatoMetadato.TextoLargo:
                <textarea class="ca-inp" rows="2" value="@current" @onchange="Set"></textarea>
                break;
            case TipoDatoMetadato.Numerico:
            case TipoDatoMetadato.Moneda:
                <input type="number" step="any" class="ca-inp" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Fecha:
                <input type="date" class="ca-inp" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Booleano:
                <select class="ca-inp" value="@current" @onchange="Set"><option value="">--</option><option value="true">Sí</option><option value="false">No</option></select>
                break;
            case TipoDatoMetadato.Lista:
                <select class="ca-inp" value="@current" @onchange="Set"><option value="">— Selecciona —</option>@foreach (var o in m.OpcionesLista) { <option value="@o.Clave">@o.Valor</option> }</select>
                break;
            default:
                <input class="ca-inp" value="@current" @onchange="Set" />
                break;
        }
    };
}

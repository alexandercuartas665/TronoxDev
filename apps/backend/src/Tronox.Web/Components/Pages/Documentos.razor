@page "/modulo/documentos"
@attribute [Authorize(Policy = "Perm:modulo/documentos:View")]
@* Llave de permisos = ruta de menu "modulo/documentos" (RF09 5.9.3). "Mis Documentos" (RQ04 - RF15):
   bandeja calcada del legacy doc_bandeja.aspx: 3 tabs (Mis Borradores, Archivados por mi, Compartidos
   [diferido]). Acciones por fila = inline Ver (visor) + Editar metadatos + menu de mas acciones (dm),
   igual que el legacy. Flujo B: crear borrador (binario en object storage / ADR-009, o Fisico) y
   archivar en un expediente (RF16). Borrado fisico solo del borrador nunca archivado (invariante 8).
   Acciones sin backend en TRONOX (Solicitar tarea, Terminar/Firmar RQ05, Editor, Compartir RF07,
   Enviar correo, Imprimir) se muestran como el legacy pero marcadas "proximamente". *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Documentos
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IDocumentoService Svc
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject IJSRuntime JS

<PageTitle>Mis Documentos - TRONOX SGDEA</PageTitle>

<div class="tx-mod tx-dep tx-trdc">
    <nav class="tronox-breadcrumb" aria-label="Ruta de navegación">
        <a href="/inicio">Inicio</a>
        <span>/</span>
        <span>Gestión Documental</span>
        <span>/</span>
        <span>Gestión Integral de Documentos</span>
        <span>/</span>
        <span class="current">Mis Documentos</span>
    </nav>

    <div class="tx-ent-headrow" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <div>
            <h1 class="tx-ent-title">Mis Documentos</h1>
            <p class="tx-ent-sub" style="margin:2px 0 0">Producción documental: crea borradores, súbelos o márcalos físicos, y archívalos en un expediente.</p>
        </div>
        @if (_canCreate)
        {
            <button class="tx-ent-btn primary" @onclick="@(() => _showSelector = true)"><i class="bi bi-file-earmark-plus"></i> Cargar Documento</button>
        }
    </div>

    @if (_pageOk is not null) { <div class="tx-ent-alert ok"><i class="bi bi-check-circle"></i><span>@_pageOk</span></div> }
    @if (_pageInfo is not null) { <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span>@_pageInfo</span></div> }
    @if (_pageError is not null) { <div class="tx-ent-fielderr">@_pageError</div> }

    <div class="tx-tabs" style="display:flex;gap:6px;border-bottom:1px solid var(--kt-border,#e9ebec);margin:12px 0;flex-wrap:wrap">
        @foreach (var b in new[] { BandejaDocumento.MisBorradores, BandejaDocumento.ArchivadosPorMi, BandejaDocumento.CompartidosConmigo })
        {
            var bb = b;
            <button class="tx-tab" style="border:none;background:none;padding:8px 14px;cursor:pointer;border-bottom:2px solid @(_bandeja == bb ? "var(--kt-primary,#405189)" : "transparent");font-weight:@(_bandeja == bb ? "600" : "400")"
                    @onclick="@(() => SwitchBandeja(bb))">@BandejaLabel(bb)</button>
        }
    </div>

    <div class="tx-ent-toolbar" style="display:flex;gap:8px;align-items:center;margin-bottom:12px">
        <input class="tx-ent-input" style="flex:1;min-width:200px" placeholder="Buscar por nombre..." @bind="_texto" @bind:event="oninput" @onkeyup="OnSearchKey" />
        <button class="tx-ent-btn" @onclick="Reload"><i class="bi bi-search"></i> Buscar</button>
    </div>

    @if (_bandeja == BandejaDocumento.MisBorradores)
    {
        <div class="tx-ent-table-wrap">
            <table class="tx-ent-table">
                <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>FECHA CREACIÓN</th><th>FOLIOS</th><th>TAMAÑO</th><th>ESTADO</th><th>FIRMA</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_borradores is null) { <tr><td colspan="8" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_borradores.Count == 0) { <tr><td colspan="8" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes borradores. Crea tu primer documento con <strong>Cargar Documento</strong>.</td></tr> }
                    else
                    {
                        @foreach (var d in _borradores)
                        {
                            var dd = d;
                            <tr>
                                <td>
                                    @if (dd.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(dd.Id))">@dd.Nombre</a> }
                                    else { @dd.Nombre }
                                </td>
                                <td class="tx-ent-hint">—</td>
                                <td>@dd.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(dd.Folios?.ToString() ?? "—")</td>
                                <td>@Tamano(dd.TamanoBytes)</td>
                                <td><span class="tx-ent-badge off">Borrador</span></td>
                                <td><span class="tx-ent-badge">@FirmaTexto(dd.EstadoFirma)</span></td>
                                <td class="right" style="white-space:nowrap">
                                    @if (dd.TieneBinario) { <button class="tx-ent-btn sm" title="Ver documento" @onclick="@(() => VerDoc(dd.Id))"><i class="bi bi-eye"></i></button> }
                                    @if (_canEdit) { <button class="tx-ent-btn sm" title="Editar metadatos y tipo documental" @onclick="@(() => OpenEditar(dd.Id))"><i class="bi bi-pencil-square"></i></button> }
                                    <span class="dm-menu">
                                        <button class="tx-ent-btn sm" title="Más acciones" @onclick="@(() => ToggleMenu(dd.Id))"><i class="bi bi-three-dots-vertical"></i></button>
                                        @if (_menuOpenId == dd.Id)
                                        {
                                            <div class="dm-backdrop" @onclick="CloseMenu"></div>
                                            <div class="dm-panel">
                                                <div class="dm-sec">Asignar tarea sobre el documento</div>
                                                <button class="dm-item" @onclick='() => Soon("Solicitar Revisión")'><i class="bi bi-eye" style="color:#2563EB"></i><span class="dm-tx"><span>Solicitar Revisión</span><span class="dm-s">Asigna a un revisor · no bloquea</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Solicitar Aprobación")'><i class="bi bi-check-lg" style="color:#16A34A"></i><span class="dm-tx"><span>Solicitar Aprobación</span><span class="dm-s">Asigna a un aprobador · no bloquea</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Solicitar Trámite")'><i class="bi bi-gear" style="color:#D97706"></i><span class="dm-tx"><span>Solicitar Trámite</span><span class="dm-s">Asigna un responsable del trámite</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Solicitar Firma")'><i class="bi bi-pencil-square" style="color:#7C3AED"></i><span class="dm-tx"><span>Solicitar Firma</span><span class="dm-s">Placeholder RQ08</span></span></button>
                                                <div class="dm-sep"></div>
                                                <div class="dm-sec">Firma</div>
                                                @if (dd.TieneBinario)
                                                {
                                                    <button class="dm-item" @onclick='() => Soon("Terminar")'><i class="bi bi-check-circle" style="color:#2563EB"></i><span class="dm-tx"><span>Terminar</span><span class="dm-s">Marca el PDF como final (listo para firmar)</span></span></button>
                                                }
                                                <div class="dm-sep"></div>
                                                <div class="dm-sec">Otras</div>
                                                <button class="dm-item" @onclick="@(() => OpenEditorContenido(dd.Id))"><i class="bi bi-file-text" style="color:#475569"></i><span class="dm-tx"><span>Editar contenido</span><span class="dm-s">Abre el editor de texto del borrador</span></span></button>
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => DescargarClose(dd.Id))"><i class="bi bi-download" style="color:#475569"></i><span class="dm-tx"><span>Descargar</span></span></button> }
                                                @if (_canEdit) { <button class="dm-item" @onclick="@(() => ArchivarClose(dd.Id))"><i class="bi bi-archive" style="color:#475569"></i><span class="dm-tx"><span>Archivar</span><span class="dm-s">Wizard TRD · RF16</span></span></button> }
                                                <button class="dm-item" @onclick='() => Soon("Compartir")'><i class="bi bi-share" style="color:#475569"></i><span class="dm-tx"><span>Compartir…</span><span class="dm-s">Con usuarios o roles</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Enviar por correo")'><i class="bi bi-envelope" style="color:#475569"></i><span class="dm-tx"><span>Enviar por correo</span></span></button>
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick='() => Soon("Imprimir")'><i class="bi bi-printer" style="color:#475569"></i><span class="dm-tx"><span>Imprimir</span></span></button> }
                                                @if (_canDelete)
                                                {
                                                    <div class="dm-sep"></div>
                                                    <button class="dm-item danger" @onclick="@(() => EliminarClose(dd))"><i class="bi bi-x-lg" style="color:#DC2626"></i><span class="dm-tx"><span>Eliminar documento</span><span class="dm-s">Eliminación permanente (borrador)</span></span></button>
                                                }
                                            </div>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_bandeja == BandejaDocumento.ArchivadosPorMi)
    {
        <div class="tx-ent-table-wrap">
            <table class="tx-ent-table">
                <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>EXPEDIENTE</th><th>FECHA INCORPORACIÓN</th><th>FOLIOS</th><th>TAMAÑO</th><th>ESTADO</th><th>FIRMA</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_archivados is null) { <tr><td colspan="9" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_archivados.Count == 0) { <tr><td colspan="9" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes documentos archivados. Archiva un borrador con el wizard <strong>Archivar</strong>.</td></tr> }
                    else
                    {
                        @foreach (var d in _archivados)
                        {
                            var dd = d;
                            <tr>
                                <td>
                                    @if (dd.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(dd.Id))">@dd.Nombre</a> }
                                    else { @dd.Nombre }
                                </td>
                                <td>@(dd.TipologiaNombre ?? "—")</td>
                                <td><span class="mono">@dd.ExpedienteCodigo</span> <span style="color:var(--kt-text-gray-600);font-size:11.5px">@dd.ExpedienteNombre</span></td>
                                <td>@(dd.FechaIncorporacion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(dd.Folios?.ToString() ?? "—")</td>
                                <td>@Tamano(dd.TamanoBytes)</td>
                                <td><span class="tx-ent-badge ok">Archivado</span></td>
                                <td><span class="tx-ent-badge">@FirmaTexto(dd.EstadoFirma)</span></td>
                                <td class="right" style="white-space:nowrap">
                                    @if (dd.TieneBinario) { <button class="tx-ent-btn sm" title="Ver documento" @onclick="@(() => VerDoc(dd.Id))"><i class="bi bi-eye"></i></button> }
                                    <span class="dm-menu">
                                        <button class="tx-ent-btn sm" title="Más acciones" @onclick="@(() => ToggleMenu(dd.Id))"><i class="bi bi-three-dots-vertical"></i></button>
                                        @if (_menuOpenId == dd.Id)
                                        {
                                            <div class="dm-backdrop" @onclick="CloseMenu"></div>
                                            <div class="dm-panel">
                                                <div class="dm-sec">Otras</div>
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => DescargarClose(dd.Id))"><i class="bi bi-download" style="color:#475569"></i><span class="dm-tx"><span>Descargar</span></span></button> }
                                                <button class="dm-item" @onclick='() => Soon("Compartir")'><i class="bi bi-share" style="color:#475569"></i><span class="dm-tx"><span>Compartir…</span><span class="dm-s">Con usuarios o roles</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Enviar por correo")'><i class="bi bi-envelope" style="color:#475569"></i><span class="dm-tx"><span>Enviar por correo</span></span></button>
                                            </div>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span>La bandeja "Compartidos conmigo" (RF07) se habilita en un siguiente avance.</span></div>
    }
</div>

@* ============ Modal SELECTOR (¿Cómo deseas incorporar?) — calcado de ctrlIncorporarDoc (MisDocumentos) ============ *@
@if (_showSelector)
{
    <div class="modal-overlay" @onclick="@(() => _showSelector = false)">
        <div class="modal-dialog" style="max-width:760px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-plus-circle"></i> ¿Cómo deseas incorporar el documento?</h3><button class="modal-close" @onclick="@(() => _showSelector = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                <div class="nd-info"><span class="nd-rf">RF09</span> <strong>Producción Documental Independiente (Flujo B).</strong> Elige el método de entrada del documento. Quedará como <strong>Borrador</strong> privado hasta ser archivado.</div>
                <div class="nd-sectitle">Métodos directos</div>
                <div class="nd-grid">
                    <div class="nd-card" @onclick="AbrirCargaBorrador">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <div class="nd-card-t">Carga de Archivos <span class="nd-rfsm">RF01 · RF02</span></div>
                        <div class="nd-card-d">Sube uno o varios archivos (PDF, imagen, ofimática) y clasifícalos uno a uno.</div>
                    </div>
                    <div class="nd-card" @onclick='() => Soon("Digitalizar (RF18)")'>
                        <i class="bi bi-camera"></i>
                        <div class="nd-card-t">Digitalizar <span class="nd-rfsm">RF18</span></div>
                        <div class="nd-card-d">Escáner local (agente TWAIN) o cámara del dispositivo móvil.</div>
                    </div>
                    <div class="nd-card" @onclick="AbrirEditorNuevo">
                        <i class="bi bi-pencil-square"></i>
                        <div class="nd-card-t">Desde Plantilla / Editor <span class="nd-rfsm">RF09</span></div>
                        <div class="nd-card-d">Crea un documento en el procesador de texto interno.</div>
                    </div>
                    <div class="nd-card disabled">
                        <span class="nd-soon">Próximamente</span>
                        <i class="bi bi-cloud"></i>
                        <div class="nd-card-t">Fuente externa <span class="nd-rfsm">RF20 · RF21</span></div>
                        <div class="nd-card-d">OneDrive, Google Drive, SharePoint, FTP/SFTP.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Carga de Archivos (modo borrador) *@
@if (_showCarga)
{
    <CargaArchivosModal ModoBorrador="true" Actor="Actor"
                        OnGuardados="OnCargaGuardados" OnCerrar="@(() => _showCarga = false)" />
}

@* Editor de texto interno (RF08) *@
@if (_showEditor)
{
    <EditorTextoModal DocId="_editorDocId" InitialNombre="@_editorNombre"
                      OnGuardado="OnEditorGuardado" OnCerrar="CloseEditor" />
}

@* ============ Modal EDITAR (metadatos) ============ *@
@if (_showEditar)
{
    <div class="modal-overlay" @onclick="@(() => _showEditar = false)">
        <div class="modal-dialog" style="max-width:560px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-tags"></i> Editar metadatos</h3><button class="modal-close" @onclick="@(() => _showEditar = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                @if (_editError is not null) { <div class="tx-ent-fielderr">@_editError</div> }
                <div class="tx-ent-field"><label>Nombre del documento <span class="req">*</span></label><input class="tx-ent-input" @bind="_eNombre" maxlength="200" /></div>
                <div class="tx-ent-field"><label>Fecha del documento <span class="req">*</span></label><input type="date" class="tx-ent-input" @bind="_eFecha" /></div>
                <div class="tx-ent-field">
                    <label>Tipo documental</label>
                    <select class="tx-ent-input" @onchange="OnEditTipoChanged">
                        <option value="0" selected="@(_eTipoId is null)">— Sin tipo —</option>
                        @foreach (var t in _eTipos) { <option value="@t.Id" selected="@(t.Id == _eTipoId)">@t.Nombre</option> }
                    </select>
                </div>
                @if (_eCampos.Count > 0)
                {
                    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#94A3B8;margin:14px 0 8px;border-top:1px solid #F1F5F9;padding-top:12px">Metadatos del tipo documental</div>
                    @foreach (var m in _eCampos)
                    {
                        <div class="tx-ent-field"><label>@m.Nombre @if (m.Obligatorio) { <span class="req">*</span> }</label>@EditMetaInput(m)</div>
                    }
                }
                else if (_eTipoId is not null)
                {
                    <div class="tx-ent-hint" style="margin-top:8px">Este tipo no tiene metadatos configurados.</div>
                }
                else
                {
                    <div class="tx-ent-hint" style="margin-top:8px">Elige un tipo documental para capturar sus metadatos.</div>
                }
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="@(() => _showEditar = false)" disabled="@_editBusy">Cancelar</button>
                <button class="tx-ent-btn primary" @onclick="GuardarEditar" disabled="@_editBusy"><i class="bi bi-save"></i> Guardar</button>
            </div>
        </div>
    </div>
}

@* ============ Modal ARCHIVAR (RF16) ============ *@
@if (_showArchivar)
{
    <div class="modal-overlay" @onclick="@(() => _showArchivar = false)">
        <div class="modal-dialog" style="max-width:760px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Archivar en expediente</h3><button class="modal-close" @onclick="@(() => _showArchivar = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                @if (_arcError is not null) { <div class="tx-ent-fielderr">@_arcError</div> }
                <div class="tx-ent-field">
                    <label>Expediente destino (Abierto) <span class="req">*</span></label>
                    <input class="tx-ent-input" placeholder="Buscar código o nombre..." @bind="_arcExpTexto" @bind:event="oninput" @onkeyup="OnArcSearchKey" />
                    <select class="tx-ent-input" style="margin-top:6px" @onchange="OnExpChanged" size="4">
                        @foreach (var e in _arcExpedientes)
                        {
                            <option value="@e.Id" selected="@(e.Id == _arcExpId)">@e.Codigo — @e.Nombre</option>
                        }
                    </select>
                    @if (_arcExpedientes.Count == 0) { <div class="tx-ent-hint">No hay expedientes abiertos visibles. Crea uno en "Mis Expedientes".</div> }
                </div>
                @if (_arcExpId > 0)
                {
                    <div class="tx-ent-grid c2">
                        <div class="tx-ent-field">
                            <label>Tipo documental <span class="req">*</span></label>
                            <select class="tx-ent-input" @onchange="OnTipChanged">
                                <option value="0">— Selecciona —</option>
                                @foreach (var t in _arcTipologias) { <option value="@t.Id" selected="@(t.Id == _arcTipId)">@t.Nombre</option> }
                            </select>
                            @if (_arcTipologias.Count == 0) { <div class="tx-ent-hint">La serie del expediente no tiene tipologías.</div> }
                        </div>
                        <div class="tx-ent-field">
                            <label>Nivel de clasificación <span class="req">*</span></label>
                            <select class="tx-ent-input" @bind="_arcNivelId">
                                @foreach (var n in _arcNiveles.Where(n => n.Orden >= _arcNivelHeredadoOrden)) { <option value="@n.Id">@n.Nombre</option> }
                            </select>
                            <div class="tx-ent-hint">Heredado del expediente; solo elevar.</div>
                        </div>
                    </div>
                    @if (_arcMetaDefs.Count > 0)
                    {
                        <div style="font-weight:600;margin:8px 0 6px">Metadatos del documento</div>
                        @foreach (var m in _arcMetaDefs)
                        {
                            <div class="tx-ent-field"><label>@m.Nombre @if (m.Obligatorio) { <span class="req">*</span> }</label>@MetaInput(m)</div>
                        }
                    }
                }
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="@(() => _showArchivar = false)" disabled="@_arcBusy">Cancelar</button>
                <button class="tx-ent-btn primary" @onclick="ConfirmarArchivar" disabled="@(_arcBusy || _arcExpId <= 0 || _arcTipId <= 0)">Archivar</button>
            </div>
        </div>
    </div>
}

@* ============ Modal ELIMINAR ============ *@
@if (_showEliminar)
{
    <div class="modal-overlay" @onclick="@(() => _showEliminar = false)">
        <div class="modal-dialog" style="max-width:480px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Eliminar borrador</h3><button class="modal-close" @onclick="@(() => _showEliminar = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                @if (_delError is not null) { <div class="tx-ent-fielderr">@_delError</div> }
                <p>Se eliminará <strong>permanentemente</strong> el borrador <strong>@_delNombre</strong> y su binario. Es el único borrado real del sistema y no se puede deshacer.</p>
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="@(() => _showEliminar = false)" disabled="@_delBusy">Cancelar</button>
                <button class="tx-ent-btn danger" @onclick="ConfirmarEliminar" disabled="@_delBusy">Eliminar definitivamente</button>
            </div>
        </div>
    </div>
}

<style>
    .doc-nom { color:#2563EB; font-weight:600; text-decoration:none; cursor:pointer; }
    .doc-nom:hover { text-decoration:underline; }
    .dm-menu { position:relative; display:inline-block; }
    .dm-backdrop { position:fixed; inset:0; z-index:40; }
    .dm-panel { position:absolute; right:0; top:calc(100% + 4px); z-index:41; width:280px; background:#fff;
        border:1px solid #E2E8F0; border-radius:10px; box-shadow:0 10px 30px rgba(15,23,42,.16); padding:6px; text-align:left; }
    .dm-sec { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#94A3B8; padding:8px 10px 4px; }
    .dm-sep { height:1px; background:#F1F5F9; margin:4px 0; }
    .dm-item { display:flex; align-items:flex-start; gap:10px; width:100%; border:none; background:none; cursor:pointer;
        padding:8px 10px; border-radius:8px; text-align:left; font-size:13px; color:#0F172A; }
    .dm-item:hover { background:#F8FAFC; }
    .dm-item.danger:hover { background:#FEF2F2; }

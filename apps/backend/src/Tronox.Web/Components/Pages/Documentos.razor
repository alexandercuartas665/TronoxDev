@page "/modulo/documentos"
@attribute [Authorize(Policy = "Perm:modulo/documentos:View")]
@* Llave de permisos = ruta de menu "modulo/documentos" (RF09 5.9.3). "Mis Documentos" (RQ04 - RF15):
   bandeja calcada del legacy doc_bandeja.aspx: 3 tabs (Mis Borradores, Archivados por mi, Compartidos
   [diferido]). Acciones por fila = inline Ver (visor) + Editar metadatos + menu de mas acciones (dm),
   igual que el legacy. Flujo B: crear borrador (binario en object storage / ADR-009, o Fisico) y
   archivar en un expediente (RF16). Borrado fisico solo del borrador nunca archivado (invariante 8).
   Acciones sin backend en TRONOX (Solicitar tarea, Terminar/Firmar RQ05, Editor, Compartir RF07,
   Enviar correo, Imprimir) se muestran como el legacy pero marcadas "proximamente". *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Documentos
@using Tronox.Application.Validaciones
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IDocumentoService Svc
@inject IValidacionService Val
@inject ICurrentPermissions Perms
@inject Tronox.Application.Common.ITenantContext Tenant
@inject IJSRuntime JS

<PageTitle>Mis Documentos - TRONOX SGDEA</PageTitle>

<style>
    /* Mis Documentos (RQ04 RF15): diseno calcado del legacy doc_bandeja.aspx (tokens del modulo). */
    .doc-wrap { padding: 8px 0 40px; }
    .doc-header { display:flex; align-items:center; justify-content:space-between; gap:14px; margin-bottom:18px; flex-wrap:wrap; }
    .doc-title { font-size:20px; font-weight:800; color:#0F172A; margin:0; display:flex; align-items:center; gap:10px; }
    .doc-subtitle { font-size:12.5px; color:#94A3B8; margin-top:3px; }
    .exp-btn { display:inline-flex; align-items:center; gap:7px; padding:9px 16px; border-radius:10px; font-size:13px; font-weight:700; border:1px solid #E2E8F0; background:#fff; color:#475569; text-decoration:none; cursor:pointer; transition:all .15s; }
    .exp-btn:hover { background:#F8FAFC; }
    .exp-btn-primary { background:#2563EB; border-color:#2563EB; color:#fff; box-shadow:0 1px 2px rgba(37,99,235,.25); }
    .exp-btn-primary:hover { background:#1D4ED8; color:#fff; }
    .doc-card { background:#fff; border:1px solid #E2E8F0; border-radius:16px; overflow:hidden; }
    .doc-tabs { display:flex; gap:4px; padding:10px 14px 0; border-bottom:1px solid #E2E8F0; background:#F8FAFC; }
    .doc-tab { padding:9px 16px; font-size:13px; font-weight:700; color:#64748B; border:1px solid transparent; border-bottom:none; border-radius:10px 10px 0 0; cursor:pointer; display:inline-flex; align-items:center; gap:7px; background:none; }
    .doc-tab.active { background:#fff; color:#2563EB; border-color:#E2E8F0; }
    .doc-tab .cnt { background:#EFF6FF; color:#2563EB; border-radius:999px; font-size:11px; padding:1px 8px; }
    table.doc-grid { width:100%; border-collapse:collapse; }
    table.doc-grid th { text-align:left; font-size:11px; font-weight:800; color:#94A3B8; text-transform:uppercase; letter-spacing:.05em; padding:12px 14px; border-bottom:1px solid #E2E8F0; background:#fff; }
    table.doc-grid td { padding:12px 14px; font-size:13px; color:#0F172A; border-bottom:1px solid #F1F5F9; vertical-align:middle; }
    table.doc-grid tr:hover td { background:#F8FAFC; }
    .doc-badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700; }
    .doc-badge-borrador { background:#FEF3C7; color:#B45309; }
    .doc-badge-archivado { background:#DCFCE7; color:#15803D; }
    .doc-badge-firma { background:#F1F5F9; color:#64748B; }
    .doc-badge-firmado { background:#DBEAFE; color:#1D4ED8; }
    .doc-fmt { display:inline-flex; align-items:center; justify-content:center; min-width:38px; padding:3px 7px; border-radius:7px; background:#EFF6FF; color:#1D4ED8; font-size:10px; font-weight:800; letter-spacing:.04em; }
    .doc-nomlink { font-weight:700; color:#0F172A; text-decoration:none; cursor:pointer; }
    .doc-nomlink:hover { color:#2563EB; }
    .doc-accion { width:30px; height:30px; border-radius:8px; border:1px solid #E2E8F0; background:#fff; color:#64748B; display:inline-flex; align-items:center; justify-content:center; font-size:12px; text-decoration:none; cursor:pointer; margin-right:4px; }
    .doc-accion:hover { background:#F8FAFC; color:#2563EB; border-color:#BFDBFE; }
    .doc-vacio { padding:56px 20px; text-align:center; color:#94A3B8; }
    .doc-vacio i { font-size:40px; opacity:.4; display:block; margin-bottom:10px; }
    /* Panel de busqueda avanzada (RF14) */
    .ba-panel { border-top:1px solid #E2E8F0; margin-top:14px; padding-top:14px; }
    .ba-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px 16px; }
    .ba-field { display:flex; flex-direction:column; gap:5px; }
    .ba-field.ba-col2 { grid-column:1 / -1; }
    .ba-field > label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#94A3B8; }
    .ba-input { padding:9px 11px; border:1px solid #E2E8F0; border-radius:9px; font-size:13px; background:#fff; outline:none; box-sizing:border-box; }
    .ba-input:focus { border-color:#2563EB; }
    .ba-chips { display:flex; flex-wrap:wrap; gap:7px; }
    .ba-chip { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border:1px solid #E2E8F0; border-radius:999px; font-size:12.5px; color:#475569; cursor:pointer; user-select:none; background:#fff; }
    .ba-chip:hover { background:#F8FAFC; }
    .ba-chip.on { background:#EFF6FF; border-color:#BFDBFE; color:#1D4ED8; font-weight:600; }
    .ba-chip input { accent-color:#2563EB; }
    .ba-actions { display:flex; align-items:center; gap:10px; margin-top:14px; flex-wrap:wrap; }
    /* Paginacion de las bandejas (calca doc-pager legacy, 12/pagina) */
    .doc-pager { display:flex; align-items:center; justify-content:flex-end; gap:12px; padding:12px 16px; border-top:1px solid #F1F5F9; font-size:12.5px; color:#64748B; }
    .doc-pg-info { color:#94A3B8; margin-right:auto; }
    .doc-pg-btn { border:1px solid #E2E8F0; background:#fff; color:#475569; border-radius:8px; width:30px; height:30px; cursor:pointer; font-size:15px; line-height:1; }
    .doc-pg-btn:hover:not(:disabled) { background:#F8FAFC; color:#2563EB; border-color:#BFDBFE; }
    .doc-pg-btn:disabled { opacity:.4; cursor:not-allowed; }
    .doc-pg-cur { font-weight:700; color:#0F172A; }
</style>

<div class="doc-wrap tx-mod">
    <div class="doc-header">
        <div>
            <h3 class="doc-title"><i class="bi bi-files" style="color:#2563EB"></i> Mis Documentos</h3>
            <div class="doc-subtitle">Producción documental independiente. Los borradores son privados: solo tú los ves.</div>
        </div>
        @if (_canCreate)
        {
            <button class="exp-btn exp-btn-primary" @onclick="@(() => _showSelector = true)"><i class="bi bi-plus-lg"></i> Crear Documento</button>
        }
    </div>

    @if (_pageOk is not null) { <div class="tx-ent-alert ok"><i class="bi bi-check-circle"></i><span>@_pageOk</span></div> }
    @if (_pageInfo is not null) { <div class="tx-ent-alert"><i class="bi bi-info-circle"></i><span>@_pageInfo</span></div> }
    @if (_pageError is not null) { <div class="tx-ent-fielderr">@_pageError</div> }

    @* Busqueda rapida + acceso a la busqueda avanzada (RF14, calca doc_bandeja aspx:210-300) *@
    <div class="doc-card" style="margin-bottom:14px;padding:14px 16px">
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <div style="position:relative;flex:1;min-width:260px">
                <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94A3B8"></i>
                <input placeholder="Buscar por nombre, contenido (OCR), metadatos…" @bind="_texto" @bind:event="oninput" @onkeyup="OnSearchKey"
                       style="width:100%;padding:10px 12px 10px 38px;border:1px solid #E2E8F0;border-radius:10px;background:#fff;outline:none;font-size:13.5px;box-sizing:border-box" />
            </div>
            <button class="exp-btn" @onclick="Reload"><i class="bi bi-search"></i>&nbsp; Buscar</button>
            <button class="exp-btn @(_showAvanzada ? "exp-btn-primary" : "")" @onclick="ToggleAvanzada"><i class="bi bi-sliders"></i>&nbsp; Búsqueda avanzada</button>
        </div>

        @if (_showAvanzada)
        {
            <div class="ba-panel">
                <div class="ba-grid">
                    <div class="ba-field ba-col2">
                        <label>Texto en nombre / contenido (OCR) / metadatos</label>
                        <input class="ba-input" placeholder="Palabra clave…" @bind="_baTexto" />
                    </div>
                    <div class="ba-field ba-col2">
                        <label>Tipo documental</label>
                        <div class="ba-chips">
                            @if (_baTipos.Count == 0) { <span class="tx-ent-hint">No hay tipologías activas.</span> }
                            @foreach (var t in _baTipos)
                            {
                                var tt = t;
                                <label class="ba-chip @(_baTipoSel.Contains(tt.Id) ? "on" : "")">
                                    <input type="checkbox" checked="@_baTipoSel.Contains(tt.Id)" @onchange="@(() => ToggleTipo(tt.Id))" /> @tt.Nombre
                                </label>
                            }
                        </div>
                    </div>
                    <div class="ba-field"><label>Fecha del documento (desde)</label><input type="date" class="ba-input" @bind="_baFDocDesde" /></div>
                    <div class="ba-field"><label>Fecha del documento (hasta)</label><input type="date" class="ba-input" @bind="_baFDocHasta" /></div>
                    <div class="ba-field"><label>Fecha de incorporación (desde)</label><input type="date" class="ba-input" @bind="_baFIncDesde" /></div>
                    <div class="ba-field"><label>Fecha de incorporación (hasta)</label><input type="date" class="ba-input" @bind="_baFIncHasta" /></div>
                    <div class="ba-field"><label>Creado por (usuario)</label><input class="ba-input" placeholder="Nombre o correo…" @bind="_baUsuario" /></div>
                    <div class="ba-field">
                        <label>Soporte</label>
                        <select class="ba-input" @bind="_baSoporte">
                            <option value="">— Cualquiera —</option>
                            <option value="Electronico">Electrónico</option>
                            <option value="Fisico">Físico</option>
                        </select>
                    </div>
                    <div class="ba-field ba-col2">
                        <label>Nivel de clasificación</label>
                        <div class="ba-chips">
                            @foreach (var n in _baNiveles)
                            {
                                var nn = n;
                                <label class="ba-chip @(_baClasifSel.Contains(nn) ? "on" : "")">
                                    <input type="checkbox" checked="@_baClasifSel.Contains(nn)" @onchange="@(() => ToggleClasif(nn))" /> @nn
                                </label>
                            }
                        </div>
                    </div>
                    <div class="ba-field ba-col2">
                        <label>Estado</label>
                        <div class="ba-chips">
                            @foreach (var es in _baEstados)
                            {
                                var ee = es;
                                <label class="ba-chip @(_baEstadoSel.Contains(ee) ? "on" : "")">
                                    <input type="checkbox" checked="@_baEstadoSel.Contains(ee)" @onchange="@(() => ToggleEstado(ee))" /> @ee
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="ba-actions">
                    <span class="tx-ent-hint" style="margin-right:auto">Dependencia y Serie/Subserie: próximamente. Resultados fail-closed por nivel de acceso, máx. 200.</span>
                    <button class="exp-btn" @onclick="LimpiarAvanzada" disabled="@_baBusy">Limpiar</button>
                    <button class="exp-btn exp-btn-primary" @onclick="AplicarAvanzada" disabled="@_baBusy"><i class="bi bi-funnel"></i>&nbsp; Aplicar filtros</button>
                </div>
            </div>
        }
    </div>

    @if (_bsqResultados is not null)
    {
        @* Resultados de la busqueda avanzada (cross-estado), calca pnlBsqResultados aspx:305-345 *@
        <div class="doc-card">
            <div class="doc-tabs" style="justify-content:space-between;align-items:center">
                <span style="padding:9px 6px;font-size:13px;font-weight:700;color:#0F172A"><i class="bi bi-funnel" style="color:#2563EB"></i> Resultados de búsqueda <span class="cnt">@_bsqResultados.Count</span></span>
                <button class="exp-btn" style="margin:4px 8px" @onclick="CerrarBusqueda"><i class="bi bi-arrow-left"></i>&nbsp; Volver a la bandeja</button>
            </div>
            <div style="overflow-x:auto">
                <table class="doc-grid">
                    <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>EXPEDIENTE</th><th>FECHA DOC.</th><th>INCORPORACIÓN</th><th>SOPORTE</th><th>ESTADO</th><th>CREADO POR</th><th class="right">ACCIONES</th></tr></thead>
                    <tbody>
                        @if (_bsqResultados.Count == 0) { <tr><td colspan="9" class="tx-ent-hint" style="text-align:center;padding:28px">Sin resultados para los filtros aplicados.</td></tr> }
                        else
                        {
                            @foreach (var r in PageOf(_bsqResultados, _pgR))
                            {
                                var rr = r;
                                <tr>
                                    <td>
                                        @if (rr.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(rr.DocId))">@rr.Nombre</a> }
                                        else { <span>@rr.Nombre</span> }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(rr.TipologiaNombre) ? "—" : rr.TipologiaNombre)</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(rr.ExpedienteCodigo)) { <span class="tx-ent-hint">— sin archivar —</span> }
                                        else { <span class="mono">@rr.ExpedienteCodigo</span> <span style="color:var(--kt-text-gray-600);font-size:11.5px">@rr.ExpedienteNombre</span> }
                                    </td>
                                    <td>@(rr.FechaDocumento?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>@(rr.FechaIncorporacion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td>@rr.Soporte</td>
                                    <td>@EstadoBadge(rr.Estado)</td>
                                    <td>@rr.CreadoPor</td>
                                    <td class="right" style="white-space:nowrap">
                                        @if (rr.TieneBinario) { <button class="doc-accion" title="Ver documento" @onclick="@(() => VerDoc(rr.DocId))"><i class="bi bi-eye"></i></button> }
                                        else { <span class="tx-ent-hint">Físico</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @DocPager(_bsqResultados.Count, _pgR, p => _pgR = p)
            </div>
        </div>
    }
    else
    {
    <div class="doc-card">
        <div class="doc-tabs">
            @foreach (var b in new[] { BandejaDocumento.MisBorradores, BandejaDocumento.ArchivadosPorMi, BandejaDocumento.CompartidosConmigo, BandejaDocumento.MisTareas })
            {
                var bb = b;
                <button class="doc-tab @(_bandeja == bb ? "active" : "")" @onclick="@(() => SwitchBandeja(bb))">
                    <i class="bi @TabIcon(bb)"></i> @BandejaLabel(bb) <span class="cnt">@Cnt(bb)</span>
                </button>
            }
        </div>

    @if (_bandeja == BandejaDocumento.MisBorradores)
    {
        <div style="overflow-x:auto">
            <table class="doc-grid">
                <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>FECHA CREACIÓN</th><th>FOLIOS</th><th>TAMAÑO</th><th>ESTADO</th><th>FIRMA</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_borradores is null) { <tr><td colspan="8" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_borradores.Count == 0) { <tr><td colspan="8" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes borradores. Crea tu primer documento con <strong>Cargar Documento</strong>.</td></tr> }
                    else
                    {
                        @foreach (var d in PageOf(_borradores, _pgB))
                        {
                            var dd = d;
                            <tr>
                                <td>
                                    @if (dd.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(dd.Id))">@dd.Nombre</a> }
                                    else { @dd.Nombre }
                                </td>
                                <td class="tx-ent-hint">—</td>
                                <td>@dd.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(dd.Folios?.ToString() ?? "—")</td>
                                <td>@Tamano(dd.TamanoBytes)</td>
                                <td>
                                    @if (dd.Estado == EstadoDocumento.Terminado)
                                    {
                                        <span class="doc-badge" style="background:#EFF6FF;color:#1D4ED8">Terminado</span>
                                    }
                                    else
                                    {
                                        <span class="doc-badge doc-badge-borrador">Borrador</span>
                                    }
                                </td>
                                <td><span class="doc-badge @(dd.EstadoFirma == EstadoFirmaDocumento.Firmado ? "doc-badge-firmado" : "doc-badge-firma")">@FirmaTexto(dd.EstadoFirma)</span></td>
                                <td class="right" style="white-space:nowrap">
                                    @if (dd.TieneBinario) { <button class="doc-accion" title="Ver documento" @onclick="@(() => VerDoc(dd.Id))"><i class="bi bi-eye"></i></button> }
                                    @if (_canEdit) { <button class="doc-accion" title="Editar metadatos y tipo documental" @onclick="@(() => OpenEditar(dd.Id))"><i class="bi bi-pencil-square"></i></button> }
                                    <span class="dm-menu">
                                        <button class="doc-accion" title="Más acciones" @onclick="@(() => ToggleMenu(dd.Id))"><i class="bi bi-three-dots-vertical"></i></button>
                                        @if (_menuOpenId == dd.Id)
                                        {
                                            <div class="dm-backdrop" @onclick="CloseMenu"></div>
                                            <div class="dm-panel">
                                                <div class="dm-sec">Asignar tarea sobre el documento</div>
                                                <button class="dm-item" @onclick="@(() => OpenSolicitar(dd.Id, dd.Nombre, TipoValidacion.Revision))"><i class="bi bi-eye" style="color:#2563EB"></i><span class="dm-tx"><span>Solicitar Revisión</span><span class="dm-s">Asigna a un revisor · no bloquea</span></span></button>
                                                <button class="dm-item" @onclick="@(() => OpenSolicitar(dd.Id, dd.Nombre, TipoValidacion.Aprobacion))"><i class="bi bi-check-lg" style="color:#16A34A"></i><span class="dm-tx"><span>Solicitar Aprobación</span><span class="dm-s">Asigna a un aprobador · no bloquea</span></span></button>
                                                <button class="dm-item" @onclick='() => Soon("Solicitar Trámite")'><i class="bi bi-gear" style="color:#D97706"></i><span class="dm-tx"><span>Solicitar Trámite</span><span class="dm-s">Asigna un responsable del trámite</span></span></button>
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => OpenSolicitarFirma(dd.Id, dd.Nombre))"><i class="bi bi-pen" style="color:#7C3AED"></i><span class="dm-tx"><span>Solicitar Firma</span><span class="dm-s">Pide la firma a otro usuario (RF06)</span></span></button> }
                                                <div class="dm-sep"></div>
                                                <div class="dm-sec">Firma</div>
                                                @if (dd.Estado == EstadoDocumento.Borrador && dd.TieneBinario)
                                                {
                                                    <button class="dm-item" @onclick="@(() => TerminarDoc(dd.Id))"><i class="bi bi-check-circle" style="color:#2563EB"></i><span class="dm-tx"><span>Terminar</span><span class="dm-s">Marca el PDF como final (listo para firmar)</span></span></button>
                                                }
                                                @if (dd.Estado == EstadoDocumento.Terminado && dd.EstadoFirma != EstadoFirmaDocumento.Firmado)
                                                {
                                                    <button class="dm-item" @onclick="@(() => OpenFirmar(dd.Id, dd.Nombre))"><i class="bi bi-patch-check" style="color:#7C3AED"></i><span class="dm-tx"><span>Firmar electrónicamente</span><span class="dm-s">Firma directa · sella el PDF (RQ05)</span></span></button>
                                                }
                                                @if (dd.EstadoFirma == EstadoFirmaDocumento.Firmado)
                                                {
                                                    <div class="dm-item" style="cursor:default"><i class="bi bi-patch-check-fill" style="color:#1D4ED8"></i><span class="dm-tx"><span>Firmado electrónicamente</span><span class="dm-s">Sellado con tu identidad y hash</span></span></div>
                                                }
                                                <div class="dm-sep"></div>
                                                <div class="dm-sec">Otras</div>
                                                @if (dd.Estado != EstadoDocumento.Terminado) { <button class="dm-item" @onclick="@(() => OpenEditorContenido(dd.Id))"><i class="bi bi-file-text" style="color:#475569"></i><span class="dm-tx"><span>Editar contenido</span><span class="dm-s">Abre el editor de texto del borrador</span></span></button> }
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => DescargarClose(dd.Id))"><i class="bi bi-download" style="color:#475569"></i><span class="dm-tx"><span>Descargar</span></span></button> }
                                                @if (_canEdit) { <button class="dm-item" @onclick="@(() => ArchivarClose(dd.Id))"><i class="bi bi-archive" style="color:#475569"></i><span class="dm-tx"><span>Archivar</span><span class="dm-s">Wizard TRD · RF16</span></span></button> }
                                                @if (_canEdit) { <button class="dm-item" @onclick="@(() => OpenCompartir(dd.Id, dd.Nombre))"><i class="bi bi-share" style="color:#475569"></i><span class="dm-tx"><span>Compartir…</span><span class="dm-s">Con usuarios o roles</span></span></button> }
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => OpenCorreo(dd.Id, dd.Nombre))"><i class="bi bi-envelope" style="color:#475569"></i><span class="dm-tx"><span>Enviar por correo</span></span></button> }
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => Imprimir(dd.Id))"><i class="bi bi-printer" style="color:#475569"></i><span class="dm-tx"><span>Imprimir</span><span class="dm-s">Copia con estampa</span></span></button> }
                                                @if (_canDelete && dd.Estado != EstadoDocumento.Terminado)
                                                {
                                                    <div class="dm-sep"></div>
                                                    <button class="dm-item danger" @onclick="@(() => EliminarClose(dd))"><i class="bi bi-x-lg" style="color:#DC2626"></i><span class="dm-tx"><span>Eliminar documento</span><span class="dm-s">Eliminación permanente (borrador)</span></span></button>
                                                }
                                            </div>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_borradores is not null) { @DocPager(_borradores.Count, _pgB, p => _pgB = p) }
        </div>
    }
    else if (_bandeja == BandejaDocumento.ArchivadosPorMi)
    {
        <div style="overflow-x:auto">
            <table class="doc-grid">
                <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>EXPEDIENTE</th><th>FECHA INCORPORACIÓN</th><th>FOLIOS</th><th>TAMAÑO</th><th>ESTADO</th><th>FIRMA</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_archivados is null) { <tr><td colspan="9" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_archivados.Count == 0) { <tr><td colspan="9" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes documentos archivados. Archiva un borrador con el wizard <strong>Archivar</strong>.</td></tr> }
                    else
                    {
                        @foreach (var d in PageOf(_archivados, _pgA))
                        {
                            var dd = d;
                            <tr>
                                <td>
                                    @if (dd.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(dd.Id))">@dd.Nombre</a> }
                                    else { @dd.Nombre }
                                </td>
                                <td>@(dd.TipologiaNombre ?? "—")</td>
                                <td><span class="mono">@dd.ExpedienteCodigo</span> <span style="color:var(--kt-text-gray-600);font-size:11.5px">@dd.ExpedienteNombre</span></td>
                                <td>@(dd.FechaIncorporacion?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(dd.Folios?.ToString() ?? "—")</td>
                                <td>@Tamano(dd.TamanoBytes)</td>
                                <td><span class="doc-badge doc-badge-archivado">Archivado</span></td>
                                <td><span class="doc-badge @(dd.EstadoFirma == EstadoFirmaDocumento.Firmado ? "doc-badge-firmado" : "doc-badge-firma")">@FirmaTexto(dd.EstadoFirma)</span></td>
                                <td class="right" style="white-space:nowrap">
                                    @if (dd.TieneBinario) { <button class="doc-accion" title="Ver documento" @onclick="@(() => VerDoc(dd.Id))"><i class="bi bi-eye"></i></button> }
                                    <span class="dm-menu">
                                        <button class="doc-accion" title="Más acciones" @onclick="@(() => ToggleMenu(dd.Id))"><i class="bi bi-three-dots-vertical"></i></button>
                                        @if (_menuOpenId == dd.Id)
                                        {
                                            <div class="dm-backdrop" @onclick="CloseMenu"></div>
                                            <div class="dm-panel">
                                                <div class="dm-sec">Otras</div>
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => DescargarClose(dd.Id))"><i class="bi bi-download" style="color:#475569"></i><span class="dm-tx"><span>Descargar</span></span></button> }
                                                @if (_canEdit) { <button class="dm-item" @onclick="@(() => OpenCompartir(dd.Id, dd.Nombre))"><i class="bi bi-share" style="color:#475569"></i><span class="dm-tx"><span>Compartir…</span><span class="dm-s">Con usuarios o roles</span></span></button> }
                                                @if (dd.TieneBinario) { <button class="dm-item" @onclick="@(() => OpenCorreo(dd.Id, dd.Nombre))"><i class="bi bi-envelope" style="color:#475569"></i><span class="dm-tx"><span>Enviar por correo</span></span></button> }
                                            </div>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_archivados is not null) { @DocPager(_archivados.Count, _pgA, p => _pgA = p) }
        </div>
    }
    else if (_bandeja == BandejaDocumento.CompartidosConmigo)
    {
        @* Compartidos conmigo (RF07): calca rpCompartidos. Acciones: Ver (si binario) + Descargar (si permiso). *@
        <div style="overflow-x:auto">
            <table class="doc-grid">
                <thead><tr><th>NOMBRE</th><th>TIPO DOCUMENTAL</th><th>COMPARTIDO POR</th><th>PERMISOS</th><th>FECHA</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_compartidos is null) { <tr><td colspan="6" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_compartidos.Count == 0) { <tr><td colspan="6" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes documentos compartidos contigo.</td></tr> }
                    else
                    {
                        @foreach (var c in PageOf(_compartidos, _pgC))
                        {
                            var cc = c;
                            <tr>
                                <td>
                                    @if (cc.TieneBinario) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(cc.DocId))">@cc.Nombre</a> }
                                    else { <span>@cc.Nombre</span> }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(cc.TipologiaNombre) ? "—" : cc.TipologiaNombre)</td>
                                <td>@cc.CompartidoPor</td>
                                <td>@foreach (var p in cc.Permisos) { <span class="cmp-badge" style="background:#EFF6FF;color:#2563EB;border-radius:6px;padding:1px 7px;font-size:11px;margin-right:4px">@p</span> }</td>
                                <td>@cc.FechaOtorgado.ToString("yyyy-MM-dd")</td>
                                <td class="right" style="white-space:nowrap">
                                    @if (cc.TieneBinario) { <button class="doc-accion" title="Ver documento" @onclick="@(() => VerDoc(cc.DocId))"><i class="bi bi-eye"></i></button> }
                                    @if (cc.TieneBinario && cc.PuedeDescargar) { <button class="doc-accion" title="Descargar" @onclick="@(() => DescargarClose(cc.DocId))"><i class="bi bi-download"></i></button> }
                                    @if (!cc.TieneBinario) { <span class="tx-ent-hint">Sin binario</span> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_compartidos is not null) { @DocPager(_compartidos.Count, _pgC, p => _pgC = p) }
        </div>
    }
    else
    {
        @* Mis tareas (RF12): tareas de validacion (Revision/Aprobacion) asignadas a mi. Responder no cambia
           el estado del documento (traza paralela). Fail-closed: solo el asignado ve y responde. *@
        <div style="overflow-x:auto">
            <table class="doc-grid">
                <thead><tr><th>DOCUMENTO</th><th>EXPEDIENTE</th><th>TIPO</th><th>PRIORIDAD</th><th>SOLICITADO POR</th><th>LIMITE</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @if (_tareas is null) { <tr><td colspan="7" class="tx-ent-hint" style="text-align:center;padding:18px">Cargando...</td></tr> }
                    else if (_tareas.Count == 0) { <tr><td colspan="7" class="tx-ent-hint" style="text-align:center;padding:18px">No tienes tareas de validación pendientes.</td></tr> }
                    else
                    {
                        @foreach (var t in PageOf(_tareas, _pgT))
                        {
                            var tt = t;
                            <tr>
                                <td>
                                    @if (tt.DocumentoId > 0) { <a href="javascript:void(0)" class="doc-nom" @onclick="@(() => VerDoc(tt.DocumentoId))">@tt.DocumentoNombre</a> }
                                    else { <span>@tt.DocumentoNombre</span> }
                                    @if (!string.IsNullOrWhiteSpace(tt.Instrucciones)) { <div style="font-size:11.5px;color:#94A3B8;margin-top:2px">@tt.Instrucciones</div> }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(tt.ExpedienteCodigo) ? "—" : tt.ExpedienteCodigo)</td>
                                <td>
                                    @if (tt.Tipo == TipoValidacion.Aprobacion) { <span class="doc-badge" style="background:#F0FDF4;color:#16A34A">Aprobación</span> }
                                    else { <span class="doc-badge" style="background:#EFF6FF;color:#2563EB">Revisión</span> }
                                </td>
                                <td>@PrioridadBadge(tt.Prioridad)</td>
                                <td>@(tt.SolicitanteNombre ?? "—")</td>
                                <td>@LimiteTexto(tt.FechaLimite, tt.DiasRestantes)</td>
                                <td class="right" style="white-space:nowrap">
                                    <button class="exp-btn exp-btn-primary" style="padding:6px 12px" @onclick="@(() => OpenResponder(tt))"><i class="bi bi-clipboard-check"></i>&nbsp; Responder</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_tareas is not null) { @DocPager(_tareas.Count, _pgT, p => _pgT = p) }
        </div>
    }
    </div>@* doc-card *@
    }@* /else busqueda *@
</div>@* doc-wrap *@

@* ============ Modal SELECTOR (¿Cómo deseas incorporar?) — calcado de ctrlIncorporarDoc (MisDocumentos) ============ *@
@if (_showSelector)
{
    <div class="modal-overlay" @onclick="@(() => _showSelector = false)">
        <div class="modal-dialog" style="max-width:760px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3><i class="bi bi-plus-circle"></i> ¿Cómo deseas incorporar el documento?</h3><button class="modal-close" @onclick="@(() => _showSelector = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                <div class="nd-info"><span class="nd-rf">RF09</span> <strong>Producción Documental Independiente (Flujo B).</strong> Elige el método de entrada del documento. Quedará como <strong>Borrador</strong> privado hasta ser archivado.</div>
                <div class="nd-sectitle">Métodos directos</div>
                <div class="nd-grid">
                    <div class="nd-card" @onclick="AbrirCargaBorrador">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <div class="nd-card-t">Carga de Archivos <span class="nd-rfsm">RF01 · RF02</span></div>
                        <div class="nd-card-d">Sube uno o varios archivos (PDF, imagen, ofimática) y clasifícalos uno a uno.</div>
                    </div>
                    <div class="nd-card" @onclick='() => Soon("Digitalizar (RF18)")'>
                        <i class="bi bi-camera"></i>
                        <div class="nd-card-t">Digitalizar <span class="nd-rfsm">RF18</span></div>
                        <div class="nd-card-d">Escáner local (agente TWAIN) o cámara del dispositivo móvil.</div>
                    </div>
                    <div class="nd-card" @onclick="AbrirEditorNuevo">
                        <i class="bi bi-pencil-square"></i>
                        <div class="nd-card-t">Desde Plantilla / Editor <span class="nd-rfsm">RF09</span></div>
                        <div class="nd-card-d">Crea un documento en el procesador de texto interno.</div>
                    </div>
                    <div class="nd-card disabled">
                        <span class="nd-soon">Próximamente</span>
                        <i class="bi bi-cloud"></i>
                        <div class="nd-card-t">Fuente externa <span class="nd-rfsm">RF20 · RF21</span></div>
                        <div class="nd-card-d">OneDrive, Google Drive, SharePoint, FTP/SFTP.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Carga de Archivos (modo borrador) *@
@if (_showCarga)
{
    <CargaArchivosModal ModoBorrador="true" Actor="Actor"
                        OnGuardados="OnCargaGuardados" OnCerrar="@(() => _showCarga = false)" />
}

@* Editor de texto interno (RF08) *@
@if (_showEditor)
{
    <EditorTextoModal DocId="_editorDocId" InitialNombre="@_editorNombre"
                      OnGuardado="OnEditorGuardado" OnCerrar="CloseEditor" />
}

@* Compartir (RF07) *@
@if (_showCompartir)
{
    <CompartirModal DocId="_compartirDocId" Nombre="@_compartirNombre" OnCerrar="CloseCompartir" />
}

@* Enviar por correo (RF05) *@
@if (_showCorreo)
{
    <EnviarCorreoModal DocId="_correoDocId" NombreDoc="@_correoNombre" OnCerrar="CloseCorreo" />
}

@* Firmar electronicamente (RQ05 - firma directa, slice 1) *@
@if (_showFirmar)
{
    <FirmarModal DocId="_firmarDocId" NombreDoc="@_firmarNombre" OnCerrar="CloseFirmar" />
}

@* Solicitar Revision/Aprobacion (RF11) *@
@if (_showSolicitar)
{
    <SolicitarValidacionModal DocId="_solDocId" NombreDoc="@_solNombre" Tipo="_solTipo" OnCerrar="CloseSolicitar" />
}

@* Solicitar Firma a otro usuario (RQ05 - RF06) *@
@if (_showSolFirma)
{
    <SolicitarFirmaModal DocId="_solFirmaDocId" NombreDoc="@_solFirmaNombre" OnCerrar="CloseSolicitarFirma" />
}

@* Responder tarea de validacion (RF12) *@
@if (_showResponder && _respTarea is not null)
{

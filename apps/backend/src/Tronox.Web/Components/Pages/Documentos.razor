    // Render de metadato del editor (con valor actual) por tipo de dato.
    private RenderFragment EditMetaInput(DocMetadatoValorDefDto m) => __builder =>
    {
        string? current = _eMetaValores.TryGetValue(m.TrdMetadatoId, out var v) ? v : null;
        void Set(ChangeEventArgs e) => _eMetaValores[m.TrdMetadatoId] = e.Value?.ToString();

        switch (m.TipoDato)
        {
            case TipoDatoMetadato.TextoLargo:
                <textarea class="tx-ent-input" rows="2" value="@current" @onchange="Set"></textarea>
                break;
            case TipoDatoMetadato.Numerico:
            case TipoDatoMetadato.Moneda:
                <input type="number" step="any" class="tx-ent-input" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Fecha:
                <input type="date" class="tx-ent-input" value="@current" @onchange="Set" />
                break;
            case TipoDatoMetadato.Booleano:
                <select class="tx-ent-input" value="@current" @onchange="Set"><option value="">--</option><option value="true">Sí</option><option value="false">No</option></select>
                break;
            case TipoDatoMetadato.Lista:
                <select class="tx-ent-input" value="@current" @onchange="Set">
                    <option value="">— Selecciona —</option>
                    @foreach (var o in m.OpcionesLista) { <option value="@o.Clave">@o.Valor</option> }
                </select>
                break;
            default:
                <input class="tx-ent-input" value="@current" @onchange="Set" />
                break;
        }
    };


@page "/modulo/formularios"
@attribute [Authorize(Policy = "Perm:modulo/formularios:View")]
@* Motor de Formularios Dinamicos (RQ08, port fiel de ECOREX). Catalogo con vista de TARJETAS + TABLA
   (toggle), KPIs, tabs Activos/Archivados, buscador y archivar/restaurar. Abre el disenador. Llave de
   permisos = ruta de menu "modulo/formularios". *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Forms
@using Tronox.Domain.Enums
@using Tronox.Web.Auth
@inject IFormDefinitionService Svc
@inject ICurrentPermissions Perms
@inject NavigationManager Nav

<PageTitle>Formularios - TRONOX SGDEA</PageTitle>

<div class="tx-mod tx-dep tx-trdc">
    <nav class="tronox-breadcrumb" aria-label="Ruta de navegación">
        <a href="/inicio">Inicio</a><span>/</span>
        <span>Motor de Formularios Dinámicos</span><span>/</span>
        <span class="current">Formularios</span>
    </nav>

    <div class="tx-ent-headrow" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <div>
            <div class="tx-ent-hint" style="letter-spacing:.06em;font-weight:600">MOTOR DE FORMULARIOS DINÁMICOS</div>
            <h1 class="tx-ent-title">Formularios</h1>
            <p class="tx-ent-sub" style="margin:2px 0 0">Diseña formularios con constructor visual, captura respuestas y publícalos como módulo o por URL.</p>
        </div>
        @if (_canCreate)
        {
            <button class="tx-ent-btn primary" @onclick="OpenNuevo"><i class="bi bi-plus-lg"></i> Nuevo formulario</button>
        }
    </div>

    @if (_pageOk is not null) { <div class="tx-ent-alert ok"><i class="bi bi-check-circle"></i><span>@_pageOk</span></div> }
    @if (_pageError is not null) { <div class="tx-ent-fielderr">@_pageError</div> }

    @* KPIs *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-top:12px">
        <div class="tx-ent-card" style="padding:14px"><div class="tx-ent-hint"><i class="bi bi-ui-checks-grid"></i> Formularios</div><div style="font-size:26px;font-weight:700">@_all.Count</div></div>
        <div class="tx-ent-card" style="padding:14px"><div class="tx-ent-hint"><i class="bi bi-check-circle"></i> Publicados</div><div style="font-size:26px;font-weight:700">@_all.Count(f => f.Status == FormStatus.Active && !f.IsArchived)</div></div>
        <div class="tx-ent-card" style="padding:14px"><div class="tx-ent-hint"><i class="bi bi-inbox"></i> Respuestas</div><div style="font-size:26px;font-weight:700">@_all.Sum(f => f.ResponseCount).ToString("N0", _co)</div></div>
        <div class="tx-ent-card" style="padding:14px"><div class="tx-ent-hint"><i class="bi bi-diagram-3"></i> Con reglas</div><div style="font-size:26px;font-weight:700">@_all.Count(f => f.RuleCount > 0)</div></div>
    </div>

    @* Toolbar: buscador + tabs estado + toggle vista *@
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px">
        <input class="tx-ent-input" style="max-width:280px" placeholder="Buscar por nombre o código..." @bind="_query" @bind:event="oninput" />
        <div style="display:flex;gap:6px">
            <button class="tx-ent-btn sm @(_tab == "act" ? "primary" : "")" @onclick='() => _tab = "act"'>Activos <span class="tx-ent-badge sm">@_all.Count(f => !f.IsArchived)</span></button>
            <button class="tx-ent-btn sm @(_tab == "arch" ? "primary" : "")" @onclick='() => _tab = "arch"' disabled="@(_all.All(f => !f.IsArchived))">Archivados <span class="tx-ent-badge sm">@_all.Count(f => f.IsArchived)</span></button>
        </div>
        <div style="flex:1"></div>
        <div style="display:flex;gap:4px">
            <button class="tx-ent-btn sm @(!_listView ? "primary" : "")" title="Tarjetas" @onclick="() => _listView = false"><i class="bi bi-grid-3x3-gap"></i> Tarjetas</button>
            <button class="tx-ent-btn sm @(_listView ? "primary" : "")" title="Lista" @onclick="() => _listView = true"><i class="bi bi-list-ul"></i> Lista</button>
        </div>
    </div>

    @if (_all is null) { <div class="tx-ent-hint" style="padding:18px">Cargando...</div> }
    else if (Filtered.Count == 0) { <div class="tx-ent-hint" style="padding:18px">@(_tab == "arch" ? "No hay formularios archivados." : "No hay formularios. Crea el primero.")</div> }
    else if (!_listView)
    {
        @* ---- Vista TARJETAS ---- *@
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:14px">
            @foreach (var f in Filtered)
            {
                var ff = f;
                <div class="tx-ent-card" style="padding:14px;position:relative;cursor:pointer" @onclick="@(() => Open(ff.Id))">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                        <i class="bi bi-file-earmark-text" style="font-size:22px;color:var(--kt-primary,#0c478a)"></i>
                        <div style="display:flex;align-items:center;gap:6px">
                            <span class="tx-ent-badge @EstadoCss(f.Status, f.IsArchived)">@EstadoLabel(f.Status, f.IsArchived)</span>
                            @if (_canDelete)
                            {
                                <button class="tx-ent-btn sm @(f.IsArchived ? "" : "danger")" title="@(f.IsArchived ? "Restaurar" : "Archivar")"
                                        @onclick:stopPropagation="true" @onclick="@(() => Archivar(ff.Id, !ff.IsArchived))">
                                    <i class="bi @(f.IsArchived ? "bi-arrow-counterclockwise" : "bi-archive")"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div style="font-weight:600;margin:8px 0 2px">@f.Title</div>
                    <div class="mono tx-ent-hint" style="margin-bottom:10px">FORX-@f.Code · rev @f.Revision</div>
                    <div style="display:flex;gap:14px;font-size:12px">
                        <span title="Campos"><i class="bi bi-input-cursor-text"></i> @f.QuestionCount</span>
                        <span title="Respuestas"><i class="bi bi-inbox"></i> @f.ResponseCount</span>
                        <span title="Reglas" style="color:#f59e0b"><i class="bi bi-diagram-3"></i> @f.RuleCount</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* ---- Vista TABLA ---- *@
        <div class="tx-ent-table-wrap" style="margin-top:14px">
            <table class="tx-ent-table">
                <thead><tr><th>FORMULARIO</th><th>ESTADO</th><th>CAMPOS</th><th>RESPUESTAS</th><th>REGLAS</th><th class="right">ACCIONES</th></tr></thead>
                <tbody>
                    @foreach (var f in Filtered)
                    {
                        var ff = f;
                        <tr style="cursor:pointer" @onclick="@(() => Open(ff.Id))">
                            <td><div style="font-weight:600">@f.Title</div><div class="mono tx-ent-hint">FORX-@f.Code · rev @f.Revision</div></td>
                            <td><span class="tx-ent-badge @EstadoCss(f.Status, f.IsArchived)">@EstadoLabel(f.Status, f.IsArchived)</span></td>
                            <td>@f.QuestionCount</td>
                            <td>@f.ResponseCount</td>
                            <td>@f.RuleCount</td>
                            <td class="right">
                                <button class="tx-ent-btn sm primary" title="Diseñar" @onclick:stopPropagation="true" @onclick="@(() => Open(ff.Id))"><i class="bi bi-pencil-square"></i></button>
                                @if (_canDelete)
                                {
                                    <button class="tx-ent-btn sm @(f.IsArchived ? "" : "danger")" title="@(f.IsArchived ? "Restaurar" : "Archivar")" @onclick:stopPropagation="true" @onclick="@(() => Archivar(ff.Id, !ff.IsArchived))"><i class="bi @(f.IsArchived ? "bi-arrow-counterclockwise" : "bi-archive")"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showNuevo)
{
    <div class="modal-overlay" @onclick="@(() => _showNuevo = false)">
        <div class="modal-dialog" style="max-width:560px;width:96%" @onclick:stopPropagation="true">
            <div class="modal-head"><h3>Nuevo formulario</h3><button class="modal-close" @onclick="@(() => _showNuevo = false)">&times;</button></div>
            <div class="modal-body tx-mod tx-trdc">
                @if (_nuevoError is not null) { <div class="tx-ent-fielderr">@_nuevoError</div> }
                <div class="tx-ent-grid c2">
                    <div class="tx-ent-field"><label>Código <span class="req">*</span></label><input class="tx-ent-input" @bind="_nCode" maxlength="50" placeholder="FRM-001" /></div>
                    <div class="tx-ent-field"><label>Título <span class="req">*</span></label><input class="tx-ent-input" @bind="_nTitle" maxlength="200" /></div>
                </div>
                <div class="tx-ent-field"><label>Descripción <span class="opt">(opcional)</span></label><textarea class="tx-ent-input" @bind="_nDesc" rows="2" maxlength="1000"></textarea></div>
            </div>
            <div class="modal-foot">
                <button class="tx-ent-btn" @onclick="@(() => _showNuevo = false)" disabled="@_nBusy">Cancelar</button>
                <button class="tx-ent-btn primary" @onclick="GuardarNuevo" disabled="@_nBusy">Crear y diseñar</button>
            </div>
        </div>
    </div>
}

@code {
    private const string ModuleKey = "modulo/formularios";
    private static readonly System.Globalization.CultureInfo _co = new("es-CO");
    private bool _canCreate, _canEdit, _canDelete;
    private IReadOnlyList<FormDefinitionListItemDto> _all = [];
    private string? _pageOk, _pageError;

    private string _query = "";
    private string _tab = "act";
    private bool _listView;

    private bool _showNuevo, _nBusy;
    private string? _nuevoError;
    private string _nCode = "", _nTitle = "", _nDesc = "";

    protected override async Task OnInitializedAsync()
    {
        var eff = await Perms.GetAsync();
        _canCreate = eff.Can(ModuleKey, PermissionAction.Create);
        _canEdit = eff.Can(ModuleKey, PermissionAction.Edit);
        _canDelete = eff.Can(ModuleKey, PermissionAction.Delete);
        await Reload();
    }

    private async Task Reload() => _all = await Svc.ListAsync(includeArchived: true);

    private IReadOnlyList<FormDefinitionListItemDto> Filtered
    {
        get
        {
            var q = (_all ?? []).Where(f => _tab == "arch" ? f.IsArchived : !f.IsArchived);
            if (!string.IsNullOrWhiteSpace(_query))
            {
                var t = _query.Trim().ToLowerInvariant();
                q = q.Where(f => f.Title.ToLowerInvariant().Contains(t) || f.Code.ToLowerInvariant().Contains(t));
            }
            return q.OrderBy(f => f.Title).ToList();
        }
    }

    private static string EstadoLabel(FormStatus s, bool archived) => archived ? "Archivado" : s switch
    { FormStatus.Draft => "Borrador", FormStatus.Active => "Publicado", FormStatus.Inactive => "Retirado", _ => s.ToString() };
    private static string EstadoCss(FormStatus s, bool archived) => archived ? "off" : s switch
    { FormStatus.Active => "ok", FormStatus.Inactive => "off", _ => "" };

    private void Open(long id) => Nav.NavigateTo($"/modulo/formularios-disenador/{id}");

    private void OpenNuevo()
    {
        _nCode = ""; _nTitle = ""; _nDesc = ""; _nuevoError = null; _nBusy = false;
        _pageOk = null; _pageError = null; _showNuevo = true;
    }

    private async Task GuardarNuevo()
    {
        _nBusy = true; _nuevoError = null;
        try
        {
            var res = await Svc.CreateAsync(new CreateFormDefinitionRequest(_nCode, _nTitle, string.IsNullOrWhiteSpace(_nDesc) ? null : _nDesc));
            if (!res.IsOk) { _nuevoError = res.Error; return; }
            Nav.NavigateTo($"/modulo/formularios-disenador/{res.Value!.Id}");
        }
        finally { _nBusy = false; }
    }

    private async Task Archivar(long id, bool archived)
    {
        var res = await Svc.SetArchivedAsync(id, archived);
        if (!res.IsOk) { _pageError = res.Error; return; }
        _pageOk = archived ? "Formulario archivado." : "Formulario restaurado.";
        await Reload();
    }
}

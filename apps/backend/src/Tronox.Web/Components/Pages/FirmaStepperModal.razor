@* Experiencia del firmante (RQ05 - RF08), port de ctrlFirmaStepper. Stepper de 5 pasos para cumplir
   una solicitud de firma pendiente: Lectura -> Identidad -> Consentimiento -> OTP (si aplica) ->
   Resultado, con sub-paso Rechazo. Diseno fst-* calcado. El sellado y la validacion OTP los hace
   IFirmaService. Autofirma (ubicacion), grafo, QR y certificado PDF quedan diferidos (ver ADR-019). *@
@using Tronox.Application.Firmas
@using Tronox.Domain.Enums
@inject IFirmaService Firmas
@inject Tronox.Application.Common.ITenantContext Tenant
@inject IJSRuntime JS

<div class="fst-ov open">
    <div class="fst-shell">
        <div class="fst-head">
            <div>
                <h4 class="fst-title"><i class="bi bi-patch-check" style="color:#2563EB"></i> Firmar: @Item.DocumentoNombre</h4>
                <div class="fst-sub">Firma electrónica · Experiencia del firmante</div>
            </div>
            <button class="fst-close" @onclick="Cerrar"><i class="bi bi-x-lg"></i></button>
        </div>

        @* Indicador de pasos *@
        <div class="fst-steps">
            @{ var pasos = OtpRequerido ? new[] { (1, "Lectura"), (2, "Identidad"), (3, "Consentimiento"), (4, "Verificación"), (5, "Firmado") }
                                        : new[] { (1, "Lectura"), (2, "Identidad"), (3, "Consentimiento"), (5, "Firmado") }; }
            @for (var i = 0; i < pasos.Length; i++)
            {
                var (n, lbl) = pasos[i];
                var cls = _paso == n ? "active" : (PasoIndice(_paso) > i ? "done" : "");
                <div class="fst-step @cls">
                    <div class="fst-circle">@(cls == "done" ? "✓" : (i + 1).ToString())</div>
                    <div class="fst-slabel">@lbl</div>
                </div>
                @if (i < pasos.Length - 1) { <div class="fst-line @(PasoIndice(_paso) > i ? "done" : "")"></div> }
            }
        </div>

        <div class="fst-body">
            @if (_err is not null) { <div class="tx-ent-fielderr" style="margin-bottom:10px">@_err</div> }

            @if (_paso == 1)
            {
                <div class="fst-doccard">
                    <div class="fst-docicon"><i class="bi bi-file-earmark-pdf"></i></div>
                    <div class="fst-docname">@Item.DocumentoNombre</div>
                    <div class="fst-docmeta">PDF · documento de archivo</div>
                    <button type="button" class="fst-b fst-b-gh" @onclick="AbrirVisor"><i class="bi bi-eye"></i> Abrir en visor de documentos</button>
                </div>
                <div class="fst-info"><i class="bi bi-info-circle" style="margin-top:2px"></i><span style="flex:1">Debe abrir el documento y revisar su contenido antes de continuar. La apertura queda registrada.</span></div>
            }
            else if (_paso == 2)
            {
                <div class="fst-idintro">Usted está a punto de firmar como:</div>
                <div class="fst-idgrid">
                    <div class="fst-idfield"><label>Nombre completo</label><div class="v">@Item.FirmanteNombre</div></div>
                    <div class="fst-idfield"><label>Solicitado por</label><div class="v">@(Item.SolicitanteNombre ?? "—")</div></div>
                    <div class="fst-idfield"><label>Tipo de firma</label><div class="v">@(Item.TipoFirma == TipoFirma.DigitalCertificada ? "Digital certificada" : "Firma electrónica")</div></div>
                    <div class="fst-idfield"><label>Documento</label><div class="v">@Item.DocumentoNombre</div></div>
                    <div class="fst-idfield" style="grid-column:1 / -1"><label>Fecha y hora</label><div class="v" style="font-family:monospace">@DateTimeOffset.UtcNow.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div></div>
                </div>
            }
            else if (_paso == 3)
            {
                <div class="fst-warn"><i class="bi bi-exclamation-triangle"></i> Al marcar la casilla, otorga su consentimiento expreso para la firma electrónica, conforme al <strong>Decreto 2364 de 2012</strong>. Este acto queda registrado en auditoría.</div>
                <label class="fst-consent @(_consent ? "on" : "")">
                    <input type="checkbox" @bind="_consent" style="margin-top:2px" />
                    <span>He leído el documento en su totalidad y estoy seguro/a de que deseo firmarlo electrónicamente.</span>
                </label>
            }
            else if (_paso == 4)
            {
                <div class="fst-otpwrap">
                    <div class="fst-otpic"><i class="bi bi-shield-lock"></i></div>
                    <div style="font-size:14px;font-weight:700;color:#0F172A">Validación de identidad</div>
                    <div style="font-size:12.5px;color:#64748B">Código enviado a: <strong>@_otpEmail</strong></div>
                    <input class="fst-otp-single" maxlength="6" inputmode="numeric" placeholder="000000" @bind="_otpCodigo" @bind:event="oninput" />
                    <div style="font-size:12px;color:#94A3B8">Válido por @_otpMin min ·
                        <button type="button" class="fst-b-lk" @onclick="ReenviarOtp" disabled="@_busy">Reenviar código</button></div>
                    @if (_otpDemo is not null)
                    {
                        <div class="fst-info" style="justify-content:center;margin-top:10px"><i class="bi bi-flask" style="margin-top:2px"></i>&nbsp; Sin correo configurado; use el código: <strong>&nbsp;@_otpDemo</strong></div>
                    }
                </div>
            }
            else if (_paso == 5)
            {
                <div style="text-align:center;padding:10px 0 4px">
                    <div class="fst-okic"><i class="bi bi-check-lg"></i></div>
                    <div style="font-size:17px;font-weight:800;color:#0F172A">Documento firmado correctamente</div>
                    <div class="fst-cert">
                        <div class="fst-cert-h">Certificado de firma</div>
                        <div class="r"><i class="bi bi-file-earmark-text"></i> <strong>Documento:</strong> @Item.DocumentoNombre</div>
                        <div class="r"><i class="bi bi-person"></i> <strong>Firmante:</strong> @Item.FirmanteNombre</div>
                        <div class="r"><i class="bi bi-clock"></i> <strong>Timestamp:</strong> @(_result?.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "")</div>
                        <div class="r" style="font-family:monospace;font-size:11px;word-break:break-all"><i class="bi bi-lock"></i> <strong>SHA-256:</strong> @(_result?.Hash ?? "")</div>
                    </div>
                    <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
                        <button class="fst-b fst-b-gh" @onclick="AbrirVisor"><i class="bi bi-eye"></i>&nbsp; Ver PDF firmado</button>
                    </div>
                </div>
            }
            else if (_paso == 99)
            {
                <div class="fst-steptag" style="color:#DC2626">Rechazar firma</div>
                <div style="font-size:13px;color:#475569;margin-bottom:10px">Indique el motivo del rechazo (obligatorio). Quedará registrado en la auditoría.</div>
                <textarea class="det-input" rows="4" maxlength="2000" placeholder="Motivo del rechazo..." @bind="_motivoRechazo"></textarea>
            }
        </div>

        <div class="fst-foot">
            <div class="fst-foot-row">
                <div class="fst-foot-l"></div>
                <div class="fst-foot-r">
                    @if (_paso is 2 or 3 or 4) { <button class="fst-b fst-b-gh" @onclick="Atras" disabled="@_busy"><i class="bi bi-arrow-left"></i> Atrás</button> }
                    @if (_paso == 1) { <button class="fst-b fst-b-pri @(_visorAbierto ? "" : "dis")" disabled="@(!_visorAbierto)" @onclick="Continuar">He leído el documento <i class="bi bi-arrow-right"></i></button> }
                    @if (_paso == 2) { <button class="fst-b fst-b-pri" @onclick="Continuar">Continuar <i class="bi bi-arrow-right"></i></button> }
                    @if (_paso == 3) { <button class="fst-b fst-b-ok @(_consent ? "" : "dis")" disabled="@(!_consent || _busy)" @onclick="DesdeConsentimiento"><i class="bi bi-patch-check"></i> @(OtpRequerido ? "Continuar" : (_busy ? "Firmando…" : "Firmar documento"))</button> }
                    @if (_paso == 4) { <button class="fst-b fst-b-ok @(_otpCodigo.Length == 6 ? "" : "dis")" disabled="@(_otpCodigo.Length != 6 || _busy)" @onclick="VerificarYFirmar"><i class="bi bi-patch-check"></i> @(_busy ? "Firmando…" : "Firmar documento")</button> }
                    @if (_paso == 5) { <button class="fst-b fst-b-pri" @onclick="Cerrar">Cerrar</button> }
                    @if (_paso == 99) { <button class="fst-b fst-b-dn" disabled="@(_busy || string.IsNullOrWhiteSpace(_motivoRechazo))" @onclick="ConfirmarRechazo">Confirmar rechazo</button> }
                </div>
            </div>
            @if (_paso is 1 or 2 or 3 or 4)
            {
                <div class="fst-foot-row fst-foot-sec">
                    <div class="fst-foot-l"><button class="fst-b fst-b-dn" @onclick="@(() => _paso = 99)" disabled="@_busy"><i class="bi bi-x-lg"></i> Rechazar firma</button></div>
                    <div class="fst-foot-r"><button class="fst-b fst-b-gh" @onclick="Cerrar" disabled="@_busy">Cancelar</button></div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fst-ov { position:fixed; inset:0; z-index:1050; background:rgba(15,23,42,.5); display:flex; align-items:center; justify-content:center; padding:14px; }
    .fst-shell { background:#fff; border-radius:18px; box-shadow:0 24px 70px rgba(15,23,42,.22); width:100%; max-width:720px; max-height:94vh; overflow-y:auto; }
    .fst-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding:20px 24px 16px; }
    .fst-title { font-size:18px; font-weight:800; color:#0F172A; margin:0; display:flex; align-items:center; gap:8px; }
    .fst-sub { font-size:12px; color:#94A3B8; margin-top:3px; }
    .fst-close { width:34px; height:34px; flex:0 0 auto; border-radius:9px; border:1px solid #E2E8F0; background:#F8FAFC; color:#475569; display:inline-flex; align-items:center; justify-content:center; font-size:15px; cursor:pointer; }
    .fst-steps { display:flex; align-items:flex-start; padding:6px 24px 18px; }
    .fst-step { display:flex; flex-direction:column; align-items:center; gap:6px; flex:0 0 auto; width:84px; }
    .fst-circle { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; background:#F1F5F9; color:#94A3B8; border:2px solid #E2E8F0; }
    .fst-slabel { font-size:10.5px; font-weight:600; color:#94A3B8; text-align:center; line-height:1.2; }
    .fst-step.active .fst-circle { background:#2563EB; color:#fff; border-color:#2563EB; box-shadow:0 0 0 4px rgba(37,99,235,.15); }
    .fst-step.active .fst-slabel { color:#2563EB; }
    .fst-step.done .fst-circle { background:#16A34A; color:#fff; border-color:#16A34A; }
    .fst-step.done .fst-slabel { color:#16A34A; }
    .fst-line { flex:1 1 auto; height:2px; background:#E2E8F0; margin-top:15px; }
    .fst-line.done { background:#16A34A; }
    .fst-body { padding:8px 24px 4px; }
    .fst-steptag { font-size:11px; font-weight:800; color:#2563EB; text-transform:uppercase; letter-spacing:.06em; margin-bottom:10px; }
    .fst-doccard { border:1.5px solid #E5E7EB; border-radius:14px; background:#F9FAFB; padding:24px; text-align:center; margin-bottom:14px; }
    .fst-docicon { width:58px; height:58px; border-radius:14px; background:#FEE2E2; color:#EF4444; display:inline-flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:10px; }
    .fst-docname { font-size:15px; font-weight:700; color:#0F172A; }
    .fst-docmeta { font-size:12px; color:#94A3B8; margin:3px 0 14px; }
    .fst-info { display:flex; gap:9px; align-items:flex-start; background:#EFF6FF; border:1px solid #BFDBFE; color:#1E40AF; border-radius:10px; padding:11px 13px; font-size:12.5px; margin-bottom:6px; }
    .fst-warn { background:#FEFCE8; border:1px solid #FDE68A; color:#92400E; border-radius:10px; padding:12px 14px; font-size:12.5px; margin-bottom:14px; }
    .fst-idintro { font-size:13.5px; color:#475569; margin-bottom:12px; }
    .fst-idgrid { display:grid; grid-template-columns:1fr 1fr; gap:12px; background:#F9FAFB; border:1.5px solid #E5E7EB; border-radius:12px; padding:16px; }
    .fst-idfield label { display:block; font-size:10px; font-weight:800; color:#94A3B8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px; }
    .fst-idfield .v { background:#fff; border:1px solid #E5E7EB; border-radius:8px; padding:8px 11px; font-size:13px; color:#334155; min-height:36px; }
    .fst-consent { display:flex; align-items:flex-start; gap:12px; padding:16px; border:2px solid #E5E7EB; border-radius:12px; background:#fafafa; }
    .fst-consent.on { border-color:#86EFAC; background:#F0FDF4; }
    .fst-consent label, .fst-consent span { font-size:13.5px; color:#0F172A; line-height:1.5; cursor:pointer; }
    .fst-otpwrap { text-align:center; }
    .fst-otpic { width:52px; height:52px; border-radius:50%; background:#EFF6FF; color:#2563EB; display:inline-flex; align-items:center; justify-content:center; font-size:20px; margin:0 auto 10px; }
    .fst-otp-single { width:220px; text-align:center; font-size:26px; font-weight:700; letter-spacing:12px; color:#0F172A; border:1.5px solid #E5E7EB; border-radius:10px; padding:10px 0; margin:14px auto 8px; display:block; }
    .fst-otp-single:focus { border-color:#2563EB; outline:none; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
    .fst-okic { width:74px; height:74px; border-radius:50%; background:#DCFCE7; border:3px solid #86EFAC; color:#16A34A; display:flex; align-items:center; justify-content:center; font-size:34px; margin:6px auto 14px; }
    .fst-cert { background:#F9FAFB; border:1px solid #E5E7EB; border-radius:12px; padding:14px 16px; text-align:left; max-width:440px; margin:16px auto 0; }
    .fst-cert-h { font-size:10px; font-weight:800; color:#94A3B8; text-transform:uppercase; letter-spacing:.06em; margin-bottom:8px; }
    .fst-cert .r { font-size:12.5px; color:#475569; line-height:1.9; }
    .fst-foot { padding:16px 28px 20px; margin-top:14px; border-top:1px solid #EEF2F7; }
    .fst-foot-row { display:flex; justify-content:space-between; align-items:center; gap:14px; flex-wrap:wrap; }
    .fst-foot-sec { margin-top:14px; padding-top:14px; border-top:1px solid #F1F5F9; }
    .fst-foot-l, .fst-foot-r { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .fst-b { display:inline-flex; align-items:center; gap:7px; padding:9px 16px; border-radius:10px; font-size:13px; font-weight:700; border:1px solid transparent; cursor:pointer; }
    .fst-b-pri { background:#2563EB; border-color:#2563EB; color:#fff; }
    .fst-b-pri.dis { background:#93C5FD; border-color:#93C5FD; cursor:not-allowed; }
    .fst-b-ok { background:#16A34A; border-color:#16A34A; color:#fff; }
    .fst-b-ok.dis { background:#A7F3C0; border-color:#A7F3C0; cursor:not-allowed; }
    .fst-b-gh { background:#fff; border-color:#CBD5E1; color:#475569; }
    .fst-b-dn { background:#fff; border-color:#FCA5A5; color:#DC2626; }
    .fst-b-lk { background:transparent; border:none; color:#2563EB; font-weight:600; padding:4px 6px; cursor:pointer; }
    .det-input { width:100%; padding:9px 12px; border:1px solid #E2E8F0; border-radius:10px; font-size:13px; color:#0F172A; background:#fff; box-sizing:border-box; }
</style>

@code {
    [Parameter] public FirmaBandejaItemDto Item { get; set; } = default!;
    [Parameter] public EventCallback<string?> OnCerrar { get; set; }

    private bool OtpRequerido => Item.OtpRequerido;

    private int _paso = 1;
    private bool _visorAbierto, _consent, _busy;
    private string _otpCodigo = "", _motivoRechazo = "";
    private string _otpEmail = "";
    private int _otpMin = 5;
    private string? _otpDemo;
    private FirmaEjecutadaDto? _result;
    private string? _err;

    private long Actor => Tenant.UserId ?? 0;

    private static int PasoIndice(int paso) => paso switch { 1 => 0, 2 => 1, 3 => 2, 4 => 3, 5 => 4, _ => 0 };

    private async Task AbrirVisor()
    {
        _visorAbierto = true;
        await JS.InvokeVoidAsync("vzAbrirVisor", $"/modulo/documento-visor?doc={Item.DocumentoId}");
    }

    private void Continuar() { _err = null; _paso = _paso == 1 ? 2 : 3; }

    private void Atras()
    {
        _err = null;
        _paso = _paso switch { 2 => 1, 3 => 2, 4 => 3, _ => _paso };
    }

    private async Task DesdeConsentimiento()
    {
        if (!_consent) { return; }
        _err = null;
        if (OtpRequerido) { _paso = 4; await ReenviarOtp(); }
        else { await FirmarSinOtp(); }
    }

    private async Task ReenviarOtp()
    {
        _busy = true; _err = null; _otpDemo = null;
        try
        {
            var res = await Firmas.GenerarOtpAsync(Item.FirmaId, Actor);
            if (res.IsOk && res.Value is not null) { _otpEmail = res.Value.EmailEnmascarado; _otpMin = res.Value.MinutosVigencia; _otpDemo = res.Value.CodigoDemo; }
            else { _err = res.Error ?? "No se pudo enviar el codigo."; }
        }
        finally { _busy = false; }
    }

    private async Task FirmarSinOtp()
    {
        _busy = true; _err = null;
        try
        {
            var res = await Firmas.FirmarSolicitadaAsync(Item.FirmaId, Actor, null, null);
            if (res.IsOk) { _result = res.Value; _paso = 5; } else { _err = res.Error ?? "No se pudo firmar."; }
        }
        finally { _busy = false; }
    }

    private async Task VerificarYFirmar()
    {
        _busy = true; _err = null;
        try
        {
            // Lee el valor exacto del campo (robusto ante el round-trip del binding oninput).
            var codigo = await JS.InvokeAsync<string>("fstReadOtp");
            if (string.IsNullOrWhiteSpace(codigo)) { codigo = _otpCodigo; }
            var res = await Firmas.FirmarConOtpAsync(Item.FirmaId, codigo, Actor, null, null);
            if (res.IsOk) { _result = res.Value; _paso = 5; } else { _err = res.Error ?? "Codigo invalido o expirado."; }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmarRechazo()
    {
        _busy = true; _err = null;
        try
        {
            var res = await Firmas.RechazarSolicitudAsync(Item.FirmaId, _motivoRechazo, Actor);
            if (res.IsOk) { await OnCerrar.InvokeAsync("Solicitud de firma rechazada."); }
            else { _err = res.Error ?? "No se pudo rechazar."; }
        }
        finally { _busy = false; }
    }

    private async Task Cerrar()
    {
        await JS.InvokeVoidAsync("vzCerrarVisor");
        await OnCerrar.InvokeAsync(_paso == 5 ? "Documento firmado electrónicamente." : null);
    }
}

    private string _wzRemDoc = "", _wzRemNombre = "", _wzRemEmail = "", _wzRemTel = "";
    private string _wzDepOrigenId = "", _wzFuncOrigenId = "";
    // Paso 3 - documento.
    private string _wzSoporte = "Fisico", _wzAsunto = "", _wzDescripcion = "";
    private int _wzFolios = 1, _wzAnexos;
    // Paso 4 - destino.
    private string _wzDepDestId = "", _wzFuncDestId = "";
    private RadicadoPrioridad _wzPrio = RadicadoPrioridad.Normal;
    // Adjuntos (Fase 2): documentos electronicos subidos al radicar.
    private const long WzMaxBytes = 50L * 1024 * 1024;
    private static readonly string[] WzExts = ["pdf", "docx", "xlsx", "pptx", "jpg", "jpeg", "png", "tif", "tiff", "gif", "bmp", "xml", "txt"];
    private sealed class WzArchivo { public byte[] Bytes = Array.Empty<byte>(); public string Nombre = ""; public long Tamano; public string Ext = ""; }
    private readonly List<WzArchivo> _wzArchivos = new();
    private string? _wzFileError;
    // Contexto para la vista previa / sticker (calca el boot del legacy).
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }
    private EsquemaRadicacionDto? _wzEsq;
    private string _wzUsuario = "Operador";
    private string _wzFechaCtx = "";

    private (int n, string lbl)[] WzPasos => new[]
    {
        (1, "Clasificacion"), (2, _wzDir == RadicadoTipo.Entrada ? "Remitente" : "Origen"), (3, "Documento"), (4, "Destinatario")
    };

    private RadicacionDireccion WzDireccionSel => _wzDir == RadicadoTipo.Entrada

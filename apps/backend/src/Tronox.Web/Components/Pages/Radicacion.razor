@page "/modulo/radicacion"
@attribute [Authorize(Policy = "Perm:modulo/radicacion:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Radicacion
@using Tronox.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@inject IRadicacionBandejaService BandejaSvc
@inject IRadicacionDistribucionService DistSvc
@inject IRadicadorService RadSvc
@inject Tronox.Application.Archivistica.IDivipolaService DivSvc
@inject IJSRuntime JS

@* RQ09 - RF11 (Bandeja de radicados, port de rad_bandeja). Lista unificada E/S/I con 6 tabs,
   filtros, contadores, export y acciones por fila. Ver -> drawer de detalle (RadDetalle); Distribuir
   -> modal (funcional). Responder / Registrar envio / + Nuevo Radicado quedan como marcadores hasta
   portar rad_radicar / rad_salida. Visibilidad fail-closed en el servicio. *@

<PageTitle>Radicacion - TRONOX SGDEA</PageTitle>

<nav class="tronox-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a><span class="sep">/</span>
    <span>Gestion y Tramite</span><span class="sep">/</span>
    <span>Ventanilla Unica / Radicacion</span><span class="sep">/</span>
    <span class="cur">Radicacion</span>
</nav>

<div class="rb-head">
    <div>
        <h1 class="page-title" style="margin:0;">Radicacion</h1>
        <p class="page-sub" style="margin:4px 0 0;">Bandeja de radicados de la entidad.</p>
    </div>
    <div class="rb-head-acts">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsvAsync" disabled="@_busy">Exportar CSV</button>
        <button class="btn btn-primary btn-sm" @onclick="NuevoRadicado">+ Nuevo Radicado</button>
    </div>
</div>

@if (_flash is not null)
{
    <div class="mc-flash @(_flashOk ? "ok" : "err")">@_flash</div>
}

<div class="rb-tabs">
    @foreach (var (key, label, count) in Tabs)
    {
        <button class="rb-tab @(_filtro.Tab == key ? "on" : "")" @onclick="@(() => SetTabAsync(key))" disabled="@_busy">
            @label <span class="rb-badge">@count</span>
        </button>
    }
    <button class="rb-filtro-toggle" @onclick="@(() => _showFilters = !_showFilters)">
        @(_showFilters ? "Ocultar filtros" : "Filtros")
    </button>
</div>

@if (_showFilters)
{
    <div class="rb-filtros">
        <input class="form-control form-control-sm" placeholder="Buscar numero / remitente / asunto..." @bind="_buscar" @bind:event="oninput" style="min-width:220px;" />
        <input type="date" class="form-control form-control-sm" @bind="_desde" title="Desde" />
        <input type="date" class="form-control form-control-sm" @bind="_hasta" title="Hasta" />
        <select class="form-control form-control-sm" @bind="_dir">
            <option value="">Direccion</option>
            <option value="Entrada">Entrada</option><option value="Salida">Salida</option><option value="Interno">Interno</option>
        </select>
        <select class="form-control form-control-sm" @bind="_tipoId">
            <option value="">Tipo</option>
            @foreach (var t in _tipos) { <option value="@t.Id">@t.Nombre</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_estado">
            <option value="">Estado</option>
            @foreach (var e in Enum.GetValues<RadicadoEstado>()) { <option value="@e">@e</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_canal">
            <option value="">Canal</option>
            @foreach (var c in Enum.GetValues<RadicadoCanal>()) { <option value="@c">@c</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_depId">
            <option value="">Dependencia</option>
            @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_sla">
            <option value="">SLA</option>
            <option value="VIGENTE">Vigente</option><option value="PROXIMO">Proximo</option><option value="VENCIDO">Vencido</option>
        </select>
        <select class="form-control form-control-sm" @bind="_top">
            <option value="25">25</option><option value="50">50</option><option value="100">100</option>
        </select>
        <button class="btn btn-primary btn-sm" @onclick="AplicarAsync" disabled="@_busy">Aplicar</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarAsync" disabled="@_busy">Limpiar</button>
    </div>
}

<div class="rb-card">
    @if (_loading)
    {
        <p style="padding:20px;"><em>Cargando bandeja...</em></p>
    }
    else if (_items.Count == 0)
    {
        <div class="rb-empty">No hay radicados que coincidan con el filtro.</div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="rb-tabla">
                <thead>
                    <tr>
                        <th>Radicado</th><th>Doc</th><th>Fecha</th><th>Tipo</th><th>Canal</th>
                        <th>Remitente</th><th>Asunto</th><th>Dependencia</th><th>Estado</th><th>SLA</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _items)
                    {
                        <tr>
                            <td>
                                <button class="rb-num" @onclick="@(() => OpenDetalle(r.Reg))">@r.Numero</button>
                                @if (r.EsPqrsd) { <span class="rb-star" title="PQRSD">*</span> }
                                @if (!string.IsNullOrEmpty(r.RespondeA)) { <div class="rb-sub">responde a @r.RespondeA</div> }
                                @if (r.NumSalidas > 0) { <div class="rb-sub">@r.NumSalidas respuesta(s)</div> }
                            </td>
                            <td><span class="rb-doc rb-doc-@r.Tipo">@DocLetra(r.Tipo)</span></td>
                            <td>@r.Fecha</td>
                            <td><span class="rb-dot" style="background:@(r.TipoColor ?? "#405189")"></span>@(r.TipoNombre ?? "-")</td>
                            <td>@r.Canal</td>
                            <td>@r.Remitente</td>
                            <td class="rb-asunto" title="@r.Asunto">@(r.Asunto ?? "-")</td>
                            <td>
                                @r.DependenciaNombre
                                @if (!string.IsNullOrEmpty(r.FuncionarioNombre)) { <div class="rb-sub">@r.FuncionarioNombre</div> }
                            </td>
                            <td>@EstadoLabel(r.Estado)</td>
                            <td>@SlaPill(r.Dias)</td>
                            <td class="rb-acts">
                                <button class="rb-act" title="Ver" @onclick="@(() => OpenDetalle(r.Reg))">Ver</button>
                                @if (r.Tipo != RadicadoTipo.Salida && !EsCerrado(r.Estado))
                                {
                                    <button class="rb-act" title="Distribuir" @onclick="@(() => OpenDistribuirAsync(r))">Distribuir</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rb-foot">Mostrando @_items.Count de @_total radicados (TOP @_top).</div>
    }
</div>

@* ============ Modal Distribuir ============ *@
@if (_distItem is not null)
{
    <div class="modal-overlay" @onclick="@(() => _distItem = null)">
        <div class="modal-dialog" style="max-width:520px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Distribuir @_distItem.Numero</h3>
                <button class="modal-close" @onclick="@(() => _distItem = null)">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Dependencia destino *</label>
                    <select class="form-control" @bind="_distDepId" @bind:after="OnDistDepChangedAsync">
                        <option value="">Selecciona...</option>
                        @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Funcionario (opcional)</label>
                    <select class="form-control" @bind="_distFuncId">
                        <option value="">Pendiente de asignar (jefe)</option>
                        @foreach (var fu in _distFuncs) { <option value="@fu.Id">@fu.Nombre</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Prioridad</label>
                    <select class="form-control" @bind="_distPrio">
                        @foreach (var p in Enum.GetValues<RadicadoPrioridad>()) { <option value="@p">@p</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Instrucciones</label>
                    <textarea class="form-control" rows="2" @bind="_distInstr" maxlength="1000"></textarea>
                </div>
                @if (_distEsReasignacion)
                {
                    <div class="field">
                        <label class="form-label">Justificacion de reasignacion *</label>
                        <textarea class="form-control" rows="2" @bind="_distJustif" maxlength="1000"></textarea>
                        <small class="text-muted">Este radicado ya tiene una tarea activa; reasignar exige justificacion (RF07-2).</small>
                    </div>
                }
                @if (_distError is not null) { <div class="tk-field-error">@_distError</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="@(() => _distItem = null)">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmDistribuirAsync" disabled="@_busy">Distribuir</button>
            </div>
        </div>
    </div>
}

@* ============ Asistente Nuevo Radicado (rad_radicar, Fase 1: Entrada + Interna) ============ *@
@if (_wzOpen)
{
    <div class="wz-page">
        <div class="wz-shell">
            <div class="wz-titlebar">
                <h1>@(_wzDir == RadicadoTipo.Salida ? "NUEVO RADICADO DE SALIDA" : "NUEVO RADICADO — " + (_wzDir == RadicadoTipo.Interno ? "INTERNA" : "PRESENCIAL"))</h1>
                <button type="button" class="x" @onclick="WzCerrar" title="Cerrar">&#10005;</button>
            </div>

                <div class="wz-head">
                    <div class="wz-ctx">
                        <div><span class="l">Sede: </span><strong>@(_wzEsq?.EntidadNombre ?? "-")</strong></div>
                        <div><span class="l">Usuario: </span><strong>@_wzUsuario</strong></div>
                        <div><span class="l">Fecha/Hora (NTP): </span><strong class="rojo">@_wzFechaCtx &mdash; No editable</strong></div>
                        <div><span class="l">Tipo: </span><strong class="navy">@WzTipoCtx</strong></div>
                    </div>
                    <div class="wz-steps">
                        @{
                            var pasos = WzPasos;
                            for (var i = 0; i < pasos.Length; i++)
                            {
                                var n = pasos[i].n; var lbl = pasos[i].lbl;
                                var cls = _wzStep > n ? "done" : (_wzStep == n ? "cur" : "");
                                <div class="wz-step @cls"><div class="b">@(_wzStep > n ? "✓" : n.ToString())</div><span class="l">@lbl</span></div>
                                if (i < pasos.Length - 1)
                                {
                                    <div class="wz-line @(_wzStep > n ? "done" : "")"></div>
                                }
                            }
                        }
                    </div>
                </div>

                <div class="wz-body">
                    @* ------- Panel izquierdo: formulario por paso ------- *@
                    <div class="wz-left">
                        @if (WzEsDigital)
                        {
                            <h2 class="wz-h2">Paso @_wzStep &mdash; Documentos Digitalizados</h2>
                            <div class="wz-ok2">
                                <div>
                                    <div class="t">&#10003; Radicado generado exitosamente</div>
                                    <div class="n">@_wzNumero</div>
                                </div>
                                <button type="button" class="wz-btn" @onclick="WzImprimirSticker">&#128424; Imprimir sticker</button>
                            </div>
                            <label class="wz-drop">
                                <InputFile OnChange="WzOnDigFiles" multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" />
                                <span class="ico" style="font-size:32px;">&#128193;</span>
                                <span style="font-weight:600;color:#212529;">Arrastrar archivos aqui o hacer clic</span>
                                <span class="hint">PDF, JPG, PNG, TIFF &mdash; Max. 50 MB por archivo</span>
                                <div style="margin-top:12px;display:flex;justify-content:center;gap:8px;">
                                    <span class="wz-btn navy" style="font-size:13px;">&#128194; Seleccionar archivos</span>
                                    <span class="wz-btn" style="font-size:13px;" title="Integracion de escaner TWAIN pendiente">&#128424; Captura TWAIN</span>
                                </div>
                            </label>
                            @if (_wzDigItems.Count > 0)
                            {
                                <div class="wz-files" style="margin-top:14px;">
                                    @foreach (var it in _wzDigItems)
                                    {
                                        <div class="wz-file">
                                            <span class="ext">@(string.IsNullOrEmpty(it.Ext) ? "?" : it.Ext.ToUpperInvariant())</span>
                                            <span class="nom" title="@it.Nombre">@it.Nombre</span>
                                            <span class="tam">@WzTam(it.Tamano)</span>
                                            <span class="est" style="color:@(it.Estado == "Adjuntado" ? "#0a7d6f" : it.Estado == "Error" ? "#DC2626" : "#94A3B8");font-size:11px;font-weight:600;">
                                                @(it.Estado == "Adjuntado" ? "✓ Adjuntado" : it.Estado == "Error" ? "✕ Error" : "Subiendo...")
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (_wzFileError is not null) { <span class="hint" style="color:#DC2626;">@_wzFileError</span> }
                            <div class="wz-warn" style="margin-top:16px;">&#128161; El radicado puede quedar sin archivo adjunto. Podra adjuntar desde la bandeja o el detalle en cualquier momento posterior.</div>
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 1)
                        {
                            <h2 class="wz-h2">Paso 1 &mdash; Origen del documento</h2>
                            <div class="wz-field">
                                <label>Comunicacion <span class="req">*</span></label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    <button type="button" class="wz-chip lg" @onclick="@(() => WzSetDir(RadicadoTipo.Entrada))">&#128229; Externa (entrada)</button>
                                    <button type="button" class="wz-chip lg on">&#128228; Salida</button>
                                    <button type="button" class="wz-chip lg" @onclick="@(() => WzSetDir(RadicadoTipo.Interno))">&#128260; Interna</button>
                                </div>
                            </div>
                            <div class="wz-sub">Seleccione de donde proviene el documento que va a radicar (RF05-2).</div>
                            <button type="button" class="wz-card2 wide @(_wzSalOrigen == "RESPUESTA" ? "on" : "")" @onclick="@(() => _wzSalOrigen = "RESPUESTA")">
                                <div class="t">Respuesta a radicado de entrada <span class="wz-badge">El mas comun</span></div>
                                <div class="d">La entidad responde una peticion, queja, tutela u oficio. Al radicar, la entrada puede quedar Respondida.</div>
                            </button>
                            <button type="button" class="wz-card2 wide @(_wzSalOrigen == "RQ04" ? "on" : "")" @onclick="@(() => _wzSalOrigen = "RQ04")">
                                <div class="t">Documento existente en TRONOX (RQ04)</div>
                                <div class="d">Seleccione desde el buscador; el sistema precarga los metadatos y estampa al confirmar.</div>
                            </button>
                            <button type="button" class="wz-card2 wide @(_wzSalOrigen == "EXTERNO" ? "on" : "")" @onclick="@(() => _wzSalOrigen = "EXTERNO")">
                                <div class="t">Documento externo cargado</div>
                                <div class="d">PDF generado fuera de TRONOX; diligencie los metadatos manualmente.</div>
                            </button>
                            @if (_wzSalOrigen == "RESPUESTA")
                            {
                                <div class="wz-field" style="margin-top:12px;">
                                    <label>Radicado de entrada que responde <span class="req">*</span></label>
                                    @if (_wzSalEntradaId is not null)
                                    {
                                        <div class="wz-dest" style="background:#F0FDF4;border-color:#86EFAC;">
                                            <div>
                                                <div class="dep" style="font-family:Consolas,monospace;">@_wzSalEntradaNum</div>
                                                <div class="fun">@(_wzSalEntradaAsunto)</div>
                                            </div>
                                            <button type="button" class="wz-btn" style="font-size:12px;" @onclick="WzSalQuitarEntrada">Cambiar</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <input class="wz-in" @bind="_wzSalBuscar" @bind:event="oninput" @bind:after="WzSalBuscarEntradas" placeholder="Buscar por numero, asunto o remitente..." />
                                        @if (_wzSalResultados.Count > 0)
                                        {
                                            <div class="wz-busq">
                                                @foreach (var r in _wzSalResultados)
                                                {
                                                    var rr = r;
                                                    <button type="button" class="wz-busq-item" @onclick="@(() => WzSalElegirEntrada(rr))">
                                                        <span style="font-family:Consolas,monospace;color:#405189;font-weight:700;">@rr.Numero</span>
                                                        <span style="color:#94A3B8;"> &middot; @rr.Remitente</span>
                                                        <div style="font-size:11px;color:#566980;">@rr.Asunto</div>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else if (_wzSalOrigen == "RQ04")
                            {
                                <div class="wz-info" style="margin-top:12px;">&#128193; El selector de documentos RQ04 se habilita al integrar ese modulo. Por ahora use "Documento externo cargado" o "Respuesta".</div>
                            }
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 2)
                        {
                            <h2 class="wz-h2">Paso 2 &mdash; Clasificacion</h2>
                            <div class="wz-sub">Tipos de direccion Salida, nivel de clasificacion y prioridad.</div>
                            <div class="wz-field">
                                <label>Tipo de comunicacion <span class="req">*</span></label>
                                <select class="wz-in" @bind="_wzTipoId" @bind:after="WzOnTipoChanged">
                                    <option value="">&mdash; Seleccione el tipo &mdash;</option>
                                    @foreach (var t in WzTiposFiltrados) { <option value="@t.Id">@t.Nombre</option> }
                                </select>
                                @if (!WzTiposFiltrados.Any()) { <span class="hint" style="color:#DC2626;">No hay tipos con direccion Salida activos en el catalogo (RF01-2).</span> }
                            </div>
                            <div class="wz-field">
                                <label>Nivel de clasificacion</label>
                                <select class="wz-in" @bind="_wzNivelId">
                                    <option value="">(por defecto del tipo)</option>
                                    @foreach (var n in _wzNiveles) { <option value="@n.Id">@n.Nombre</option> }
                                </select>
                            </div>
                            <div class="wz-field">
                                <label>Prioridad</label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    @foreach (var p in Enum.GetValues<RadicadoPrioridad>())
                                    {
                                        var ico = p == RadicadoPrioridad.Urgente ? "\U0001F534" : p == RadicadoPrioridad.Alta ? "\U0001F7E0" : "\U0001F535";
                                        <button type="button" class="wz-chip @(_wzPrio == p ? "on" : "")" @onclick="@(() => _wzPrio = p)">@ico @p</button>
                                    }
                                </div>
                            </div>
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 3)
                        {
                            <h2 class="wz-h2">Paso 3 &mdash; Destinatario</h2>
                            <div class="wz-sub">Datos del destinatario y canal de envio (RF05-4).</div>
                            <div class="wz-field">
                                <label>Tipo de tercero</label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    @foreach (var (val, txt) in new[] { ("natural", "Persona Natural"), ("juridica", "Persona Juridica"), ("publica", "Entidad Publica") })
                                    {
                                        <button type="button" class="wz-chip @(_wzTerTipo == val ? "on" : "")" @onclick="@(() => _wzTerTipo = val)">@txt</button>
                                    }
                                </div>
                            </div>
                            <div class="wz-grid2">
                                <div class="wz-field">
                                    <label>Tipo de documento</label>
                                    <select class="wz-in" @bind="_wzRemTipoDoc">
                                        @foreach (var td in new[] { "CC", "NIT", "CE", "Pasaporte", "TI", "PPT" }) { <option value="@td">@td</option> }
                                    </select>
                                </div>
                                <div class="wz-field">
                                    <label>Numero de documento</label>
                                    <input class="wz-in" @bind="_wzRemDoc" @bind:after="WzAutocompletarTercero" placeholder="Ej: 79.456.231" />
                                    @if (_wzTerceroSugerido) { <span class="hint" style="color:#0a7d6f;">&#10003; Destinatario encontrado en radicados previos.</span> }
                                </div>
                            </div>
                            <div class="wz-field">
                                <label>Nombre / Razon social <span class="req">*</span></label>
                                <input class="wz-in" @bind="_wzRemNombre" placeholder="Nombre completo o razon social" />
                            </div>
                            <div class="wz-grid2">
                                <div class="wz-field">
                                    <label>Correo electronico @(_wzSalCanal == "EMAIL" ? "" : "")<span class="req" style="@(_wzSalCanal == "EMAIL" ? "" : "display:none")">*</span></label>
                                    <input class="wz-in" @bind="_wzRemEmail" placeholder="correo@@ejemplo.com" />
                                </div>
                                <div class="wz-field">
                                    <label>Telefono</label>
                                    <input class="wz-in" @bind="_wzRemTel" placeholder="Numero de contacto" />
                                </div>
                            </div>
                            <div class="wz-field">
                                <label>Canal de envio <span class="req">*</span></label>
                                <div class="wz-cards2" style="flex-wrap:wrap;">
                                    @foreach (var (val, txt, desc) in WzCanalesSalida)
                                    {
                                        <button type="button" class="wz-card2 @(_wzSalCanal == val ? "on" : "")" @onclick="@(() => _wzSalCanal = val)">
                                            <div class="t">@txt</div><div class="d">@desc</div>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 4)
                        {
                            <h2 class="wz-h2">Paso 4 &mdash; Informacion del documento</h2>
                            <div class="wz-sub">Asunto, folios y vinculacion con el radicado de entrada (RF05-5).</div>
                            <div class="wz-field">
                                <label>Asunto <span class="req">*</span></label>
                                <textarea class="wz-in" rows="2" maxlength="500" @bind="_wzAsunto" @bind:event="oninput" placeholder="Asunto del documento de salida"></textarea>
                                <div class="wz-cnt">@(_wzAsunto.Length)/500</div>
                            </div>
                            <div class="wz-field">
                                <label>Descripcion</label>
                                <textarea class="wz-in" rows="2" @bind="_wzDescripcion" placeholder="Descripcion (opcional)"></textarea>
                            </div>
                            <div class="wz-field" style="max-width:200px;">
                                <label>Folios</label>
                                <input type="number" min="0" class="wz-in" @bind="_wzFolios" placeholder="0" />
                            </div>
                            <div class="wz-field">
                                <label>Radicado de entrada vinculado</label>
                                @if (_wzSalEntradaId is not null)
                                {
                                    <div class="wz-dest" style="background:#eef0f7;">
                                        <div><div class="dep" style="font-family:Consolas,monospace;">@_wzSalEntradaNum</div><div class="fun">Vinculado por el origen "Respuesta"</div></div>
                                    </div>
                                }
                                else
                                {
                                    <span class="hint">La vinculacion es opcional. Un radicado de salida se vincula a maximo un radicado de entrada.</span>
                                }
                            </div>
                            @if (_wzSalEntradaId is not null)
                            {
                                <label class="wz-tgl">
                                    <input type="checkbox" @bind="_wzSalDefinitiva" />
                                    <span><strong>Respuesta definitiva</strong> &mdash; solo la respuesta definitiva cierra el termino del radicado de entrada. Un radicado de entrada puede tener multiples salidas.</span>
                                </label>
                            }
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 5)
                        {
                            <h2 class="wz-h2">Paso 5 &mdash; Documento</h2>
                            <div class="wz-sub">El documento principal es <strong>obligatorio</strong> en radicacion de salida.</div>
                            <div class="wz-field">
                                <label>Documento principal <span class="req">*</span></label>
                                <label class="wz-drop">
                                    <InputFile OnChange="WzOnFiles" multiple accept=".pdf,.docx,.jpg,.jpeg,.png" />
                                    <span class="ico">&#8681;</span>
                                    <span>Clic para seleccionar el documento principal</span>
                                    <span class="hint">PDF recomendado &mdash; Max. 50 MB</span>
                                </label>
                                @if (_wzArchivos.Count > 0)
                                {
                                    <div class="wz-files">
                                        @for (var i = 0; i < _wzArchivos.Count; i++)
                                        {
                                            var idx = i; var f = _wzArchivos[i];
                                            <div class="wz-file">
                                                <span class="ext">@(string.IsNullOrEmpty(f.Ext) ? "?" : f.Ext.ToUpperInvariant())</span>
                                                <span class="nom" title="@f.Nombre">@f.Nombre</span>
                                                <span class="tam">@WzTam(f.Tamano)</span>
                                                <button type="button" class="x" @onclick="@(() => _wzArchivos.RemoveAt(idx))">&times;</button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (_wzFileError is not null) { <span class="hint" style="color:#DC2626;">@_wzFileError</span> }
                            </div>
                            <div class="wz-info">&#128396; Estado de firma (RQ05): Sin flujo de firma asociado &mdash; la integracion con el modulo de firmas RQ05 aplica cuando el documento provenga de un flujo de aprobacion.</div>
                        }
                        else if (_wzDir == RadicadoTipo.Salida && _wzStep == 6)
                        {
                            <h2 class="wz-h2">Paso 6 &mdash; Confirmacion y radicacion</h2>
                            <div class="wz-sub">Revise la informacion. Al radicar se asigna el consecutivo de salida.</div>
                            @foreach (var (k, v) in WzSalidaResumen())
                            {
                                <div class="pv-row"><span class="k">@k</span><span class="v">@v</span></div>
                            }
                            @if (_wzSalCanal == "EMAIL")
                            {
                                <div class="wz-info" style="margin-top:12px;">&#9993; Al radicar, el sistema enviara el documento automaticamente a @(_wzRemEmail).</div>
                            }
                            else if (!string.IsNullOrEmpty(_wzSalCanal))
                            {
                                <div class="wz-warn" style="margin-top:12px;">El envio queda Pendiente: registrelo desde la bandeja (&#128233;) para generar la constancia@(_wzSalCanal == "JUDICIAL" ? " / acta judicial" : "").</div>
                            }
                            <div class="wz-ok-note">&#10003; <strong>Listo para radicar</strong> &mdash; al hacer clic en "Radicar salida" se asignara el consecutivo de salida.</div>
                        }
                        else if (_wzStep == 1)
                        {
                            <h2 class="wz-h2">Paso 1 &mdash; Clasificacion</h2>
                            <div class="wz-field">
                                <label>Comunicacion <span class="req">*</span></label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    <button type="button" class="wz-chip lg @(_wzDir == RadicadoTipo.Entrada ? "on" : "")" @onclick="@(() => WzSetDir(RadicadoTipo.Entrada))">&#128229; Externa (entrada)</button>
                                    <button type="button" class="wz-chip lg @(_wzDir == RadicadoTipo.Salida ? "on" : "")" @onclick="@(() => WzSetDir(RadicadoTipo.Salida))">&#128228; Salida</button>
                                    <button type="button" class="wz-chip lg @(_wzDir == RadicadoTipo.Interno ? "on" : "")" @onclick="@(() => WzSetDir(RadicadoTipo.Interno))">&#128260; Interna</button>
                                </div>
                                <span class="hint">Defina el sentido de la comunicacion antes de elegir el tipo</span>
                            </div>
                            <div class="wz-field">
                                <label>Tipo de comunicacion <span class="req">*</span></label>
                                <select class="wz-in" @bind="_wzTipoId" @bind:after="WzOnTipoChanged">
                                    <option value="">&mdash; Seleccione el tipo &mdash;</option>
                                    @foreach (var t in WzTiposFiltrados) { <option value="@t.Id">@t.Nombre</option> }
                                </select>
                                @if (WzTipoSel is { } ts)
                                {
                                    <div class="wz-tipoinfo">
                                        <span>@WzVenceTxt</span>
                                        @if (ts.EsPqrsd) { <span class="wz-badge pqrsd">PQRSD</span> }
                                        @if (ts.EsTutela) { <span class="wz-badge tutela">TUTELA &mdash; Control estricto</span> }
                                    </div>
                                }
                            </div>
                            <div class="wz-field">
                                <label>Nivel de clasificacion <span class="req">*</span></label>
                                <select class="wz-in" @bind="_wzNivelId">
                                    <option value="">(por defecto del tipo)</option>
                                    @foreach (var nv in _wzNiveles) { <option value="@nv.Id">@nv.Nombre</option> }
                                </select>
                            </div>
                            <div class="wz-field">
                                <label>Canal de recepcion <span class="req">*</span></label>
                                <div class="wz-ro">&#127970; Presencial &mdash; Canal preseleccionado (no editable)</div>
                            </div>
                        }
                        else if (_wzStep == 2)
                        {
                            <h2 class="wz-h2">Paso 2 &mdash; Remitente (@(_wzDir == RadicadoTipo.Entrada ? "tercero externo" : "dependencia interna"))</h2>
                            <div class="wz-sub">Comunicacion @(_wzDir == RadicadoTipo.Entrada ? "Externa (entrada)" : "Interna"): el remitente es @(_wzDir == RadicadoTipo.Entrada ? "un tercero externo a la entidad." : "una dependencia interna de la entidad.")</div>
                            @if (_wzDir == RadicadoTipo.Entrada)
                            {
                                <div class="wz-field">
                                    <label>Tipo de tercero <span class="req">*</span></label>
                                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                        @foreach (var (val, lbl) in new[] { ("natural", "Persona Natural"), ("juridica", "Persona Juridica"), ("publica", "Entidad Publica"), ("anonimo", "Anonimo") })
                                        {
                                            var dis = val == "anonimo" && !(WzTipoSel?.PermiteAnonimo ?? false);
                                            <button type="button" class="wz-chip @(_wzTerTipo == val ? "on" : "")" disabled="@dis" title="@(dis ? "Este tipo de comunicacion no permite anonimo" : "")" @onclick="@(() => _wzTerTipo = val)">@lbl</button>
                                        }
                                    </div>
                                </div>
                                @if (_wzTerTipo != "anonimo")
                                {
                                    <div class="wz-grid12">
                                        <div class="wz-field">
                                            <label>Tipo de documento <span class="req">*</span></label>
                                            <select class="wz-in" @bind="_wzRemTipoDoc">
                                                @foreach (var td in new[] { "CC", "NIT", "CE", "Pasaporte", "TI", "NUIP", "PEP", "PPT" }) { <option value="@td">@td</option> }
                                            </select>
                                        </div>
                                        <div class="wz-field">
                                            <label>Numero de documento <span class="req">*</span></label>
                                            <input class="wz-in" @bind="_wzRemDoc" @bind:after="WzAutocompletarTercero" maxlength="30" placeholder="Ej: 79.456.231" />
                                            <span class="hint">@(_wzTerceroSugerido ? "✓ Remitente encontrado en radicados previos (autocompletado)." : "Busqueda automatica por documento")</span>
                                        </div>
                                    </div>
                                    <div class="wz-field">
                                        <label>Nombre / Razon social <span class="req">*</span></label>
                                        <input class="wz-in" @bind="_wzRemNombre" maxlength="200" placeholder="Nombre completo o razon social" />
                                        <span class="hint">Autocompleta desde el directorio de terceros (RQ07)</span>
                                    </div>
                                    <div class="wz-grid2">
                                        <div class="wz-field"><label>Correo electronico</label><input type="email" class="wz-in" @bind="_wzRemEmail" maxlength="150" placeholder="correo@@ejemplo.com" /></div>
                                        <div class="wz-field"><label>Telefono</label><input class="wz-in" @bind="_wzRemTel" maxlength="30" placeholder="Numero de contacto" /></div>
                                    </div>
                                    <div class="wz-grid2">
                                        <div class="wz-field">
                                            <label>Departamento (DIVIPOLA)</label>
                                            <select class="wz-in" @bind="_wzDeptoSel" @bind:after="WzOnDeptoChanged">
                                                <option value="">&mdash; Departamento &mdash;</option>
                                                @foreach (var d in _wzDeptos) { <option value="@d.Id">@d.Nombre</option> }
                                            </select>
                                        </div>
                                        <div class="wz-field">
                                            <label>Municipio</label>
                                            <select class="wz-in" @bind="_wzRemMunicipio" disabled="@(string.IsNullOrEmpty(_wzDeptoSel))">
                                                <option value="">@(string.IsNullOrEmpty(_wzDeptoSel) ? "Primero seleccione departamento" : "— Municipio —")</option>
                                                @foreach (var m in _wzMunis) { <option value="@m.Nombre">@m.Nombre</option> }
                                            </select>
                                        </div>
                                    </div>
                                }
                                <label class="wz-check"><input type="checkbox" @bind="_wzGuardarDir" /> Guardar/actualizar en directorio de terceros (RQ07)</label>
                            }
                            else
                            {
                                <div class="wz-info">&#127963; Dependencia y funcionario que envian la comunicacion (RF06-2 &mdash; ambos obligatorios).</div>
                                <div class="wz-field">
                                    <label>Dependencia <span class="req">*</span></label>
                                    <select class="wz-in" @bind="_wzDepOrigenId" @bind:after="WzOnDepOrigenChanged">
                                        <option value="">&mdash; Seleccione la dependencia &mdash;</option>
                                        @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                                    </select>
                                </div>
                                <div class="wz-field">
                                    <label>Funcionario <span class="req">*</span></label>
                                    <select class="wz-in" @bind="_wzFuncOrigenId" disabled="@(string.IsNullOrEmpty(_wzDepOrigenId))">
                                        <option value="">@(string.IsNullOrEmpty(_wzDepOrigenId) ? "Primero seleccione dependencia" : "— Seleccione el funcionario —")</option>
                                        @foreach (var f in _wzFuncsOrigen) { <option value="@f.Id">@f.Nombre</option> }
                                    </select>
                                    <span class="hint">Obligatorio: quien envia la comunicacion (RF06-2)</span>
                                </div>
                            }
                        }
                        else if (_wzStep == 3)
                        {
                            <h2 class="wz-h2">Paso 3 &mdash; Informacion del Documento</h2>
                            <div class="wz-field">
                                <label>Tipo de soporte del documento <span class="req">*</span></label>
                                <div class="wz-cards2">
                                    <button type="button" class="wz-card2 @(_wzSoporte == "Fisico" ? "on" : "")" @onclick="@(() => _wzSoporte = "Fisico")">
                                        <div class="t">&#128196; Fisico</div><div class="d">El documento se recibe en papel</div>
                                    </button>
                                    <button type="button" class="wz-card2 @(_wzSoporte == "Electronico" ? "on" : "")" @onclick="@(() => _wzSoporte = "Electronico")">
                                        <div class="t">&#128187; Electronico</div><div class="d">El ciudadano aporta archivos digitales</div>
                                    </button>
                                </div>
                                <span class="hint">Si es electronico, se habilitara la carga de documentos con visor.</span>
                            </div>
                            @if (_wzSoporte == "Electronico")
                            {
                                <div class="wz-field">
                                    <label>Documentos electronicos</label>
                                    <label class="wz-drop">
                                        <InputFile OnChange="WzOnFiles" multiple />
                                        <span class="ico">&#8681;</span>
                                        <span>Haz clic para subir. PDF, DOCX, XLSX, JPG, PNG, TIFF, XML &mdash; max 50 MB c/u.</span>
                                    </label>
                                    @if (_wzArchivos.Count > 0)
                                    {
                                        <div class="wz-files">
                                            @for (var i = 0; i < _wzArchivos.Count; i++)
                                            {
                                                var idx = i; var f = _wzArchivos[i];
                                                <div class="wz-file">
                                                    <span class="ext">@(string.IsNullOrEmpty(f.Ext) ? "?" : f.Ext.ToUpperInvariant())</span>
                                                    <span class="nom" title="@f.Nombre">@f.Nombre</span>
                                                    <span class="tam">@WzTam(f.Tamano)</span>
                                                    <button type="button" class="x" @onclick="@(() => _wzArchivos.RemoveAt(idx))">&times;</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (_wzFileError is not null) { <span class="hint" style="color:#DC2626;">@_wzFileError</span> }
                                </div>
                                @if (WzPrimerPdf is { } pdf)
                                {
                                    <div class="wz-field">
                                        <label class="wz-check"><input type="checkbox" @bind="_wzEstampar" /> Estampar radicado sobre el PDF (RF02-5)</label>
                                        <span class="hint">@(_wzEstampar ? "Arrastre el sello sobre el documento para elegir donde quedara la estampa." : "El PDF se guardara sin estampa.")</span>
                                        @if (_wzEstampar)
                                        {
                                            <div class="tx-est-stage" id="wzEstStage" data-estx="62" data-esty="6">
                                                <object class="tx-est-frame" data="@WzPdfDataUrl(pdf)" type="application/pdf"></object>
                                                <div class="tx-est-chip" style="left:62%;top:6%;" title="Arrastre para ubicar la estampa">
                                                    <div class="t">TRONOX &middot; RADICADO</div>
                                                    <div class="n">@WzNumeroPlaceholder()</div>
                                                    <div class="f">@_wzFechaCtx</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            <div class="wz-field">
                                <label>Asunto <span class="req">*</span></label>
                                <textarea class="wz-in" rows="3" maxlength="500" @bind="_wzAsunto" @bind:event="oninput" placeholder="Descripcion concisa del asunto del documento (max. 500 caracteres)"></textarea>
                                <div class="wz-cnt">@(_wzAsunto.Length)/500</div>
                            </div>
                            <div class="wz-field">
                                <label>Descripcion</label>
                                <textarea class="wz-in" rows="2" @bind="_wzDescripcion" placeholder="Descripcion detallada (opcional)"></textarea>
                            </div>
                            <div class="wz-grid3">
                                <div class="wz-field">
                                    <label>Fecha del documento</label>
                                    <input type="date" class="wz-in" @bind="_wzFechaDoc" />
                                    <span class="hint">Fecha de elaboracion (no de radicacion)</span>
                                </div>
                                <div class="wz-field">
                                    <label>Numero de folios</label>
                                    @if (_wzSoporte == "Electronico" && _wzArchivos.Count > 0)
                                    {
                                        <input type="text" class="wz-in" value="Automatico" readonly />
                                        <span class="hint">Se calcula con los documentos cargados</span>
                                    }
                                    else
                                    {
                                        <input type="number" min="0" class="wz-in" @bind="_wzFolios" placeholder="0" />
                                    }
                                </div>
                                <div class="wz-field">
                                    <label>Numero de anexos</label>
                                    <select class="wz-in" @bind="_wzAnexos">
                                        @for (var an = 0; an <= 5; an++) { <option value="@an">@an</option> }
                                        <option value="6">+5</option>
                                    </select>
                                </div>
                            </div>
                            <div class="wz-field">
                                <label>Observaciones del operador</label>
                                <textarea class="wz-in" rows="2" @bind="_wzObservaciones" placeholder="Observaciones internas (campo privado)..."></textarea>
                                <span class="hint">Nota interna &mdash; nunca visible al ciudadano</span>
                            </div>
                        }
                        else if (_wzStep == 4 && _wzDir == RadicadoTipo.Interno)
                        {
                            <h2 class="wz-h2">Paso 4 &mdash; Destinatarios (dentro de la entidad)</h2>
                            <div class="wz-sub">Dependencia y/o funcionario destinatario. Agregue varias dependencias para una circular interna.</div>
                            <div class="wz-grid2">
                                <div class="wz-field">
                                    <label>Dependencia destino</label>
                                    <select class="wz-in" @bind="_wzDestDepSel" @bind:after="WzOnDestDepChanged">
                                        <option value="">&mdash; Seleccione la dependencia &mdash;</option>
                                        @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                                    </select>
                                </div>
                                <div class="wz-field">
                                    <label>Funcionario destinatario</label>
                                    <select class="wz-in" @bind="_wzDestFuncSel" disabled="@(string.IsNullOrEmpty(_wzDestDepSel))">
                                        <option value="">@(string.IsNullOrEmpty(_wzDestDepSel) ? "Primero seleccione dependencia" : "— Opcional: el jefe lo asigna despues (RF07) —")</option>
                                        @foreach (var f in _wzDestFuncs) { <option value="@f.Id">@f.Nombre</option> }
                                    </select>
                                </div>
                            </div>
                            <button type="button" class="wz-btn navy" style="font-size:13px;" @onclick="WzAgregarDestino">+ Agregar destinatario</button>
                            @if (_wzDestinos.Count > 0)
                            {
                                <div class="wz-dests">
                                    @for (var i = 0; i < _wzDestinos.Count; i++)
                                    {
                                        var idx = i; var d = _wzDestinos[i];
                                        <div class="wz-dest">
                                            <div>
                                                <div class="dep">@d.DepNombre</div>
                                                <div class="fun">@(string.IsNullOrEmpty(d.FuncNombre) ? "\U0001F464 Sin funcionario - lo asigna el jefe de la dependencia" : "\U0001F464 " + d.FuncNombre)</div>
                                            </div>
                                            <button type="button" class="qx" title="Quitar" @onclick="@(() => _wzDestinos.RemoveAt(idx))">&times;</button>
                                        </div>
                                    }
                                </div>
                            }
                            @if (_wzDestinos.Count > 1)
                            {
                                <div class="wz-circular">&#128226; Circular interna: el sistema genera UN numero de radicado y UNA tarea por cada una de las @_wzDestinos.Count dependencias destinatarias (RF06-2).</div>
                            }
                            <div class="wz-field" style="margin-top:12px;">
                                <label>Instrucciones para el destinatario</label>
                                <textarea class="wz-in" rows="2" @bind="_wzInstrucciones" placeholder="Instrucciones opcionales..."></textarea>
                            </div>
                            <div class="wz-field">
                                <label>Prioridad</label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    @foreach (var p in Enum.GetValues<RadicadoPrioridad>())
                                    {
                                        var ico = p == RadicadoPrioridad.Urgente ? "\U0001F534" : p == RadicadoPrioridad.Alta ? "\U0001F7E0" : "\U0001F535";
                                        <button type="button" class="wz-chip @(_wzPrio == p ? "on" : "")" @onclick="@(() => _wzPrio = p)">@ico @p</button>
                                    }
                                </div>
                            </div>
                            <div class="wz-ok-note">&#10003; <strong>Listo para radicar</strong> &mdash; al hacer clic en "Radicar" se asignara el numero consecutivo. La fecha y hora las impone el servidor.</div>
                        }
                        else if (_wzStep == 4)
                        {
                            <h2 class="wz-h2">Paso 4 &mdash; Destinatario (dependencia interna)</h2>
                            <div class="wz-sub">Comunicacion Externa (entrada): el destinatario es una dependencia interna de la entidad.</div>
                            <div class="wz-info">&#127963; Seleccione la dependencia destino (y opcionalmente el funcionario responsable). Es opcional: puede distribuirlo despues desde la bandeja.</div>
                            <div class="wz-field">
                                <label>Dependencia</label>
                                <select class="wz-in" @bind="_wzDepDestId" @bind:after="WzOnDepDestChanged">
                                    <option value="">Sin distribuir</option>
                                    @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                                </select>
                            </div>
                            <div class="wz-field">
                                <label>Funcionario</label>
                                <select class="wz-in" @bind="_wzFuncDestId" disabled="@(string.IsNullOrEmpty(_wzDepDestId))">
                                    <option value="">@(string.IsNullOrEmpty(_wzDepDestId) ? "Primero seleccione dependencia" : "— Opcional: seleccionar funcionario —")</option>
                                    @foreach (var f in _wzFuncsDest) { <option value="@f.Id">@f.Nombre</option> }
                                </select>
                                <span class="hint">Opcional</span>
                            </div>
                            <div class="wz-field">
                                <label>Prioridad</label>
                                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                    @foreach (var p in Enum.GetValues<RadicadoPrioridad>())
                                    {
                                        var ico = p == RadicadoPrioridad.Urgente ? "\U0001F534" : p == RadicadoPrioridad.Alta ? "\U0001F7E0" : "\U0001F535";
                                        <button type="button" class="wz-chip @(_wzPrio == p ? "on" : "")" @onclick="@(() => _wzPrio = p)">@ico @p</button>
                                    }
                                </div>
                                <span class="hint">Catalogo administrable en Configuracion &rarr; Prioridades (RF01-1)</span>
                            </div>
                            <div class="wz-field">
                                <label>Radicado relacionado</label>
                                <input class="wz-in" @bind="_wzRelacionado" maxlength="60" placeholder="@("Ej: " + WzNumeroPlaceholder().Replace("X", "1"))" />
                                <span class="hint">Si este documento responde o continua un radicado anterior</span>
                            </div>
                            <div class="wz-ok-note">&#10003; <strong>Listo para radicar</strong> &mdash; al hacer clic en "Radicar" se asignara el numero consecutivo. La fecha y hora las impone el servidor.</div>
                        }
                        @if (_wzError is not null) { <div class="wz-err">@_wzError</div> }
                    </div>

                    @* ------- Panel derecho: vista previa en tiempo real + sticker ------- *@
                    <div class="wz-right">
                        <div class="pv-title">Vista previa en tiempo real</div>
                        <div class="pv-card">
                            <div class="pv-head">
                                <div>
                                    <div class="e">@(_wzEsq?.EntidadNombre ?? "SGDEA") &mdash; SGDEA</div>
                                    <div class="n">NIT: @(_wzEsq?.Nit ?? "-") | Sistema de Gestion Documental</div>
                                </div>
                                <div class="pv-tag" style="@(WzTipoSel is { } tg && !string.IsNullOrEmpty(tg.Color) ? $"background:{tg.Color};color:#fff" : "")">@(WzTipoSel?.Nombre ?? "TIPO")</div>
                            </div>
                            <div class="pv-num">
                                <div class="ph" style="@(_wzNumero is not null ? "color:#0ab39c;font-weight:800;letter-spacing:.04em;" : "")">@(_wzNumero ?? "Numero se asignara al radicar")</div>
                                <div class="f">@_wzFechaCtx</div>
                            </div>
                            @foreach (var (k, v) in WzPreviewRows())
                            {
                                <div class="pv-row"><span class="k">@k</span><span class="v">@v</span></div>
                            }
                        </div>

                        <div class="pv-stk">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <span class="t">&#127991; Sticker adhesivo</span>
                            </div>
                            <div class="num">@(_wzNumero ?? WzNumeroPlaceholder())</div>
                            <div class="m">@_wzFechaCtx | @(WzTipoSel?.Nombre ?? "-")</div>
                            <div style="display:flex;justify-content:space-between;font-size:11px;color:#94A3B8;">
                                <span>@WzStickerDestino</span>
                                <span>@WzFoliosPreview folio(s)</span>
                            </div>
                            <div class="qr"></div>
                        </div>
                    </div>
                </div>

                <div class="wz-foot">
                    <div style="display:flex;gap:8px;">
                        @if (!WzEsDigital)
                        {
                            <button type="button" class="wz-btn" @onclick="WzCerrar">&#10005; Cancelar</button>
                        }
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <span class="paso">Paso @_wzStep de @WzPasos.Length</span>
                        @if (WzEsDigital)
                        {
                            <button type="button" class="wz-btn green" @onclick="WzCerrar" disabled="@_wzBusy">&#10003; Finalizar</button>
                        }
                        else
                        {
                            @if (_wzStep > 1) { <button type="button" class="wz-btn" @onclick="WzAtras" disabled="@_wzBusy">&#8592; Anterior</button> }
                            @if (_wzStep < WzRadicarStep)
                            {
                                <button type="button" class="wz-btn navy" @onclick="WzSiguiente" disabled="@_wzBusy">Siguiente &#8594;</button>
                            }
                            else
                            {
                                <button type="button" class="wz-btn green" @onclick="WzRadicarAsync" disabled="@_wzBusy">&#10003; @WzRadicarLabel</button>
                            }
                        }
                    </div>
                </div>
        </div>
    </div>
}


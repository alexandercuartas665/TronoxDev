    private string? WzValidarPaso(int step) => step switch
    {
        // ---- Salida (rad_salida_wizard): 6 pasos de datos. ----
        1 when _wzDir == RadicadoTipo.Salida =>
            _wzSalOrigen == "RESPUESTA" && _wzSalEntradaId is null ? "Seleccione el radicado de entrada que responde." : null,
        2 when _wzDir == RadicadoTipo.Salida => WzTipoSel is null ? "Selecciona el tipo de comunicacion." : null,
        3 when _wzDir == RadicadoTipo.Salida =>
            string.IsNullOrWhiteSpace(_wzRemNombre) ? "El nombre o razon social del destinatario es obligatorio."
                : (string.IsNullOrEmpty(_wzSalCanal) ? "Seleccione el canal de envio."
                    : (_wzSalCanal == "EMAIL" && string.IsNullOrWhiteSpace(_wzRemEmail) ? "El correo del destinatario es obligatorio para envio por Email." : null)),
        4 when _wzDir == RadicadoTipo.Salida => string.IsNullOrWhiteSpace(_wzAsunto) ? "El asunto es obligatorio." : null,
        5 when _wzDir == RadicadoTipo.Salida => _wzArchivos.Count == 0 ? "El documento principal es obligatorio en radicacion de salida." : null,
        // ---- Entrada / Interna. ----
        1 => WzTipoSel is null ? "Selecciona el tipo de comunicacion." : null,
        2 when _wzDir == RadicadoTipo.Entrada && _wzTerTipo != "anonimo" =>
            string.IsNullOrWhiteSpace(_wzRemNombre) || string.IsNullOrWhiteSpace(_wzRemDoc)
                ? "Nombre y numero de documento del remitente son obligatorios." : null,
        2 when _wzDir == RadicadoTipo.Interno =>
            string.IsNullOrWhiteSpace(_wzDepOrigenId) ? "La dependencia de origen es obligatoria."
                : (string.IsNullOrWhiteSpace(_wzFuncOrigenId) ? "El funcionario de origen es obligatorio (RF06-2)." : null),
        3 => string.IsNullOrWhiteSpace(_wzAsunto) ? "El asunto es obligatorio." : null,
        _ => null
    };

    private void WzSiguiente()
    {
        _wzError = WzValidarPaso(_wzStep);
        if (_wzError is null && _wzStep < WzRadicarStep) { _wzStep++; }
    }

    private void WzAtras() { _wzError = null; if (_wzStep > 1 && _wzNumero is null) { _wzStep--; } }

    private async Task WzRadicarAsync()
    {
        // Revalidar todos los pasos de datos por si se salto con navegacion.
        for (var s = 1; s <= WzRadicarStep; s++)
        {
            var err = WzValidarPaso(s);
            if (err is not null) { _wzError = err; _wzStep = s; return; }
        }
        // Interna: auto-agrega el destino pendiente del formulario (fiel al legacy) y exige al menos uno.
        if (_wzDir == RadicadoTipo.Interno)
        {
            if (!string.IsNullOrEmpty(_wzDestDepSel) && !_wzDestinos.Any(x => x.DepId.ToString() == _wzDestDepSel))
            {
                WzAgregarDestino();
            }
            if (_wzDestinos.Count == 0) { _wzError = "Agregue al menos una dependencia destinataria."; _wzStep = 4; return; }
        }
        var tipo = WzTipoSel!;
        var anonimo = _wzDir == RadicadoTipo.Entrada && _wzTerTipo == "anonimo";
        var esEntrada = _wzDir == RadicadoTipo.Entrada;
        var esSalida = _wzDir == RadicadoTipo.Salida;
        // En salida el "remitente" persiste el DESTINATARIO (mismas columnas, fiel al legacy AccRadicar).
        var conTercero = (esEntrada && !anonimo) || esSalida;
        var usaArchivos = _wzSoporte == "Electronico" && _wzArchivos.Count > 0;
        _wzBusy = true; _wzError = null;
        try
        {
            var req = new RadicarNuevoRequest(
                Tipo: _wzDir,
                TipoComunicacionId: tipo.Id,
                Asunto: _wzAsunto.Trim(),
                Descripcion: string.IsNullOrWhiteSpace(_wzDescripcion) ? null : _wzDescripcion.Trim(),
                Canal: _wzCanal,
                Anonimo: anonimo,
                RemitenteNombre: conTercero && !string.IsNullOrWhiteSpace(_wzRemNombre) ? _wzRemNombre.Trim() : null,
                RemitenteEmail: conTercero && !string.IsNullOrWhiteSpace(_wzRemEmail) ? _wzRemEmail.Trim() : null,
                RemitenteTipoDoc: conTercero ? _wzRemTipoDoc : null,
                RemitenteDocumento: conTercero && !string.IsNullOrWhiteSpace(_wzRemDoc) ? _wzRemDoc.Trim() : null,
                RemitenteTelefono: conTercero && !string.IsNullOrWhiteSpace(_wzRemTel) ? _wzRemTel.Trim() : null,
                NivelReservaId: long.TryParse(_wzNivelId, out var nvId) ? nvId : null,
                RadicadoRelacionadoId: esSalida ? _wzSalEntradaId : null,
                Soporte: _wzSoporte,
                Prioridad: _wzPrio,
                Adjuntos: null,
                // En electronico con archivos los folios los calcula el servicio (suma de paginas).
                Folios: usaArchivos ? null : _wzFolios,
                NumAnexos: _wzAnexos,
                DependenciaOrigenId: _wzDir == RadicadoTipo.Interno && long.TryParse(_wzDepOrigenId, out var doId) ? doId : null,
                FuncionarioOrigenId: _wzDir == RadicadoTipo.Interno && long.TryParse(_wzFuncOrigenId, out var foId) ? foId : null,
                FechaDocumento: _wzFechaDoc,
                Observaciones: string.IsNullOrWhiteSpace(_wzObservaciones) ? null : _wzObservaciones.Trim(),
                RemitenteMunicipio: esEntrada && !anonimo && !string.IsNullOrWhiteSpace(_wzRemMunicipio) ? _wzRemMunicipio : null,
                CanalEnvio: esSalida && !string.IsNullOrEmpty(_wzSalCanal) ? _wzSalCanal : null,
                EsRespuestaDefinitiva: esSalida && _wzSalDefinitiva && _wzSalEntradaId is not null);

            RadicarResult res;
            if (usaArchivos)
            {
                // Estampa (RF02-5): si hay un PDF y el operador dejo activo "Estampar", lee la posicion del
                // arrastre y la pasa al servicio para sellar con el numero real.
                var estampar = _wzEstampar && WzPrimerPdf is not null;
                double estX = 62, estY = 6;
                if (estampar)
                {
                    try
                    {
                        var pos = await JS.InvokeAsync<WzEstPos>("tronoxMenuConfig.estampaPos", "wzEstStage");
                        estX = pos.x; estY = pos.y;
                    }
                    catch { /* sin JS: usa la posicion por defecto arriba a la derecha */ }
                }
                res = await RadSvc.RadicarConArchivosAsync(req,
                    _wzArchivos.Select(a => new AdjuntoBytes(a.Nombre, a.Bytes)).ToList(),
                    estampar, estX, estY);
            }
            else
            {
                res = await RadSvc.RadicarAsync(req);
            }
            if (!res.Ok) { _wzError = res.Error ?? "No se pudo radicar."; return; }

            // Radicar + distribuir en un paso (calca el legacy).
            if (res.RadicadoId is long rid)
            {
                if (_wzDir == RadicadoTipo.Interno && _wzDestinos.Count > 0)
                {
                    // Circular interna: UN radicado, N tareas (una por dependencia destinataria).
                    var creq = new DistribuirCircularRequest(rid,
                        _wzDestinos.Select(x => new DestinoCircular(x.DepId, x.FuncId)).ToList(),
                        _wzPrio, string.IsNullOrWhiteSpace(_wzInstrucciones) ? null : _wzInstrucciones.Trim());
                    await DistSvc.DistribuirCircularAsync(creq);
                }
                else if (long.TryParse(_wzDepDestId, out var depDest))
                {
                    var dreq = new DistribuirRequest(rid, depDest,
                        long.TryParse(_wzFuncDestId, out var fd) ? fd : null,
                        "", _wzPrio, "");
                    await DistSvc.DistribuirAsync(dreq);
                }
            }

            _wzNumero = res.Numero;
            _wzDigRadicadoId = res.RadicadoId;
            _wzStep = WzDigitalStep; // avanza al paso final de Digitalizacion (adjuntar el soporte fisico).
            Flash($"Radicado {res.Numero} creado.", true);
            await LoadAsync();
        }
        finally { _wzBusy = false; }
    }

    private async Task ExportCsvAsync()
    {
        var f = BuildFiltro() with { Top = 0 };
        var res = await BandejaSvc.ListarAsync(f);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Radicado;Doc;Fecha;Tipo;Canal;Remitente;Asunto;Dependencia;Funcionario;Estado;SLA");
        foreach (var r in res.Items)
        {
            string q(string? s) => "\"" + (s ?? "").Replace("\"", "\"\"") + "\"";
            sb.AppendLine(string.Join(";", q(r.Numero), q(DocLetra(r.Tipo)), q(r.Fecha), q(r.TipoNombre), q(r.Canal),
                q(r.Remitente), q(r.Asunto), q(r.DependenciaNombre), q(r.FuncionarioNombre), q(r.Estado),
                q(r.Dias?.ToString())));
        }
        await JS.InvokeVoidAsync("tronoxMenuConfig.downloadText", "radicados.csv", sb.ToString(), "text/csv");
    }

    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }
    private static string DocLetra(RadicadoTipo t) => t switch { RadicadoTipo.Entrada => "E", RadicadoTipo.Salida => "S", _ => "I" };
    private static string EstadoLabel(string e) => e == "EnTramite" ? "En tramite" : e;
    private static bool EsCerrado(string e) => e is "Respondido" or "Archivado" or "Anulado" or "Borrador";

    private RenderFragment SlaPill(int? dias) => __builder =>
    {
        if (dias is null) { <span>-</span> return; }
        var d = dias.Value;
        var (bg, fg, txt) = d < 0 ? ("#FEE2E2", "#991B1B", $"{Math.Abs(d)}d vencido")
            : d <= 3 ? ("#FEF3C7", "#92400E", $"{d}d restantes")
            : ("#D1FAE5", "#065F46", $"{d}d restantes");
        <span class="rb-pill" style="background:@bg;color:@fg">@txt</span>
    };

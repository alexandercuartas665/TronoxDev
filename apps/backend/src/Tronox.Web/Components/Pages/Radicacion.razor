@page "/modulo/radicacion"
@attribute [Authorize(Policy = "Perm:modulo/radicacion:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Radicacion
@using Tronox.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@inject IRadicacionBandejaService BandejaSvc
@inject IRadicacionDistribucionService DistSvc
@inject IRadicadorService RadSvc
@inject IJSRuntime JS

@* RQ09 - RF11 (Bandeja de radicados, port de rad_bandeja). Lista unificada E/S/I con 6 tabs,
   filtros, contadores, export y acciones por fila. Ver -> drawer de detalle (RadDetalle); Distribuir
   -> modal (funcional). Responder / Registrar envio / + Nuevo Radicado quedan como marcadores hasta
   portar rad_radicar / rad_salida. Visibilidad fail-closed en el servicio. *@

<PageTitle>Radicacion - TRONOX SGDEA</PageTitle>

<nav class="tronox-breadcrumb" aria-label="Ruta de navegacion">
    <a href="/inicio">Workspace</a><span class="sep">/</span>
    <span>Gestion y Tramite</span><span class="sep">/</span>
    <span>Ventanilla Unica / Radicacion</span><span class="sep">/</span>
    <span class="cur">Radicacion</span>
</nav>

<div class="rb-head">
    <div>
        <h1 class="page-title" style="margin:0;">Radicacion</h1>
        <p class="page-sub" style="margin:4px 0 0;">Bandeja de radicados de la entidad.</p>
    </div>
    <div class="rb-head-acts">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsvAsync" disabled="@_busy">Exportar CSV</button>
        <button class="btn btn-primary btn-sm" @onclick="NuevoRadicado">+ Nuevo Radicado</button>
    </div>
</div>

@if (_flash is not null)
{
    <div class="mc-flash @(_flashOk ? "ok" : "err")">@_flash</div>
}

<div class="rb-tabs">
    @foreach (var (key, label, count) in Tabs)
    {
        <button class="rb-tab @(_filtro.Tab == key ? "on" : "")" @onclick="@(() => SetTabAsync(key))" disabled="@_busy">
            @label <span class="rb-badge">@count</span>
        </button>
    }
    <button class="rb-filtro-toggle" @onclick="@(() => _showFilters = !_showFilters)">
        @(_showFilters ? "Ocultar filtros" : "Filtros")
    </button>
</div>

@if (_showFilters)
{
    <div class="rb-filtros">
        <input class="form-control form-control-sm" placeholder="Buscar numero / remitente / asunto..." @bind="_buscar" @bind:event="oninput" style="min-width:220px;" />
        <input type="date" class="form-control form-control-sm" @bind="_desde" title="Desde" />
        <input type="date" class="form-control form-control-sm" @bind="_hasta" title="Hasta" />
        <select class="form-control form-control-sm" @bind="_dir">
            <option value="">Direccion</option>
            <option value="Entrada">Entrada</option><option value="Salida">Salida</option><option value="Interno">Interno</option>
        </select>
        <select class="form-control form-control-sm" @bind="_tipoId">
            <option value="">Tipo</option>
            @foreach (var t in _tipos) { <option value="@t.Id">@t.Nombre</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_estado">
            <option value="">Estado</option>
            @foreach (var e in Enum.GetValues<RadicadoEstado>()) { <option value="@e">@e</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_canal">
            <option value="">Canal</option>
            @foreach (var c in Enum.GetValues<RadicadoCanal>()) { <option value="@c">@c</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_depId">
            <option value="">Dependencia</option>
            @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
        </select>
        <select class="form-control form-control-sm" @bind="_sla">
            <option value="">SLA</option>
            <option value="VIGENTE">Vigente</option><option value="PROXIMO">Proximo</option><option value="VENCIDO">Vencido</option>
        </select>
        <select class="form-control form-control-sm" @bind="_top">
            <option value="25">25</option><option value="50">50</option><option value="100">100</option>
        </select>
        <button class="btn btn-primary btn-sm" @onclick="AplicarAsync" disabled="@_busy">Aplicar</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarAsync" disabled="@_busy">Limpiar</button>
    </div>
}

<div class="rb-card">
    @if (_loading)
    {
        <p style="padding:20px;"><em>Cargando bandeja...</em></p>
    }
    else if (_items.Count == 0)
    {
        <div class="rb-empty">No hay radicados que coincidan con el filtro.</div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="rb-tabla">
                <thead>
                    <tr>
                        <th>Radicado</th><th>Doc</th><th>Fecha</th><th>Tipo</th><th>Canal</th>
                        <th>Remitente</th><th>Asunto</th><th>Dependencia</th><th>Estado</th><th>SLA</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _items)
                    {
                        <tr>
                            <td>
                                <button class="rb-num" @onclick="@(() => OpenDetalle(r.Reg))">@r.Numero</button>
                                @if (r.EsPqrsd) { <span class="rb-star" title="PQRSD">*</span> }
                                @if (!string.IsNullOrEmpty(r.RespondeA)) { <div class="rb-sub">responde a @r.RespondeA</div> }
                                @if (r.NumSalidas > 0) { <div class="rb-sub">@r.NumSalidas respuesta(s)</div> }
                            </td>
                            <td><span class="rb-doc rb-doc-@r.Tipo">@DocLetra(r.Tipo)</span></td>
                            <td>@r.Fecha</td>
                            <td><span class="rb-dot" style="background:@(r.TipoColor ?? "#405189")"></span>@(r.TipoNombre ?? "-")</td>
                            <td>@r.Canal</td>
                            <td>@r.Remitente</td>
                            <td class="rb-asunto" title="@r.Asunto">@(r.Asunto ?? "-")</td>
                            <td>
                                @r.DependenciaNombre
                                @if (!string.IsNullOrEmpty(r.FuncionarioNombre)) { <div class="rb-sub">@r.FuncionarioNombre</div> }
                            </td>
                            <td>@EstadoLabel(r.Estado)</td>
                            <td>@SlaPill(r.Dias)</td>
                            <td class="rb-acts">
                                <button class="rb-act" title="Ver" @onclick="@(() => OpenDetalle(r.Reg))">Ver</button>
                                @if (r.Tipo != RadicadoTipo.Salida && !EsCerrado(r.Estado))
                                {
                                    <button class="rb-act" title="Distribuir" @onclick="@(() => OpenDistribuirAsync(r))">Distribuir</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rb-foot">Mostrando @_items.Count de @_total radicados (TOP @_top).</div>
    }
</div>

@* ============ Modal Distribuir ============ *@
@if (_distItem is not null)
{
    <div class="modal-overlay" @onclick="@(() => _distItem = null)">
        <div class="modal-dialog" style="max-width:520px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Distribuir @_distItem.Numero</h3>
                <button class="modal-close" @onclick="@(() => _distItem = null)">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Dependencia destino *</label>
                    <select class="form-control" @bind="_distDepId" @bind:after="OnDistDepChangedAsync">
                        <option value="">Selecciona...</option>
                        @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Funcionario (opcional)</label>
                    <select class="form-control" @bind="_distFuncId">
                        <option value="">Pendiente de asignar (jefe)</option>
                        @foreach (var fu in _distFuncs) { <option value="@fu.Id">@fu.Nombre</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Prioridad</label>
                    <select class="form-control" @bind="_distPrio">
                        @foreach (var p in Enum.GetValues<RadicadoPrioridad>()) { <option value="@p">@p</option> }
                    </select>
                </div>
                <div class="field">
                    <label class="form-label">Instrucciones</label>
                    <textarea class="form-control" rows="2" @bind="_distInstr" maxlength="1000"></textarea>
                </div>
                @if (_distEsReasignacion)
                {
                    <div class="field">
                        <label class="form-label">Justificacion de reasignacion *</label>
                        <textarea class="form-control" rows="2" @bind="_distJustif" maxlength="1000"></textarea>
                        <small class="text-muted">Este radicado ya tiene una tarea activa; reasignar exige justificacion (RF07-2).</small>
                    </div>
                }
                @if (_distError is not null) { <div class="tk-field-error">@_distError</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="@(() => _distItem = null)">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmDistribuirAsync" disabled="@_busy">Distribuir</button>
            </div>
        </div>
    </div>
}

@* ============ Asistente Nuevo Radicado (rad_radicar, Fase 1: Entrada + Interna) ============ *@
@if (_wzOpen)
{
    <div class="modal-overlay" @onclick="WzCerrar">
        <div class="modal-dialog" style="max-width:640px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Nuevo Radicado</h3>
                <button class="modal-close" @onclick="WzCerrar">&times;</button>
            </div>

            @if (_wzNumero is not null)
            {
                <div class="modal-body">
                    <div class="rad-ok">
                        <div class="rad-ok-ico">&#10003;</div>
                        <div class="rad-ok-num">@_wzNumero</div>
                        <p>Radicado creado correctamente@(string.IsNullOrEmpty(_wzDepDestId) ? " (sin distribuir; puedes distribuirlo desde la bandeja)." : " y distribuido.")</p>
                    </div>
                </div>
                <div class="modal-foot">
                    <button class="btn btn-primary" @onclick="WzCerrar">Cerrar</button>
                </div>
            }
            else
            {
                <div class="rad-steps">
                    @foreach (var (n, lbl) in WzPasos)
                    {
                        <div class="rad-step @(_wzStep == n ? "on" : "") @(_wzStep > n ? "done" : "")">
                            <span class="rad-step-n">@n</span><span class="rad-step-l">@lbl</span>
                        </div>
                    }
                </div>

                <div class="modal-body">
                    @if (_wzStep == 1)
                    {
                        <div class="field">
                            <label class="form-label">Comunicacion *</label>
                            <div class="rad-chips">
                                <button type="button" class="rad-chip @(_wzDir == RadicadoTipo.Entrada ? "on" : "")" @onclick="@(() => WzSetDir(RadicadoTipo.Entrada))">Externa (entrada)</button>
                                <button type="button" class="rad-chip @(_wzDir == RadicadoTipo.Interno ? "on" : "")" @onclick="@(() => WzSetDir(RadicadoTipo.Interno))">Interna</button>
                            </div>
                        </div>
                        <div class="field">
                            <label class="form-label">Tipo de comunicacion *</label>
                            <select class="form-control" @bind="_wzTipoId" @bind:after="WzOnTipoChanged">
                                <option value="">Selecciona...</option>
                                @foreach (var t in WzTiposFiltrados) { <option value="@t.Id">@t.Nombre</option> }
                            </select>
                            @if (WzTipoSel is { } ts)
                            {
                                <div class="rad-badges">
                                    @if (ts.EsPqrsd) { <span class="rad-badge pqrsd">PQRSD</span> }
                                    @if (ts.EsTutela) { <span class="rad-badge tutela">TUTELA - Control estricto</span> }
                                </div>
                            }
                        </div>
                        <div class="rad-2col">
                            <div class="field">
                                <label class="form-label">Nivel de clasificacion</label>
                                <select class="form-control" @bind="_wzNivelId">
                                    <option value="">(por defecto del tipo)</option>
                                    @foreach (var n in _wzNiveles) { <option value="@n.Id">@n.Nombre</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label class="form-label">Canal de recepcion</label>
                                <select class="form-control" @bind="_wzCanal">
                                    @foreach (var c in Enum.GetValues<RadicadoCanal>()) { <option value="@c">@c</option> }
                                </select>
                            </div>
                        </div>
                    }
                    else if (_wzStep == 2)
                    {
                        @if (_wzDir == RadicadoTipo.Entrada)
                        {
                            <div class="field">
                                <label class="form-label">Tipo de tercero *</label>
                                <div class="rad-chips">
                                    @foreach (var tt in new[] { "Natural", "Juridica", "Publica", "Anonimo" })
                                    {
                                        var dis = tt == "Anonimo" && !(WzTipoSel?.PermiteAnonimo ?? false);
                                        <button type="button" class="rad-chip @(_wzTerTipo == tt ? "on" : "")" disabled="@dis" @onclick="@(() => _wzTerTipo = tt)">@tt</button>
                                    }
                                </div>
                                @if (WzTipoSel is { PermiteAnonimo: false }) { <small class="text-muted">Este tipo de comunicacion no permite radicacion anonima.</small> }
                            </div>
                            @if (_wzTerTipo != "Anonimo")
                            {
                                <div class="rad-2col">
                                    <div class="field">
                                        <label class="form-label">Tipo de documento</label>
                                        <select class="form-control" @bind="_wzRemTipoDoc">
                                            @foreach (var td in new[] { "CC", "NIT", "CE", "Pasaporte", "TI", "NUIP", "PEP", "PPT" }) { <option value="@td">@td</option> }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label class="form-label">Numero de documento *</label>
                                        <input class="form-control" @bind="_wzRemDoc" maxlength="30" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label class="form-label">Nombre / Razon social *</label>
                                    <input class="form-control" @bind="_wzRemNombre" maxlength="200" />
                                </div>
                                <div class="rad-2col">
                                    <div class="field"><label class="form-label">Correo electronico</label><input type="email" class="form-control" @bind="_wzRemEmail" maxlength="150" /></div>
                                    <div class="field"><label class="form-label">Telefono</label><input class="form-control" @bind="_wzRemTel" maxlength="30" /></div>
                                </div>
                            }
                            else { <p class="text-muted">Radicacion anonima: no se capturan datos del remitente.</p> }
                        }
                        else
                        {
                            <div class="field">
                                <label class="form-label">Dependencia de origen *</label>
                                <select class="form-control" @bind="_wzDepOrigenId" @bind:after="WzOnDepOrigenChanged">
                                    <option value="">Selecciona...</option>
                                    @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                                </select>
                            </div>
                            <div class="field">
                                <label class="form-label">Funcionario de origen</label>
                                <select class="form-control" @bind="_wzFuncOrigenId">
                                    <option value="">(sin especificar)</option>
                                    @foreach (var f in _wzFuncsOrigen) { <option value="@f.Id">@f.Nombre</option> }
                                </select>
                            </div>
                        }
                    }
                    else if (_wzStep == 3)
                    {
                        <div class="field">
                            <label class="form-label">Tipo de soporte *</label>
                            <div class="rad-chips">
                                <button type="button" class="rad-chip @(_wzSoporte == "Fisico" ? "on" : "")" @onclick="@(() => _wzSoporte = "Fisico")">Fisico</button>
                                <button type="button" class="rad-chip @(_wzSoporte == "Electronico" ? "on" : "")" @onclick="@(() => _wzSoporte = "Electronico")">Electronico</button>
                            </div>
                        </div>
                        @if (_wzSoporte == "Electronico")
                        {
                            <div class="field">
                                <label class="form-label">Documentos electronicos</label>
                                <label class="rad-drop">
                                    <InputFile OnChange="WzOnFiles" multiple />
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    <span>Haz clic para subir. PDF, DOCX, XLSX, JPG, PNG, TIFF, XML - max 50 MB c/u.</span>
                                </label>
                                @if (_wzArchivos.Count > 0)
                                {
                                    <div class="rad-files">
                                        @for (var i = 0; i < _wzArchivos.Count; i++)
                                        {
                                            var idx = i; var f = _wzArchivos[i];
                                            <div class="rad-file">
                                                <span class="rad-file-ext">@(string.IsNullOrEmpty(f.Ext) ? "?" : f.Ext.ToUpperInvariant())</span>
                                                <span class="rad-file-nom" title="@f.Nombre">@f.Nombre</span>
                                                <span class="rad-file-tam">@WzTam(f.Tamano)</span>
                                                <button type="button" class="rad-file-x" @onclick="@(() => _wzArchivos.RemoveAt(idx))">&times;</button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (_wzFileError is not null) { <small class="text-danger">@_wzFileError</small> }
                            </div>
                        }
                        <div class="field">
                            <label class="form-label">Asunto *</label>
                            <textarea class="form-control" rows="2" maxlength="500" @bind="_wzAsunto"></textarea>
                        </div>
                        <div class="field">
                            <label class="form-label">Descripcion</label>
                            <textarea class="form-control" rows="2" @bind="_wzDescripcion"></textarea>
                        </div>
                        <div class="rad-2col">
                            <div class="field">
                                <label class="form-label">Numero de folios</label>
                                @if (_wzSoporte == "Electronico" && _wzArchivos.Count > 0)
                                {
                                    <input type="text" class="form-control" value="Automatico" readonly />
                                    <small class="text-muted">Se calcula de los documentos (PDF: paginas).</small>
                                }
                                else
                                {
                                    <input type="number" min="0" class="form-control" @bind="_wzFolios" />
                                }
                            </div>
                            <div class="field"><label class="form-label">Numero de anexos</label><input type="number" min="0" class="form-control" @bind="_wzAnexos" /></div>
                        </div>
                    }
                    else if (_wzStep == 4)
                    {
                        <p class="text-muted" style="margin-top:0;">Asigna la dependencia que tramitara el radicado. Es opcional: puedes distribuirlo despues desde la bandeja.</p>
                        <div class="field">
                            <label class="form-label">Dependencia destino</label>
                            <select class="form-control" @bind="_wzDepDestId" @bind:after="WzOnDepDestChanged">
                                <option value="">Sin distribuir</option>
                                @foreach (var d in _deps) { <option value="@d.Id">@d.Nombre</option> }
                            </select>
                        </div>
                        <div class="field">
                            <label class="form-label">Funcionario (opcional)</label>
                            <select class="form-control" @bind="_wzFuncDestId">
                                <option value="">Pendiente de asignar (jefe)</option>
                                @foreach (var f in _wzFuncsDest) { <option value="@f.Id">@f.Nombre</option> }
                            </select>
                        </div>
                        <div class="field">
                            <label class="form-label">Prioridad</label>
                            <select class="form-control" @bind="_wzPrio">
                                @foreach (var p in Enum.GetValues<RadicadoPrioridad>()) { <option value="@p">@p</option> }
                            </select>
                        </div>
                    }
                    @if (_wzError is not null) { <div class="tk-field-error">@_wzError</div> }
                </div>

                <div class="modal-foot">
                    <button class="btn btn-outline-secondary" @onclick="WzAtras" disabled="@(_wzStep == 1 || _wzBusy)">Atras</button>
                    @if (_wzStep < 4)
                    {
                        <button class="btn btn-primary" @onclick="WzSiguiente" disabled="@_wzBusy">Siguiente</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="WzRadicarAsync" disabled="@_wzBusy">Radicar</button>
                    }
                </div>
            }
        </div>
    </div>
}

@* ============ Drawer Detalle ============ *@
@if (_detalleReg is long reg)
{
    <div class="modal-overlay rb-detalle-overlay" @onclick="@(() => _detalleReg = null)">
        <div class="rb-detalle-panel" @onclick:stopPropagation="true">
            <RadDetalle Reg="reg" OnClose="@(() => _detalleReg = null)"
                        OnResponder="Responder"
                        OnDistribuir="OpenDistribuirDesdeDetalleAsync" />
        </div>
    </div>
}

<style>
    .rb-head { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; flex-wrap:wrap; margin-bottom:14px; }
    .rb-head-acts { display:flex; gap:8px; }
    .rb-tabs { display:flex; gap:6px; align-items:center; flex-wrap:wrap; margin-bottom:12px; }
    .rb-tab { border:1px solid var(--tx-border,#e2e8f0); background:var(--tx-surface,#fff); color:var(--ink-2,#334155); border-radius:8px; padding:6px 12px; font-size:.82rem; cursor:pointer; display:flex; align-items:center; gap:6px; }
    .rb-tab.on { background:#405189; border-color:#405189; color:#fff; }
    .rb-badge { background:rgba(0,0,0,.08); border-radius:10px; padding:0 7px; font-size:.72rem; font-weight:600; }
    .rb-tab.on .rb-badge { background:rgba(255,255,255,.25); }
    .rb-filtro-toggle { margin-left:auto; border:none; background:none; color:#405189; font-size:.82rem; cursor:pointer; }
    .rb-filtros { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; padding:12px; background:var(--tx-muted,#f8fafc); border:1px solid var(--tx-border,#e2e8f0); border-radius:10px; }
    .rb-card { background:var(--tx-surface,#fff); border:1px solid var(--tx-border,#e2e8f0); border-radius:12px; }
    .rb-empty { padding:40px; text-align:center; color:var(--ink-3,#94a3b8); }
    .rb-tabla { width:100%; border-collapse:collapse; font-size:.82rem; }
    .rb-tabla th { text-align:left; color:var(--ink-3,#64748b); font-weight:600; padding:10px 10px; border-bottom:1px solid var(--tx-border,#e2e8f0); white-space:nowrap; }
    .rb-tabla td { padding:9px 10px; border-bottom:1px solid var(--tx-muted,#f1f5f9); color:var(--ink-2,#334155); vertical-align:top; }
    .rb-num { background:none; border:none; color:#405189; font-weight:600; cursor:pointer; padding:0; font-size:.82rem; }
    .rb-star { color:#D97706; font-weight:700; margin-left:4px; }
    .rb-sub { font-size:.72rem; color:var(--ink-3,#94a3b8); }
    .rb-doc { display:inline-block; width:20px; height:20px; line-height:20px; text-align:center; border-radius:5px; font-weight:700; font-size:.72rem; color:#fff; }
    .rb-doc-Entrada { background:#0891B2; } .rb-doc-Salida { background:#7C3AED; } .rb-doc-Interno { background:#0ab39c; }
    .rb-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
    .rb-asunto { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .rb-pill { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.72rem; font-weight:600; }
    .rb-acts { white-space:nowrap; }
    .rb-act { border:1px solid var(--tx-border,#e2e8f0); background:var(--tx-surface,#fff); color:#405189; border-radius:6px; padding:3px 8px; font-size:.74rem; cursor:pointer; margin-left:4px; }
    .rb-foot { padding:10px 12px; font-size:.76rem; color:var(--ink-3,#94a3b8); }
    .rb-detalle-overlay { justify-content:flex-end; }
    .rb-detalle-panel { background:var(--tx-surface,#fff); width:min(920px,96vw); height:100%; box-shadow:-8px 0 24px rgba(2,6,23,.18); overflow:auto; }

    /* Asistente Nuevo Radicado */
    .rad-steps { display:flex; gap:4px; padding:12px 16px 0; flex-wrap:wrap; }
    .rad-step { display:flex; align-items:center; gap:6px; font-size:.76rem; color:var(--ink-3,#94a3b8); padding:4px 8px; border-radius:8px; }
    .rad-step.on { color:#405189; font-weight:600; background:rgba(64,81,137,.08); }
    .rad-step.done { color:#0ab39c; }
    .rad-step-n { display:inline-flex; width:20px; height:20px; align-items:center; justify-content:center; border-radius:50%; background:var(--tx-muted,#f1f5f9); font-weight:700; font-size:.72rem; }
    .rad-step.on .rad-step-n { background:#405189; color:#fff; }
    .rad-step.done .rad-step-n { background:#0ab39c; color:#fff; }
    .rad-chips { display:flex; gap:8px; flex-wrap:wrap; }
    .rad-chip { border:1px solid var(--tx-border,#e2e8f0); background:var(--tx-surface,#fff); color:var(--ink-2,#334155); border-radius:8px; padding:7px 14px; font-size:.82rem; cursor:pointer; }
    .rad-chip.on { background:#405189; border-color:#405189; color:#fff; }
    .rad-chip:disabled { opacity:.45; cursor:not-allowed; }
    .rad-badges { display:flex; gap:6px; margin-top:6px; flex-wrap:wrap; }
    .rad-badge { display:inline-block; padding:2px 8px; border-radius:6px; font-size:.72rem; font-weight:600; }
    .rad-badge.pqrsd { background:#DBEAFE; color:#1E40AF; }
    .rad-badge.tutela { background:#FEE2E2; color:#991B1B; }
    .rad-2col { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    @@media (max-width:520px){ .rad-2col { grid-template-columns:1fr; } }
    .rad-ok { text-align:center; padding:16px 8px; }
    .rad-ok-ico { width:56px; height:56px; margin:0 auto 10px; border-radius:50%; background:#D1FAE5; color:#065F46; font-size:1.8rem; display:flex; align-items:center; justify-content:center; }
    .rad-ok-num { font-size:1.3rem; font-weight:700; color:#405189; letter-spacing:.5px; }
    .rad-drop { display:flex; flex-direction:column; align-items:center; gap:4px; border:2px dashed var(--tx-border,#cbd5e1); border-radius:10px; padding:16px 12px; text-align:center; cursor:pointer; background:var(--tx-muted,#f8fafc); font-size:.8rem; color:var(--ink-2,#475569); }
    .rad-drop:hover { border-color:#405189; }
    .rad-drop i { font-size:1.4rem; color:#405189; }
    .rad-drop input[type=file] { display:none; }
    .rad-files { margin-top:8px; display:flex; flex-direction:column; gap:6px; }
    .rad-file { display:flex; align-items:center; gap:8px; border:1px solid var(--tx-border,#e2e8f0); border-radius:8px; padding:6px 10px; background:var(--tx-surface,#fff); }
    .rad-file-ext { font-size:.66rem; font-weight:700; background:#EFF6FF; color:#2563EB; border-radius:5px; padding:2px 6px; min-width:38px; text-align:center; }
    .rad-file-nom { flex:1; min-width:0; font-size:.8rem; color:var(--ink-1,#0f172a); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .rad-file-tam { font-size:.72rem; color:var(--ink-3,#94a3b8); }
    .rad-file-x { border:none; background:none; color:#94a3b8; cursor:pointer; font-size:1.1rem; line-height:1; }
    .rad-file-x:hover { color:#DC2626; }
</style>

@code {
    private bool _loading = true, _busy;
    private string? _flash; private bool _flashOk;

    private BandejaFiltro _filtro = new();
    private IReadOnlyList<BandejaItemDto> _items = Array.Empty<BandejaItemDto>();
    private int _total;
    private BandejaContadoresDto _cont = new(0, 0, 0, 0, 0, 0);
    private IReadOnlyList<OpcionDto> _tipos = Array.Empty<OpcionDto>();
    private IReadOnlyList<OpcionDto> _deps = Array.Empty<OpcionDto>();

    // Filtros (form).
    private bool _showFilters;
    private string _buscar = ""; private DateOnly? _desde, _hasta;
    private string _dir = "", _tipoId = "", _estado = "", _canal = "", _depId = "", _sla = "";
    private int _top = 50;

    // Distribuir.
    private BandejaItemDto? _distItem; private string _distDepId = "", _distFuncId = "";
    private RadicadoPrioridad _distPrio = RadicadoPrioridad.Normal; private string _distInstr = "", _distJustif = "";
    private IReadOnlyList<OpcionDto> _distFuncs = Array.Empty<OpcionDto>();
    private bool _distEsReasignacion; private string? _distError;

    // Detalle.
    private long? _detalleReg;

    private (string key, string label, int count)[] Tabs => new[]
    {
        ("todos", "Todos", _cont.Todos), ("pqrsd", "PQRSD", _cont.Pqrsd), ("tutelas", "Tutelas", _cont.Tutelas),
        ("sindist", "Sin distribuir", _cont.SinDistribuir), ("prox", "Proximos", _cont.Prox), ("venc", "Vencidos", _cont.Venc)
    };

    protected override async Task OnInitializedAsync()
    {
        _tipos = await BandejaSvc.TiposAsync();
        _deps = await BandejaSvc.DependenciasAsync();
        await LoadAsync();
    }

    private BandejaFiltro BuildFiltro() => new(
        Tab: _filtro.Tab,
        Buscar: string.IsNullOrWhiteSpace(_buscar) ? null : _buscar,
        Desde: _desde, Hasta: _hasta,
        Direccion: Enum.TryParse<RadicadoTipo>(_dir, out var d) ? d : null,
        TipoComunicacionId: long.TryParse(_tipoId, out var t) ? t : null,
        Estado: Enum.TryParse<RadicadoEstado>(_estado, out var e) ? e : null,
        Canal: Enum.TryParse<RadicadoCanal>(_canal, out var c) ? c : null,
        DependenciaId: long.TryParse(_depId, out var dep) ? dep : null,
        Sla: string.IsNullOrEmpty(_sla) ? null : _sla,
        Funcionario: null,
        Top: _top);

    private async Task LoadAsync()
    {
        _loading = true; _busy = true;
        try
        {
            _filtro = BuildFiltro();
            var res = await BandejaSvc.ListarAsync(_filtro);
            _items = res.Items; _total = res.Total;
            _cont = await BandejaSvc.ContadoresAsync(_filtro);
        }
        finally { _loading = false; _busy = false; }
    }

    private async Task SetTabAsync(string tab) { _filtro = _filtro with { Tab = tab }; await LoadAsync(); }
    private async Task AplicarAsync() => await LoadAsync();
    private async Task LimpiarAsync()
    {
        _buscar = ""; _desde = _hasta = null; _dir = _tipoId = _estado = _canal = _depId = _sla = ""; _top = 50;
        await LoadAsync();
    }

    private void OpenDetalle(long reg) => _detalleReg = reg;

    private async Task OpenDistribuirAsync(BandejaItemDto item)
    {
        _distItem = item; _distDepId = ""; _distFuncId = ""; _distInstr = ""; _distJustif = "";
        _distPrio = RadicadoPrioridad.Normal; _distError = null;
        _distFuncs = await BandejaSvc.FuncionariosAsync(null);
        // Reasignacion si el item ya tiene funcionario/dependencia asignada.
        _distEsReasignacion = !string.IsNullOrEmpty(item.FuncionarioNombre) || item.DependenciaNombre != "Sin asignar";
    }

    private async Task OpenDistribuirDesdeDetalleAsync(long reg)
    {
        var item = _items.FirstOrDefault(i => i.Reg == reg);
        if (item is not null) { _detalleReg = null; await OpenDistribuirAsync(item); }
    }

    private async Task OnDistDepChangedAsync()
        => _distFuncs = await BandejaSvc.FuncionariosAsync(long.TryParse(_distDepId, out var d) ? d : null);

    private async Task ConfirmDistribuirAsync()
    {
        if (_distItem is null) { return; }
        if (!long.TryParse(_distDepId, out var depId)) { _distError = "La dependencia destino es obligatoria."; return; }
        _busy = true; _distError = null;
        try
        {
            var req = new DistribuirRequest(_distItem.Reg, depId,
                long.TryParse(_distFuncId, out var fu) ? fu : null,
                _distInstr, _distPrio, _distJustif);
            var res = await DistSvc.DistribuirAsync(req);
            if (!res.Ok) { _distError = res.Error; return; }
            _distItem = null;
            Flash($"Radicado distribuido ({res.Estado}).", true);
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private void Responder(string numero)
        => Flash($"Responder {numero}: el asistente de salida (rad_radicar) se habilita al portar ese modulo.", true);

    // ===== Asistente Nuevo Radicado (rad_radicar, Fase 1: Entrada + Interna) =====
    private bool _wzOpen, _wzBusy;
    private int _wzStep = 1;
    private string? _wzError, _wzNumero;
    private IReadOnlyList<TipoRadicacionDto> _wzTipos = Array.Empty<TipoRadicacionDto>();
    private IReadOnlyList<OpcionDto> _wzNiveles = Array.Empty<OpcionDto>();
    private IReadOnlyList<OpcionDto> _wzFuncsOrigen = Array.Empty<OpcionDto>();
    private IReadOnlyList<OpcionDto> _wzFuncsDest = Array.Empty<OpcionDto>();
    // Paso 1 - clasificacion.
    private RadicadoTipo _wzDir = RadicadoTipo.Entrada;
    private string _wzTipoId = "", _wzNivelId = "";
    private RadicadoCanal _wzCanal = RadicadoCanal.Presencial;
    // Paso 2 - remitente (entrada) / origen (interna).
    private string _wzTerTipo = "Natural", _wzRemTipoDoc = "CC";
    private string _wzRemDoc = "", _wzRemNombre = "", _wzRemEmail = "", _wzRemTel = "";
    private string _wzDepOrigenId = "", _wzFuncOrigenId = "";
    // Paso 3 - documento.
    private string _wzSoporte = "Fisico", _wzAsunto = "", _wzDescripcion = "";
    private int _wzFolios = 1, _wzAnexos;
    // Paso 4 - destino.
    private string _wzDepDestId = "", _wzFuncDestId = "";
    private RadicadoPrioridad _wzPrio = RadicadoPrioridad.Normal;
    // Adjuntos (Fase 2): documentos electronicos subidos al radicar.
    private const long WzMaxBytes = 50L * 1024 * 1024;
    private static readonly string[] WzExts = ["pdf", "docx", "xlsx", "pptx", "jpg", "jpeg", "png", "tif", "tiff", "gif", "bmp", "xml", "txt"];
    private sealed class WzArchivo { public byte[] Bytes = Array.Empty<byte>(); public string Nombre = ""; public long Tamano; public string Ext = ""; }
    private readonly List<WzArchivo> _wzArchivos = new();
    private string? _wzFileError;

    private (int n, string lbl)[] WzPasos => new[]
    {
        (1, "Clasificacion"), (2, _wzDir == RadicadoTipo.Entrada ? "Remitente" : "Origen"), (3, "Documento"), (4, "Destino")
    };

    private RadicacionDireccion WzDireccionSel => _wzDir == RadicadoTipo.Entrada
        ? RadicacionDireccion.Entrada : RadicacionDireccion.Interno;
    private IEnumerable<TipoRadicacionDto> WzTiposFiltrados => _wzTipos.Where(t => t.Direccion == WzDireccionSel);
    private TipoRadicacionDto? WzTipoSel => _wzTipos.FirstOrDefault(t => t.Id.ToString() == _wzTipoId);

    private async Task NuevoRadicado()
    {
        _wzOpen = true; _wzStep = 1; _wzError = null; _wzNumero = null; _wzBusy = false;
        _wzDir = RadicadoTipo.Entrada; _wzTipoId = ""; _wzNivelId = ""; _wzCanal = RadicadoCanal.Presencial;
        _wzTerTipo = "Natural"; _wzRemTipoDoc = "CC"; _wzRemDoc = _wzRemNombre = _wzRemEmail = _wzRemTel = "";
        _wzDepOrigenId = _wzFuncOrigenId = ""; _wzSoporte = "Fisico"; _wzAsunto = _wzDescripcion = "";
        _wzFolios = 1; _wzAnexos = 0; _wzDepDestId = _wzFuncDestId = ""; _wzPrio = RadicadoPrioridad.Normal;
        _wzArchivos.Clear(); _wzFileError = null;
        _wzFuncsOrigen = _wzFuncsDest = Array.Empty<OpcionDto>();
        _wzTipos = await BandejaSvc.TiposAsistenteAsync();
        _wzNiveles = await BandejaSvc.NivelesReservaAsync();
    }

    private void WzCerrar() { _wzOpen = false; }

    private void WzSetDir(RadicadoTipo dir)
    {
        _wzDir = dir; _wzTipoId = ""; _wzNivelId = ""; _wzTerTipo = "Natural"; _wzError = null;
    }

    private void WzOnTipoChanged()
    {
        var t = WzTipoSel;
        if (t is null) { return; }
        // Autollenar el nivel de reserva por defecto del tipo (calca onTipo del legacy).
        if (t.NivelReservaDefaultId is long nv) { _wzNivelId = nv.ToString(); }
        // Si el tipo no permite anonimo y estaba seleccionado, revertir.
        if (!t.PermiteAnonimo && _wzTerTipo == "Anonimo") { _wzTerTipo = "Natural"; }
    }

    private async Task WzOnDepOrigenChanged()
        => _wzFuncsOrigen = await BandejaSvc.FuncionariosAsync(long.TryParse(_wzDepOrigenId, out var d) ? d : null);

    private async Task WzOnDepDestChanged()
    {
        _wzFuncDestId = "";
        _wzFuncsDest = await BandejaSvc.FuncionariosAsync(long.TryParse(_wzDepDestId, out var d) ? d : null);
    }

    private async Task WzOnFiles(InputFileChangeEventArgs e)
    {
        _wzFileError = null;
        foreach (var f in e.GetMultipleFiles(20))
        {
            var ext = System.IO.Path.GetExtension(f.Name).TrimStart('.').ToLowerInvariant();
            if (!WzExts.Contains(ext)) { _wzFileError = $"'{f.Name}': extension no permitida."; continue; }
            if (f.Size <= 0 || f.Size > WzMaxBytes) { _wzFileError = $"'{f.Name}': tamano invalido (max 50 MB)."; continue; }
            byte[] bytes;
            using (var ms = new MemoryStream())
            {
                await f.OpenReadStream(WzMaxBytes).CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            _wzArchivos.Add(new WzArchivo { Bytes = bytes, Nombre = f.Name, Tamano = bytes.LongLength, Ext = ext });
        }
    }

    private static string WzTam(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0.#} KB" : $"{b / 1048576.0:0.#} MB";

    private string? WzValidarPaso(int step) => step switch
    {
        1 => WzTipoSel is null ? "Selecciona el tipo de comunicacion." : null,
        2 when _wzDir == RadicadoTipo.Entrada && _wzTerTipo != "Anonimo" =>
            string.IsNullOrWhiteSpace(_wzRemNombre) || string.IsNullOrWhiteSpace(_wzRemDoc)
                ? "Nombre y numero de documento del remitente son obligatorios." : null,
        2 when _wzDir == RadicadoTipo.Interno =>
            string.IsNullOrWhiteSpace(_wzDepOrigenId) ? "La dependencia de origen es obligatoria." : null,
        3 => string.IsNullOrWhiteSpace(_wzAsunto) ? "El asunto es obligatorio." : null,
        _ => null
    };

    private void WzSiguiente()
    {
        _wzError = WzValidarPaso(_wzStep);
        if (_wzError is null && _wzStep < 4) { _wzStep++; }
    }

    private void WzAtras() { _wzError = null; if (_wzStep > 1) { _wzStep--; } }

    private async Task WzRadicarAsync()
    {
        // Revalidar todos los pasos por si se salto con navegacion.
        for (var s = 1; s <= 3; s++)
        {
            var err = WzValidarPaso(s);
            if (err is not null) { _wzError = err; _wzStep = s; return; }
        }
        var tipo = WzTipoSel!;
        var anonimo = _wzDir == RadicadoTipo.Entrada && _wzTerTipo == "Anonimo";
        var esEntrada = _wzDir == RadicadoTipo.Entrada;
        var usaArchivos = _wzSoporte == "Electronico" && _wzArchivos.Count > 0;
        _wzBusy = true; _wzError = null;
        try
        {
            var req = new RadicarNuevoRequest(
                Tipo: _wzDir,
                TipoComunicacionId: tipo.Id,
                Asunto: _wzAsunto.Trim(),
                Descripcion: string.IsNullOrWhiteSpace(_wzDescripcion) ? null : _wzDescripcion.Trim(),
                Canal: _wzCanal,
                Anonimo: anonimo,
                RemitenteNombre: esEntrada && !anonimo ? _wzRemNombre.Trim() : null,
                RemitenteEmail: esEntrada && !anonimo && !string.IsNullOrWhiteSpace(_wzRemEmail) ? _wzRemEmail.Trim() : null,
                RemitenteTipoDoc: esEntrada && !anonimo ? _wzRemTipoDoc : null,
                RemitenteDocumento: esEntrada && !anonimo ? _wzRemDoc.Trim() : null,
                RemitenteTelefono: esEntrada && !anonimo && !string.IsNullOrWhiteSpace(_wzRemTel) ? _wzRemTel.Trim() : null,
                NivelReservaId: long.TryParse(_wzNivelId, out var nvId) ? nvId : null,
                RadicadoRelacionadoId: null,
                Soporte: _wzSoporte,
                Prioridad: _wzPrio,
                Adjuntos: null,
                // En electronico con archivos los folios los calcula el servicio (suma de paginas).
                Folios: usaArchivos ? null : _wzFolios,
                NumAnexos: _wzAnexos,
                DependenciaOrigenId: !esEntrada && long.TryParse(_wzDepOrigenId, out var doId) ? doId : null,
                FuncionarioOrigenId: !esEntrada && long.TryParse(_wzFuncOrigenId, out var foId) ? foId : null);

            var res = usaArchivos
                ? await RadSvc.RadicarConArchivosAsync(req,
                    _wzArchivos.Select(a => new AdjuntoBytes(a.Nombre, a.Bytes)).ToList())
                : await RadSvc.RadicarAsync(req);
            if (!res.Ok) { _wzError = res.Error ?? "No se pudo radicar."; return; }

            // Radicar + distribuir en un paso (calca el legacy): si se eligio dependencia destino, distribuir.
            if (long.TryParse(_wzDepDestId, out var depDest) && res.RadicadoId is long rid)
            {
                var dreq = new DistribuirRequest(rid, depDest,
                    long.TryParse(_wzFuncDestId, out var fd) ? fd : null,
                    "", _wzPrio, "");
                await DistSvc.DistribuirAsync(dreq);
            }

            _wzNumero = res.Numero;
            Flash($"Radicado {res.Numero} creado.", true);
            await LoadAsync();
        }
        finally { _wzBusy = false; }
    }

    private async Task ExportCsvAsync()
    {
        var f = BuildFiltro() with { Top = 0 };
        var res = await BandejaSvc.ListarAsync(f);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Radicado;Doc;Fecha;Tipo;Canal;Remitente;Asunto;Dependencia;Funcionario;Estado;SLA");
        foreach (var r in res.Items)
        {
            string q(string? s) => "\"" + (s ?? "").Replace("\"", "\"\"") + "\"";
            sb.AppendLine(string.Join(";", q(r.Numero), q(DocLetra(r.Tipo)), q(r.Fecha), q(r.TipoNombre), q(r.Canal),
                q(r.Remitente), q(r.Asunto), q(r.DependenciaNombre), q(r.FuncionarioNombre), q(r.Estado),
                q(r.Dias?.ToString())));
        }
        await JS.InvokeVoidAsync("tronoxMenuConfig.downloadText", "radicados.csv", sb.ToString(), "text/csv");
    }

    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }
    private static string DocLetra(RadicadoTipo t) => t switch { RadicadoTipo.Entrada => "E", RadicadoTipo.Salida => "S", _ => "I" };
    private static string EstadoLabel(string e) => e == "EnTramite" ? "En tramite" : e;
    private static bool EsCerrado(string e) => e is "Respondido" or "Archivado" or "Anulado" or "Borrador";

    private RenderFragment SlaPill(int? dias) => __builder =>
    {
        if (dias is null) { <span>-</span> return; }
        var d = dias.Value;
        var (bg, fg, txt) = d < 0 ? ("#FEE2E2", "#991B1B", $"{Math.Abs(d)}d vencido")
            : d <= 3 ? ("#FEF3C7", "#92400E", $"{d}d restantes")
            : ("#D1FAE5", "#065F46", $"{d}d restantes");
        <span class="rb-pill" style="background:@bg;color:@fg">@txt</span>
    };
}

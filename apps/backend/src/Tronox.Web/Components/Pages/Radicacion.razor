    private async Task NuevoRadicado()
    {
        _wzOpen = true; _wzStep = 1; _wzError = null; _wzNumero = null; _wzBusy = false;
        _wzDir = RadicadoTipo.Entrada; _wzTipoId = ""; _wzNivelId = ""; _wzCanal = RadicadoCanal.Presencial;
        _wzTerTipo = "Natural"; _wzRemTipoDoc = "CC"; _wzRemDoc = _wzRemNombre = _wzRemEmail = _wzRemTel = "";
        _wzDepOrigenId = _wzFuncOrigenId = ""; _wzSoporte = "Fisico"; _wzAsunto = _wzDescripcion = "";
        _wzFolios = 1; _wzAnexos = 0; _wzDepDestId = _wzFuncDestId = ""; _wzPrio = RadicadoPrioridad.Normal;
        _wzArchivos.Clear(); _wzFileError = null;
        _wzFuncsOrigen = _wzFuncsDest = Array.Empty<OpcionDto>();
        _wzTipos = await BandejaSvc.TiposAsistenteAsync();
        _wzNiveles = await BandejaSvc.NivelesReservaAsync();
        _wzEsq = await BandejaSvc.AsistenteEsquemaAsync();
        _wzFechaCtx = DateTime.Now.ToString("ddd dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("es-CO"));
        if (_authTask is not null)
        {
            var st = await _authTask;
            _wzUsuario = st.User.Identity?.Name
                ?? st.User.FindFirst("display_name")?.Value
                ?? st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? "Operador";
        }
    }

    // ---- Helpers de la vista previa en tiempo real (calca renderRight / renderCtx del legacy) ----
    private string WzTipoCtx => _wzDir == RadicadoTipo.Interno ? "INTERNA — PRESENCIAL" : "ENTRADA — PRESENCIAL";

    private string WzVenceTxt => WzTipoSel is { } t
        ? (t.RequiereRespuesta && t.DiasRespuesta is int d && d > 0
            ? $"Hasta {d} dias {(t.TipoDia == RadicacionTipoDia.Calendario ? "calendario" : "habiles")}"
            : "Sin termino")
        : "";

    private string WzDepNombre(string id) => _deps.FirstOrDefault(x => x.Id.ToString() == id)?.Nombre ?? "—";

    private string WzFoliosPreview => _wzSoporte == "Electronico" && _wzArchivos.Count > 0 ? "auto" : _wzFolios.ToString();

    private string WzNumeroPlaceholder()
    {
        if (_wzEsq is null) { return "—"; }
        var cod = _wzDir switch { RadicadoTipo.Interno => "I", RadicadoTipo.Salida => "S", _ => "E" };
        var x = new string('X', Math.Max(1, _wzEsq.Digitos));
        var partes = _wzEsq.IncluirAnio
            ? new[] { _wzEsq.Sigla, cod, DateTime.Now.Year.ToString(), x }
            : new[] { _wzEsq.Sigla, cod, x };
        return string.Join(_wzEsq.Separador, partes);
    }

    private IEnumerable<(string k, string v)> WzPreviewRows()
    {
        var esEntrada = _wzDir == RadicadoTipo.Entrada;
        var anon = esEntrada && _wzTerTipo == "Anonimo";
        var em = "—";
        var canal = $"{(_wzDir == RadicadoTipo.Interno ? "Interno" : "Presencial")} — {_wzEsq?.EntidadNombre ?? "-"}";
        var remLabel = esEntrada ? "Remitente" : "Origen";
        var remValor = esEntrada
            ? (anon ? "Anonimo" : (string.IsNullOrWhiteSpace(_wzRemNombre) ? em : _wzRemNombre))
            : (string.IsNullOrWhiteSpace(_wzDepOrigenId) ? em : WzDepNombre(_wzDepOrigenId));
        var doc = esEntrada && !anon && !string.IsNullOrWhiteSpace(_wzRemDoc) ? $"{_wzRemTipoDoc} {_wzRemDoc}" : em;
        var asunto = string.IsNullOrWhiteSpace(_wzAsunto) ? em : (_wzAsunto.Length > 45 ? _wzAsunto[..45] + "…" : _wzAsunto);
        var dep = string.IsNullOrWhiteSpace(_wzDepDestId) ? em : WzDepNombre(_wzDepDestId);
        var func = string.IsNullOrWhiteSpace(_wzFuncDestId)
            ? "(sin asignar)"
            : (_wzFuncsDest.FirstOrDefault(f => f.Id.ToString() == _wzFuncDestId)?.Nombre ?? "(sin asignar)");
        yield return ("Canal", canal);
        yield return ("Tipo comunicacion", WzTipoSel?.Nombre ?? em);
        yield return (remLabel, remValor);
        yield return ("Documento", doc);
        yield return ("Asunto", asunto);
        yield return ("Folios", WzFoliosPreview);
        yield return ("Dependencia", dep);
        yield return ("Funcionario", func);
        yield return ("Fecha vencimiento", string.IsNullOrEmpty(WzVenceTxt) ? em : WzVenceTxt);
    }

    private void WzCerrar() { _wzOpen = false; }

    private void WzSetDir(RadicadoTipo dir)
    {
        _wzDir = dir; _wzTipoId = ""; _wzNivelId = ""; _wzTerTipo = "Natural"; _wzError = null;
    }

    private void WzOnTipoChanged()
    {
        var t = WzTipoSel;
        if (t is null) { return; }
        // Autollenar el nivel de reserva por defecto del tipo (calca onTipo del legacy).
        if (t.NivelReservaDefaultId is long nv) { _wzNivelId = nv.ToString(); }
        // Si el tipo no permite anonimo y estaba seleccionado, revertir.
        if (!t.PermiteAnonimo && _wzTerTipo == "Anonimo") { _wzTerTipo = "Natural"; }
    }

    private async Task WzOnDepOrigenChanged()
        => _wzFuncsOrigen = await BandejaSvc.FuncionariosAsync(long.TryParse(_wzDepOrigenId, out var d) ? d : null);

    private async Task WzOnDepDestChanged()
    {
        _wzFuncDestId = "";
        _wzFuncsDest = await BandejaSvc.FuncionariosAsync(long.TryParse(_wzDepDestId, out var d) ? d : null);
    }

    private async Task WzOnFiles(InputFileChangeEventArgs e)
    {
        _wzFileError = null;
        foreach (var f in e.GetMultipleFiles(20))
        {
            var ext = System.IO.Path.GetExtension(f.Name).TrimStart('.').ToLowerInvariant();
            if (!WzExts.Contains(ext)) { _wzFileError = $"'{f.Name}': extension no permitida."; continue; }
            if (f.Size <= 0 || f.Size > WzMaxBytes) { _wzFileError = $"'{f.Name}': tamano invalido (max 50 MB)."; continue; }
            byte[] bytes;
            using (var ms = new MemoryStream())
            {
                await f.OpenReadStream(WzMaxBytes).CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            _wzArchivos.Add(new WzArchivo { Bytes = bytes, Nombre = f.Name, Tamano = bytes.LongLength, Ext = ext });
        }
    }

    private static string WzTam(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0.#} KB" : $"{b / 1048576.0:0.#} MB";

    private string? WzValidarPaso(int step) => step switch
    {
        1 => WzTipoSel is null ? "Selecciona el tipo de comunicacion." : null,
        2 when _wzDir == RadicadoTipo.Entrada && _wzTerTipo != "Anonimo" =>
            string.IsNullOrWhiteSpace(_wzRemNombre) || string.IsNullOrWhiteSpace(_wzRemDoc)
                ? "Nombre y numero de documento del remitente son obligatorios." : null,
        2 when _wzDir == RadicadoTipo.Interno =>
            string.IsNullOrWhiteSpace(_wzDepOrigenId) ? "La dependencia de origen es obligatoria." : null,
        3 => string.IsNullOrWhiteSpace(_wzAsunto) ? "El asunto es obligatorio." : null,
        _ => null
    };

    private void WzSiguiente()
    {
        _wzError = WzValidarPaso(_wzStep);
        if (_wzError is null && _wzStep < 4) { _wzStep++; }
    }

    private void WzAtras() { _wzError = null; if (_wzStep > 1) { _wzStep--; } }

    private async Task WzRadicarAsync()
    {
        // Revalidar todos los pasos por si se salto con navegacion.
        for (var s = 1; s <= 3; s++)
        {
            var err = WzValidarPaso(s);
            if (err is not null) { _wzError = err; _wzStep = s; return; }
        }
        var tipo = WzTipoSel!;
        var anonimo = _wzDir == RadicadoTipo.Entrada && _wzTerTipo == "Anonimo";
        var esEntrada = _wzDir == RadicadoTipo.Entrada;
        var usaArchivos = _wzSoporte == "Electronico" && _wzArchivos.Count > 0;
        _wzBusy = true; _wzError = null;
        try
        {
            var req = new RadicarNuevoRequest(
                Tipo: _wzDir,
                TipoComunicacionId: tipo.Id,
                Asunto: _wzAsunto.Trim(),
                Descripcion: string.IsNullOrWhiteSpace(_wzDescripcion) ? null : _wzDescripcion.Trim(),
                Canal: _wzCanal,
                Anonimo: anonimo,
                RemitenteNombre: esEntrada && !anonimo ? _wzRemNombre.Trim() : null,
                RemitenteEmail: esEntrada && !anonimo && !string.IsNullOrWhiteSpace(_wzRemEmail) ? _wzRemEmail.Trim() : null,
                RemitenteTipoDoc: esEntrada && !anonimo ? _wzRemTipoDoc : null,
                RemitenteDocumento: esEntrada && !anonimo ? _wzRemDoc.Trim() : null,
                RemitenteTelefono: esEntrada && !anonimo && !string.IsNullOrWhiteSpace(_wzRemTel) ? _wzRemTel.Trim() : null,
                NivelReservaId: long.TryParse(_wzNivelId, out var nvId) ? nvId : null,
                RadicadoRelacionadoId: null,
                Soporte: _wzSoporte,
                Prioridad: _wzPrio,
                Adjuntos: null,
                // En electronico con archivos los folios los calcula el servicio (suma de paginas).
                Folios: usaArchivos ? null : _wzFolios,
                NumAnexos: _wzAnexos,
                DependenciaOrigenId: !esEntrada && long.TryParse(_wzDepOrigenId, out var doId) ? doId : null,
                FuncionarioOrigenId: !esEntrada && long.TryParse(_wzFuncOrigenId, out var foId) ? foId : null);

            var res = usaArchivos
                ? await RadSvc.RadicarConArchivosAsync(req,
                    _wzArchivos.Select(a => new AdjuntoBytes(a.Nombre, a.Bytes)).ToList())
                : await RadSvc.RadicarAsync(req);
            if (!res.Ok) { _wzError = res.Error ?? "No se pudo radicar."; return; }

            // Radicar + distribuir en un paso (calca el legacy): si se eligio dependencia destino, distribuir.
            if (long.TryParse(_wzDepDestId, out var depDest) && res.RadicadoId is long rid)
            {
                var dreq = new DistribuirRequest(rid, depDest,
                    long.TryParse(_wzFuncDestId, out var fd) ? fd : null,
                    "", _wzPrio, "");
                await DistSvc.DistribuirAsync(dreq);
            }

            _wzNumero = res.Numero;
            Flash($"Radicado {res.Numero} creado.", true);
            await LoadAsync();
        }
        finally { _wzBusy = false; }
    }

    private async Task ExportCsvAsync()
    {
        var f = BuildFiltro() with { Top = 0 };
        var res = await BandejaSvc.ListarAsync(f);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Radicado;Doc;Fecha;Tipo;Canal;Remitente;Asunto;Dependencia;Funcionario;Estado;SLA");
        foreach (var r in res.Items)
        {
            string q(string? s) => "\"" + (s ?? "").Replace("\"", "\"\"") + "\"";
            sb.AppendLine(string.Join(";", q(r.Numero), q(DocLetra(r.Tipo)), q(r.Fecha), q(r.TipoNombre), q(r.Canal),
                q(r.Remitente), q(r.Asunto), q(r.DependenciaNombre), q(r.FuncionarioNombre), q(r.Estado),
                q(r.Dias?.ToString())));
        }
        await JS.InvokeVoidAsync("tronoxMenuConfig.downloadText", "radicados.csv", sb.ToString(), "text/csv");
    }

    private void Flash(string m, bool ok) { _flash = m; _flashOk = ok; }
    private static string DocLetra(RadicadoTipo t) => t switch { RadicadoTipo.Entrada => "E", RadicadoTipo.Salida => "S", _ => "I" };
    private static string EstadoLabel(string e) => e == "EnTramite" ? "En tramite" : e;
    private static bool EsCerrado(string e) => e is "Respondido" or "Archivado" or "Anulado" or "Borrador";

    private RenderFragment SlaPill(int? dias) => __builder =>
    {
        if (dias is null) { <span>-</span> return; }
        var d = dias.Value;
        var (bg, fg, txt) = d < 0 ? ("#FEE2E2", "#991B1B", $"{Math.Abs(d)}d vencido")
            : d <= 3 ? ("#FEF3C7", "#92400E", $"{d}d restantes")
            : ("#D1FAE5", "#065F46", $"{d}d restantes");
        <span class="rb-pill" style="background:@bg;color:@fg">@txt</span>
    };
}

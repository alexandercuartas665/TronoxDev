        _wzRemMunicipio = ""; _wzGuardarDir = true; _wzFechaDoc = null; _wzObservaciones = ""; _wzRelacionado = "";
        _wzDepOrigenId = _wzFuncOrigenId = ""; _wzSoporte = "Fisico"; _wzAsunto = _wzDescripcion = "";
        _wzFolios = 1; _wzAnexos = 0; _wzDepDestId = _wzFuncDestId = ""; _wzPrio = RadicadoPrioridad.Normal;
        _wzArchivos.Clear(); _wzFileError = null; _wzEstampar = true;
        _wzDigItems.Clear(); _wzDigRadicadoId = null;
        _wzDestinos.Clear(); _wzDestDepSel = _wzDestFuncSel = _wzInstrucciones = "";
        _wzSalOrigen = "RESPUESTA"; _wzSalCanal = _wzSalBuscar = ""; _wzSalEntradaId = null;
        _wzSalEntradaNum = _wzSalEntradaAsunto = _wzSalEntradaRem = ""; _wzSalDefinitiva = false; _wzSalResultados = new();
        _wzFuncsOrigen = _wzFuncsDest = _wzDestFuncs = Array.Empty<OpcionDto>();
        _wzTipos = await BandejaSvc.TiposAsistenteAsync();
        _wzNiveles = await BandejaSvc.NivelesReservaAsync();
        _wzEsq = await BandejaSvc.AsistenteEsquemaAsync();
        // DIVIPOLA: carga los departamentos de Colombia (o el primer pais del catalogo) una sola vez.
        _wzDeptoSel = ""; _wzMunis = Array.Empty<Tronox.Application.Archivistica.MunicipioDto>();
        if (_wzPaisId is null)
        {
            var paises = await DivSvc.ListPaisesAsync();
            _wzPaisId = (paises.FirstOrDefault(p => p.CodigoIso3 == "COL") ?? paises.FirstOrDefault())?.Id;
        }
        _wzDeptos = _wzPaisId is long pid ? await DivSvc.ListDepartamentosAsync(pid) : Array.Empty<Tronox.Application.Archivistica.DepartamentoDto>();
        _wzFechaCtx = DateTime.Now.ToString("ddd dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("es-CO"));
        if (_authTask is not null)
        {
            var st = await _authTask;
            _wzUsuario = st.User.Identity?.Name
                ?? st.User.FindFirst("display_name")?.Value
                ?? st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? "Operador";
        }
    }


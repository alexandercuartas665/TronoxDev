    // Autocompletado del tercero por documento (RF01-3). No pisa lo que el operador ya escribio (solo rellena vacios).
    private async Task WzAutocompletarTercero()
    {
        _wzTerceroSugerido = false;
        var sug = await BandejaSvc.BuscarTerceroPorDocumentoAsync(_wzRemDoc ?? "");
        if (sug is null) { return; }
        if (string.IsNullOrWhiteSpace(_wzRemNombre) && !string.IsNullOrWhiteSpace(sug.Nombre)) { _wzRemNombre = sug.Nombre!; }
        if (string.IsNullOrWhiteSpace(_wzRemEmail) && !string.IsNullOrWhiteSpace(sug.Email)) { _wzRemEmail = sug.Email!; }
        if (string.IsNullOrWhiteSpace(_wzRemTel) && !string.IsNullOrWhiteSpace(sug.Telefono)) { _wzRemTel = sug.Telefono!; }
        if (!string.IsNullOrWhiteSpace(sug.TipoDoc)) { _wzRemTipoDoc = sug.TipoDoc!; }
        // El municipio se autocompleta buscando su departamento en el catalogo cargado (entrada).
        if (string.IsNullOrWhiteSpace(_wzRemMunicipio) && !string.IsNullOrWhiteSpace(sug.Municipio))
        {
            foreach (var d in _wzDeptos)
            {
                var munis = await DivSvc.ListMunicipiosAsync(d.Id);
                if (munis.Any(m => m.Nombre == sug.Municipio))
                {
                    _wzDeptoSel = d.Id.ToString(); _wzMunis = munis; _wzRemMunicipio = sug.Municipio!;
                    break;
                }
            }
        }
        _wzTerceroSugerido = true;
    }


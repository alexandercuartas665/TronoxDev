    }

    // Agrega el destino del formulario a la lista, sin duplicar dependencia (fiel al legacy addDestino).
    private void WzAgregarDestino()
    {
        _wzError = null;
        if (!long.TryParse(_wzDestDepSel, out var depId)) { _wzError = "Seleccione la dependencia destino."; return; }
        if (_wzDestinos.Any(x => x.DepId == depId)) { _wzError = "Esa dependencia ya esta en la lista."; return; }
        long? funcId = long.TryParse(_wzDestFuncSel, out var fid) ? fid : null;
        _wzDestinos.Add(new WzDestino
        {
            DepId = depId,
            FuncId = funcId,
            DepNombre = WzDepNombre(_wzDestDepSel),
            FuncNombre = funcId is null ? "" : (_wzDestFuncs.FirstOrDefault(f => f.Id == funcId)?.Nombre ?? "")
        });
        _wzDestDepSel = ""; _wzDestFuncSel = ""; _wzDestFuncs = Array.Empty<OpcionDto>();
    }

    private async Task WzOnFiles(InputFileChangeEventArgs e)
    {
        _wzFileError = null;
        foreach (var f in e.GetMultipleFiles(20))
        {
            var ext = System.IO.Path.GetExtension(f.Name).TrimStart('.').ToLowerInvariant();
            if (!WzExts.Contains(ext)) { _wzFileError = $"'{f.Name}': extension no permitida."; continue; }
            if (f.Size <= 0 || f.Size > WzMaxBytes) { _wzFileError = $"'{f.Name}': tamano invalido (max 50 MB)."; continue; }
            byte[] bytes;
            using (var ms = new MemoryStream())
            {
                await f.OpenReadStream(WzMaxBytes).CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            _wzArchivos.Add(new WzArchivo { Bytes = bytes, Nombre = f.Name, Tamano = bytes.LongLength, Ext = ext });
        }
    }

    private static string WzTam(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024.0:0.#} KB" : $"{b / 1048576.0:0.#} MB";

    // Paso Digitalizacion: sube cada archivo escaneado al radicado ya creado (AdjuntarAsync), con estado por item.
    private async Task WzOnDigFiles(InputFileChangeEventArgs e)
    {
        _wzFileError = null;
        if (_wzDigRadicadoId is not long rid) { _wzFileError = "El radicado aun no esta disponible."; return; }
        var nuevos = new List<AdjuntoBytes>();
        var items = new List<WzDigItem>();
        foreach (var f in e.GetMultipleFiles(20))
        {
            var ext = System.IO.Path.GetExtension(f.Name).TrimStart('.').ToLowerInvariant();
            if (!WzExts.Contains(ext)) { _wzFileError = $"'{f.Name}': extension no permitida."; continue; }
            if (f.Size <= 0 || f.Size > WzMaxBytes) { _wzFileError = $"'{f.Name}': tamano invalido (max 50 MB)."; continue; }
            byte[] bytes;
            using (var ms = new MemoryStream())
            {
                await f.OpenReadStream(WzMaxBytes).CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            var item = new WzDigItem { Nombre = f.Name, Tamano = bytes.LongLength, Ext = ext, Estado = "Subiendo" };
            _wzDigItems.Add(item);
            items.Add(item);
            nuevos.Add(new AdjuntoBytes(f.Name, bytes));
        }
        if (nuevos.Count == 0) { return; }
        StateHasChanged();
        var res = await RadSvc.AdjuntarAsync(rid, nuevos);
        var estado = res.Ok ? "Adjuntado" : "Error";
        foreach (var it in items) { it.Estado = estado; }
        if (!res.Ok) { _wzFileError = res.Error; }
    }

    // Sticker imprimible del radicado (calca wzImprimirSticker del legacy: ventana propia + window.print).

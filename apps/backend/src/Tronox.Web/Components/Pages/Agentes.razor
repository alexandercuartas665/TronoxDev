@page "/modulo/agentes"
@attribute [Authorize(Policy = "Perm:modulo/agentes:View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Tronox.Application.Tenancy
@using Tronox.Application.Admin
@using Tronox.Domain.Enums
@inject IAiAgentService AgentSvc
@inject IAiAgentCacheService CacheSvc
@inject IAiInferenceService Inferencia
@inject IAiServerConfigService ServersSvc
@inject IEnumerable<IAgentToolset> Toolsets
@inject Tronox.Application.Common.ITenantContext Tenant

@* RQ16 - Agentes de IA (port de ECOREX): agente configurable por tenant (proveedor, modelo, prompt
   editable, prompts enrutados, datos cache, herramientas) con chat de prueba y bitacora. La cuenta del
   proveedor (API key) la define el Super Admin en Servidores de IA. *@

<PageTitle>Agentes de IA - TRONOX</PageTitle>

<div class="ag-wrap">
    <div class="ag-head">
        <div>
            <h1>Agentes de IA</h1>
            <p>Configura agentes con su proveedor, modelo, prompt y herramientas. Pruebalos aqui antes de conectarlos a un proceso (ej. Correos &rarr; PQR).</p>
        </div>
        <button class="btn btn-primary" @onclick="@(() => AbrirEditorNuevo())">+ Nuevo agente</button>
    </div>

    @if (_flash is not null) { <div class="ag-alert @(_flashOk ? "ok" : "err")">@_flash</div> }

    @if (_enabledProviders.Count == 0)
    {
        <div class="ag-warn">&#9888; No hay proveedores de IA habilitados en la plataforma. Un administrador debe configurarlos en <strong>Servidores de IA</strong> antes de que los agentes puedan responder.</div>
    }

    @if (_agents.Count == 0)
    {
        <div class="ag-empty">Aun no hay agentes. Crea uno con "+ Nuevo agente".</div>
    }
    else
    {
        <div class="ag-grid">
            @foreach (var a in _agents)
            {
                <div class="ag-card">
                    <div class="ag-card-top">
                        <div class="ag-title">@a.Name</div>
                        <span class="ag-badge @(a.IsActive ? "on" : "off")">@(a.IsActive ? "Activo" : "Apagado")</span>
                    </div>
                    <div class="ag-role">@(string.IsNullOrWhiteSpace(a.Role) ? "(sin rol)" : a.Role)</div>
                    <div class="ag-meta">
                        <div><span class="k">Proveedor</span> @ProviderName(a.Provider)</div>
                        <div><span class="k">Modelo</span> @(string.IsNullOrWhiteSpace(a.Model) ? "(por defecto)" : a.Model)</div>
                        <div><span class="k">Recursos</span> @a.ResourceCount</div>
                    </div>
                    <div class="ag-acts">
                        <button class="ag-btn" @onclick="@(() => AbrirChat(a))">Probar</button>
                        <button class="ag-btn" @onclick="@(() => AbrirEditor(a.Id))">Editar</button>
                        <button class="ag-btn" @onclick="@(() => ToggleActivoAsync(a))">@(a.IsActive ? "Apagar" : "Encender")</button>
                        <button class="ag-btn" @onclick="@(() => DuplicarAsync(a.Id))">Duplicar</button>
                        <button class="ag-btn danger" @onclick="@(() => EliminarAsync(a))">Eliminar</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ===== Editor ===== *@
@if (_showEditor)
{
    <div class="ag-modal-back" @onclick="CerrarEditor">
        <div class="ag-modal" @onclick:stopPropagation="true">
            <div class="ag-modal-head">
                <h2>@(_editId is null ? "Nuevo agente" : "Editar agente")</h2>
                <button class="ag-x" @onclick="CerrarEditor">&times;</button>
            </div>
            <div class="ag-modal-body">
                <div class="ag-row">
                    <label>Nombre</label>
                    <input class="form-control" @bind="_fName" placeholder="Ej. Clasificador PQRS" />
                </div>
                <div class="ag-row">
                    <label>Rol (descriptivo)</label>
                    <input class="form-control" @bind="_fRole" placeholder="Ej. clasificador, copiloto, seguimiento" />
                </div>
                <div class="ag-row2">
                    <div>
                        <label>Proveedor</label>
                        <select class="form-select" @bind="_fProvider">
                            @foreach (var p in _enabledProviders)
                            {
                                <option value="@p.Provider">@p.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Modelo (opcional)</label>
                        <input class="form-control" @bind="_fModel" placeholder="Vacio = por defecto del proveedor" />
                    </div>
                </div>
                <div class="ag-row">
                    <label>Prompt de sistema</label>
                    <textarea class="form-control" rows="8" @bind="_fPrompt" placeholder="Instrucciones base del agente..."></textarea>
                </div>

                @if (_toolNames.Count > 0)
                {
                    <div class="ag-row">
                        <label>Herramientas habilitadas</label>
                        <div class="ag-tools">
                            @foreach (var t in _toolNames)
                            {
                                <label class="ag-tool"><input type="checkbox" checked="@(!_disabledTools.Contains(t.Name))" @onchange="e => ToggleTool(t.Name, (bool)e.Value!)" /> <span>@t.Name</span> <em>@t.Group</em></label>
                            }
                        </div>
                    </div>
                }

                @if (_editId is not null)
                {
                    <div class="ag-sub">
                        <div class="ag-sub-head"><h3>Prompts enrutados</h3><button class="ag-btn" @onclick="AgregarPrompt">+ Agregar</button></div>
                        @if (_prompts.Count == 0) { <div class="ag-hint">Sin prompts enrutados. El agente usa solo el prompt base.</div> }
                        @foreach (var p in _prompts)
                        {
                            <div class="ag-prompt">
                                <input class="form-control" @bind="p.Name" placeholder="Nombre" />
                                <input class="form-control" @bind="p.Rule" placeholder="Regla: cuando usarlo" />
                                <textarea class="form-control" rows="2" @bind="p.Body" placeholder="Instrucciones"></textarea>
                                <div class="ag-prompt-acts">
                                    <button class="ag-btn" @onclick="@(() => GuardarPromptAsync(p))">Guardar</button>
                                    <button class="ag-btn danger" @onclick="@(() => EliminarPromptAsync(p))">Quitar</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="ag-sub">
                        <div class="ag-sub-head"><h3>Datos que captura (cache)</h3><button class="ag-btn" @onclick="AgregarCampo">+ Agregar</button></div>
                        @if (_fields.Count == 0) { <div class="ag-hint">Sin campos. El agente no extrae datos estructurados.</div> }
                        @foreach (var f in _fields)
                        {
                            <div class="ag-field">
                                <span class="ag-key">@f.FieldKey</span>
                                <input class="form-control" @bind="f.Label" placeholder="Etiqueta" />
                                <input class="form-control" @bind="f.Description" placeholder="Descripcion (ayuda a la extraccion)" />
                                <label class="ag-sticky" title="Si se desmarca, no se sobrescribe una vez capturado"><input type="checkbox" @bind="f.IsUpdatable" /> actualizable</label>
                                <button class="ag-btn" @onclick="@(() => GuardarCampoAsync(f))">Guardar</button>
                                <button class="ag-btn danger" @onclick="@(() => EliminarCampoAsync(f))">Quitar</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ag-hint">Guarda el agente para configurar prompts enrutados y datos de cache.</div>
                }
            </div>
            <div class="ag-modal-foot">
                <button class="btn btn-light" @onclick="CerrarEditor">Cancelar</button>
                <button class="btn btn-primary" @onclick="GuardarAgenteAsync" disabled="@_busy">Guardar</button>
            </div>
        </div>
    </div>
}

@* ===== Chat de prueba ===== *@
@if (_showChat && _chatAgent is not null)
{
    <div class="ag-modal-back" @onclick="CerrarChat">
        <div class="ag-modal ag-chatmodal" @onclick:stopPropagation="true">
            <div class="ag-modal-head">
                <h2>Probar: @_chatAgent.Name</h2>
                <button class="ag-x" @onclick="CerrarChat">&times;</button>
            </div>
            <div class="ag-chat-body">
                <div class="ag-chat-col">
                    <div class="ag-chat-log">
                        @foreach (var m in _turns)
                        {
                            <div class="ag-msg @(m.Role == "user" ? "u" : "m")"><span>@m.Text</span></div>
                        }
                        @if (_chatBusy) { <div class="ag-msg m"><span class="ag-typing">...</span></div> }
                    </div>
                    <div class="ag-chat-input">
                        <input class="form-control" @bind="_chatInput" @bind:event="oninput" @onkeydown="ChatKeyDown" placeholder="Escribe un mensaje de prueba..." />
                        <button class="btn btn-primary" @onclick="EnviarChatAsync" disabled="@_chatBusy">Enviar</button>
                    </div>
                    @if (_chatError is not null) { <div class="ag-alert err">@_chatError</div> }
                </div>
                <div class="ag-debug-col">
                    <div class="ag-debug-head">Prompts enviados a la IA</div>
                    @if (_debug.Count == 0) { <div class="ag-hint">Aqui apareceran los prompts y herramientas de la ultima respuesta.</div> }
                    @foreach (var d in _debug)
                    {
                        <details class="ag-debug">
                            <summary>@d.Title</summary>
                            <pre>@d.Content</pre>
                            @if (!string.IsNullOrWhiteSpace(d.Response)) { <div class="ag-debug-resp">Respuesta:</div> <pre>@d.Response</pre> }
                        </details>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .ag-wrap { padding: 8px 4px 40px; }
    .ag-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:16px; }
    .ag-head h1 { font-size:22px; margin:0 0 4px; }
    .ag-head p { color:var(--tx-muted,#878a99); margin:0; max-width:640px; font-size:13px; }
    .ag-alert { padding:10px 14px; border-radius:6px; margin-bottom:12px; font-size:13px; }
    .ag-alert.ok { background:#d1f5e6; color:#0a6b45; }
    .ag-alert.err { background:#f9d7d7; color:#a12626; }
    .ag-warn { background:#fef4d9; color:#8a5a00; padding:10px 14px; border-radius:6px; margin-bottom:12px; font-size:13px; }
    .ag-empty { color:#878a99; padding:40px; text-align:center; border:1px dashed #ccc; border-radius:8px; }
    .ag-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
    .ag-card { border:1px solid #e0e0e0; border-radius:10px; padding:14px; background:#fff; }
    .ag-card-top { display:flex; justify-content:space-between; align-items:center; }
    .ag-title { font-weight:600; font-size:15px; }
    .ag-badge { font-size:11px; padding:2px 8px; border-radius:10px; }
    .ag-badge.on { background:#d1f5e6; color:#0a6b45; }
    .ag-badge.off { background:#eceef1; color:#878a99; }
    .ag-role { color:#878a99; font-size:12px; margin:4px 0 10px; }
    .ag-meta { font-size:12px; display:grid; gap:3px; margin-bottom:12px; }
    .ag-meta .k { color:#878a99; display:inline-block; width:74px; }
    .ag-acts { display:flex; flex-wrap:wrap; gap:6px; }
    .ag-btn { border:1px solid #d0d3d9; background:#f6f7f9; border-radius:6px; padding:4px 10px; font-size:12px; cursor:pointer; }
    .ag-btn:hover { background:#eceef1; }
    .ag-btn.danger { color:#a12626; border-color:#eec4c4; }
    .ag-modal-back { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; z-index:1200; padding:20px; }
    .ag-modal { background:#fff; border-radius:12px; width:100%; max-width:720px; max-height:90vh; display:flex; flex-direction:column; }
    .ag-chatmodal { max-width:960px; }
    .ag-modal-head { display:flex; justify-content:space-between; align-items:center; padding:16px 20px; border-bottom:1px solid #eee; }
    .ag-modal-head h2 { font-size:17px; margin:0; }
    .ag-x { border:none; background:none; font-size:24px; line-height:1; cursor:pointer; color:#878a99; }
    .ag-modal-body { padding:16px 20px; overflow:auto; }
    .ag-modal-foot { display:flex; justify-content:flex-end; gap:8px; padding:14px 20px; border-top:1px solid #eee; }
    .ag-row { margin-bottom:12px; }
    .ag-row label, .ag-row2 label { display:block; font-size:12px; font-weight:600; margin-bottom:4px; }
    .ag-row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px; }
    .ag-tools { display:flex; flex-wrap:wrap; gap:8px; }
    .ag-tool { display:flex; align-items:center; gap:5px; font-size:12px; border:1px solid #e0e0e0; border-radius:6px; padding:4px 8px; }
    .ag-tool em { color:#878a99; font-style:normal; font-size:11px; }
    .ag-sub { border-top:1px solid #eee; margin-top:14px; padding-top:12px; }
    .ag-sub-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
    .ag-sub-head h3 { font-size:14px; margin:0; }
    .ag-hint { color:#878a99; font-size:12px; }
    .ag-prompt { border:1px solid #eee; border-radius:8px; padding:10px; margin-bottom:8px; display:grid; gap:6px; }
    .ag-prompt-acts { display:flex; gap:6px; }
    .ag-field { display:grid; grid-template-columns:auto 1fr 1.4fr auto auto auto; gap:6px; align-items:center; margin-bottom:6px; }
    .ag-key { font-family:monospace; font-size:11px; background:#eceef1; padding:2px 6px; border-radius:4px; }
    .ag-sticky { font-size:11px; color:#878a99; display:flex; align-items:center; gap:3px; }

    .ag-debug pre { margin:0; padding:8px 10px; font-size:11px; white-space:pre-wrap; word-break:break-word; background:#f6f7f9; max-height:280px; overflow:auto; }
    .ag-debug-resp { font-size:11px; font-weight:600; padding:4px 10px 0; color:#0a6b45; }
</style>

@code {
    private sealed class ProviderOpt { public AiProvider Provider { get; set; } public string DisplayName { get; set; } = ""; }
    private sealed class ToolName { public string Name { get; set; } = ""; public string Group { get; set; } = ""; }
    private sealed class PromptEdit { public long Id { get; set; } public string Name { get; set; } = ""; public string? Rule { get; set; } public string Body { get; set; } = ""; }
    private sealed class FieldEdit { public long Id { get; set; } public string FieldKey { get; set; } = ""; public string Label { get; set; } = ""; public string? Description { get; set; } public bool IsUpdatable { get; set; } = true; }

    private List<AiAgentDto> _agents = new();
    private List<ProviderOpt> _enabledProviders = new();
    private List<ToolName> _toolNames = new();
    private string? _flash; private bool _flashOk; private bool _busy;

    // Editor
    private bool _showEditor; private long? _editId;
    private string _fName = ""; private string? _fRole; private AiProvider _fProvider = AiProvider.Claude;
    private string? _fModel; private string _fPrompt = "";
    private HashSet<string> _disabledTools = new(StringComparer.OrdinalIgnoreCase);
    private List<PromptEdit> _prompts = new();
    private List<FieldEdit> _fields = new();

    // Chat
    private bool _showChat; private AiAgentDto? _chatAgent;
    private List<AiChatTurn> _turns = new(); private string _chatInput = "";
    private bool _chatBusy; private string? _chatError;
    private List<AiDebugPrompt> _debug = new();

    private long Actor => Tenant.UserId ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _toolNames = Toolsets.SelectMany(t => t.GetSpecs().Select(s => new ToolName { Name = s.Name, Group = t.GroupLabel }))
            .GroupBy(t => t.Name).Select(g => g.First()).ToList();
        await CargarProveedores();
        await Cargar();
    }

    private async Task CargarProveedores()
    {
        try
        {
            var list = await ServersSvc.ListEnabledAsync();
            _enabledProviders = list.Select(p => new ProviderOpt { Provider = p.Provider, DisplayName = p.DisplayName }).ToList();
        }
        catch { _enabledProviders = new(); }
        if (_enabledProviders.Count > 0) { _fProvider = _enabledProviders[0].Provider; }
    }

    private async Task Cargar() => _agents = (await AgentSvc.ListAsync()).ToList();

    private static string ProviderName(AiProvider p) => AiProviderCatalog.For(p).DisplayName;

    private void Flash(string msg, bool ok) { _flash = msg; _flashOk = ok; }

    // ===== Editor =====
    private void AbrirEditorNuevo()
    {
        _editId = null; _fName = ""; _fRole = null; _fModel = null; _fPrompt = "";
        _fProvider = _enabledProviders.Count > 0 ? _enabledProviders[0].Provider : AiProvider.Claude;
        _disabledTools = new(StringComparer.OrdinalIgnoreCase);
        _prompts = new(); _fields = new();
        _showEditor = true;
    }

    private async Task AbrirEditor(long id)
    {
        var d = await AgentSvc.GetAsync(id);
        if (d is null) { Flash("El agente ya no existe.", false); await Cargar(); return; }
        _editId = id;
        _fName = d.Agent.Name; _fRole = d.Agent.Role; _fProvider = d.Agent.Provider;
        _fModel = d.Agent.Model; _fPrompt = d.Agent.SystemPrompt;
        _disabledTools = new HashSet<string>(d.Agent.DisabledTools ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
        _prompts = d.Prompts.Select(p => new PromptEdit { Id = p.Id, Name = p.Name, Rule = p.Rule, Body = p.Body }).ToList();
        var fields = await CacheSvc.ListFieldsAsync(id);
        _fields = fields.Select(f => new FieldEdit { Id = f.Id, FieldKey = f.FieldKey, Label = f.Label, Description = f.Description, IsUpdatable = f.IsUpdatable }).ToList();
        _showEditor = true;
    }

    private void CerrarEditor() { _showEditor = false; }

    private void ToggleTool(string name, bool enabled)
    {
        if (enabled) { _disabledTools.Remove(name); } else { _disabledTools.Add(name); }
    }

    private async Task GuardarAgenteAsync()
    {
        if (string.IsNullOrWhiteSpace(_fName)) { Flash("El nombre es obligatorio.", false); return; }
        _busy = true;
        try
        {
            var tools = _disabledTools.ToList();
            if (_editId is null)
            {
                var created = await AgentSvc.CreateAsync(new CreateAiAgentRequest(_fName, _fRole, _fProvider, _fModel, _fPrompt, tools), Actor);
                if (created is null) { Flash("No se pudo crear el agente.", false); return; }
                _editId = created.Id; // permite configurar prompts/cache sin cerrar
                Flash("Agente creado. Ahora puedes configurar prompts y datos.", true);
            }
            else
            {
                await AgentSvc.UpdateAsync(_editId.Value, new UpdateAiAgentRequest(_fName, _fRole, _fProvider, _fModel, _fPrompt, tools), Actor);
                Flash("Agente actualizado.", true);
            }
            await Cargar();
        }
        finally { _busy = false; }
    }

    private async Task ToggleActivoAsync(AiAgentDto a)
    {
        await AgentSvc.SetActiveAsync(a.Id, !a.IsActive, Actor);
        await Cargar();
        Flash(a.IsActive ? "Agente apagado." : "Agente encendido.", true);
    }

    private async Task DuplicarAsync(long id)
    {
        await AgentSvc.DuplicateAsync(id, Actor);
        await Cargar();
        Flash("Agente duplicado.", true);
    }

    private async Task EliminarAsync(AiAgentDto a)
    {
        await AgentSvc.DeleteAsync(a.Id, Actor);
        await Cargar();
        Flash($"Agente \"{a.Name}\" eliminado.", true);
    }

    // ===== Prompts enrutados =====
    private void AgregarPrompt() => _prompts.Add(new PromptEdit { Name = "Nuevo prompt", Body = "" });

    private async Task GuardarPromptAsync(PromptEdit p)
    {
        if (_editId is null) { return; }
        if (p.Id == 0)
        {
            var created = await AgentSvc.AddPromptAsync(new CreateAgentPromptRequest(_editId.Value, p.Name, p.Rule, p.Body), Actor);
            if (created is not null) { p.Id = created.Id; }
        }
        else
        {
            await AgentSvc.UpdatePromptAsync(p.Id, new UpdateAgentPromptRequest(p.Name, p.Rule, p.Body), Actor);
        }
        Flash("Prompt guardado.", true);
    }

    private async Task EliminarPromptAsync(PromptEdit p)
    {
        if (p.Id != 0) { await AgentSvc.DeletePromptAsync(p.Id, Actor); }
        _prompts.Remove(p);
    }

    // ===== Datos cache =====
    private async Task AgregarCampo()
    {
        if (_editId is null) { return; }
        var created = await CacheSvc.CreateFieldAsync(new CreateAgentCacheFieldRequest(_editId.Value, "Nuevo dato", null), Actor);
        if (created is not null)
        {
            _fields.Add(new FieldEdit { Id = created.Id, FieldKey = created.FieldKey, Label = created.Label, Description = created.Description, IsUpdatable = created.IsUpdatable });
        }
    }

    private async Task GuardarCampoAsync(FieldEdit f)
    {
        await CacheSvc.UpdateFieldAsync(f.Id, new UpdateAgentCacheFieldRequest(f.Label, f.Description, f.IsUpdatable), Actor);
        Flash("Dato guardado.", true);
    }

    private async Task EliminarCampoAsync(FieldEdit f)
    {
        await CacheSvc.DeleteFieldAsync(f.Id, Actor);
        _fields.Remove(f);
    }

    // ===== Chat de prueba =====
    private void AbrirChat(AiAgentDto a)
    {
        _chatAgent = a; _turns = new(); _debug = new(); _chatInput = ""; _chatError = null;
        _showChat = true;
    }

    private void CerrarChat() { _showChat = false; }

    private async Task ChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_chatBusy) { await EnviarChatAsync(); }
    }

    private async Task EnviarChatAsync()
    {
        if (_chatAgent is null || string.IsNullOrWhiteSpace(_chatInput)) { return; }
        var texto = _chatInput.Trim();
        _turns.Add(new AiChatTurn("user", texto));
        _chatInput = ""; _chatError = null; _chatBusy = true;
        try
        {
            var res = await Inferencia.TestChatAsync(_chatAgent.Id, _turns.ToList(), actorUserId: Actor);
            if (res.Ok)
            {
                _turns.Add(new AiChatTurn("model", res.Text ?? "(sin respuesta)"));
            }
            else
            {
                _chatError = res.Error ?? "La IA no respondio.";
            }
            _debug = (res.DebugPrompts ?? Array.Empty<AiDebugPrompt>()).ToList();
        }
        catch (Exception ex) { _chatError = ex.Message; }
        finally { _chatBusy = false; }
    }
}

    .ag-chat-col { display:flex; flex-direction:column; border-right:1px solid #eee; }
    .ag-chat-log { flex:1; overflow:auto; padding:16px; display:flex; flex-direction:column; gap:8px; }
    .ag-msg { max-width:85%; padding:8px 12px; border-radius:10px; font-size:13px; }
    .ag-msg.u { align-self:flex-end; background:#405189; color:#fff; }
    .ag-msg.m { align-self:flex-start; background:#f1f3f5; color:#222; }
    .ag-chat-input { display:flex; gap:8px; padding:12px 16px; border-top:1px solid #eee; }

    .ag-debug-head { font-size:12px; font-weight:600; text-transform:uppercase; color:#878a99; margin-bottom:8px; }
    .ag-debug { border:1px solid #e6e8eb; border-radius:6px; margin-bottom:6px; background:#fff; }

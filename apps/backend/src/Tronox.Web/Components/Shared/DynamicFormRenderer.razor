@* =====================================================================================
   DynamicFormRenderer (RQ08, port fiel de ECOREX / ADR-0015) sobre el sistema de diseno de
   TRONOX (tx-* + Velzon). Motor de render de formularios dinamicos: arbol contenedores ->
   preguntas, los 28 FormControlType, condiciones (visibilidad/obligatoriedad/setvalue) vivas,
   campos calculados, tablas dinamicas (GridDetail), maestro-detalle (Subform), configurador en
   cascada, captura Tier 2 real (firma/foto/archivo/GPS) y autosave + envio con validacion
   servidor por campo. NO copia el CSS de ECOREX: estilo TRONOX (tx-ent-*) + un bloque txfr-*.
   ===================================================================================== *@
@using Tronox.Application.Forms
@using Tronox.Domain.Enums
@using System.Text.Json
@using Tronox.Application.Forms.Calc
@using Tronox.Application.Forms.Cascade
@using Tronox.Application.Forms.Lookups
@implements IDisposable
@inject IFormDefinitionService DefSvc
@inject IFormResponseService RespSvc
@inject IFormConditionService CondSvc
@inject Tronox.Application.Forms.Lookups.IFormLookupService LookupSvc
@inject Tronox.Application.Common.ITenantContext Tenant
@inject IJSRuntime JS

@if (_loading)
{
    <div class="txfr-root tx-mod"><p class="tx-ent-hint" style="padding:14px 0"><em>Cargando formulario...</em></p></div>
}
else if (_definition is null)
{
    <div class="txfr-root tx-mod"><div class="tx-ent-hint" style="padding:14px 0">El formulario no esta disponible.</div></div>
}
else
{
    <div class="txfr-root tx-mod @CardWidthClass()">
        @if (ShowHeader)
        {
            <div class="txfr-head">
                <h3 class="txfr-title">@_definition.Title</h3>
                @if (!string.IsNullOrWhiteSpace(_definition.Description))
                {
                    <p class="txfr-sub">@_definition.Description</p>
                }
                <div class="txfr-meta">
                    <span class="tx-ent-badge info">@_definition.Code</span>
                    <span class="tx-ent-badge off">rev @_definition.Revision</span>
                    @if (!string.IsNullOrWhiteSpace(_response?.Reference))
                    {
                        <span class="tx-ent-badge off">ref @_response!.Reference</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_response?.RecordNumber))
                    {
                        <span class="tx-ent-badge ok">@_response!.RecordNumber</span>
                    }
                    else if (_definition.IsTransactional && Mode == FormRenderMode.Fill)
                    {
                        <span class="tx-ent-badge warn" title="El consecutivo se asigna al guardar">N.o por asignar</span>
                    }
                    @if (_response?.RecordStatus == FormRecordStatus.Voided)
                    {
                        <span class="tx-ent-badge" style="background:var(--kt-danger-light,#fde8e8);color:var(--kt-danger,#f06548)">Anulado</span>
                    }
                </div>
            </div>
        }

        @if (_globalError is not null)
        {
            <div class="tx-ent-alert err"><i class="bi bi-exclamation-triangle"></i><span>@_globalError</span></div>
        }

        @{ var rootQuestions = QuestionsOf(null); }
        @if (rootQuestions.Count > 0)
        {
            <div class="row g-3">
                @foreach (var q in rootQuestions)
                {
                    @RenderQuestion(q)
                }
            </div>
        }
        @foreach (var container in ChildrenOf(null))
        {
            @RenderContainer(container)
        }

        @* ---- Decision de aprobacion (compuerta de flujo adelante): se pide junto al formulario.
             NOTA: el binding al flujo BPMN esta DIFERIDO en TRONOX; la eleccion gatea el envio pero
             aun no se propaga al servidor (IFormResponseService.SaveAsync no recibe la decision). ---- *@
        @if (Mode == FormRenderMode.Fill && _response is not null && ApprovalOptions is { Count: > 0 } && !Submitted)
        {
            <div class="txfr-decision">
                <label class="txfr-label">Decision <span class="req">*</span></label>
                <div class="txfr-options">
                    @foreach (var option in ApprovalOptions)
                    {
                        var opt = option;
                        <label class="txfr-check">
                            <input type="radio" name="txfr-approval" checked="@(_approvalChoice == opt)"
                                   disabled="@_busy" @onchange="@(() => _approvalChoice = opt)" />
                            <span>@opt</span>
                        </label>
                    }
                </div>
            </div>
        }

        @* ---- Barra de acciones ---- *@
        @if (Mode == FormRenderMode.Fill && _response is not null)
        {
            <div class="txfr-foot">
                <span class="txfr-autosave">
                    @(_lastSavedAt is null ? "Borrador sin guardar" : $"Borrador guardado {_lastSavedAt:HH:mm:ss}")
                </span>
                @if (!string.IsNullOrEmpty(ImprimirHref))
                {
                    <a class="tx-ent-btn sm" href="@ImprimirHref" target="_blank" rel="noopener"><i class="bi bi-printer"></i> Imprimir</a>
                }
                <button class="tx-ent-btn primary" @onclick="SubmitAsync"
                        disabled="@(_busy || Submitted || (ApprovalOptions is { Count: > 0 } && string.IsNullOrEmpty(_approvalChoice)))">
                    @(Submitted ? "Enviado" : "Enviar")
                </button>
            </div>
        }
        else if (Mode is FormRenderMode.View or FormRenderMode.ReadOnly && _response is not null)
        {
            <div class="txfr-foot">
                @if (!string.IsNullOrEmpty(ImprimirHref))
                {
                    <a class="tx-ent-btn sm" href="@ImprimirHref" target="_blank" rel="noopener"><i class="bi bi-printer"></i> Imprimir</a>
                }
                @* Anular registro transaccional confirmado. *@
                @if (_response.RecordStatus == FormRecordStatus.Confirmed)
                {
                    @if (_voiding)
                    {
                        <input class="tx-ent-input" style="max-width:260px" placeholder="Motivo de anulacion"
                               value="@_voidReason" @oninput="@(e => _voidReason = e.Value?.ToString())" />
                        <button class="tx-ent-btn sm danger" @onclick="VoidAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_voidReason))">Confirmar anulacion</button>
                        <button class="tx-ent-btn sm" @onclick="@(() => _voiding = false)" disabled="@_busy">Cancelar</button>
                    }
                    else
                    {
                        <button class="tx-ent-btn sm danger" @onclick="@(() => _voiding = true)" disabled="@_busy">Anular</button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    // ---- Contrato ----
    [Parameter, EditorRequired] public long DefinitionId { get; set; }
    [Parameter] public string? Reference { get; set; }
    [Parameter] public FormRenderMode Mode { get; set; } = FormRenderMode.Fill;
    [Parameter] public long? ResponseId { get; set; }
    [Parameter] public EventCallback OnSubmitted { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ApplyCardWidth { get; set; }
    [Parameter] public IReadOnlyList<string>? ApprovalOptions { get; set; }

    // ---- Estado ----
    private FormDefinitionDetailDto? _definition;
    private FormResponseDto? _response;
    private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _errors = new(StringComparer.Ordinal);

    // Condiciones (D4): reglas autocontenidas + efectos vivos calculados por FormConditionEvaluator.
    private IReadOnlyList<FormFieldConditionDto> _conditions = Array.Empty<FormFieldConditionDto>();
    private FormConditionEffects _effects = new(
        new HashSet<string>(StringComparer.Ordinal), new HashSet<string>(StringComparer.Ordinal),
        new HashSet<string>(StringComparer.Ordinal), new Dictionary<string, string?>(StringComparer.Ordinal));

    private string? _approvalChoice;
    private bool _voiding;
    private string? _voidReason;

    private bool _loading = true;
    private bool _busy;
    private bool _dirty;
    private string? _globalError;
    private DateTimeOffset? _lastSavedAt;
    private System.Threading.Timer? _autosaveTimer;
    private long _loadedKey = long.MinValue;
    private bool _loadInProgress;

    // Serializa TODO acceso al DbContext desde este componente: las devoluciones de JS (firma, GPS,
    // archivo, lookup) pueden reentrar y dos operaciones concurrentes sobre el mismo contexto lo tumban.
    private readonly SemaphoreSlim _gate = new(1, 1);

    // Estado de UI del configurador en cascada, por campo.
    private readonly Dictionary<string, CascadeState> _cascade = new(StringComparer.Ordinal);
    // Errores de captura de archivo, por campo.
    private readonly Dictionary<string, string> _captureError = new(StringComparer.Ordinal);
    // Registros hijos de subformularios, por campo.
    private readonly Dictionary<string, IReadOnlyList<FormRecordListItemDto>> _subformChildren = new(StringComparer.Ordinal);
    private string? _activeChildField;
    private long? _activeChildResponseId;
    // Estado de lookup (autocompletado), por campo.
    private readonly Dictionary<string, string?> _lookupDisplay = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _lookupQuery = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<FormLookupRow>> _lookupResults = new(StringComparer.Ordinal);
    private readonly HashSet<string> _lookupOpen = new(StringComparer.Ordinal);
    // Filtro / orden de tablas, por campo.
    private readonly Dictionary<string, string> _gridFilter = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (string col, bool asc)> _gridSort = new(StringComparer.Ordinal);

    private long? Actor => Tenant.UserId;
    private bool Submitted => _response?.Status == FormResponseStatus.Submitted;
    private bool ReadOnlyMode => Mode is FormRenderMode.ReadOnly or FormRenderMode.View;
    private bool Editable => !_busy && !ReadOnlyMode && !(Mode == FormRenderMode.Fill && Submitted);
    private bool InputDisabled => !Editable;
    private string? ImprimirHref => _response is not null && Mode != FormRenderMode.Design
        ? $"/formularios/imprimir/{_response.Id}" : null;

    // =====================================================================================
    // Ciclo de vida
    // =====================================================================================

    protected override async Task OnParametersSetAsync()
    {
        var key = DefinitionId;
        if ((_loadedKey == key && !_loading) || _loadInProgress) { return; }
        _loadedKey = key;
        _loading = true;
        _loadInProgress = true;
        try
        {
            await _gate.WaitAsync();
            try
            {
                _definition = await DefSvc.GetAsync(DefinitionId);
                _response = null;
                _values.Clear();
                _errors.Clear();
                _cascade.Clear();
                _conditions = _definition is null
                    ? Array.Empty<FormFieldConditionDto>()
                    : await CondSvc.ListAsync(DefinitionId);

                if (_definition is not null)
                {
                    if (ResponseId is long rid)
                    {
                        _response = await RespSvc.GetAsync(rid);
                    }
                    else if (Mode == FormRenderMode.Fill)
                    {
                        var draft = await RespSvc.GetOrCreateDraftAsync(DefinitionId, Reference);
                        if (!draft.IsOk) { _globalError = draft.Error; }
                        _response = draft.Value;
                    }
                    if (_response is not null)
                    {
                        foreach (var (fieldCode, field) in _response.Data)
                        {
                            _values[fieldCode] = field.Value;
                        }
                    }
                    SeedDefaults();
                    LoadCascadeState();
                    if (_response is not null)
                    {
                        await LoadSubformChildrenAsync();
                    }
                }
            }
            finally { _gate.Release(); }

            // Calculo/condiciones iniciales (puros, sin DB) fuera del gate.
            if (_definition is not null)
            {
                RecomputeConditions();
                RecomputeGrids();
                RecomputeCalculatedFields();
            }
        }
        finally
        {
            _loading = false;
            _loadInProgress = false;
        }

        _autosaveTimer?.Dispose();
        _autosaveTimer = null;
        if (Mode == FormRenderMode.Fill && _response is not null && !Submitted)
        {
            _autosaveTimer = new System.Threading.Timer(
                _ => _ = InvokeAsync(AutosaveTickAsync), null,
                TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_definition is null || InputDisabled) { return; }
        foreach (var q in _definition.Questions.Where(x => x.ControlType == FormControlType.Signature))
        {
            try { await JS.InvokeVoidAsync("tronoxFormCapture.initSignature", $"sig-{q.Id}"); }
            catch (JSException) { /* JS aun no disponible: se reintenta en el siguiente render */ }
        }
    }

    public void Dispose()
    {
        _autosaveTimer?.Dispose();
        _gate.Dispose();
    }

    /// <summary>Valor por defecto (dinamico Hoy/UsuarioActual o literal) en Fill, solo campos de captura sin valor previo.</summary>
    private void SeedDefaults()
    {
        if (_definition is null || Mode != FormRenderMode.Fill || Submitted) { return; }
        foreach (var q in _definition.Questions)
        {
            if (FormFieldValidator.IsNonInput(q.ControlType)
                || FormFieldValidator.IsPlaceholderCapture(q.ControlType)
                || q.ControlType is FormControlType.GridDetail or FormControlType.CascadeConfigurator)
            {
                continue;
            }
            if (!string.IsNullOrEmpty(_values.GetValueOrDefault(q.FieldCode))) { continue; }
            var dyn = ResolveDynamicDefault(q.DefaultDynamic);
            var def = dyn ?? (string.IsNullOrWhiteSpace(q.DefaultValue) ? null : q.DefaultValue);
            if (def is not null) { _values[q.FieldCode] = def; _dirty = true; }
        }
    }

    private string? ResolveDynamicDefault(FormDefaultDynamic d) => d switch
    {
        FormDefaultDynamic.Today => DateTimeOffset.Now.ToString("yyyy-MM-dd"),
        FormDefaultDynamic.CurrentUser => Actor?.ToString(),
        _ => null,
    };

    // =====================================================================================
    // Arbol de contenedores / preguntas
    // =====================================================================================

    private List<FormContainerDto> ChildrenOf(long? parentId)
        => _definition!.Containers.Where(c => c.ParentId == parentId).OrderBy(c => c.SortOrder).ToList();

    private List<FormQuestionDto> QuestionsOf(long? containerId)
        => _definition!.Questions.Where(q => q.ContainerId == containerId).OrderBy(q => q.SortOrder).ToList();

    private readonly Dictionary<long, int> _activeTab = new();

    private static IReadOnlyList<string> ParseTabs(string? tabsJson)
    {
        if (string.IsNullOrWhiteSpace(tabsJson)) { return Array.Empty<string>(); }
        try { return JsonSerializer.Deserialize<List<string>>(tabsJson) ?? new List<string>(); }
        catch (JsonException) { return Array.Empty<string>(); }
    }

    private RenderFragment RenderContainer(FormContainerDto container) => __builder =>
    {
        if (container.IsHidden) { return; }

        if (container.ContainerType == FormContainerType.Tabs)
        {
            var panels = ChildrenOf(container.Id).Where(c => !c.IsHidden).ToList();
            var names = ParseTabs(container.TabsJson);
            var active = Math.Clamp(_activeTab.GetValueOrDefault(container.Id), 0, Math.Max(panels.Count - 1, 0));
            <div class="txfr-segment" style="@container.Style">
                @if (!string.IsNullOrWhiteSpace(container.Name)) { <div class="txfr-segment-head">@container.Name</div> }
                @if (panels.Count > 0)
                {
                    <div class="txfr-tabbar" role="tablist">
                        @for (var i = 0; i < panels.Count; i++)
                        {
                            var index = i;
                            <button type="button" role="tab" class="txfr-tab @(index == active ? "on" : "")"
                                    @onclick="@(() => _activeTab[container.Id] = index)">
                                @(index < names.Count && !string.IsNullOrWhiteSpace(names[index]) ? names[index] : panels[index].Name)
                            </button>
                        }
                    </div>
                }
                @{ var tabRoot = QuestionsOf(container.Id); }
                @if (tabRoot.Count > 0)
                {
                    <div class="row g-3">@foreach (var q in tabRoot) { @RenderQuestion(q) }</div>
                }
                @if (panels.Count > 0)
                {
                    <div class="txfr-tabpanel" role="tabpanel">@RenderContainerChildren(panels[active], panels[active].ContainerType == FormContainerType.Col)</div>
                }
            </div>
            return;
        }

        if (container.ContainerType is FormContainerType.Row or FormContainerType.Col)
        {
            <div class="txfr-group @(container.ContainerType == FormContainerType.Row ? "row-group" : "col-group") @(container.InlineLabels ? "inline" : "")"
                 style="@(WidthStyle(container) + container.Style)">
                @if (!string.IsNullOrWhiteSpace(container.Name)) { <div class="txfr-group-head">@container.Name</div> }
                @RenderContainerChildren(container, stack: container.ContainerType == FormContainerType.Col)
            </div>
            return;
        }

        <div class="txfr-segment" style="@(WidthStyle(container) + container.Style)">
            @if (!string.IsNullOrWhiteSpace(container.Name)) { <div class="txfr-segment-head">@container.Name</div> }
            @RenderContainerChildren(container, stack: false)
        </div>
    };

    private RenderFragment RenderContainerChildren(FormContainerDto container, bool stack) => __builder =>
    {
        var questions = QuestionsOf(container.Id);
        @if (questions.Count > 0)
        {
            <div class="row g-3">
                @foreach (var q in questions) { @RenderQuestion(q, forceFullWidth: stack) }
            </div>
        }
        @foreach (var child in ChildrenOf(container.Id)) { @RenderContainer(child) }
    };

    private static string WidthStyle(FormContainerDto container)
        => container.Width is >= 1 and < 12
            ? $"width:{Math.Round(container.Width / 12d * 100, 2).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;"
            : "";

    // =====================================================================================
    // Render de una pregunta
    // =====================================================================================

    private RenderFragment RenderQuestion(FormQuestionDto q, bool forceFullWidth = false) => __builder =>
    {
        if (q.IsHidden || _effects.Hidden.Contains(q.FieldCode)) { return; }
        var colClass = forceFullWidth ? "col-12" : string.IsNullOrWhiteSpace(q.GridCol) ? "col-12" : q.GridCol;
        <div class="@colClass">
            @switch (q.ControlType)
            {
                case FormControlType.Paragraph:
                    <div class="txfr-paragraph">@(string.IsNullOrWhiteSpace(q.DefaultValue) ? q.Label : q.DefaultValue)</div>
                    break;
                case FormControlType.Divider:
                    <hr class="txfr-divider" role="separator" />
                    break;
                case FormControlType.Spacer:
                    <div style="height:@(int.TryParse(q.DefaultValue, out var h) && h > 0 ? h : 24)px"></div>
                    break;
                case FormControlType.Heading:
                    <h4 class="txfr-heading">@Prefixed(q)</h4>
                    @if (!string.IsNullOrWhiteSpace(q.Caption)) { <p class="tx-ent-hint" style="margin:2px 0 0">@q.Caption</p> }
                    break;
                case FormControlType.Literal:
                    <div class="txfr-literal">@Prefixed(q)</div>
                    @if (!string.IsNullOrWhiteSpace(q.Caption)) { <div class="tx-ent-hint">@q.Caption</div> }
                    break;
                default:
                    <div class="tx-ent-field" style="margin-bottom:0">
                        <label title="@q.HelpText">
                            @Prefixed(q)
                            @if (IsRequired(q)) { <span class="req">*</span> }
                        </label>
                        @if (!string.IsNullOrWhiteSpace(q.Caption)) { <div class="tx-ent-hint" style="margin:0 0 4px">@q.Caption</div> }
                        @RenderInput(q)
                        @if (!string.IsNullOrWhiteSpace(q.HelpText)) { <div class="tx-ent-hint">@q.HelpText</div> }
                        @if (_errors.TryGetValue(q.FieldCode, out var error)) { <div class="tx-ent-fielderr">@error</div> }
                    </div>
                    break;
            }
        </div>
    };

    private RenderFragment RenderInput(FormQuestionDto q) => __builder =>
    {
        var value = _values.GetValueOrDefault(q.FieldCode);

        // Campo calculado: solo lectura, valor recomputado.
        if (!string.IsNullOrWhiteSpace(q.CalcExpression))
        {
            <input class="tx-ent-input readonly" value="@FormatValue(q.Format, value)" tabindex="-1" readonly disabled />
            return;
        }
        // Origen de datos (lookup): degrada si no hay fuente registrada.
        if (q.SourceKind != FormSourceKind.Options)
        {
            @RenderLookup(q, value)
            return;
        }

        switch (q.ControlType)
        {
            case FormControlType.Text:
                <input class="tx-ent-input" value="@(string.IsNullOrEmpty(q.Format) ? value : MaskInput(q.Format, value))"
                       disabled="@InputDisabled" placeholder="@q.PlaceholderText"
                       @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
                break;
            case FormControlType.TextArea:
                <textarea class="tx-ent-input" rows="3" disabled="@InputDisabled" placeholder="@q.PlaceholderText"
                          @onchange="@(e => SetValue(q, e.Value?.ToString()))">@value</textarea>
                break;
            case FormControlType.Number:
                <input type="number" step="any" class="tx-ent-input" value="@value" disabled="@InputDisabled" placeholder="@q.PlaceholderText"
                       @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
                break;
            case FormControlType.Date:
                <input type="date" class="tx-ent-input" value="@value" disabled="@InputDisabled"
                       @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
                break;
            case FormControlType.Time:
                <input type="time" class="tx-ent-input" value="@value" disabled="@InputDisabled"
                       @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
                break;
            case FormControlType.DateTime:
                <input type="datetime-local" class="tx-ent-input" value="@value" disabled="@InputDisabled"
                       @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
                break;
            case FormControlType.Toggle:
                <label class="txfr-toggle">
                    <input type="checkbox" checked="@(value == "true")" disabled="@InputDisabled"
                           @onchange="@(e => SetValue(q, (e.Value is true) ? "true" : "false"))" />
                    <span>@(value == "true" ? "Si" : "No")</span>
                </label>
                break;
            case FormControlType.Select:
                <select class="tx-ent-input" disabled="@InputDisabled"
                        @onchange="@(e => SetValue(q, e.Value?.ToString()))">
                    <option value="" selected="@string.IsNullOrEmpty(value)">-- Selecciona --</option>
                    @foreach (var option in FormFieldValidator.ParseOptions(q.OptionsJson))
                    {
                        <option value="@option.Id" selected="@(option.Id == value)">@option.Label</option>
                    }
                </select>
                break;
            case FormControlType.Radio:
                <div class="txfr-options">
                    @foreach (var option in FormFieldValidator.ParseOptions(q.OptionsJson))
                    {
                        var oid = option.Id;
                        <label class="txfr-check">
                            <input type="radio" name="@($"txfr-{q.Id}")" checked="@(oid == value)" disabled="@InputDisabled"
                                   @onchange="@(() => SetValue(q, oid))" />
                            <span>@option.Label</span>
                        </label>
                    }
                </div>
                break;
            case FormControlType.MultiCheck:
                var selected = FormFieldValidator.ParseMultiValues(value).ToHashSet(StringComparer.Ordinal);
                <div class="txfr-options">
                    @foreach (var option in FormFieldValidator.ParseOptions(q.OptionsJson))
                    {
                        var oid = option.Id;
                        <label class="txfr-check">
                            <input type="checkbox" checked="@selected.Contains(oid)" disabled="@InputDisabled"
                                   @onchange="@(e => ToggleMulti(q, oid, e.Value is true))" />
                            <span>@option.Label</span>
                        </label>
                    }
                </div>
                break;
            case FormControlType.GridDetail:
                @RenderGrid(q, value)
                break;
            case FormControlType.CascadeConfigurator:
                @RenderCascade(q, value)
                break;
            case FormControlType.Subform:
                @RenderSubform(q)
                break;
            case FormControlType.Signature:
                @RenderSignature(q, value)
                break;
            case FormControlType.Photo:
            case FormControlType.Image:
                @RenderFileCapture(q, value, accept: "image/*", capture: q.ControlType == FormControlType.Photo)
                break;
            case FormControlType.File:
                @RenderFileCapture(q, value, accept: null, capture: false)
                break;
            case FormControlType.Gps:
                @RenderGps(q, value)
                break;
            case FormControlType.Audio:
                @RenderPlaceholder("Grabar audio", "bi-mic")
                break;
            case FormControlType.Barcode:
                @RenderPlaceholder("Escanear codigo", "bi-upc-scan")
                break;
            case FormControlType.Button:
                @RenderPlaceholder("Boton (accion via flujo, diferido)", "bi-hand-index")
                break;
            case FormControlType.Chart:
                @RenderPlaceholder("Grafico (disponible en una ola posterior)", "bi-bar-chart")
                break;
            case FormControlType.Html:
                @RenderPlaceholder("Bloque HTML (disponible en una ola posterior)", "bi-code-slash")
                break;
            default:
                <div class="txfr-placeholder">Control @q.ControlType disponible en una ola posterior.</div>
                break;
        }
    };

    private RenderFragment RenderPlaceholder(string label, string icon) => __builder =>
    {
        <div class="txfr-placeholder" aria-disabled="true">
            <i class="bi @icon"></i><span>@label</span>
            <span class="txfr-soon">captura no disponible aun</span>
        </div>
    };

    // =====================================================================================
    // Lookup / origen de datos (degradado: sin fuentes registradas en TRONOX todavia)
    // =====================================================================================

    private RenderFragment RenderLookup(FormQuestionDto q, string? value) => __builder =>
    {
        if (!LookupSvc.HasSource(q.SourceKind))
        {
            <input class="tx-ent-input" value="@value" disabled="@InputDisabled" placeholder="@q.PlaceholderText"
                   @onchange="@(e => SetValue(q, e.Value?.ToString()))" />
            <div class="tx-ent-hint" style="color:var(--kt-warning,#f7b84b)">Fuente de datos no disponible aun.</div>
            return;
        }

        var display = _lookupDisplay.GetValueOrDefault(q.FieldCode) ?? value;
        var results = _lookupResults.GetValueOrDefault(q.FieldCode);
        <div class="txfr-lookup">
            <div class="txfr-lookup-box">
                <input class="tx-ent-input" disabled="@InputDisabled"
                       placeholder="@(string.IsNullOrWhiteSpace(q.PlaceholderText) ? "Buscar..." : q.PlaceholderText)"
                       value="@(_lookupQuery.TryGetValue(q.FieldCode, out var typed) ? typed : display)"
                       @oninput="@(e => LookupTypeAsync(q, e.Value?.ToString()))"
                       @onfocus="@(() => LookupSearchAsync(q, _lookupQuery.GetValueOrDefault(q.FieldCode)))" />
                @if (!string.IsNullOrEmpty(value) && !InputDisabled)
                {
                    <button type="button" class="txfr-lookup-clear" title="Quitar" @onclick="@(() => LookupClearAsync(q))">&times;</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(value) && !string.IsNullOrEmpty(display))
            {
                <div class="tx-ent-hint">Seleccionado: <strong>@display</strong></div>
            }
            @if (_lookupOpen.Contains(q.FieldCode))
            {
                <div class="txfr-lookup-panel">
                    @if (results is null || results.Count == 0)
                    {
                        <div class="txfr-lookup-empty">Sin resultados.</div>
                    }
                    else
                    {
                        @foreach (var it in results)
                        {
                            var item = it;
                            <button type="button" class="txfr-lookup-opt" @onclick="@(() => LookupChoose(q, item))">@item.Display</button>
                        }
                    }
                </div>
            }
        </div>
    };

    private async Task LookupTypeAsync(FormQuestionDto q, string? text)
    {
        _lookupQuery[q.FieldCode] = text;
        await LookupSearchAsync(q, text);
    }

    private async Task LookupSearchAsync(FormQuestionDto q, string? text)
    {
        if (InputDisabled || !LookupSvc.HasSource(q.SourceKind)) { return; }
        _lookupOpen.Add(q.FieldCode);
        await _gate.WaitAsync();
        try
        {
            var rows = await LookupSvc.SearchAsync(q.SourceKind, q.SourceRef ?? "", text, q.FilterJson);
            _lookupResults[q.FieldCode] = rows;
        }
        catch (Exception ex)
        {
            _lookupResults[q.FieldCode] = Array.Empty<FormLookupRow>();
            _globalError = $"No se pudo buscar en la fuente: {ex.Message}";
        }
        finally { _gate.Release(); }
    }

    private void LookupChoose(FormQuestionDto q, FormLookupRow item)
    {
        _lookupDisplay[q.FieldCode] = item.Display;
        _lookupQuery[q.FieldCode] = item.Display;
        _lookupOpen.Remove(q.FieldCode);
        SetValue(q, item.Value);
    }

    private void LookupClearAsync(FormQuestionDto q)
    {
        _lookupDisplay.Remove(q.FieldCode);
        _lookupQuery[q.FieldCode] = null;
        _lookupOpen.Remove(q.FieldCode);
        SetValue(q, null);
    }

    // =====================================================================================
    // Tabla dinamica (GridDetail)
    // =====================================================================================

    private List<FormGridColumn> GridColumnsOf(FormQuestionDto q) => FormGridCalculator.ParseColumns(q.OptionsJson).ToList();

    private List<Dictionary<string, string?>> GridRowsOf(FormQuestionDto q)
        => FormFieldValidator.ParseGridRows(_values.GetValueOrDefault(q.FieldCode))
            .Select(r => new Dictionary<string, string?>(r, StringComparer.Ordinal)).ToList();

    private RenderFragment RenderGrid(FormQuestionDto q, string? value) => __builder =>
    {
        var columns = GridColumnsOf(q);
        if (columns.Count == 0)
        {
            <div class="txfr-placeholder">La tabla no tiene columnas definidas.</div>
            return;
        }
        var rows = GridRowsOf(q);
        var hasTotals = columns.Any(c => c.Agg != FormAggregate.None);
        var sort = _gridSort.GetValueOrDefault(q.FieldCode);
        var filter = _gridFilter.GetValueOrDefault(q.FieldCode);
        <div class="txfr-grid">
            <div class="txfr-grid-toolbar">
                <input class="tx-ent-input" style="max-width:220px;padding:6px 10px" placeholder="Filtrar filas..."
                       value="@filter" @oninput="@(e => _gridFilter[q.FieldCode] = e.Value?.ToString() ?? "")" />
            </div>
            <div class="tx-ent-table-wrap">
                <table class="tx-ent-table txfr-grid-table">
                    <thead>
                        <tr>
                            @if (!InputDisabled) { <th class="txfr-grid-tools"></th> }
                            @foreach (var col in columns)
                            {
                                var colId = col.Id;
                                <th class="txfr-grid-th" @onclick="@(() => SortGridBy(q, colId))">
                                    @col.Label
                                    @if (sort.col == colId) { <span>@(sort.asc ? "↑" : "↓")</span> }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td class="tx-ent-hint" style="text-align:center;padding:12px" colspan="@(columns.Count + (InputDisabled ? 0 : 1))">Sin filas todavia.</td></tr>
                        }
                        @for (var r = 0; r < rows.Count; r++)
                        {
                            var rowIndex = r;
                            if (!GridRowVisible(filter, rows[rowIndex])) { continue; }
                            <tr>
                                @if (!InputDisabled)
                                {
                                    <td class="txfr-grid-tools">
                                        <button type="button" class="txfr-rowtool" title="Duplicar" @onclick="@(() => DuplicateGridRow(q, rowIndex))"><i class="bi bi-files"></i></button>
                                        <button type="button" class="txfr-rowtool danger" title="Eliminar" @onclick="@(() => RemoveGridRow(q, rowIndex))"><i class="bi bi-trash"></i></button>
                                    </td>
                                }
                                @foreach (var col in columns)
                                {
                                    var colId = col.Id;
                                    var cell = rows[rowIndex].GetValueOrDefault(colId);
                                    <td>
                                        @if (col.Calc is not null)
                                        {
                                            <input class="tx-ent-input readonly@(NumCls(col.Format))" tabindex="-1" readonly disabled value="@FormatValue(col.Format, cell)" />
                                        }
                                        else if (col.IsSelect)
                                        {
                                            <select class="tx-ent-input" disabled="@InputDisabled"
                                                    @onchange="@(e => SetGridCell(q, rowIndex, colId, e.Value?.ToString()))">
                                                <option value="" selected="@string.IsNullOrEmpty(cell)">--</option>
                                                @foreach (var opt in col.Options ?? Array.Empty<FormOption>())
                                                {
                                                    <option value="@opt.Id" selected="@(opt.Id == cell)">@opt.Label</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input class="tx-ent-input@(NumCls(col.Format))" disabled="@InputDisabled"
                                                   value="@(string.IsNullOrEmpty(col.Format) ? cell : MaskInput(col.Format, cell))"
                                                   @onchange="@(e => SetGridCell(q, rowIndex, colId, UnformatNumber(col.Format, e.Value?.ToString())))" />
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (hasTotals && rows.Count > 0)
                    {
                        <tfoot>
                            <tr class="txfr-grid-total">
                                @if (!InputDisabled) { <td class="txfr-grid-tools"></td> }
                                @foreach (var col in columns)
                                {
                                    var total = col.Agg == FormAggregate.None ? null : FormGridCalculator.Aggregate(col, rows, _values);
                                    <td class="@(NumCls(col.Format).Trim())">@FormatValue(col.Format, total?.ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            @if (!InputDisabled)
            {
                <button type="button" class="tx-ent-btn sm" style="margin-top:8px" @onclick="@(() => AddGridRow(q))"><i class="bi bi-plus-lg"></i> Agregar fila</button>
            }
        </div>
    };

    private static bool GridRowVisible(string? filter, Dictionary<string, string?> row)
    {
        if (string.IsNullOrWhiteSpace(filter)) { return true; }
        return row.Values.Any(v => !string.IsNullOrEmpty(v) && v.Contains(filter, StringComparison.OrdinalIgnoreCase));
    }

    private void SortGridBy(FormQuestionDto q, string colId)
    {
        var rows = GridRowsOf(q);
        var cur = _gridSort.GetValueOrDefault(q.FieldCode);
        var asc = !(cur.col == colId && cur.asc);
        _gridSort[q.FieldCode] = (colId, asc);
        if (rows.Count > 1)
        {
            rows.Sort((a, b) => CompareCells(a.GetValueOrDefault(colId), b.GetValueOrDefault(colId), asc));
            PersistGrid(q, rows);
        }
    }

    private static int CompareCells(string? a, string? b, bool asc)
    {
        var ea = string.IsNullOrWhiteSpace(a);
        var eb = string.IsNullOrWhiteSpace(b);
        if (ea && eb) { return 0; }
        if (ea) { return 1; }
        if (eb) { return -1; }
        int cmp;
        if (double.TryParse(a, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var na)
            && double.TryParse(b, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var nb))
        {
            cmp = na.CompareTo(nb);
        }
        else { cmp = string.Compare(a, b, StringComparison.OrdinalIgnoreCase); }
        return asc ? cmp : -cmp;
    }

    private void AddGridRow(FormQuestionDto q)
    {
        var rows = GridRowsOf(q);
        var row = new Dictionary<string, string?>(StringComparer.Ordinal);
        foreach (var col in GridColumnsOf(q)) { row[col.Id] = null; }
        rows.Add(row);
        PersistGrid(q, rows);
    }

    private void DuplicateGridRow(FormQuestionDto q, int rowIndex)
    {
        var rows = GridRowsOf(q);
        if (rowIndex < 0 || rowIndex >= rows.Count) { return; }
        rows.Insert(rowIndex + 1, new Dictionary<string, string?>(rows[rowIndex], StringComparer.Ordinal));
        PersistGrid(q, rows);
    }

    private void RemoveGridRow(FormQuestionDto q, int rowIndex)
    {
        var rows = GridRowsOf(q);
        if (rowIndex < 0 || rowIndex >= rows.Count) { return; }
        rows.RemoveAt(rowIndex);
        PersistGrid(q, rows);
    }

    private void SetGridCell(FormQuestionDto q, int rowIndex, string colId, string? cellValue)
    {
        var rows = GridRowsOf(q);
        if (rowIndex < 0 || rowIndex >= rows.Count) { return; }
        rows[rowIndex][colId] = cellValue;
        PersistGrid(q, rows);
    }

    private void PersistGrid(FormQuestionDto q, List<Dictionary<string, string?>> rows)
    {
        _values[q.FieldCode] = rows.Count == 0 ? null : JsonSerializer.Serialize(rows);
        _dirty = true;
        RecomputeGrids();
        RecomputeCalculatedFields();
        RecomputeConditions();
        ValidateField(q);
    }

    /// <summary>Recalcula todas las tablas (formula por fila + roll-up al encabezado) via el helper compartido.</summary>
    private void RecomputeGrids()
    {
        if (_definition is null) { return; }
        foreach (var q in _definition.Questions.Where(x => x.ControlType == FormControlType.GridDetail))
        {
            var cols = GridColumnsOf(q);
            if (cols.Count == 0) { continue; }
            var computation = FormGridCalculator.Compute(GridRowsOf(q), cols, _values);
            var rows = computation.Rows;
            _values[q.FieldCode] = rows.Count == 0 ? null : JsonSerializer.Serialize(rows);
            foreach (var (field, total) in computation.Rollups) { _values[field] = total; }
        }
    }

    // =====================================================================================
    // Maestro-detalle (Subform)
    // =====================================================================================

    private RenderFragment RenderSubform(FormQuestionDto q) => __builder =>
    {
        if (q.SubformDefinitionId is not long childDef)
        {
            <div class="txfr-placeholder">Subformulario sin definicion hija configurada.</div>
            return;
        }
        if (_response is null && Mode != FormRenderMode.Design)
        {
            <div class="txfr-placeholder">El subformulario se habilita al iniciar el registro.</div>
            return;
        }
        var children = _subformChildren.GetValueOrDefault(q.FieldCode) ?? Array.Empty<FormRecordListItemDto>();
        <div class="txfr-subform">
            <div class="tx-ent-table-wrap">
                <table class="tx-ent-table">
                    <thead>
                        <tr><th>Registro</th><th>Estado</th><th>Referencia</th>@if (!InputDisabled) { <th></th> }</tr>
                    </thead>
                    <tbody>
                        @if (children.Count == 0)
                        {
                            <tr><td class="tx-ent-hint" style="text-align:center;padding:12px" colspan="@(InputDisabled ? 3 : 4)">Sin registros hijos todavia.</td></tr>
                        }
                        @foreach (var c in children)
                        {
                            var childId = c.Id;
                            <tr>
                                <td>@(c.RecordNumber ?? "(borrador)")</td>
                                <td>@(c.RecordStatus == FormRecordStatus.Confirmed ? "Confirmado" : c.RecordStatus == FormRecordStatus.Voided ? "Anulado" : "Borrador")</td>
                                <td>@(c.Reference ?? "-")</td>
                                @if (!InputDisabled)
                                {
                                    <td><button type="button" class="txfr-rowtool danger" title="Quitar" @onclick="@(() => RemoveSubformChildAsync(q, childId))"><i class="bi bi-x-lg"></i></button></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!InputDisabled && _response is not null && _activeChildField != q.FieldCode)
            {
                <button type="button" class="tx-ent-btn sm" style="margin-top:8px" @onclick="@(() => AddSubformChildAsync(q))"><i class="bi bi-plus-lg"></i> Agregar registro</button>
            }
            @if (_activeChildField == q.FieldCode && _activeChildResponseId is long activeChild)
            {
                <div class="modal-overlay" @onclick="@(() => { _activeChildField = null; _activeChildResponseId = null; })">
                    <div class="modal-dialog txfr-child-dialog" @onclick:stopPropagation="true">
                        <div class="modal-head"><span>Nuevo registro hijo</span>
                            <button type="button" class="txfr-lookup-clear" @onclick="@(() => { _activeChildField = null; _activeChildResponseId = null; })">&times;</button>
                        </div>
                        <div class="modal-body">
                            <DynamicFormRenderer DefinitionId="childDef" ResponseId="activeChild" Mode="FormRenderMode.Fill"
                                                 ShowHeader="false" OnSubmitted="@(() => OnSubformChildSubmittedAsync(q))" />
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    private async Task LoadSubformChildrenAsync()
    {
        if (_definition is null || _response is null) { return; }
        foreach (var q in _definition.Questions.Where(x => x.ControlType == FormControlType.Subform))
        {
            _subformChildren[q.FieldCode] = await RespSvc.ListChildrenAsync(_response.Id, q.FieldCode);
        }
    }

    private async Task AddSubformChildAsync(FormQuestionDto q)
    {
        if (_response is null || q.SubformDefinitionId is not long childDef) { return; }
        await _gate.WaitAsync();
        try
        {
            var result = await RespSvc.AddChildAsync(_response.Id, q.FieldCode, childDef);
            if (result.IsOk) { _activeChildField = q.FieldCode; _activeChildResponseId = result.Value; }
            else { _globalError = result.Error; }
        }
        finally { _gate.Release(); }
    }

    private async Task OnSubformChildSubmittedAsync(FormQuestionDto q)
    {
        _activeChildField = null;
        _activeChildResponseId = null;
        if (_response is null) { return; }
        await _gate.WaitAsync();
        try { _subformChildren[q.FieldCode] = await RespSvc.ListChildrenAsync(_response.Id, q.FieldCode); }
        finally { _gate.Release(); }
    }

    private async Task RemoveSubformChildAsync(FormQuestionDto q, long childId)
    {
        if (_response is null) { return; }
        await _gate.WaitAsync();
        try
        {
            await RespSvc.UnlinkChildAsync(_response.Id, q.FieldCode, childId);
            _subformChildren[q.FieldCode] = await RespSvc.ListChildrenAsync(_response.Id, q.FieldCode);
        }
        finally { _gate.Release(); }
    }

    // =====================================================================================
    // Configurador en cascada (motor generico via CascadeConfig / CascadeRuntime)
    // =====================================================================================

    private sealed class CascadeState
    {
        public Dictionary<string, List<string>> Selections { get; } = new(StringComparer.Ordinal);
        public Dictionary<string, List<Dictionary<string, string?>>> TableRows { get; } = new(StringComparer.Ordinal);
    }

    private readonly Dictionary<string, CascadeConfig?> _cascadeCfg = new(StringComparer.Ordinal);

    private CascadeConfig? ParseCascade(FormQuestionDto q)
    {
        var json = q.CascadeConfigJson ?? "";
        if (_cascadeCfg.TryGetValue(json, out var cached)) { return cached; }
        var cfg = CascadeConfig.Parse(json, out _);
        _cascadeCfg[json] = cfg;
        return cfg;
    }

    private CascadeState CascadeStateOf(FormQuestionDto q)
    {
        if (!_cascade.TryGetValue(q.FieldCode, out var st)) { st = new CascadeState(); _cascade[q.FieldCode] = st; }
        return st;
    }

    private void LoadCascadeState()
    {
        if (_definition is null) { return; }
        foreach (var q in _definition.Questions.Where(x => x.ControlType == FormControlType.CascadeConfigurator))
        {
            var st = CascadeStateOf(q);
            var raw = _values.GetValueOrDefault(q.FieldCode);
            if (string.IsNullOrWhiteSpace(raw)) { continue; }
            try
            {
                using var doc = JsonDocument.Parse(raw);
                if (doc.RootElement.TryGetProperty("selections", out var sel) && sel.ValueKind == JsonValueKind.Object)
                {
                    foreach (var p in sel.EnumerateObject())
                    {
                        var list = new List<string>();
                        if (p.Value.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var e in p.Value.EnumerateArray()) { if (e.GetString() is string s) { list.Add(s); } }
                        }
                        st.Selections[p.Name] = list;
                    }
                }
                if (doc.RootElement.TryGetProperty("tables", out var tables) && tables.ValueKind == JsonValueKind.Array)
                {
                    foreach (var t in tables.EnumerateArray())
                    {
                        if (!t.TryGetProperty("key", out var kp) || kp.GetString() is not string key) { continue; }
                        var rows = new List<Dictionary<string, string?>>();
                        if (t.TryGetProperty("rows", out var rr) && rr.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var rowEl in rr.EnumerateArray())
                            {
                                var row = new Dictionary<string, string?>(StringComparer.Ordinal);
                                foreach (var cp in rowEl.EnumerateObject()) { row[cp.Name] = cp.Value.ValueKind == JsonValueKind.String ? cp.Value.GetString() : cp.Value.ToString(); }
                                rows.Add(row);
                            }
                        }
                        st.TableRows[key] = rows;
                    }
                }
            }
            catch (JsonException) { /* valor invalido: cascade arranca vacio */ }
        }
    }

    private RenderFragment RenderCascade(FormQuestionDto q, string? value) => __builder =>
    {
        var cfg = ParseCascade(q);
        if (cfg is null)
        {
            <div class="txfr-placeholder">El configurador en cascada no tiene una configuracion (taxonomia) valida.</div>
            return;
        }
        var st = CascadeStateOf(q);
        var selections = st.Selections.ToDictionary(kv => kv.Key, kv => (IReadOnlyList<string>)kv.Value, StringComparer.Ordinal);
        <div class="txfr-cascade">
            @foreach (var level in cfg.Levels)
            {
                <div class="txfr-cascade-level">
                    <div class="txfr-label">@level.Label</div>
                    @if (level.Source is not null)
                    {
                        <div class="tx-ent-hint" style="color:var(--kt-warning,#f7b84b)">Fuente de datos no disponible aun.</div>
                    }
                    else
                    {
                        var visible = CascadeRuntime.VisibleOptions(level, selections);
                        if (visible.Count == 0)
                        {
                            <div class="tx-ent-hint">Selecciona una opcion del nivel anterior.</div>
                        }
                        else
                        {
                            <div class="txfr-options">
                                @foreach (var op in visible)
                                {
                                    var opId = op.Id;
                                    var chosen = st.Selections.GetValueOrDefault(level.Key)?.Contains(opId) == true;
                                    <label class="txfr-check">
                                        <input type="@(level.Select == "single" ? "radio" : "checkbox")"
                                               name="@($"txcas-{q.Id}-{level.Key}")" checked="@chosen" disabled="@InputDisabled"
                                               @onchange="@(e => CascadeToggle(q, cfg, level, opId, level.Select == "single" || e.Value is true))" />
                                        <span>@op.Label</span>
                                    </label>
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (cfg.RenderTables)
            {
                var specs = CascadeRuntime.DesiredTables(cfg, selections);
                @foreach (var spec in specs)
                {
                    var setName = spec.ColumnSet;
                    var colKeys = cfg.ColumnSets.TryGetValue(setName, out var cs) ? cs : Array.Empty<string>();
                    var rows = st.TableRows.TryGetValue(spec.Key, out var tr) ? tr : new List<Dictionary<string, string?>>();
                    <div class="txfr-cascade-table">
                        <div class="txfr-segment-head">@string.Join(" / ", spec.ProductLabels)</div>
                        <div class="tx-ent-table-wrap">
                            <table class="tx-ent-table txfr-grid-table">
                                <thead>
                                    <tr>
                                        @if (!InputDisabled) { <th class="txfr-grid-tools"></th> }
                                        @foreach (var ck in colKeys) { <th>@(cfg.Columns.TryGetValue(ck, out var cc) ? cc.Label : ck)</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (rows.Count == 0)
                                    {
                                        <tr><td class="tx-ent-hint" style="text-align:center;padding:10px" colspan="@(colKeys.Count + (InputDisabled ? 0 : 1))">Sin filas.</td></tr>
                                    }
                                    @for (var r = 0; r < rows.Count; r++)
                                    {
                                        var rowIndex = r;
                                        <tr>
                                            @if (!InputDisabled)
                                            {
                                                <td class="txfr-grid-tools"><button type="button" class="txfr-rowtool danger" @onclick="@(() => CascadeRemoveRow(q, spec.Key, rowIndex))"><i class="bi bi-trash"></i></button></td>
                                            }
                                            @foreach (var ck in colKeys)
                                            {
                                                var colKey = ck;
                                                var col = cfg.Columns.TryGetValue(colKey, out var cc2) ? cc2 : null;
                                                var cell = rows[rowIndex].GetValueOrDefault(colKey);
                                                <td>
                                                    @if (col?.Calc is not null)
                                                    {
                                                        <input class="tx-ent-input readonly@(NumCls(col.Format))" readonly disabled tabindex="-1" value="@FormatValue(col.Format, cell)" />
                                                    }
                                                    else
                                                    {
                                                        <input class="tx-ent-input@(NumCls(col?.Format))" disabled="@InputDisabled" value="@cell"
                                                               @onchange="@(e => CascadeSetCell(q, cfg, spec.Key, rowIndex, colKey, e.Value?.ToString()))" />
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!InputDisabled)
                        {
                            <button type="button" class="tx-ent-btn sm" style="margin-top:6px" @onclick="@(() => CascadeAddRow(q, spec.Key, colKeys))"><i class="bi bi-plus-lg"></i> Agregar fila</button>
                        }
                    </div>
                }
            }
        </div>
    };

    private void CascadeToggle(FormQuestionDto q, CascadeConfig cfg, CascadeLevel level, string opId, bool on)
    {
        var st = CascadeStateOf(q);
        if (!st.Selections.TryGetValue(level.Key, out var list)) { list = new List<string>(); st.Selections[level.Key] = list; }
        if (level.Select == "single") { list.Clear(); if (on) { list.Add(opId); } }
        else { if (on) { if (!list.Contains(opId)) { list.Add(opId); } } else { list.Remove(opId); } }
        PersistCascade(q, cfg);
    }

    private void CascadeAddRow(FormQuestionDto q, string tableKey, IReadOnlyList<string> colKeys)
    {
        var st = CascadeStateOf(q);
        if (!st.TableRows.TryGetValue(tableKey, out var rows)) { rows = new List<Dictionary<string, string?>>(); st.TableRows[tableKey] = rows; }
        var row = new Dictionary<string, string?>(StringComparer.Ordinal);
        foreach (var ck in colKeys) { row[ck] = null; }
        rows.Add(row);
        PersistCascade(q, ParseCascade(q)!);
    }

    private void CascadeRemoveRow(FormQuestionDto q, string tableKey, int rowIndex)
    {
        var st = CascadeStateOf(q);
        if (st.TableRows.TryGetValue(tableKey, out var rows) && rowIndex >= 0 && rowIndex < rows.Count)
        {
            rows.RemoveAt(rowIndex);
            PersistCascade(q, ParseCascade(q)!);
        }
    }

    private void CascadeSetCell(FormQuestionDto q, CascadeConfig cfg, string tableKey, int rowIndex, string colKey, string? val)
    {
        var st = CascadeStateOf(q);
        if (st.TableRows.TryGetValue(tableKey, out var rows) && rowIndex >= 0 && rowIndex < rows.Count)
        {
            rows[rowIndex][colKey] = val;
            PersistCascade(q, cfg);
        }
    }

    /// <summary>Recalcula formulas por fila de las tablas de cascade y serializa el shape {selections, tables, totals}.</summary>
    private void PersistCascade(FormQuestionDto q, CascadeConfig cfg)
    {
        var st = CascadeStateOf(q);
        // Formula por fila con el evaluador compartido.
        foreach (var (_, rows) in st.TableRows)
        {
            foreach (var row in rows)
            {
                foreach (var (colKey, col) in cfg.Columns)
                {
                    if (string.IsNullOrWhiteSpace(col.Calc)) { continue; }
                    if (!row.ContainsKey(colKey)) { continue; }
                    var res = FormExpressionEvaluator.Evaluate(col.Calc, row, _values);
                    row[colKey] = res?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                }
            }
        }
        var payload = new Dictionary<string, object?>
        {
            ["selections"] = st.Selections.ToDictionary(kv => kv.Key, kv => kv.Value),
            ["tables"] = st.TableRows.Select(kv => new Dictionary<string, object?> { ["key"] = kv.Key, ["rows"] = kv.Value }).ToList(),
        };
        _values[q.FieldCode] = JsonSerializer.Serialize(payload);
        _dirty = true;
        RecomputeCalculatedFields();
        RecomputeConditions();
        ValidateField(q);
    }

    // =====================================================================================
    // Captura Tier 2 real: firma, foto/imagen/archivo, GPS
    // =====================================================================================

    private RenderFragment RenderSignature(FormQuestionDto q, string? value) => __builder =>
    {
        var hasVal = !string.IsNullOrEmpty(value);
        <div class="txfr-sign">
            @if (InputDisabled)
            {
                @if (hasVal) { <img class="txfr-sign-preview" src="@value" alt="Firma" /> }
                else { <div class="txfr-placeholder"><span>Sin firma</span></div> }
            }
            else
            {
                <canvas id="@($"sig-{q.Id}")" class="txfr-sign-canvas" width="320" height="120"></canvas>
                <div class="txfr-sign-actions">
                    <button type="button" class="tx-ent-btn sm" @onclick="@(() => ClearSignatureAsync(q))">Limpiar</button>
                    <button type="button" class="tx-ent-btn sm primary" @onclick="@(() => SaveSignatureAsync(q))">Guardar firma</button>
                    @if (hasVal) { <span class="txfr-ok">Firma capturada</span> }
                </div>
            }
        </div>
    };

    private RenderFragment RenderGps(FormQuestionDto q, string? value) => __builder =>
    {
        <div class="txfr-gps">
            <input class="tx-ent-input readonly" readonly value="@value" placeholder="Sin ubicacion" />
            @if (!InputDisabled)
            {
                <button type="button" class="tx-ent-btn sm" disabled="@_busy" @onclick="@(() => CaptureGpsAsync(q))"><i class="bi bi-geo-alt"></i> Capturar ubicacion</button>
            }
        </div>
    };

    private RenderFragment RenderFileCapture(FormQuestionDto q, string? value, string? accept, bool capture) => __builder =>
    {
        var hasVal = !string.IsNullOrEmpty(value);
        <div class="txfr-file">
            @if (!InputDisabled)
            {
                @if (capture)
                {
                    <InputFile OnChange="@(e => OnFileSelectedAsync(q, e))" accept="@accept" capture="environment" />
                }
                else
                {
                    <InputFile OnChange="@(e => OnFileSelectedAsync(q, e))" accept="@accept" />
                }
            }
            @if (_captureError.TryGetValue(q.FieldCode, out var cerr)) { <div class="tx-ent-fielderr">@cerr</div> }
            @if (hasVal)
            {
                <div class="txfr-file-chosen">
                    @if (IsImageDataUri(value)) { <img class="txfr-file-preview" src="@value" alt="adjunto" /> }
                    <span class="txfr-ok">@(MimeOf(value) ?? "archivo adjunto")</span>
                    @if (!InputDisabled) { <button type="button" class="txfr-lookup-clear" title="Quitar" @onclick="@(() => SetValue(q, null))">&times;</button> }
                </div>
            }
        </div>
    };

    private static bool IsImageDataUri(string? v) => v is not null && v.StartsWith("data:image", StringComparison.OrdinalIgnoreCase);

    private static string? MimeOf(string? v)
    {
        if (string.IsNullOrEmpty(v) || !v.StartsWith("data:", StringComparison.Ordinal)) { return null; }
        var semi = v.IndexOf(';');
        return semi > 5 ? v[5..semi] : null;
    }

    private async Task SaveSignatureAsync(FormQuestionDto q)
    {
        try
        {
            var data = await JS.InvokeAsync<string>("tronoxFormCapture.signatureData", $"sig-{q.Id}");
            if (!string.IsNullOrEmpty(data)) { SetValue(q, data); }
        }
        catch (JSException) { }
    }

    private async Task ClearSignatureAsync(FormQuestionDto q)
    {
        try { await JS.InvokeVoidAsync("tronoxFormCapture.clearSignature", $"sig-{q.Id}"); }
        catch (JSException) { }
        SetValue(q, null);
    }

    private async Task CaptureGpsAsync(FormQuestionDto q)
    {
        try
        {
            var coords = await JS.InvokeAsync<string>("tronoxFormCapture.geolocate");
            SetValue(q, coords);
        }
        catch (JSException) { }
    }

    private async Task OnFileSelectedAsync(FormQuestionDto q, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) { return; }
        const long max = 1024 * 1024; // 1 MB inline
        if (file.Size > max)
        {
            _captureError[q.FieldCode] = $"El archivo supera 1 MB ({file.Size / 1024} KB). El almacenamiento de objetos para adjuntos grandes llega en un incremento posterior.";
            return;
        }
        _captureError.Remove(q.FieldCode);
        try
        {
            await using var stream = file.OpenReadStream(max);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
            SetValue(q, $"data:{mime};base64,{b64}");
        }
        catch (Exception ex)
        {
            _captureError[q.FieldCode] = $"No se pudo leer el archivo: {ex.Message}";
        }
    }

    // =====================================================================================
    // Estado, condiciones, calculo y validacion (puros)
    // =====================================================================================

    private void SetValue(FormQuestionDto q, string? value)
    {
        _values[q.FieldCode] = value;
        _dirty = true;
        RecomputeConditions();
        RecomputeGrids();
        RecomputeCalculatedFields();
        ValidateField(q);
    }

    private void ToggleMulti(FormQuestionDto q, string optionId, bool on)
    {
        var selected = FormFieldValidator.ParseMultiValues(_values.GetValueOrDefault(q.FieldCode)).ToList();
        if (on && !selected.Contains(optionId, StringComparer.Ordinal)) { selected.Add(optionId); }
        else if (!on) { selected.RemoveAll(s => string.Equals(s, optionId, StringComparison.Ordinal)); }
        _values[q.FieldCode] = selected.Count == 0 ? null : JsonSerializer.Serialize(selected);
        _dirty = true;
        RecomputeConditions();
        RecomputeCalculatedFields();
        ValidateField(q);
    }

    /// <summary>Reevalua las condiciones sobre los valores actuales y fija los setValue resultantes.</summary>
    private void RecomputeConditions()
    {
        if (_conditions.Count == 0) { return; }
        var eff = FormConditionEvaluator.Evaluate(_conditions, _values);
        foreach (var (code, val) in eff.SetValues)
        {
            if (!string.Equals(_values.GetValueOrDefault(code), val, StringComparison.Ordinal))
            {
                _values[code] = val;
            }
        }
        _effects = eff;
    }

    private void RecomputeCalculatedFields()
    {
        if (_definition is null) { return; }
        foreach (var q in _definition.Questions.Where(x => !string.IsNullOrWhiteSpace(x.CalcExpression)))
        {
            var result = FormExpressionEvaluator.Evaluate(q.CalcExpression, _values);
            _values[q.FieldCode] = result?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private bool IsRequired(FormQuestionDto q)
        => _effects.Required.Contains(q.FieldCode) || (q.Required && !_effects.Optional.Contains(q.FieldCode));

    private void ValidateField(FormQuestionDto q)
    {
        if (_effects.Hidden.Contains(q.FieldCode)) { _errors.Remove(q.FieldCode); return; }
        var error = FormFieldValidator.Validate(
            q.ControlType, IsRequired(q), _values.GetValueOrDefault(q.FieldCode),
            FormFieldValidator.ParseOptions(q.OptionsJson),
            FormFieldValidator.ParseRules(q.ValidationJson), q.OptionsJson);
        if (error is null) { _errors.Remove(q.FieldCode); } else { _errors[q.FieldCode] = error; }
    }

    private IReadOnlyDictionary<string, FormFieldValue> BuildDocument()
        => _definition!.Questions
            .Where(q => !FormFieldValidator.IsNonInput(q.ControlType))
            .Where(q => _values.GetValueOrDefault(q.FieldCode) is not null)
            .ToDictionary(
                q => q.FieldCode,
                q => new FormFieldValue(_values[q.FieldCode], q.ControlType.ToString()),
                StringComparer.Ordinal);

    // =====================================================================================
    // Guardado / envio / anulacion
    // =====================================================================================

    private async Task AutosaveTickAsync()
    {
        if (!_dirty || _busy || _response is null || Submitted || Mode != FormRenderMode.Fill) { return; }
        await SaveAsync(submit: false);
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        _errors.Clear();
        foreach (var q in _definition!.Questions) { ValidateField(q); }
        if (_errors.Count > 0) { _globalError = "Revisa los campos marcados antes de enviar."; return; }
        await SaveAsync(submit: true);
    }

    private async Task SaveAsync(bool submit)
    {
        if (_response is null || Mode != FormRenderMode.Fill) { return; }
        _busy = true;
        _globalError = null;
        FormResponseDto? submitted = null;
        await _gate.WaitAsync();
        try
        {
            var result = await RespSvc.SaveAsync(
                _response.Id, BuildDocument(), submit, Actor,
                hiddenFieldCodes: _effects.Hidden.ToArray());
            if (result.Status == FormServiceStatus.ValidationFailed && result.FieldErrors is not null)
            {
                foreach (var (fieldCode, message) in result.FieldErrors) { _errors[fieldCode] = message; }
                _globalError = "Revisa los campos marcados antes de enviar.";
                return;
            }
            if (!result.IsOk || result.Value is null)
            {
                _globalError = result.Error ?? "No se pudo guardar la respuesta.";
                return;
            }
            _response = result.Value;
            _dirty = false;
            _lastSavedAt = DateTimeOffset.Now;
            if (submit)
            {
                _autosaveTimer?.Dispose();
                _autosaveTimer = null;
                submitted = result.Value;
            }
        }
        finally { _gate.Release(); _busy = false; }

        // OnSubmitted fuera del gate: el padre puede destruir este componente en el callback.
        if (submitted is not null) { await OnSubmitted.InvokeAsync(); }
    }

    private async Task VoidAsync()
    {
        if (_response is null || string.IsNullOrWhiteSpace(_voidReason)) { return; }
        _busy = true;
        await _gate.WaitAsync();
        try
        {
            var result = await RespSvc.VoidAsync(_response.Id, _voidReason!, Actor);
            if (result.IsOk && result.Value is not null)
            {
                _response = result.Value;
                _voiding = false;
                _voidReason = null;
            }
            else { _globalError = result.Error ?? "No se pudo anular el registro."; }
        }
        finally { _gate.Release(); _busy = false; }
    }

    // =====================================================================================
    // Formato / helpers
    // =====================================================================================

    private static string Prefixed(FormQuestionDto q)
        => string.IsNullOrWhiteSpace(q.Numeral) ? q.Label : $"{q.Numeral}. {q.Label}";

    private string? CardWidthClass()
    {
        if (!ApplyCardWidth || _definition is null) { return null; }
        return _definition.CardLayout switch
        {
            FormCardLayout.Ancho => "cw-ancho",
            FormCardLayout.Completo => "cw-completo",
            _ => "cw-normal"
        };
    }

    private static string NumCls(string? format)
        => format is "currency" or "integer" or "decimal" or "percent" or "document" ? " txfr-num" : "";

    private static string FormatValue(string? format, string? value)
    {
        if (string.IsNullOrWhiteSpace(format) || string.IsNullOrWhiteSpace(value)) { return value ?? ""; }
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        if (!decimal.TryParse(value.Replace(" ", "").Replace(",", ""), System.Globalization.NumberStyles.Any, ci, out var num)) { return value; }
        return format.Trim().ToLowerInvariant() switch
        {
            "currency" => "$ " + num.ToString("#,##0", ci),
            "percent" => num.ToString("0.##", ci) + " %",
            "integer" => Math.Round(num).ToString("#,##0", ci),
            "decimal" => num.ToString("#,##0.00", ci),
            "document" => num.ToString("#,##0", ci),
            _ => value,
        };
    }

    private static string MaskInput(string? format, string? value)
    {
        if (string.IsNullOrWhiteSpace(format) || string.IsNullOrWhiteSpace(value)) { return value ?? ""; }
        if (format.Trim().ToLowerInvariant() == "phone")
        {
            var d = new string(value.Where(char.IsDigit).ToArray());
            if (d.Length == 10) { return $"({d[..3]}) {d[3..6]}-{d[6..]}"; }
            if (d.Length == 7) { return $"{d[..3]}-{d[3..]}"; }
            return value;
        }
        return FormatValue(format, value);
    }

    private static string? UnformatNumber(string? format, string? value)
    {
        if (string.IsNullOrWhiteSpace(format) || string.IsNullOrWhiteSpace(value)) { return value; }
        var cleaned = value.Replace("$", "").Replace("%", "").Replace(" ", "").Replace(",", "").Trim();
        return decimal.TryParse(cleaned, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? n.ToString(System.Globalization.CultureInfo.InvariantCulture) : value;
    }
}

